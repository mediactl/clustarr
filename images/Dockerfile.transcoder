# syntax=docker/dockerfile:1.7
#
# ghcr.io/mediactl/clustarr/transcoder -- the squasharr worker
# on FFmpeg 9.0's libraries, in images built FROM scratch (spec
# docs/superpowers/specs/2026-09-30-ffgo-transcoding-design.md §5 and its
# 2026-10-01 amendment). Targets:
#
#   transcoder        every class -- CPU, NVIDIA and Intel; amd64 and arm64
#                     (Intel's VAAPI driver and QSV runtimes on amd64 only)
#   transcoder-debug  the same plus a static busybox, for kubectl exec
#
# There is no CUDA target (docs/adr/0015-no-cuda-image.md; removed
# 2026-10-01). An nvidia pool runs `transcoder`: the NVIDIA container
# runtime injects the driver's libraries (libcuda, libnvidia-encode,
# libnvcuvid) into the pod, which asks for them with runtimeClassName, an
# nvidia.com/gpu request and NVIDIA_DRIVER_CAPABILITIES=video,compute,utility
# (app/squash/controller/pool.applyHardware). The old target differed from
# `transcoder` by two ENV lines only, one of them NVIDIA_VISIBLE_DEVICES=all,
# which would hand every GPU to any pod running it under the nvidia runtime.
#
#   docker build -f images/Dockerfile.transcoder --target transcoder -t ghcr.io/mediactl/clustarr/transcoder:dev .
#
# Nothing in the final images is copied by hand that lddtree can trace:
# images/distroless/stage.sh follows the DT_NEEDED tree of everything the
# worker loads (the worker is a purego binary, so it brings ld-linux and
# libc), and names what is dlopen'ed (glibc's NSS plugins; the Intel
# runtime). One image runs every pool (ADR 0015), so it carries the Intel
# runtime too, which nothing injects at run time as NVIDIA's runtime injects
# NVIDIA's driver (Phase 4 folded the old transcoder-intel target in).
#
# There is no ffmpeg or ffprobe executable in the image: the worker runs
# every transcode and probe in-process (ffgo Phase 5 deleted the argv
# engine, and with it the Wolfi image that was named transcoder until
# then; this one was transcoder-distroless). stage.sh refuses to stage
# either, so a copy cannot creep back in.
#
# FFmpeg is BtbN's 9.0 shared GPL build (FFMPEG_URL / FFMPEG_SHA256 pin
# one): NVENC/NVDEC and the CUDA filters (built with clang), VAAPI through
# libva (dlopen'ed), and the libvpl dispatcher (linked in). Its libraries
# and the ffgo shim, compiled against the same tarball's headers, live in
# /usr/lib, which the dynamic linker searches without an ld.so.cache.

ARG GO_VERSION=1.27
ARG FFMPEG_BRANCH=9.0

# ---------------------------------------------------------------------------
# build: the worker (CGO_ENABLED=0) and the ffgo shim's source
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -ldflags "-s -w -X github.com/mediactl/clustarr/pkg/version.Version=${VERSION}" \
      -o /out/squasharr-worker ./cmd/squasharr-worker \
 && mkdir -p /out/ffgo /out/licenses/clustarr /out/licenses/ffgo \
 && ffgo="$(go list -m -f '{{.Dir}}' github.com/obinnaokechukwu/ffgo)" \
 && cp -r "$ffgo/shim" /out/ffgo/ \
 && cp "$ffgo/LICENSE" /out/licenses/ffgo/LICENSE \
 && cp LICENSE /out/licenses/clustarr/LICENSE

# ---------------------------------------------------------------------------
# ffmpeg: BtbN's shared build into /usr, and the shim against its headers
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS ffmpeg
ARG TARGETARCH
ARG FFMPEG_BRANCH
# One dated BtbN build, checked by its published SHA-256, so CI and the
# release build the same FFmpeg. FFMPEG_URL (with FFMPEG_SHA256) overrides.
ARG FFMPEG_RELEASE=autobuild-2026-09-30-13-08
ARG FFMPEG_VERSION=n9.0.2-17-g2a571b6068
ARG FFMPEG_SHA256_AMD64=01a9764d0b5364b66cfeb4617557c64321b0e232e172ec73f0a701c5f7694326
ARG FFMPEG_SHA256_ARM64=706ccdbc8b0537646345532713a9b6750c0a6258cc001ec1c0379754f0ae730a
ARG FFMPEG_URL=""
ARG FFMPEG_SHA256=""
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ffgo/shim /src/shim
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) a=linux64; sum="${FFMPEG_SHA256_AMD64}" ;; \
      arm64) a=linuxarm64; sum="${FFMPEG_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/ffmpeg-${FFMPEG_VERSION}-${a}-gpl-shared-${FFMPEG_BRANCH}.tar.xz"; \
    if [ -n "${FFMPEG_URL}" ]; then url="${FFMPEG_URL}"; sum="${FFMPEG_SHA256}"; fi; \
    curl -fsSL -o /tmp/ff.tar.xz "${url}"; \
    if [ -n "${sum}" ]; then echo "${sum}  /tmp/ff.tar.xz" | sha256sum -c -; fi; \
    mkdir -p /opt/ffmpeg; \
    tar -xJf /tmp/ff.tar.xz --strip-components=1 -C /opt/ffmpeg; \
    mkdir -p /out/usr/lib; \
    cp -a /opt/ffmpeg/lib/lib*.so* /out/usr/lib/; \
    mkdir -p /out/usr/share/licenses/ffmpeg; \
    cp /opt/ffmpeg/LICENSE.txt /out/usr/share/licenses/ffmpeg/LICENSE.txt; \
    printf 'FFmpeg %s, built by BtbN/FFmpeg-Builds (GPL, shared): %s\nSource: https://github.com/FFmpeg/FFmpeg (the commit after the last "g" in the version)\nBuild scripts: https://github.com/BtbN/FFmpeg-Builds\n' \
      "$(LD_LIBRARY_PATH=/opt/ffmpeg/lib /opt/ffmpeg/bin/ffmpeg -hide_banner -version 2>/dev/null | head -n1 || echo "${FFMPEG_VERSION}")" "${url}" \
      > /out/usr/share/licenses/ffmpeg/SOURCE; \
    gcc -shared -fPIC -O2 -Wall -DFFSHIM_HAVE_AVDEVICE=1 -DFFSHIM_HAVE_AVFILTER=1 \
      -I/opt/ffmpeg/include -o /out/usr/lib/libffshim.so /src/shim/ffshim.c \
      -L/opt/ffmpeg/lib -lavutil -lavcodec -lavformat -lavdevice -lavfilter; \
    LD_LIBRARY_PATH=/opt/ffmpeg/lib /opt/ffmpeg/bin/ffmpeg -hide_banner -version | head -n1

# ---------------------------------------------------------------------------
# staging: lddtree everything the worker loads into /staging
# ---------------------------------------------------------------------------
# Staged from Debian 13: BtbN's FFmpeg 9 calls libva 2.21's vaMapBuffer2,
# and Debian 12's libva 2.17 lacks it (BtbN's libva stub then asserts and
# aborts the process on the first VAAPI call). glibc runs binaries built
# against an older glibc, as the worker (bookworm) and BtbN's are.
FROM debian:trixie-slim AS staging-base
RUN apt-get update \
 && apt-get install -y --no-install-recommends pax-utils ca-certificates gcc \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ffmpeg /out/ /
COPY --from=build /out/squasharr-worker /usr/bin/squasharr-worker
COPY --from=build /out/licenses/ /usr/share/licenses/
COPY images/distroless/stage.sh /stage.sh

# Intel (amd64 only): Debian 13's VAAPI driver (the non-free iHD build: the
# free one has no HEVC 10-bit encode on Kaby Lake through Comet Lake) and
# libva 2.22, and both QSV runtimes -- libmfx-gen for Gen12 and newer, and
# Media SDK's libmfxhw64 for Broadwell..Ice Lake, which Debian 13 dropped,
# so it alone comes from Debian 12 (it links libva.so.2, whose ABI 2.22
# keeps). All of it is dlopen'ed (by BtbN's libva stubs, libva and the
# libvpl dispatcher), so it is named for lddtree. On arm64 there is no
# Intel GPU to drive, and the image stages the worker alone.
FROM staging-base AS staging
ARG TARGETARCH
RUN set -eux; \
    if [ "$TARGETARCH" != amd64 ]; then /stage.sh /staging; exit 0; fi; \
    sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources; \
    grep -q '^Components: main non-free$' /etc/apt/sources.list.d/debian.sources; \
    printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: bookworm\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
      > /etc/apt/sources.list.d/bookworm.sources; \
    printf 'Package: *\nPin: release n=bookworm\nPin-Priority: 100\n' > /etc/apt/preferences.d/bookworm; \
    apt-get update; \
    apt-get install -y --no-install-recommends intel-media-va-driver-non-free libmfx-gen1.2 libva2 libva-drm2 libmfx1/bookworm; \
    rm -rf /var/lib/apt/lists/*; \
    d=/usr/lib/x86_64-linux-gnu; \
    EXTRA_DLOPEN="$d/dri/iHD_drv_video.so $d/libva.so.2 $d/libva-drm.so.2 $d/libmfx-gen.so.1.2 $(ls $d/libmfx-gen/*.so) $d/libmfxhw64.so.1 $(ls $d/mfx/*.so)" \
      /stage.sh /staging

# ---------------------------------------------------------------------------
# transcoder: FROM scratch
# ---------------------------------------------------------------------------
FROM scratch AS transcoder
LABEL org.opencontainers.image.source="https://github.com/mediactl/clustarr" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.title="clustarr-transcoder"
COPY --from=staging /staging/ /
# libva logs every driver load at info level on stderr; errors only keeps
# FFmpeg's own error in the worker's stderr tail. The driver path names
# iHD's directory on amd64; on arm64 it does not exist, and nothing there
# opens VAAPI.
ENV FFGO_SHIM_DIR=/usr/lib \
    LIBVA_MESSAGING_LEVEL=1 \
    LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri \
    LIBVA_DRIVER_NAME=iHD
VOLUME ["/data"]
USER 1000:1000
ENTRYPOINT ["/usr/bin/squasharr-worker"]

FROM transcoder AS transcoder-debug
COPY --from=busybox:1.37-musl /bin/ /bin/
COPY images/distroless/busybox-SOURCE /usr/share/licenses/busybox/SOURCE
