# syntax=docker/dockerfile:1.7
#
# ghcr.io/mediactl/clustarr -- the manager and ui binaries, static, cgo-free
# and UPX-packed, on distroless (spec 2026-10-06 §10.1.2, R1). Everything
# that loads FFmpeg, ONNX Runtime or par2 runs from images/Dockerfile.native.
# The deps guards (test/guards/deps_test.go) keep both binaries free of a
# dynamic loader, so they cross-compile from $BUILDPLATFORM.
#
# No ENTRYPOINT: the image holds two binaries, so every container names its
# own (pkg/binpath; TestEveryContainerNamesItsBinary).
#
#   make docker-build     # this image and the native one, with the pinned contexts

ARG GO_VERSION=1.27

# ---------------------------------------------------------------------------
# build: cmd/manager and cmd/ui, CGO_ENABLED=0
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
# UPX packs both binaries after the build; it packs any architecture's ELF,
# so it runs on $BUILDPLATFORM like the compiler. UPX_FLAGS sets the packing
# ("--ultra-brute" squeezes a few percent more, at minutes per binary).
ARG UPX_FLAGS="--best --lzma"
# UPX_ARM64=0 leaves the arm64 binaries unpacked: the control-plane placement
# design (2026-10-21, §6) runs the manager and ui on arm64 nodes, and a packed
# binary is the one piece that kernel has not yet been shown to start.
ARG UPX_ARM64=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends upx-ucl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# grpcnotrace: see the Makefile's GOTAGS.
ENV CGO_ENABLED=0 \
    GOFLAGS="-trimpath -tags=grpcnotrace"
# Warm the module cache separately so source edits do not re-download.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -ldflags "-s -w -X github.com/mediactl/clustarr/pkg/version.Version=${VERSION}" \
      -o /out/manager ./cmd/manager \
 && GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -ldflags "-s -w -X github.com/mediactl/clustarr/pkg/version.Version=${VERSION}" \
      -o /out/ui ./cmd/ui \
 && if [ "${TARGETARCH}" = arm64 ] && [ "${UPX_ARM64}" = 0 ]; then echo 'UPX_ARM64=0: arm64 binaries left unpacked'; \
    else upx ${UPX_FLAGS} /out/manager /out/ui && upx -t /out/manager /out/ui; fi

# ---------------------------------------------------------------------------
# clustarr: distroless static, non-root
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot AS clustarr
LABEL org.opencontainers.image.source="https://github.com/mediactl/clustarr" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.title="clustarr"
COPY --from=build /out/manager /out/ui /usr/bin/
USER 65532:65532
