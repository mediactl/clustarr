# syntax=docker/dockerfile:1.7
#
# ghcr.io/mediactl/clustarr -- the manager and ui binaries, static and
# cgo-free, on distroless (spec 2026-10-06 §10.1.2, R1); neither is
# UPX-packed (below). Everything
# that loads FFmpeg, ONNX Runtime or par2 runs from images/Dockerfile.native.
# The deps guards (test/guards/deps_test.go) keep both binaries free of a
# dynamic loader, so they cross-compile from $BUILDPLATFORM.
#
# No ENTRYPOINT: the image holds two binaries, so every container names its
# own (pkg/binpath; TestEveryContainerNamesItsBinary).
#
#   make docker-build     # this image and the native one, with the pinned contexts

ARG GO_VERSION=1.27

# ---------------------------------------------------------------------------
# build: cmd/manager and cmd/ui, CGO_ENABLED=0
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
# Neither binary is UPX-packed: a packed ELF is decompressed into anonymous
# memory at exec, so the whole file is resident, private and unevictable for
# the pod's life, where an unpacked binary is demand-paged from the image
# layer, file-backed and dropped under memory pressure. The manager's 66 MiB
# was unpacked on 2026-11-04 (packing saved 7 MiB of pull per architecture;
# docs/superpowers/plans/2026-11-04-binary-size-reduction.md §5, R1) and the
# ui's 86 MiB on 2026-11-16 (owner: the three ui pods sat at their memory
# limit, each holding the binary beside its heap).
WORKDIR /src
# grpcnotrace: see the Makefile's GOTAGS.
ENV CGO_ENABLED=0 \
    GOFLAGS="-trimpath -tags=grpcnotrace"
# Warm the module cache separately so source edits do not re-download.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -trimpath \
      -ldflags "-s -w -X github.com/mediactl/clustarr/pkg/version.Version=${VERSION}" \
      -o /out/manager ./cmd/manager \
 && GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
      -ldflags "-s -w -X github.com/mediactl/clustarr/pkg/version.Version=${VERSION}" \
      -o /out/ui ./cmd/ui

# ---------------------------------------------------------------------------
# clustarr: distroless static, non-root
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot AS clustarr
LABEL org.opencontainers.image.source="https://github.com/mediactl/clustarr" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.title="clustarr"
COPY --from=build /out/manager /out/ui /usr/bin/
USER 65532:65532
