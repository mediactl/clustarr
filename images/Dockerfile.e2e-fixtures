# syntax=docker/dockerfile:1.7
#
# ghcr.io/mediactl/clustarr/e2e-fixtures -- in-cluster stub services for the
# kind-based e2e suite (docs/superpowers/plans/2026-09-18-remaining-work.md,
# Phase H). No fixture ever calls out to the real Internet;
# images/Dockerfile.clustarr is the shape this mirrors.
#
#   docker build -f images/Dockerfile.e2e-fixtures -t ghcr.io/mediactl/clustarr/e2e-fixtures:dev .

ARG GO_VERSION=1.27

# ---------------------------------------------------------------------------
# clipgen: the e2e clips, made by test/fixtures/mkclips on internal/testmedia
# (ffgo) against the native image's pinned BtbN FFmpeg; no ffmpeg CLI is
# installed or run (upgrade guide U2.7, W10.11). The five FFMPEG_* defaults
# are images/Dockerfile.native's (TestTheE2EFixturesImageRunsNoFFmpeg holds
# them equal), and the ffgo shim is compiled from the fork's own
# shim/ffshim.c against the same tarball's headers, as there.
#
# tiny.mkv is the probe clip every scenario plants and the seeder and NNTP
# stubs serve: H.264 1920x1080 (the 1080p every name it travels under
# claims -- mkclips' package doc records the ruling) CBR at 48 Mb/s for ten
# seconds, plus AAC. The bit rate is not an accident:
# pkg/fsops.IsSuspectedSample classifies ANY video file under SampleMaxBytes
# (50 MiB by default) as ClassSuspectedSample, and the rescan worker records
# that in LibraryScan.status.unmatched with reason suspected_sample instead
# of attributing it to a MediaFile -- so a genuinely tiny clip would land
# unmatched in every scenario. Ten seconds at 48 Mb/s is about 57 MiB, and
# mkclips fails the build under 50 MiB (test/fixtures/seed.MinMediaBytes
# asserts it again at seed time).
#
# hdr10.mkv is HEVC Main 10, BT.2020 primaries, SMPTE ST 2084 (PQ),
# mastering display and MaxCLL/MaxFALL 1000/400 -- docs/research/
# transcode.md §2.2's worked example. No e2e scenario consumes it yet (see
# test/e2e/transcode_test.go's package doc); test/fixtures/seed copies it out
# so a future HDR-aware scenario has it. mkclips' own test reads it back as
# PQ with mastering display metadata.
#
# Dolby Vision is deliberately NOT attempted: it needs an RPU a tool like
# dovi_tool produces from a real Dolby Vision master, and FFmpeg alone
# cannot synthesise one. test/e2e/transcode_test.go's Dolby Vision scenario
# skips with that reason instead of faking one.
# ---------------------------------------------------------------------------
FROM golang:${GO_VERSION}-bookworm AS clipgen
ARG TARGETARCH
ARG FFMPEG_BRANCH=9.0
ARG FFMPEG_RELEASE=autobuild-2026-09-30-13-08
ARG FFMPEG_VERSION=n9.0.2-17-g2a571b6068
ARG FFMPEG_SHA256_AMD64=01a9764d0b5364b66cfeb4617557c64321b0e232e172ec73f0a701c5f7694326
ARG FFMPEG_SHA256_ARM64=706ccdbc8b0537646345532713a9b6750c0a6258cc001ec1c0379754f0ae730a
# tar -xJ needs xz, which the golang image does not carry.
RUN apt-get update \
 && apt-get install -y --no-install-recommends xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) a=linux64; sum="${FFMPEG_SHA256_AMD64}" ;; \
      arm64) a=linuxarm64; sum="${FFMPEG_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/ff.tar.xz \
      "https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/ffmpeg-${FFMPEG_VERSION}-${a}-gpl-shared-${FFMPEG_BRANCH}.tar.xz"; \
    echo "${sum}  /tmp/ff.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/ffmpeg; \
    tar -xJf /tmp/ff.tar.xz --strip-components=1 -C /opt/ffmpeg; \
    rm -rf /tmp/ff.tar.xz /opt/ffmpeg/bin
WORKDIR /src
ENV CGO_ENABLED=0 \
    LD_LIBRARY_PATH=/opt/ffmpeg/lib \
    FFGO_SHIM_DIR=/opt/ffmpeg/lib
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
RUN --mount=type=cache,target=/go/pkg/mod \
    gcc -shared -fPIC -O2 -Wall -DFFSHIM_HAVE_AVDEVICE=1 -DFFSHIM_HAVE_AVFILTER=1 -I/opt/ffmpeg/include \
      -o /opt/ffmpeg/lib/libffshim.so "$(go list -m -f '{{.Dir}}' github.com/obinnaokechukwu/ffgo)/shim/ffshim.c" \
      -L/opt/ffmpeg/lib -lavutil -lavcodec -lavformat -lavdevice -lavfilter
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run ./test/fixtures/mkclips -out /out

# ---------------------------------------------------------------------------
# build: compile ./test/fixtures
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
ENV CGO_ENABLED=0 \
    GOFLAGS=-trimpath

# Warm the module cache separately so source edits do not re-download.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags "-s -w" -o /out/clustarr-e2e-fixtures ./test/fixtures

# ---------------------------------------------------------------------------
# final: distroless static, non-root (uid 65532); recorded JSON + baked clip
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot
LABEL org.opencontainers.image.source="https://github.com/mediactl/clustarr" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.title="clustarr-e2e-fixtures" \
      org.opencontainers.image.description="In-cluster stub services for the Clustarr e2e suite"

COPY --from=build /out/clustarr-e2e-fixtures /clustarr-e2e-fixtures
COPY --from=clipgen /out/tiny.mkv /fixtures/media/tiny.mkv
COPY --from=clipgen /out/hdr10.mkv /fixtures/media/hdr10.mkv
COPY test/data/metadata /fixtures/testdata/metadata
COPY test/data/cardigann /fixtures/testdata/cardigann
COPY test/data/importlist /fixtures/testdata/importlist

USER 65532:65532
ENTRYPOINT ["/clustarr-e2e-fixtures"]
