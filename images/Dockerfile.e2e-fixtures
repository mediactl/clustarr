# syntax=docker/dockerfile:1.7
#
# ghcr.io/mediactl/clustarr/e2e-fixtures -- in-cluster stub services for the
# kind-based e2e suite (docs/superpowers/plans/2026-09-18-remaining-work.md,
# Phase H). No fixture ever calls out to the real Internet;
# images/Dockerfile.controller is the shape this mirrors.
#
#   docker build -f images/Dockerfile.e2e-fixtures -t ghcr.io/mediactl/clustarr/e2e-fixtures:dev .

ARG GO_VERSION=1.27

# ---------------------------------------------------------------------------
# clipgen: one lavfi-generated H.264/AAC clip, baked in at build time so no
# machine running `go test` (or this image, at runtime) needs ffmpeg itself.
# A plain apt ffmpeg is enough -- this is a structural probe target for
# pkg/mediainfo, not a codec/HDR fixture (those come with Phase E's clips).
#
# The bitrate is not an accident. pkg/fsops.IsSample classifies ANY file with
# a MediaExtensions extension under 50 MiB as a promotional sample, and the
# rescan worker only attributes files fsops calls ClassMedia -- so a genuinely
# tiny clip would be skipped by every scenario and no MediaFile would ever be
# created. Forcing x264 into CBR at 48 Mbit for ten seconds lands the file at
# roughly 57 MiB, comfortably over that threshold and still a few seconds to
# encode. test/fixtures/seed.MinMediaBytes asserts the result at seed time.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS clipgen
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /out && \
    ffmpeg -v error -f lavfi -i "testsrc=duration=10:size=640x480:rate=25" \
           -f lavfi -i "sine=frequency=1000:duration=10" \
           -c:v libx264 -preset ultrafast -pix_fmt yuv420p \
           -x264-params "nal-hrd=cbr:force-cfr=1" \
           -b:v 48M -minrate 48M -maxrate 48M -bufsize 48M \
           -c:a aac -shortest \
           /out/tiny.mkv && \
    test "$(stat -c %s /out/tiny.mkv)" -ge 52428800

# ---------------------------------------------------------------------------
# clipgen-hdr10: an HDR10 clip -- HEVC 10-bit, BT.2020 primaries, SMPTE
# ST 2084 (PQ) transfer, mastering-display and content-light metadata --
# baked in at build time alongside clipgen's plain probe target (Task E-5).
#
# Its proof obligation is pkg/mediainfo/hdr10_fixture_test.go, a UNIT test
# (not this e2e suite) that runs the IDENTICAL ffmpeg recipe itself and
# asserts pkg/mediainfo.ClassifyHDR reads the result back as HDR10 -- a clip
# ffmpeg writes but ClassifyHDR reads as SDR proves nothing, so that test is
# what actually establishes this recipe works, not this Dockerfile stage. No
# scenario in test/e2e consumes this clip as of Phase E: see
# test/e2e/transcode_test.go's package doc comment for why scenario 12 uses
# the plain h264/AAC probe clip instead (the profile's default policy would
# plan a remux or a skip against an already-HEVC-10-bit source, not the real
# encode that scenario exists to exercise). test/fixtures/seed.Run copies it
# out anyway, alongside tiny.mkv, so a future HDR-aware scenario has it
# ready without a second bake step; its absence from an older image is
# handled there as optional cargo, never a hard failure.
#
# colorprim/transfer/colormatrix and the mastering-display/max-cll SEI are
# ALL set through -x265-params, not the generic -color_primaries/-color_trc/
# -colorspace ffmpeg output options: verified on this box's ffmpeg (n9.0.1)
# that the generic options reach libx265's VUI for colorspace alone, not for
# primaries or transfer, so a clip built with THOSE instead would ffprobe
# back with color_transfer missing entirely -- ClassifyHDR would then call
# it PQ10 (no mastering display) or SDR, never HDR10, exactly the "ffmpeg
# writes it, ClassifyHDR reads SDR" trap this task's brief warns against.
# The values are docs/research/transcode.md §2.2's own worked example, so
# this clip decodes to the exact side data
# pkg/mediainfo/ffprobe_test.go's hdr10FrameJSON fixture already
# hand-authored from a real capture on this same box.
#
# Dolby Vision is deliberately NOT attempted here: it needs an RPU a tool
# like dovi_tool produces from a real DV master, and ffmpeg alone cannot
# synthesise one -- confirmed on this box (`ffmpeg -dolbyvision 1` refuses
# with "Dolby Vision requires VBV settings" and there is no RPU to feed it
# regardless; see pkg/mediainfo/ffprobe_test.go's doviStreamsJSON comment,
# which hit the identical wall). test/e2e/transcode_test.go's Dolby Vision
# scenario skips with that reason instead of faking one.
FROM debian:bookworm-slim AS clipgen-hdr10
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /out && \
    ffmpeg -v error -f lavfi -i "testsrc2=duration=3:size=640x480:rate=25" \
           -c:v libx265 -pix_fmt yuv420p10le \
           -x265-params "colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc:master-display=G(13250,34500)B(7500,3000)R(34000,16000)WP(15635,16450)L(10000000,1):max-cll=1000,400" \
           /out/hdr10.mkv

# ---------------------------------------------------------------------------
# build: compile ./test/fixtures
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
ENV CGO_ENABLED=0 \
    GOFLAGS=-trimpath

# Warm the module cache separately so source edits do not re-download.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags "-s -w" -o /out/clustarr-e2e-fixtures ./test/fixtures

# ---------------------------------------------------------------------------
# final: distroless static, non-root (uid 65532); recorded JSON + baked clip
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot
LABEL org.opencontainers.image.source="https://github.com/mediactl/clustarr" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.title="clustarr-e2e-fixtures" \
      org.opencontainers.image.description="In-cluster stub services for the Clustarr e2e suite"

COPY --from=build /out/clustarr-e2e-fixtures /clustarr-e2e-fixtures
COPY --from=clipgen /out/tiny.mkv /fixtures/media/tiny.mkv
COPY --from=clipgen-hdr10 /out/hdr10.mkv /fixtures/media/hdr10.mkv
COPY testdata/metadata /fixtures/testdata/metadata

USER 65532:65532
ENTRYPOINT ["/clustarr-e2e-fixtures"]
