package views

import (
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/table"
)

// Row selection and bulk edit for an inner table (owner, 2026-11-17:
// "Inner pages like seasons with the episode tables should all be
// selectable and editable (multi select)"): a leading column of marks, a
// select-all in the head per table, and one bar across the page's top that
// posts the selection to the container's bulk route
// (ui/rows_bulk.go). ui/static/rowselect.js keeps the selection.
//
// The mark is a plain button with role="checkbox" drawn by the theme
// (primitives.css), not the vendored checkbox: that component registers
// every root with the component lifecycle, whose observer rescans on each
// DOM mutation, which a 194-row season or a 749-row channel table cannot
// afford (measured on Live TV: 27-62 ms a mutation for 1,500 roots).

// selectHead is the table's first head cell: select every row of the
// table (its [data-select-scope]).
templ selectHead(label string) {
	@table.Head() {
		@selectMark("data-select-all", label)
	}
}

// selectCell is a row's first cell: select the row.
templ selectCell(label string) {
	@table.Cell() {
		@selectMark("data-select-row", label)
	}
}

templ selectMark(hook, label string) {
	@button.Button(button.Props{
		Type:       button.TypeButton,
		Variant:    button.VariantGhost,
		Size:       button.SizeIconSm,
		Class:      "hover:bg-transparent " + rowButton,
		Attributes: templ.Attributes{hook: true, "role": "checkbox", "aria-checked": "false", "aria-label": label},
	}) {
		<span data-select-box></span>
	}
}

// selectionBar is the page's one selection bar, as Plex Web draws its
// own (owner, 2026-11-17: "This is what Plex web's selection screen looks
// like now"): a gold-rimmed glass bar across the top of the content, in
// the page bar's place, saying how many items are selected at its left,
// the verbs as icons at its centre and Deselect All at its right. It is
// hidden until something is selected (rowselect.js) and takes no room of
// its own -- a zero-height sticky holder with the bar laid over what is
// under it -- so showing it moves nothing. The first child of the page's
// content.
templ selectionBar(b SelectionBar) {
	<div data-selection-bar hidden role="region" aria-label="Bulk actions" class="sticky top-(--bar-top) z-30 h-0" { b.Attrs... }>
		<div class={ selectionBarClass }>
			<span class="flex min-w-0 items-center gap-2 text-sm whitespace-nowrap text-primary" aria-live="polite">
				@icon.Icon("check")(icon.Props{Class: "size-4 shrink-0"})
				<span><span data-rows-count>0</span> <span class="max-sm:hidden" data-rows-noun>items</span> selected</span>
			</span>
			<div class="mx-auto flex items-center gap-1">
				for _, v := range b.Verbs {
					@selectionVerb(b, v)
				}
				if b.Extra != nil {
					@b.Extra
				}
			</div>
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-rows-clear": true, "aria-label": "Deselect all", "title": "Deselect all (Esc)"},
			}) {
				@icon.Icon("x")()
				<span class="max-sm:sr-only">Deselect All</span>
			}
		</div>
	</div>
}

templ selectionVerb(b SelectionBar, v SelectionVerb) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeSm,
		Class:      verbClass(v),
		Attributes: b.verbAttrs(v),
	}) {
		@icon.Icon(v.Icon)()
		<span class="max-lg:sr-only">{ v.Label }</span>
	}
}
