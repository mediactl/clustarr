package views

import (
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/projection"
)

// MovieSearchModal is Radarr's InteractiveSearchModal, opened from the
// movie page's "Interactive Search": "Interactive Search - <title>" over
// the results panel an episode's or a season's interactive search shows.
// It is swapped into the page's #movie-modal and opens as it lands; the
// next one swapped in retires it.
templ MovieSearchModal(movie projection.LibraryItem, p SearchPanel) {
	@dialog.Dialog(dialog.Props{DefaultOpen: true}) {
		@dialog.Content(dialog.ContentProps{
			Class:      "max-h-[90vh] overflow-y-auto sm:max-w-6xl",
			Attributes: templ.Attributes{"data-movie-search-modal": movie.Ref.Name},
		}) {
			@dialog.Header() {
				@dialog.Title() { { "Interactive Search - " + movie.Title } }
			}
			@SearchPanelView(p)
		}
	}
}
