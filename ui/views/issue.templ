package views

import (
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/collapsible"
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/spinner"
	"github.com/mediactl/clustarr/ui/components/table"
	"github.com/mediactl/clustarr/ui/components/tabs"
)

// An issue's details modal and its interactive search (2026-11-10 design
// §9.4), the episode modal's shape: "Comic - #12 - Title", then the
// Details tab (overview, credits, file) and the Search tab, whose
// interactive search lists releases in comic columns -- Format (cbz, cbr,
// pdf), Size, Age, Indexer, Peers, Score -- over the issue's own panel
// routes, so a poll or a grab keeps the columns.

// IssueModal is an issue's details modal, opened from its interactive
// search or its details route. It is swapped into the page's #issue-modal
// and opens as it lands; the next one swapped in retires it.
templ IssueModal(d IssueDetail) {
	@dialog.Dialog(dialog.Props{DefaultOpen: true}) {
		@dialog.Content(dialog.ContentProps{
			Class:      "max-h-[90vh] overflow-y-auto sm:max-w-6xl",
			Attributes: templ.Attributes{"data-issue-modal": d.Row.Name},
		}) {
			@dialog.Header() {
				@dialog.Title() {
					{ issueHeading(d) }
				}
				@dialog.Description() {
					{ issueFacts(d) }
				}
			}
			@issueTabs(d)
		}
	}
}

// issueHeading is the modal's title: the comic, the issue's number and
// its title when it has one.
func issueHeading(d IssueDetail) string {
	heading := d.ComicTitle + " - " + d.Row.Label()
	if d.Row.Title != "" {
		heading += " - " + d.Row.Title
	}
	return heading
}

// issueFacts is the line under the title: the cover date, the store date,
// the status.
func issueFacts(d IssueDetail) string {
	var facts []string
	if d.Row.CoverDate != "" {
		facts = append(facts, "Cover "+d.Row.CoverDateLabel)
	}
	if d.Row.StoreDate != "" {
		facts = append(facts, "In shops "+d.Row.StoreDateLabel)
	}
	if d.Row.Status.Label != "" {
		facts = append(facts, d.Row.Status.Label)
	}
	return strings.Join(facts, " · ")
}

// issueTabs are the modal's Details and Search tabs, d.Tab open.
templ issueTabs(d IssueDetail) {
	@tabs.Tabs(tabs.Props{DefaultValue: d.Tab, Class: "min-w-0"}) {
		@tabs.List() {
			@tabs.Trigger(tabs.TriggerProps{Value: "details", Attributes: templ.Attributes{"data-tab": "details"}}) {
				Details
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "search", Attributes: templ.Attributes{"data-tab": "search"}}) {
				Search
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "details", Class: "space-y-4 pt-2"}) {
			@issueSummary(d)
		}
		@tabs.Content(tabs.ContentProps{Value: "search", Class: "pt-2"}) {
			@IssueSearchTab(d)
		}
	}
}

// issueSummary is the episode summary's counterpart: the overview, the
// credits and the file.
templ issueSummary(d IssueDetail) {
	<p class="leading-relaxed" data-issue-overview>
		if d.Overview != "" {
			{ d.Overview }
		} else {
			<span class="text-muted-foreground">No overview.</span>
		}
	</p>
	if len(d.Credits) > 0 {
		@issueCredits(d.Credits)
	}
	@fileTable("issue", d.File, d.Row.Status.Warn)
}

// issueCredits lists the people credited on the issue, each a quiet badge
// naming the role.
templ issueCredits(credits []IssueCredit) {
	<p class="flex flex-wrap gap-1" data-issue-credits={ fmt.Sprint(len(credits)) }>
		for _, c := range credits {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"data-credit-role": c.Role}}) {
				{ c.String() }
			}
		}
	</p>
}

// IssueSearchTab is the issue's searches on its modal: searchTab's two
// buttons, or the issue's panel in comic columns once a search runs.
// #issue-search-body is what the Interactive Search button swaps (htmx
// selects it out of the modal the action answers with).
templ IssueSearchTab(d IssueDetail) {
	<div id="issue-search-body" data-issue-search={ d.Row.Name }>
		if d.Search != nil {
			@IssueSearchPanelView(*d.Search)
		} else {
			<div class="flex flex-col items-center gap-3 py-10">
				<form hx-post={ d.Row.SearchURL() } hx-target="#action-status" method="post" action={ templ.URL(d.Row.SearchURL()) }>
					<input type="hidden" name="return" value={ d.Row.ReturnURL() }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-56", Attributes: templ.Attributes{"data-action": "issue-search"}}) {
						@icon.Icon("search")()
						Automatic Search
					}
				</form>
				<form
					hx-post={ d.Row.InteractiveSearchURL() }
					hx-target="#issue-search-body"
					hx-select="#issue-search-body"
					hx-swap="outerHTML"
					method="post"
					action={ templ.URL(d.Row.InteractiveSearchURL()) }
				>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "w-56", Attributes: templ.Attributes{"data-action": "issue-interactive-search"}}) {
						@icon.Icon("user-search")()
						Interactive Search
					}
				</form>
			</div>
		}
	</div>
}

// IssueSearchPage is an issue's interactive search as a page: the panel's
// own route outside htmx.
templ IssueSearchPage(p IssueSearchPanel, title string) {
	@Shell(Chrome{Title: title}) {
		<h1 class="mb-4 text-xl font-semibold">{ title }</h1>
		@IssueSearchPanelView(p)
	}
}

// IssueSearchPanelView is SearchPanelView in comic columns: the same
// summary line, the releases best first -- approved, rejected, then the
// other titles collapsed -- each with its verdict and its download button,
// and the same self-replacement every two seconds while Poll is set, at
// the issue's own panel route.
templ IssueSearchPanelView(p IssueSearchPanel) {
	<div
		class="min-w-0 space-y-3"
		data-search-panel={ p.Name }
		data-search-phase={ p.Phase }
		data-search-columns="comic"
		if p.Poll {
			hx-get={ p.PanelURL() }
			hx-trigger="load delay:2s"
			hx-swap="outerHTML"
		}
	>
		@actionFailure(p.Error)
		<p class="flex items-center gap-2 text-sm text-muted-foreground" data-search-summary>
			switch  {
				case p.Gone:
					This search has expired; run it again.
				case p.Pending():
					@spinner.Spinner(spinner.Props{Attributes: templ.Attributes{"aria-label": "Searching"}})
					Searching indexers…
				case p.Phase == "Failed":
					<span class="text-red-300">Search failed: { p.Failed }</span>
				default:
					{ searchSummary(p.SearchPanel) }
			}
		</p>
		if listed := p.Listed(); len(listed) > 0 {
			@issueReleaseTable(p, listed, "data-release-table")
		} else if len(p.Results) > 0 {
			@emptyNote("No releases for this issue; the others are below.", "rounded-md border border-border", templ.Attributes{"data-search-empty": true})
		} else if !p.Pending() && !p.Gone && p.Phase != "Failed" {
			@emptyNote("No results found.", "rounded-md border border-border", templ.Attributes{"data-search-empty": true})
		}
		if others := p.OtherRows(); len(others) > 0 {
			@collapsible.Collapsible(collapsible.Props{Class: "rounded-md border border-border", Attributes: templ.Attributes{"data-other-titles": fmt.Sprint(len(others))}}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-auto w-full justify-start rounded-md px-4 py-2 text-sm font-normal text-muted-foreground hover:bg-muted/50", Attributes: collapsible.Trigger(ctx)}) {
					{ otherTitlesLabel(len(others)) }
				}
				@collapsible.Content() {
					@issueReleaseTable(p, others, "data-other-titles-table")
				}
			}
		}
	</div>
}

// issueReleaseTable is the results' table in Mylar's columns -- Source,
// Age, Title, Format, Indexer, Size, Peers, Score -- then the rejections
// and the download button; attr marks it. A usenet post has no peers, and
// its indexer reports no grab count, so the cell is empty for one.
templ issueReleaseTable(p IssueSearchPanel, rows []ReleaseRow, attr string) {
	<div class="rounded-md border border-border">
		@table.Table(table.Props{Attributes: templ.Attributes{attr: ""}}) {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Source
					}
					@table.Head() {
						Age
					}
					@table.Head() {
						Title
					}
					@table.Head() {
						Format
					}
					@table.Head() {
						Indexer
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Size
					}
					@table.Head() {
						Peers
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						Score
					}
					@table.Head() {
						<span class="sr-only">Rejections</span>
					}
					@table.Head() {
						<span class="sr-only">Download</span>
					}
				}
			}
			@table.Body() {
				for _, r := range rows {
					@issueReleaseRow(p, r)
				}
			}
		}
	</div>
}

// issueReleaseRow is one result in comic columns: the release's quality is
// its format (the comic ladder's CBZ, CBR, PDF).
templ issueReleaseRow(p IssueSearchPanel, r ReleaseRow) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{
		"data-release":     r.GUID,
		"data-approved":    fmt.Sprintf("%t", r.Approved),
		"data-grab":        r.Grab,
		"data-other-title": fmt.Sprintf("%t", r.OtherTitle),
	}}) {
		@table.Cell() {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: protocolTone(r.Protocol)}) {
				{ r.Protocol }
			}
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
			{ r.Age }
		}
		@table.Cell(table.CellProps{Class: "max-w-xl break-all whitespace-normal"}) {
			if r.InfoURL != "" {
				<a href={ templ.URL(r.InfoURL) } target="_blank" rel="noopener noreferrer" class="hover:underline">{ r.Title }</a>
			} else {
				{ r.Title }
			}
		}
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"data-format": r.Quality}}) {
			if r.Quality != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ r.Quality }
				}
			}
		}
		@table.Cell() {
			{ r.Indexer }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ formatBytes(r.Size) }
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ r.Peers }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums", Attributes: templ.Attributes{"title": scoreTitle(r)}}) {
			{ releaseScore(r) }
		}
		@table.Cell() {
			if len(r.Rejections) > 0 {
				<span class="text-red-300 [&_svg]:size-4" title={ strings.Join(r.Rejections, "\n") } data-rejections={ fmt.Sprint(len(r.Rejections)) }>
					@icon.Icon("circle-alert")()
				</span>
			}
		}
		@table.Cell(table.CellProps{Class: "py-1"}) {
			@issueGrabCell(p, r)
		}
	}
}

// issueGrabCell is grabCell over the issue's own grab route: the download
// button, or how the grab it made went. A release with a permanent
// rejection asks first, naming the rejections, and is grabbed with
// spec.override.
templ issueGrabCell(p IssueSearchPanel, r ReleaseRow) {
	switch r.Grab {
		case "grabbed":
			<span class="text-emerald-300 [&_svg]:size-4" title="Grabbed" data-grab-state="grabbed">
				@icon.Icon("check")()
			</span>
		case "requested":
			@spinner.Spinner(spinner.Props{Class: "text-muted-foreground", Attributes: templ.Attributes{"title": "Grabbing…", "aria-label": "Grabbing", "data-grab-state": "requested"}})
		default:
			<form
				hx-post={ p.GrabURL() }
				hx-target="closest [data-search-panel]"
				hx-swap="outerHTML"
				if r.Override {
					hx-confirm={ "This release was rejected:\n" + strings.Join(r.Rejections, "\n") + "\n\nGrab it anyway?" }
				}
				method="post"
				action={ templ.URL(p.GrabURL()) }
				class="contents"
			>
				<input type="hidden" name="guid" value={ r.GUID }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconSm,
					Attributes: templ.Attributes{"data-action": "grab-release", "aria-label": "Download", "title": grabTitle(r)}}) {
					if r.Grab == "failed" {
						<span class="text-red-300">
							@icon.Icon("download")()
						</span>
					} else {
						@icon.Icon("download")()
					}
				}
			</form>
	}
}
