package views

import (
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/components/tabs"
)

// An issue's details modal and its interactive search (2026-11-10 design
// §9.4), the episode modal's shape: "Comic - #12 - Title", then the
// Details tab (overview, credits, file) and the Search tab, whose
// interactive search lists releases in comic columns -- Format (cbz, cbr,
// pdf), Size, Age, Indexer, Peers, Score -- on the shared panel, which
// draws them for an issue's Search and polls and grabs through the shared
// /searches routes, so a poll or a grab keeps the columns.

// IssueModal is an issue's details modal, opened from its interactive
// search or its details route. It is swapped into the page's #issue-modal
// and opens as it lands; the next one swapped in retires it.
templ IssueModal(d IssueDetail) {
	@dialog.Dialog(dialog.Props{DefaultOpen: true}) {
		@dialog.Content(dialog.ContentProps{
			Class:      "max-h-[90vh] overflow-y-auto sm:max-w-6xl",
			Attributes: templ.Attributes{"data-issue-modal": d.Row.Name},
		}) {
			@dialog.Header() {
				@dialog.Title() {
					{ issueHeading(d) }
				}
				@dialog.Description() {
					{ issueFacts(d) }
				}
			}
			@issueTabs(d)
		}
	}
}

// issueHeading is the modal's title: the comic, the issue's number and
// its title when it has one.
func issueHeading(d IssueDetail) string {
	heading := d.ComicTitle + " - " + d.Row.Label()
	if d.Row.Title != "" {
		heading += " - " + d.Row.Title
	}
	return heading
}

// issueFacts is the line under the title: the cover date, the store date,
// the status.
func issueFacts(d IssueDetail) string {
	var facts []string
	if d.Row.CoverDate != "" {
		facts = append(facts, "Cover "+d.Row.CoverDateLabel)
	}
	if d.Row.StoreDate != "" {
		facts = append(facts, "In shops "+d.Row.StoreDateLabel)
	}
	if d.Row.Status.Label != "" {
		facts = append(facts, d.Row.Status.Label)
	}
	return strings.Join(facts, " · ")
}

// issueTabs are the modal's Details and Search tabs, d.Tab open.
templ issueTabs(d IssueDetail) {
	@tabs.Tabs(tabs.Props{DefaultValue: d.Tab, Class: "min-w-0"}) {
		@tabs.List() {
			@tabs.Trigger(tabs.TriggerProps{Value: "details", Attributes: templ.Attributes{"data-tab": "details"}}) {
				Details
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "search", Attributes: templ.Attributes{"data-tab": "search"}}) {
				Search
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "details", Class: "space-y-4 pt-2"}) {
			@issueSummary(d)
		}
		@tabs.Content(tabs.ContentProps{Value: "search", Class: "pt-2"}) {
			@IssueSearchTab(d)
		}
	}
}

// issueSummary is the episode summary's counterpart: the overview, the
// credits and the file.
templ issueSummary(d IssueDetail) {
	<p class="leading-relaxed" data-issue-overview>
		if d.Overview != "" {
			{ d.Overview }
		} else {
			<span class="text-muted-foreground">No overview.</span>
		}
	</p>
	if len(d.Credits) > 0 {
		@issueCredits(d.Credits)
	}
	@fileTable("issue", d.File, d.Row.Status.Warn)
}

// issueCredits lists the people credited on the issue, each a quiet badge
// naming the role.
templ issueCredits(credits []IssueCredit) {
	<p class="flex flex-wrap gap-1" data-issue-credits={ fmt.Sprint(len(credits)) }>
		for _, c := range credits {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"data-credit-role": c.Role}}) {
				{ c.String() }
			}
		}
	</p>
}

// IssueSearchTab is the issue's searches on its modal, searchTab's for
// kind issue: the two buttons, or the shared panel once a search runs,
// which draws comic columns for an issue's Search (formatReleaseTable) and
// polls and grabs through the shared /searches routes. #issue-search-body
// is what the Interactive Search button swaps (htmx selects it out of the
// modal the action answers with).
templ IssueSearchTab(d IssueDetail) {
	@searchTab("issue", d.Row.Name, d.Row.SearchURL(), d.Row.InteractiveSearchURL(), d.Row.ReturnURL(), d.Search)
}
