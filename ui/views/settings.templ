package views

import (
	"fmt"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/empty"
	"github.com/mediactl/clustarr/ui/components/input"
	"github.com/mediactl/clustarr/ui/components/label"
	corev1 "k8s.io/api/core/v1"
	"k8s.io/apimachinery/pkg/api/meta"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	downloadv1 "github.com/mediactl/clustarr/api/download/v1alpha1"
	indexv1 "github.com/mediactl/clustarr/api/index/v1alpha1"
	subtitlev1 "github.com/mediactl/clustarr/api/subtitle/v1alpha1"
	transcodev1 "github.com/mediactl/clustarr/api/transcode/v1alpha1"
)

// settingsReturnPath is every Settings-page form's "return" field: back to
// /settings itself, regardless of ui/routes.go's finishAction own default of
// /library (which exists for the Library page's own forms).
const settingsReturnPath = "/settings"

// Settings renders the Settings page (amendment §A3.4, Task G3-4): root
// folders, quality profiles, indexers, download clients, metadata
// providers, subtitle providers, subtitle profiles and transcode profiles,
// "each rendered from the corresponding resources with an edit form that
// patches spec". Unlike every other live page, Settings has no SSE stream
// (§A3.4: "None") -- config like this does not need to ride the shared
// projection's live cadence, the same reasoning ui/routes.go's
// listRootFolders and listDownloads already give for the Library and
// Downloads pages' own config sections -- so a plain GET is the whole page,
// no #settings-rows sse-swap target.
//
// A Secret's contents are never shown: every secretRef field below renders
// only the Secret's name, never a value read from it (this task's own
// instruction) -- and none of these kinds' Get calls ever read a Secret at
// all, so there is nothing to accidentally leak.
templ Settings(
	rootFolders []catalogv1.RootFolder,
	qualityProfiles []catalogv1.QualityProfile,
	indexers []indexv1.Indexer,
	indexerProxies []indexv1.IndexerProxy,
	downloadClients []downloadv1.DownloadClient,
	metadataProviders []catalogv1.MetadataProvider,
	subtitleProviders []subtitlev1.SubtitleProvider,
	subtitleProfiles []subtitlev1.SubtitleProfile,
	transcodeProfiles []transcodev1.TranscodeProfile,
) {
	@Layout("Settings") {
		<h1 class="mb-6 text-2xl font-semibold tracking-tight">Settings</h1>
		@settingsSection("Root Folders", "rootfolders") {
			if len(rootFolders) == 0 {
				@settingsEmpty("No root folders configured.")
			}
			for _, rf := range rootFolders {
				@rootFolderCard(rf)
			}
		}
		@settingsSection("Quality Profiles", "qualityprofiles") {
			if len(qualityProfiles) == 0 {
				@settingsEmpty("No quality profiles configured.")
			}
			for _, qp := range qualityProfiles {
				@qualityProfileCard(qp)
			}
		}
		@settingsSection("Indexers", "indexers") {
			if len(indexers) == 0 {
				@settingsEmpty("No indexers configured.")
			}
			for _, idx := range indexers {
				@indexerCard(idx)
			}
		}
		@settingsSection("Indexer Proxies", "indexerproxies") {
			if len(indexerProxies) == 0 {
				@settingsEmpty("No indexer proxies configured.")
			}
			for _, p := range indexerProxies {
				@indexerProxyCard(p)
			}
		}
		@settingsSection("Download Clients", "downloadclients") {
			if len(downloadClients) == 0 {
				@settingsEmpty("No download clients configured.")
			}
			for _, dc := range downloadClients {
				@downloadClientSettingsCard(dc)
			}
		}
		@settingsSection("Metadata Providers", "metadataproviders") {
			if len(metadataProviders) == 0 {
				@settingsEmpty("No metadata providers configured.")
			}
			for _, mp := range metadataProviders {
				@metadataProviderCard(mp)
			}
		}
		@settingsSection("Subtitle Providers", "subtitleproviders") {
			if len(subtitleProviders) == 0 {
				@settingsEmpty("No subtitle providers configured.")
			}
			for _, sp := range subtitleProviders {
				@subtitleProviderCard(sp)
			}
		}
		@settingsSection("Subtitle Profiles", "subtitleprofiles") {
			if len(subtitleProfiles) == 0 {
				@settingsEmpty("No subtitle profiles configured.")
			}
			for _, sp := range subtitleProfiles {
				@subtitleProfileCard(sp)
			}
		}
		@settingsSection("Transcode Profiles", "transcodeprofiles") {
			if len(transcodeProfiles) == 0 {
				@settingsEmpty("No transcode profiles configured.")
			}
			for _, tp := range transcodeProfiles {
				@transcodeProfileCard(tp)
			}
		}
	}
}

// settingsSection wraps one kind's cards under a heading, mirroring
// downloads.templ's downloadClientsSection.
templ settingsSection(title, slug string) {
	<section class="mb-10" data-settings-kind={ slug }>
		<div class="mb-3 flex items-center justify-between">
			<h2 class="text-lg font-semibold tracking-tight">{ title }</h2>
			@button.Button(button.Props{Href: "/settings/new/" + slug, Size: button.SizeSm, Variant: button.VariantOutline}) {
				Add
			}
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			{ children... }
		</div>
	</section>
}

// settingsEmpty is a section with nothing in it: the empty component
// across the grid.
templ settingsEmpty(message string) {
	@empty.Empty(empty.Props{Class: "border border-dashed py-8 sm:col-span-2"}) {
		@empty.Header() {
			@empty.Description() {
				{ message }
			}
		}
	}
}

// settingsCard is one object on the Settings page (2026-09-29, the card
// component): its name, a line of what it is, a badge in the header's
// action slot, the quick edit form as content and the Edit and Delete
// actions as footer. attrs are the card's data-* hooks.
templ settingsCard(name string, attrs templ.Attributes, badges templ.Component, details templ.Component) {
	@card.Card(card.Props{Size: card.SizeSm, Attributes: attrs}) {
		@card.Header() {
			@card.Title() {
				{ name }
			}
			@card.Description() {
				@details
			}
			@card.Action() {
				<div class="flex flex-wrap items-center justify-end gap-1.5">
					@badges
				</div>
			}
		}
		{ children... }
	}
}

// detailLines are a card's description: one line each, muted.
templ detailLines(lines ...string) {
	for i, l := range lines {
		if l != "" {
			if i > 0 {
				<br/>
			}
			<span class="break-all">{ l }</span>
		}
	}
}

// credentialsLine names a secretRef's Secret -- only its name, never a
// value read from it.
func credentialsLine(name string) string {
	if name == "" {
		return ""
	}
	return "credentials: Secret/" + name
}

// kindBadge is a neutral badge naming what an object is (a kind, a type).
templ kindBadge(text string) {
	if text != "" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			{ text }
		}
	}
}

// enabledBadge is an object's enabled state: secondary when on, outline
// and muted when off.
templ enabledBadge(enabled bool) {
	if enabled {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			{ enabledLabel(true) }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-muted-foreground"}) {
			{ enabledLabel(false) }
		}
	}
}

// defaultBadge marks the default profile of its kind.
templ defaultBadge(isDefault bool) {
	if isDefault {
		@badge.Badge() {
			default
		}
	}
}

// rootFolderCard renders one RootFolder with an edit form for
// spec.scanSchedule -- the one field RootFolderSpec offers that is neither
// immutable (path and kind) nor a nested struct with no single obviously
// safe leaf (ui/actions/settings.go's own doc comment on
// SetRootFolderScanSchedule).
templ rootFolderCard(rf catalogv1.RootFolder) {
	@settingsCard(rf.Name, templ.Attributes{"data-root-folder": rf.Namespace + "/" + rf.Name, "data-scan-schedule": rf.Spec.ScanSchedule}, kindBadge(string(rf.Spec.Kind)), detailLines(rf.Spec.Path)) {
		@card.Content() {
			<form method="post" action={ templ.URL(fmt.Sprintf("/settings/rootfolders/%s/%s", rf.Namespace, rf.Name)) } class="flex items-end gap-2">
				<input type="hidden" name="return" value={ settingsReturnPath }/>
				<div class="grid flex-1 gap-1.5">
					@label.Label(label.Props{For: "scanSchedule-" + rf.Name, Class: "text-xs text-muted-foreground"}) {
						Scan schedule (cron)
					}
					@input.Input(input.Props{ID: "scanSchedule-" + rf.Name, Name: "scanSchedule", Value: rf.Spec.ScanSchedule, Placeholder: "e.g. 0 3 * * *", Class: "h-8"})
				</div>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Attributes: templ.Attributes{"data-action": "save"}}) {
					Save
				}
			</form>
		}
		@configActions("rootfolders", rf.Namespace, rf.Name)
	}
}

// qualityProfileCard renders one QualityProfile with an edit form for
// spec.upgradeAllowed. A built-in profile's own CEL rule rejects any patch
// to it; the form still renders (this page never special-cases builtIn by
// hiding the form), and a rejection surfaces through routes.go's
// finishAction -> views.ActionError, per this task's "handle the rejection
// visibly" instruction.
templ qualityProfileCard(qp catalogv1.QualityProfile) {
	@settingsCard(qp.Name, templ.Attributes{"data-quality-profile": qp.Name, "data-built-in": fmt.Sprintf("%t", qp.Spec.BuiltIn), "data-upgrade-allowed": fmt.Sprintf("%t", qualityProfileUpgradeAllowed(qp))}, builtInBadge(qp.Spec.BuiltIn), detailLines(string(qp.Spec.MediaKind)+" · cutoff "+qp.Spec.Cutoff)) {
		@card.Content() {
			<form method="post" action={ templ.URL(fmt.Sprintf("/settings/qualityprofiles/%s", qp.Name)) }>
				<input type="hidden" name="return" value={ settingsReturnPath }/>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Variant: button.VariantSecondary, Attributes: templ.Attributes{"name": "upgradeAllowed", "value": fmt.Sprintf("%t", !qualityProfileUpgradeAllowed(qp)), "data-action": "set-upgrade-allowed"}}) {
					if qualityProfileUpgradeAllowed(qp) {
						Disable upgrades
					} else {
						Enable upgrades
					}
				}
			</form>
		}
		@configActions("qualityprofiles", "", qp.Name)
	}
}

templ builtInBadge(builtIn bool) {
	if builtIn {
		@kindBadge("built-in")
	}
}

func qualityProfileUpgradeAllowed(qp catalogv1.QualityProfile) bool {
	return qp.Spec.UpgradeAllowed == nil || *qp.Spec.UpgradeAllowed
}

func secretName(ref *corev1.LocalObjectReference) string {
	if ref == nil {
		return ""
	}
	return ref.Name
}

// indexerCard renders one Indexer with a combined edit form for
// spec.enabled and spec.priority, submitted together as one merge patch
// (ui/actions.SetIndexerSettings). SecretRef is shown only by name, per this
// task's "never expose a Secret's contents" instruction -- there is no path
// here that reads the Secret at all.
templ indexerCard(idx indexv1.Indexer) {
	@settingsCard(idx.Name, templ.Attributes{"data-indexer": idx.Namespace + "/" + idx.Name, "data-enabled": fmt.Sprintf("%t", indexerEnabled(idx)), "data-priority": fmt.Sprintf("%d", idx.Spec.Priority)}, enabledBadge(indexerEnabled(idx)), detailLines(idx.Spec.BaseURL, credentialsLine(secretName(idx.Spec.SecretRef)))) {
		@card.Content() {
			@enabledPriorityForm(fmt.Sprintf("/settings/indexers/%s/%s", idx.Namespace, idx.Name), indexerEnabled(idx), idx.Spec.Priority, "indexer-"+idx.Name)
		}
		@configActions("indexers", idx.Namespace, idx.Name)
	}
}

func indexerEnabled(idx indexv1.Indexer) bool {
	return idx.Spec.Enabled == nil || *idx.Spec.Enabled
}

// indexerProxyCard renders one IndexerProxy: its type and address, whether
// the proxy controller reached it, and its Secret's name. An Indexer uses it
// through its own Proxy choice (spec.proxyRef).
templ indexerProxyCard(p indexv1.IndexerProxy) {
	@settingsCard(p.Name, templ.Attributes{"data-indexer-proxy": p.Namespace + "/" + p.Name}, readyBadge(p.Status.Conditions), detailLines(fmt.Sprintf("%s · %s:%d", p.Spec.Type, p.Spec.Host, p.Spec.Port), credentialsLine(secretName(p.Spec.SecretRef)))) {
		@configActions("indexerproxies", p.Namespace, p.Name)
	}
}

// readyBadge is an object's Ready condition: nothing until the controller
// has reported, then "ready" or "not ready".
templ readyBadge(conds []metav1.Condition) {
	if c := meta.FindStatusCondition(conds, "Ready"); c != nil {
		if c.Status == metav1.ConditionTrue {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				ready
			}
		} else {
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Attributes: templ.Attributes{"title": c.Message}}) {
				not ready
			}
		}
	}
}

// downloadClientSettingsCard is downloads.templ's downloadClientCard's own
// Settings-page counterpart: same identifying data, plus the edit form
// downloads.templ's read-only summary card has no reason to carry.
templ downloadClientSettingsCard(dc downloadv1.DownloadClient) {
	@settingsCard(dc.Name, templ.Attributes{"data-download-client": dc.Namespace + "/" + dc.Name, "data-enabled": fmt.Sprintf("%t", downloadClientEnabled(dc)), "data-priority": fmt.Sprintf("%d", dc.Spec.Priority)}, enabledBadge(downloadClientEnabled(dc)), detailLines(string(dc.Spec.Protocol))) {
		@card.Content() {
			@enabledPriorityForm(fmt.Sprintf("/settings/downloadclients/%s/%s", dc.Namespace, dc.Name), downloadClientEnabled(dc), dc.Spec.Priority, "downloadclient-"+dc.Name)
		}
		@configActions("downloadclients", dc.Namespace, dc.Name)
	}
}

func downloadClientEnabled(dc downloadv1.DownloadClient) bool {
	return dc.Spec.Enabled == nil || *dc.Spec.Enabled
}

// metadataProviderCard renders one MetadataProvider with the same
// enabled/priority edit form as Indexer and DownloadClient.
templ metadataProviderCard(mp catalogv1.MetadataProvider) {
	@settingsCard(mp.Name, templ.Attributes{"data-metadata-provider": mp.Namespace + "/" + mp.Name, "data-enabled": fmt.Sprintf("%t", metadataProviderEnabled(mp)), "data-priority": fmt.Sprintf("%d", mp.Spec.Priority)}, enabledBadge(metadataProviderEnabled(mp)), detailLines(string(mp.Spec.Type), credentialsLine(secretName(mp.Spec.SecretRef)))) {
		@card.Content() {
			@enabledPriorityForm(fmt.Sprintf("/settings/metadataproviders/%s/%s", mp.Namespace, mp.Name), metadataProviderEnabled(mp), mp.Spec.Priority, "metadataprovider-"+mp.Name)
		}
		@configActions("metadataproviders", mp.Namespace, mp.Name)
	}
}

func metadataProviderEnabled(mp catalogv1.MetadataProvider) bool {
	return mp.Spec.Enabled == nil || *mp.Spec.Enabled
}

// subtitleProviderCard renders one SubtitleProvider with the same
// enabled/priority edit form as the other three; a nil spec.enabled reads as
// its CRD default, true.
templ subtitleProviderCard(sp subtitlev1.SubtitleProvider) {
	@settingsCard(sp.Name, templ.Attributes{"data-subtitle-provider": sp.Namespace + "/" + sp.Name, "data-enabled": fmt.Sprintf("%t", sp.Spec.EnabledOrDefault()), "data-priority": fmt.Sprintf("%d", sp.Spec.Priority)}, enabledBadge(sp.Spec.EnabledOrDefault()), detailLines(string(sp.Spec.Type), credentialsLine(secretName(sp.Spec.SecretRef)))) {
		@card.Content() {
			@enabledPriorityForm(fmt.Sprintf("/settings/subtitleproviders/%s/%s", sp.Namespace, sp.Name), sp.Spec.EnabledOrDefault(), sp.Spec.Priority, "subtitleprovider-"+sp.Name)
		}
		@configActions("subtitleproviders", sp.Namespace, sp.Name)
	}
}

// subtitleProfileCard renders one SubtitleProfile (cluster-scoped) with an
// edit form for spec.default.
templ subtitleProfileCard(sp subtitlev1.SubtitleProfile) {
	@settingsCard(sp.Name, templ.Attributes{"data-subtitle-profile": sp.Name, "data-default": fmt.Sprintf("%t", sp.Spec.Default)}, defaultBadge(sp.Spec.Default), detailLines(fmt.Sprintf("%d languages", len(sp.Spec.Languages)))) {
		@card.Content() {
			<form method="post" action={ templ.URL(fmt.Sprintf("/settings/subtitleprofiles/%s", sp.Name)) }>
				<input type="hidden" name="return" value={ settingsReturnPath }/>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Variant: button.VariantSecondary, Attributes: templ.Attributes{"name": "default", "value": fmt.Sprintf("%t", !sp.Spec.Default), "data-action": "set-default"}}) {
					if sp.Spec.Default {
						Unset as default
					} else {
						Set as default
					}
				}
			</form>
		}
		@configActions("subtitleprofiles", "", sp.Name)
	}
}

// transcodeProfileCard renders one TranscodeProfile (cluster-scoped) with an
// edit form for spec.priority.
templ transcodeProfileCard(tp transcodev1.TranscodeProfile) {
	@settingsCard(tp.Name, templ.Attributes{"data-transcode-profile": tp.Name, "data-priority": fmt.Sprintf("%d", tp.Spec.Priority)}, defaultBadge(tp.Spec.Default), detailLines(string(tp.Spec.Hardware)+" · "+string(tp.Spec.Container))) {
		@card.Content() {
			<form method="post" action={ templ.URL(fmt.Sprintf("/settings/transcodeprofiles/%s", tp.Name)) } class="flex items-end gap-2">
				<input type="hidden" name="return" value={ settingsReturnPath }/>
				<div class="grid gap-1.5">
					@label.Label(label.Props{For: "priority-" + tp.Name, Class: "text-xs text-muted-foreground"}) {
						Priority
					}
					@input.Input(input.Props{ID: "priority-" + tp.Name, Name: "priority", Type: "number", Value: fmt.Sprintf("%d", tp.Spec.Priority), Class: "h-8 w-24"})
				</div>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Attributes: templ.Attributes{"data-action": "save"}}) {
					Save
				}
			</form>
		}
		@configActions("transcodeprofiles", "", tp.Name)
	}
}

// enabledPriorityForm is the shared edit form for the four kinds whose
// Settings-page edit is exactly spec.enabled and spec.priority (Indexer,
// DownloadClient, MetadataProvider, SubtitleProvider): a priority number
// input, plus two submit buttons that each carry the priority input's
// current value together with their own explicit enabled=true/false --
// clicking either both toggles enabled and saves whatever priority is
// currently typed, in one merge patch.
templ enabledPriorityForm(action string, enabled bool, priority int32, idPrefix string) {
	<form method="post" action={ templ.URL(action) } class="flex items-end gap-2">
		<input type="hidden" name="return" value={ settingsReturnPath }/>
		<div class="grid gap-1.5">
			@label.Label(label.Props{For: "priority-" + idPrefix, Class: "text-xs text-muted-foreground"}) {
				Priority
			}
			@input.Input(input.Props{ID: "priority-" + idPrefix, Name: "priority", Type: "number", Value: fmt.Sprintf("%d", priority), Class: "h-8 w-24"})
		</div>
		if enabled {
			@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Variant: button.VariantSecondary, Attributes: templ.Attributes{"name": "enabled", "value": "false", "data-action": "disable"}}) {
				Disable
			}
		} else {
			@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Variant: button.VariantSecondary, Attributes: templ.Attributes{"name": "enabled", "value": "true", "data-action": "enable"}}) {
				Enable
			}
		}
		@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Attributes: templ.Attributes{"name": "enabled", "value": fmt.Sprintf("%t", enabled), "data-action": "save"}}) {
			Save
		}
	</form>
}

// enabledLabel names an enabled state, as the badge reads it.
func enabledLabel(enabled bool) string {
	if enabled {
		return "enabled"
	}
	return "disabled"
}
