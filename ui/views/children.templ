package views

import (
	"fmt"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/projection"
)

// ParentDetail is an artist's or an author's page (spec
// 2026-09-23-library-page-design): the item header and one component that
// loads the children -- albums or books -- on first expand, the series
// page's shape with one component instead of one per season. label names
// the children ("Albums", "Books").
templ ParentDetail(li projection.LibraryItem, label string) {
	@Layout(li.Title) {
		<a href={ templ.URL("/library/" + string(li.Tab)) } class="text-sm text-muted-foreground hover:text-foreground">&larr; Library</a>
		@itemHeader(li)
		<div class="mt-6 rounded-md border border-border bg-card">
			<details
				hx-get={ ChildrenURL(li.Ref.Namespace, string(li.Kind), li.Ref.Name) }
				hx-trigger="toggle once"
				hx-target="find .children"
				hx-swap="innerHTML"
			>
				<summary class="cursor-pointer px-4 py-3 font-medium">
					<a href={ templ.URL(ChildrenURL(li.Ref.Namespace, string(li.Kind), li.Ref.Name)) } class="hover:underline">{ label }</a>
				</summary>
				<div class="children border-t border-border px-4 py-3 text-sm text-muted-foreground">Loading…</div>
			</details>
		</div>
	}
}

// ChildrenPage is a parent's children on their own page.
templ ChildrenPage(li projection.LibraryItem, label string, children []ChildRow) {
	@Layout(fmt.Sprintf("%s · %s", li.Title, label)) {
		<a href={ libraryItemURL(li) } class="text-sm text-muted-foreground hover:text-foreground">&larr; { li.Title }</a>
		@itemHeader(li)
		<div class="mt-6 rounded-md border border-border bg-card">
			<h2 class="px-4 py-3 font-medium">{ label }</h2>
			<div class="children border-t border-border">
				@ChildRows(children)
			</div>
		</div>
	}
}

// ChildRows is the children component: what a parent's first expand
// fetches, and what the children page renders inline.
templ ChildRows(children []ChildRow) {
	if len(children) == 0 {
		<p class="px-4 py-3 text-sm text-muted-foreground">Nothing here yet.</p>
	} else {
		@item.Group(item.GroupProps{Class: "gap-0 p-2"}) {
			for _, child := range children {
				@ChildRowView(child)
			}
		}
	}
}

// ChildRowView is one album or book row, and what its monitor toggle swaps
// in place.
templ ChildRowView(child ChildRow) {
	@item.Item(item.Props{
		Size:  item.SizeSm,
		Class: "flex-nowrap",
		Attributes: templ.Attributes{
			"data-child":     child.Name,
			"data-kind":      child.Kind,
			"data-monitored": fmt.Sprintf("%t", child.Monitored),
			"data-hasfile":   fmt.Sprintf("%t", child.HasFile),
			"data-quality":   child.Quality,
			"data-phase":     child.Phase,
		},
	}) {
		@item.Content() {
			@item.Title() {
				{ child.Title }
				if child.Year > 0 {
					<span class="text-muted-foreground">{ fmt.Sprint(child.Year) }</span>
				}
			}
			@actionFailure(child.Error)
		}
		@item.Content(item.ContentProps{Class: "flex-none items-end"}) {
			if child.HasFile {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: phaseTone("Imported")}) { { child.Quality } }
			} else if child.Phase != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: phaseTone(child.Phase)}) { { child.Phase } }
			}
		}
		@item.Actions() {
			<form hx-post={ child.MonitorURL() } hx-target="closest [data-slot=item]" hx-swap="outerHTML" method="post" action={ templ.URL(child.MonitorURL()) }>
				<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !child.Monitored) }/>
				@monitorToggle(child.Monitored, "set-monitored")
			</form>
		}
	}
}
