package views

import (
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/buttongroup"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/menubar"
)

// Sonarr's page toolbar (design 2026-09-24; shadcn's menubar since
// 2026-10-06): a full-width bar under the top bar holding icon-over-label
// buttons -- the page's actions on the left, its view menus on the right.
// The bar is shadcn-templ's menubar, so the view menus (toolbarMenu) are
// its menus, with its keyboard handling and its portalled popups, which
// the bar's sideways scroll cannot clip; an action is shadcn-templ's
// button in its ghost variant, laid out as a column, so the bar composes
// forms (an action), links and menu triggers alike.
//
// An item page's bar (actionBar, owner 2026-11-04) is the other shape: it
// has actions and no menus, so it is one shadcn-templ button group in its
// large size -- outline buttons joined at their borders, each an icon over
// one short word -- the group itself the glass, centred under the top bar,
// with no panel around it.

// toolbarButtonClass turns a button into Radarr's toolbar button: the
// icon above a small label, the whole thing a hover target.
const toolbarButtonClass = "h-auto min-w-16 flex-col gap-1 px-2 py-1.5 text-[11px] leading-tight font-normal text-muted-foreground hover:text-foreground [&_svg]:size-5"

// Field is one hidden input of a toolbar action's form.
type Field struct {
	Name  string
	Value string
}

// toolbar is the bar itself: the menubar as a floating glass panel inside
// the page's padding (2026-10-22, after the Plex apps: rounded like the
// sidebar, never a squared-off strip), sticky half a rem beneath the top
// bar at a fixed height (h-14, which the library's A-Z bar counts on), its
// groups pushed to the edges.
// attrs land on the bar, beside data-toolbar.
templ toolbar(attrs templ.Attributes) {
	@menubar.Menubar(menubar.Props{
		Class:      "glass panel sticky top-14 z-20 mb-6 flex h-14 items-stretch justify-between gap-2 overflow-x-auto rounded-xl border border-border bg-background/55 px-2 py-1 shadow-lg shadow-black/30",
		Attributes: toolbarAttrs(attrs),
	}) {
		{ children... }
	}
}

// toolbarAttrs adds data-toolbar to the page's own attributes.
func toolbarAttrs(attrs templ.Attributes) templ.Attributes {
	out := templ.Attributes{"data-toolbar": true}
	for k, v := range attrs {
		out[k] = v
	}
	return out
}

// toolbarGroup is one run of buttons, centred so a button in a form and a
// menu trigger line up.
templ toolbarGroup() {
	<div class="flex items-center gap-0.5">
		{ children... }
	</div>
}

// toolbarForm is one action: a form posting to action with fields, whose
// only control is an icon-over-label submit button carrying data-action
// for the tests. formAttrs land on the form.
templ toolbarForm(action string, fields []Field, iconName, label, dataAction string, formAttrs templ.Attributes) {
	<form method="post" action={ templ.URL(action) } { formAttrs... }>
		for _, f := range fields {
			<input type="hidden" name={ f.Name } value={ f.Value }/>
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Class: toolbarButtonClass, Attributes: templ.Attributes{"data-action": dataAction, "data-toolbar-button": true}}) {
			@icon.Icon(iconName)()
			<span>{ label }</span>
		}
	</form>
}

// toolbarMenu is one of the bar's menus -- Options, Sort, Filter -- as a
// menubar menu: an icon-over-label trigger carrying data-toolbar-menu with
// its label, and its content, aligned to the trigger's end since the menus
// sit at the bar's right.
templ toolbarMenu(iconName, label string) {
	@menubar.Menu() {
		@menubar.Trigger(menubar.TriggerProps{Class: toolbarButtonClass + " justify-center rounded-md aria-expanded:text-foreground", Attributes: templ.Attributes{"data-toolbar-menu": label}}) {
			@icon.Icon(iconName)()
			<span>{ label }</span>
		}
		@menubar.Content(menubar.ContentProps{Align: menubar.AlignEnd, Class: "min-w-48"}) {
			{ children... }
		}
	}
}

// toolbarButton is an icon-over-label button that acts on the page itself
// in the browser, not by posting: attrs carry what ui/static/library.js
// binds to.
templ toolbarButton(iconName, label string, attrs templ.Attributes) {
	@button.Button(button.Props{Variant: button.VariantGhost, Class: toolbarButtonClass, Attributes: attrs}) {
		@icon.Icon(iconName)()
		<span>{ label }</span>
	}
}

// actionBar is an item page's toolbar: the page's actions as one button
// group, shadcn's large size (owner, 2026-11-04: "Simplify the toolbar on
// movie pages to use something like the large variant"), the group itself
// the frosted glass -- no panel around it, so its buttons' hairlines are
// the only frame -- only as wide as its buttons, centred, sticky half a rem
// beneath the top bar as the library's bar is, and scrolling sideways
// where a narrow window cannot hold it, with no scrollbar drawn under it
// (the cut-off button says there is more), and never down: a pressed
// button's 1px nudge would otherwise flash one. It carries data-toolbar,
// as the library's bar does. Its children are the group's buttons --
// actionForm's, and the dialogs' triggers, which stand in the group
// themselves (a dialog root renders no element of its own, and its portal
// is hidden until the script moves it to <body>).
templ actionBar() {
	@buttongroup.ButtonGroup(buttongroup.Props{
		Class:      "glass sticky top-14 z-20 mx-auto mb-6 max-w-full overflow-x-auto overflow-y-hidden rounded-md bg-background/55 [scrollbar-width:none] shadow-lg shadow-black/30",
		Attributes: templ.Attributes{"data-toolbar": true},
	}) {
		{ children... }
	}
}

// actionButtonClass is a button of the group: shadcn's large outline
// button, its text and weight, stood up as a column -- the icon above one
// short word, both centred -- with the glass showing through (the outline
// variant's opaque fill and its shadow dropped).
const actionButtonClass = "h-auto min-w-18 flex-col gap-1 bg-transparent px-3.5 py-2 shadow-none hover:bg-muted aria-expanded:bg-muted [&_svg]:size-[18px]!"

// actionButtonProps is the group's button: outline, the variant the group
// joins at the borders, at the large size, with attrs on it.
func actionButtonProps(attrs templ.Attributes) button.Props {
	return button.Props{Variant: button.VariantOutline, Size: button.SizeLg, Class: actionButtonClass, Attributes: attrs}
}

// actionTitle is the hover title of a button whose word does not say the
// whole action ("Refresh" for Refresh & Scan): title when it adds to
// label, else nothing, so a button never repeats its own word.
func actionTitle(label, title string) templ.Attributes {
	if title == "" || title == label {
		return nil
	}
	return templ.Attributes{"title": title}
}

// actionForm is one action of the bar: a hidden form, id, posting to
// action with fields, and the group's submit button for it. The button
// names the form (the form attribute) rather than standing inside it, so
// it is the group's own child and takes the joined borders; a click
// submits the form all the same, and htmx attributes in formAttrs still
// catch the submit. label is the button's word, title the whole action
// (actionTitle), dataAction what the tests key on.
templ actionForm(id, action string, fields []Field, iconName, label, title, dataAction string, formAttrs templ.Attributes) {
	<form id={ id } method="post" action={ templ.URL(action) } hidden { formAttrs... }>
		for _, f := range fields {
			<input type="hidden" name={ f.Name } value={ f.Value }/>
		}
	</form>
	{{ p := actionButtonProps(actionAttrs(dataAction, actionTitle(label, title))) }}
	{{ p.Type, p.Form = button.TypeSubmit, id }}
	@button.Button(p) {
		@icon.Icon(iconName)()
		<span>{ label }</span>
	}
}

// actionAttrs is a group button's data-action and data-toolbar-button,
// plus extra.
func actionAttrs(dataAction string, extra templ.Attributes) templ.Attributes {
	attrs := templ.Attributes{"data-action": dataAction, "data-toolbar-button": true}
	for k, v := range extra {
		attrs[k] = v
	}
	return attrs
}
