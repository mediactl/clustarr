package views

import (
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/alert"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/collapsible"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/components/skeleton"
	"github.com/mediactl/clustarr/ui/components/table"
)

// SeriesDetail is a series' page (spec 2026-09-23-library-page-design):
// the item header -- poster, title, monitored toggle, profile, search now
// -- followed by one season component per season. Episodes are not on the
// page; each season loads its own on first expand, and an episode's title
// opens its page (EpisodePage). #episode-modal holds an episode's or a
// season's interactive search once one is opened, and
// #action-status says how an episode's automatic search went.
templ SeriesDetail(d Detail, seasons []SeasonRow) {
	@Shell(Chrome{Title: d.Item.Title, Crumbs: itemCrumbs(d.Item), Tab: d.Item.Tab}) {
		@itemToolbar(d)
		@hero(d)
		<div class="mt-6 space-y-4" data-seasons={ fmt.Sprint(len(seasons)) }>
			if len(seasons) == 0 {
				@emptyNote("No seasons yet: they arrive with the series' metadata.", "", nil)
			}
			for _, season := range seasons {
				@SeasonComponent(season)
			}
		</div>
		@episodeRegions()
	}
}

// episodeRegions are what an episode's actions answer into: the modal's
// mount point and the action status, above the modal's overlay.
templ episodeRegions() {
	<div id="episode-modal"></div>
	@ActionStatusRegion()
}

// ActionStatusRegion is where an htmx action says how it went
// (ActionStatus, ActionError); ui/static/library.js clears it after a
// while. It sits above a dialog's overlay, so an action posted from a
// modal answers where it can be seen.
templ ActionStatusRegion() {
	<div id="action-status" aria-live="polite" class="fixed top-16 left-1/2 z-[60] w-max max-w-[90vw] -translate-x-1/2 empty:hidden"></div>
}

// SeasonComponent is one season, Sonarr's season block: its header, and a
// collapsible (shadcn-templ's, since 2026-11-04; a <details> before) whose
// first open fetches the season's episodes table into its panel
// (hx-trigger on the collapsible's open-change event, once). The header
// links to the season's own page, so a browser without JavaScript still
// gets there.
templ SeasonComponent(season SeasonRow) {
	<div class="overflow-hidden panel rounded-xl border border-border bg-card" id={ fmt.Sprintf("season-%d", season.Number) }>
		@SeasonHeader(season)
		@collapsible.Collapsible(collapsible.Props{
			Class:      "border-t border-border",
			Attributes: templ.Attributes{"hx-get": season.URL(), "hx-trigger": expandOnce, "hx-target": "find .episodes", "hx-swap": "innerHTML"},
		}) {
			@expandTrigger("Show episodes", "Hide episodes")
			@collapsible.Content(collapsible.ContentProps{Class: "episodes border-t border-border text-sm text-muted-foreground"}) {
				@loadingRows()
			}
		}
	</div>
}

// loadingRows stands in for a table that is being fetched: three
// skeleton lines (shadcn-templ's, since 2026-11-04; "Loading…" before).
templ loadingRows() {
	<div class="space-y-2 px-4 py-3" data-loading aria-busy="true" aria-label="Loading">
		@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
		@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3"})
		@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/2"})
	</div>
}

// expandOnce is the hx-trigger of a collapsible whose first open loads
// its panel: the collapsible's open-change event, filtered to an opening,
// once. A <details>' "toggle once" before 2026-11-04.
const expandOnce = "collapsible-open-change[detail.open] once"

// expandTrigger is a collapsible's trigger as the season blocks draw it:
// a slim centred row reading show while closed and hide while open, with
// a chevron that turns.
templ expandTrigger(show, hide string) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Class:      "group/trigger h-auto w-full gap-1 rounded-none py-1.5 text-xs font-normal text-muted-foreground hover:bg-muted/50",
		Attributes: collapsible.Trigger(ctx),
	}) {
		<span class="group-data-[panel-open]/trigger:hidden">{ show }</span>
		<span class="hidden group-data-[panel-open]/trigger:inline">{ hide }</span>
		<span class="transition-transform group-data-[panel-open]/trigger:rotate-180 [&_svg]:size-4">
			@icon.Icon("chevron-down")()
		</span>
	}
}

// SeasonHeader is the season's heading row, Sonarr's: the monitor
// bookmark, the season's name, the files-of-episodes badge (green when
// complete, red when monitored and missing, amber when unmonitored), the
// size on disk and the next airing. It is what its monitor toggle swaps in
// place -- the header alone, so an expanded episode list below it stays
// put. Its data attributes carry the counts and the effective monitored
// flag for the tests; a failed toggle renders its error here.
templ SeasonHeader(season SeasonRow) {
	@item.Item(item.Props{
		Variant: item.VariantMuted,
		Class:   "season-header flex-nowrap rounded-none border-0",
		Attributes: templ.Attributes{
			"data-season":    fmt.Sprint(season.Number),
			"data-monitored": fmt.Sprintf("%t", season.Monitored),
			"data-episodes":  fmt.Sprint(season.Episodes),
			"data-files":     fmt.Sprint(season.Files),
		},
	}) {
		<form
			hx-post={ season.MonitorURL() }
			hx-target="closest .season-header"
			hx-swap="outerHTML"
			method="post"
			action={ templ.URL(season.MonitorURL()) }
			class="contents"
		>
			<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !season.Monitored) }/>
			@bookmarkToggle(season.Monitored, "set-season-monitored", true)
		</form>
		@item.Content() {
			@item.Title(item.TitleProps{Class: "flex-wrap gap-x-3 gap-y-1"}) {
				<a href={ templ.URL(season.URL()) } class="text-lg font-semibold hover:underline">{ season.Label() }</a>
				if season.Title != "" {
					<span class="text-base font-normal text-muted-foreground" data-season-title>{ season.Title }</span>
				}
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: season.CountTone(), Attributes: templ.Attributes{"data-season-count": season.CountLabel()}}) {
					{ season.CountLabel() }
				}
				if season.SizeBytes > 0 {
					<span class="text-xs font-normal text-muted-foreground" data-season-size>{ formatBytes(season.SizeBytes) }</span>
				}
			}
			if season.NextAiring != "" {
				@item.Description() {
					Next airing { season.NextAiring }
				}
			}
			@actionFailure(season.Error)
		}
		@item.Actions(item.ActionsProps{Class: "shrink-0 gap-1"}) {
			if season.Search.Label != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: seasonSearchTone(season.Search.Phase), Attributes: templ.Attributes{
					"data-season-search": season.Search.Phase, "title": season.Search.Title,
				}}) {
					{ season.Search.Label }
				}
			}
			@seasonSearchButtons(season)
		}
	}
}

// seasonSearchButtons are Sonarr's two season searches (Wave S): the
// magnifier, which the Series plans -- one paced query for the season,
// grabbing the best release for each wanted episode -- answered into
// #action-status; and the person, an interactive season search whose
// results open in the season's modal.
templ seasonSearchButtons(season SeasonRow) {
	<form hx-post={ season.SearchURL() } hx-target="#action-status" method="post" action={ templ.URL(season.SearchURL()) } class="contents">
		<input type="hidden" name="return" value={ season.URL() }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconSm,
			Attributes: templ.Attributes{"data-action": "season-search", "aria-label": "Search Season", "title": "Search Season"}}) {
			@icon.Icon("search")()
		}
	</form>
	<form hx-post={ season.InteractiveSearchURL() } hx-target="#episode-modal" hx-swap="innerHTML" method="post" action={ templ.URL(season.InteractiveSearchURL()) } class="contents">
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconSm,
			Attributes: templ.Attributes{"data-action": "season-interactive-search", "aria-label": "Interactive Season Search", "title": "Interactive Season Search"}}) {
			@icon.Icon("user-search")()
		}
	</form>
}

// seasonSearchTone colours a season's search badge: sky while queued or
// searching, emerald once searched. Whole literals, for Tailwind's scan.
func seasonSearchTone(phase string) string {
	if phase == "Answered" {
		return "border-emerald-500/40 text-emerald-300"
	}
	return "border-sky-500/40 text-sky-300"
}

// bookmarkToggle is Sonarr's monitor toggle: a bookmark, filled when
// monitored and hollow when not, whose press flips it; large is the
// season header's.
templ bookmarkToggle(monitored bool, action string, large bool) {
	@button.Button(button.Props{
		Type:    button.TypeSubmit,
		Variant: button.VariantGhost,
		Size:    button.SizeIconSm,
		Class:   "text-foreground",
		Attributes: templ.Attributes{
			"data-action": action,
			"aria-label":  bookmarkLabel(monitored),
			"title":       bookmarkLabel(monitored),
		},
	}) {
		<span class={ bookmarkClass(monitored, large) }>
			@icon.Icon("bookmark")()
		</span>
	}
}

// bookmarkClass sizes and fills a bookmarkToggle's icon. The classes are
// whole literals so Tailwind's scan finds them.
func bookmarkClass(monitored, large bool) string {
	switch {
	case monitored && large:
		return "[&_svg]:size-6 [&_svg]:fill-current"
	case monitored:
		return "[&_svg]:size-4 [&_svg]:fill-current"
	case large:
		return "text-muted-foreground [&_svg]:size-6"
	default:
		return "text-muted-foreground [&_svg]:size-4"
	}
}

// monitorToggle is the toggle button an album or book row shows: the
// current state as its label, the primary look when monitored and the
// outline look when not, so it reads as the badge it flips.
templ monitorToggle(monitored bool, action string) {
	if monitored {
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Attributes: templ.Attributes{"data-action": action}}) {
			{ monitoredLabel(monitored) }
		}
	} else {
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-action": action}}) {
			{ monitoredLabel(monitored) }
		}
	}
}

// actionFailure renders a failed toggle's error inside its component --
// the alert ActionError is (shadcn-templ's, since 2026-11-04); nothing
// for a zero value.
templ actionFailure(f ActionFailure) {
	if f.Code != "" {
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "mt-2", Attributes: templ.Attributes{"data-action-error": f.Code, "role": "alert"}}) {
			@icon.CircleAlert()
			@alert.Title() {
				Action failed
			}
			@alert.Description() {
				{ f.Message }
			}
		}
	}
}

// SeasonPage is a season on its own: the series header, the season's
// header, then its episodes.
templ SeasonPage(d Detail, season SeasonRow, episodes []EpisodeRow) {
	@Shell(Chrome{Title: fmt.Sprintf("%s · %s", d.Item.Title, season.Label()), Crumbs: childCrumbs(d.Item, season.Label()), Tab: d.Item.Tab}) {
		@itemToolbar(d)
		@hero(d)
		<div class="mt-6 overflow-hidden panel rounded-xl border border-border bg-card">
			@SeasonHeader(season)
			<div class="episodes border-t border-border">
				@EpisodeRows(episodes)
			</div>
		</div>
		@episodeRegions()
	}
}

// EpisodeRows is the episodes component, Sonarr's season table: what a
// season's first expand fetches, and what the season page renders inline.
// Air dates fold away on a narrow screen; the file columns -- languages
// and score from a laptop's width, the codecs and the three remediations
// from a desktop's -- fold away before them.
templ EpisodeRows(episodes []EpisodeRow) {
	if len(episodes) == 0 {
		@emptyNote("No episodes in this season yet.", "py-3", nil)
	} else {
		@table.Table(table.Props{Attributes: templ.Attributes{"data-episode-table": ""}}) {
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "w-10"}) {
						<span class="sr-only">Monitored</span>
					}
					@table.Head(table.HeadProps{Class: "w-10"}) {
						# 
					}
					@table.Head() {
						Title 
					}
					@table.Head(table.HeadProps{Class: "hidden w-32 sm:table-cell"}) {
						Air Date 
					}
					@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
						Languages 
					}
					@table.Head(table.HeadProps{Class: "hidden w-16 text-right lg:table-cell"}) {
						Score 
					}
					@table.Head(table.HeadProps{Class: "hidden xl:table-cell"}) {
						Video 
					}
					@table.Head(table.HeadProps{Class: "hidden xl:table-cell"}) {
						Audio 
					}
					@table.Head(table.HeadProps{Class: "hidden xl:table-cell"}) {
						Transcode 
					}
					@table.Head(table.HeadProps{Class: "hidden xl:table-cell"}) {
						Subtitles 
					}
					@table.Head(table.HeadProps{Class: "hidden xl:table-cell"}) {
						Markers 
					}
					@table.Head(table.HeadProps{Class: "w-36"}) {
						Status 
					}
					@table.Head(table.HeadProps{Class: "w-20"}) {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@table.Body() {
				for _, ep := range episodes {
					@EpisodeRowView(ep)
				}
			}
		}
	}
}

// EpisodeRowView is one episode, Sonarr's episode row, and what its monitor
// toggle swaps in place: the bookmark, the number, the title (the
// episode's page) with its finale and audio badges, the air date, the
// file's columns (empty without a file), the status cell, and the
// automatic and interactive searches. An unmonitored episode reads dimmed.
templ EpisodeRowView(ep EpisodeRow) {
	@table.Row(table.RowProps{
		Class: rowTone(ep.Monitored),
		Attributes: templ.Attributes{
			"data-episode":   fmt.Sprint(ep.Number),
			"data-monitored": fmt.Sprintf("%t", ep.Monitored),
			"data-hasfile":   fmt.Sprintf("%t", ep.HasFile),
			"data-quality":   ep.Quality,
			"data-phase":     ep.Phase,
			"data-status":    ep.Status.Kind,
		},
	}) {
		@table.Cell(table.CellProps{Class: "py-1"}) {
			<form hx-post={ ep.MonitorURL() } hx-target="closest tr" hx-swap="outerHTML" method="post" action={ templ.URL(ep.MonitorURL()) } class="contents">
				<input type="hidden" name="return" value={ ep.ReturnURL() }/>
				<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !ep.Monitored) }/>
				@bookmarkToggle(ep.Monitored, "set-monitored", false)
			</form>
		}
		@table.Cell(table.CellProps{Class: "tabular-nums text-muted-foreground"}) {
			{ fmt.Sprint(ep.Number) }
		}
		@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
			<span class="flex flex-wrap items-center gap-2">
				<a
					href={ templ.URL(ep.URL()) }
					preload="mouseover"
					class="font-medium hover:underline"
					data-episode-title
				>
					if ep.Title != "" {
						{ ep.Title }
					} else {
						TBA
					}
				</a>
				if ep.FinaleLabel() != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "border-sky-500/40 text-sky-300", Attributes: templ.Attributes{"data-finale": ep.FinaleType}}) {
						{ ep.FinaleLabel() }
					}
				}
				if ep.Audio.Text != "" {
					@audioBadge(ep.Audio)
				}
			</span>
			@actionFailure(ep.Error)
		}
		@table.Cell(table.CellProps{Class: "hidden text-muted-foreground sm:table-cell"}) {
			if ep.AirDate != "" {
				<time datetime={ ep.AirDate } title={ ep.AirDate }>{ ep.AirDateLabel }</time>
			}
		}
		@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
			if ep.File != nil {
				@languagesCell(ep.File)
			}
		}
		@table.Cell(table.CellProps{Class: "hidden text-right tabular-nums lg:table-cell"}) {
			if ep.File != nil {
				<span data-score={ signed(ep.File.Score) }>{ signed(ep.File.Score) }</span>
			}
		}
		@table.Cell(table.CellProps{Class: "hidden xl:table-cell"}) {
			if ep.File != nil {
				@fileCell(ep.File.VideoCodec, "data-video")
			}
		}
		@table.Cell(table.CellProps{Class: "hidden xl:table-cell"}) {
			if ep.File != nil {
				@fileCell(ep.File.AudioCodec, "data-audio-codec")
			}
		}
		@table.Cell(table.CellProps{Class: "hidden xl:table-cell"}) {
			if ep.File != nil {
				@fileCell(ep.File.Transcode, "data-transcode")
			}
		}
		@table.Cell(table.CellProps{Class: "hidden xl:table-cell"}) {
			if ep.File != nil {
				@fileCell(ep.File.Subtitles, "data-subtitles")
			}
		}
		@table.Cell(table.CellProps{Class: "hidden xl:table-cell"}) {
			if ep.File != nil {
				@fileCell(ep.File.Markers, "data-markers")
			}
		}
		@table.Cell() {
			@statusCell(ep.Status)
		}
		@table.Cell(table.CellProps{Class: "py-1"}) {
			<span class="flex justify-end">
				@episodeSearchButtons(ep)
			</span>
		}
	}
}

// languagesCell is the file's frozen languages, Sonarr's Languages
// column: the first LanguagesShown as badges and the rest behind a count
// that names them in its tooltip.
templ languagesCell(f *EpisodeFile) {
	<span class="flex flex-wrap gap-1" data-languages={ strings.Join(f.Languages, ",") }>
		for i, l := range f.Languages {
			if i < LanguagesShown {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ l }
				}
			}
		}
		if more := f.MoreLanguages(); len(more) > 0 {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"title": strings.Join(more, ", "), "data-more-languages": fmt.Sprint(len(more))}}) {
				{ fmt.Sprintf("+%d", len(more)) }
			}
		}
	</span>
}

// fileCell is one of a file's cells: its label in its tone, the detail as
// the tooltip, carried on attr for the tests; nothing for an empty one.
templ fileCell(c Cell, attr string) {
	if c.Label != "" {
		<span class={ "whitespace-nowrap text-xs " + cellTone(c.Tone) } title={ c.Title } { templ.Attributes{attr: c.Label}... }>{ c.Label }</span>
	}
}

// cellTone is a Cell's colour: done, in flight, a warning, a failure, else
// muted.
func cellTone(tone string) string {
	switch tone {
	case "done":
		return "text-emerald-300"
	case "busy":
		return "text-sky-300"
	case "warn":
		return "text-amber-300"
	case "fail":
		return "text-red-300"
	}
	return "text-muted-foreground"
}

// rowTone dims an unmonitored episode, as Sonarr does.
func rowTone(monitored bool) string {
	if monitored {
		return ""
	}
	return "text-muted-foreground"
}

// episodeSearchButtons are an episode row's two searches.
templ episodeSearchButtons(ep EpisodeRow) {
	@searchButtons("episode", ep.SearchURL(), ep.InteractiveSearchURL(), ep.ReturnURL())
}

// searchButtons are Sonarr's two row actions, on an episode's row or a
// book's (kind names which): the magnifier is the automatic search,
// answered into #action-status; the person is the interactive search,
// which opens the item's modal, #<kind>-modal, on its results. Both are
// forms, so a browser without JavaScript still gets there.
templ searchButtons(kind, searchURL, interactiveURL, returnURL string) {
	<form hx-post={ searchURL } hx-target="#action-status" method="post" action={ templ.URL(searchURL) } class="contents">
		<input type="hidden" name="return" value={ returnURL }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconSm,
			Attributes: templ.Attributes{"data-action": kind + "-search", "aria-label": "Automatic Search", "title": "Automatic Search"}}) {
			@icon.Icon("search")()
		}
	</form>
	<form hx-post={ interactiveURL } hx-target={ "#" + kind + "-modal" } hx-swap="innerHTML" method="post" action={ templ.URL(interactiveURL) } class="contents">
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconSm,
			Attributes: templ.Attributes{"data-action": kind + "-interactive-search", "aria-label": "Interactive Search", "title": "Interactive Search"}}) {
			@icon.Icon("user-search")()
		}
	</form>
}

// statusCell is Sonarr's status cell, an episode's or a book's: the
// file's quality as a badge (amber below the cutoff), or what the item is
// waiting on.
templ statusCell(s RowStatus) {
	switch s.Kind {
		case "file":
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: fileTone(s.Warn), Attributes: templ.Attributes{"title": s.Title}}) {
				{ s.Label }
			}
		case "missing":
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "bg-red-500/20 text-red-300", Attributes: templ.Attributes{"title": s.Title}}) {
				{ s.Label }
			}
		case "downloading", "pending":
			<span class="inline-flex items-center gap-1 text-sky-300 [&_svg]:size-4" title={ s.Title }>
				if s.Kind == "downloading" {
					@icon.Icon("download")()
				} else {
					@icon.Icon("clock")()
				}
				{ s.Label }
			</span>
		default:
			<span class="text-xs text-muted-foreground" title={ s.Title }>{ s.Label }</span>
	}
}

// fileTone is a file's quality badge: amber below the cutoff, else done.
func fileTone(warn bool) string {
	if warn {
		return phaseTone("CutoffUnmet")
	}
	return phaseTone("Imported")
}

// audioBadge is an AudioNote: a quiet badge, toned as a problem when it
// warns, with a failure's reason as its tooltip.
templ audioBadge(n AudioNote) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: audioTone(n),
		Attributes: templ.Attributes{"data-audio": n.Text, "title": n.Title}}) {
		{ n.Text }
	}
}
