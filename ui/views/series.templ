package views

import (
	"fmt"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/projection"
)

// SeriesDetail is a series' page (spec 2026-09-23-library-page-design):
// the item header -- poster, title, monitored toggle, profile, search now
// -- followed by one season component per season. Episodes are not on the
// page; each season loads its own on first expand.
templ SeriesDetail(li projection.LibraryItem, seasons []SeasonRow) {
	@Layout(li.Title) {
		<a href={ templ.URL("/library/" + string(li.Tab)) } class="text-sm text-muted-foreground hover:text-foreground">&larr; Library</a>
		@itemHeader(li)
		<div class="mt-6 space-y-3" data-seasons={ fmt.Sprint(len(seasons)) }>
			if len(seasons) == 0 {
				<p class="text-slate-400">No seasons yet: they arrive with the series' metadata.</p>
			}
			for _, season := range seasons {
				@SeasonComponent(season)
			}
		</div>
	}
}

// itemHeader is the top of a parent's page: the card's facts at full size
// and the two per-item actions, monitor/unmonitor and search now (§A3.2).
templ itemHeader(li projection.LibraryItem) {
	@item.Item(item.Props{
		Variant: item.VariantOutline,
		Class:   "mt-4 flex-nowrap items-start p-6",
		Attributes: templ.Attributes{
			"data-ref":       li.Ref.String(),
			"data-kind":      string(li.Kind),
			"data-monitored": fmt.Sprintf("%t", li.Monitored),
			"data-phase":     li.Phase,
			"data-hasfile":   fmt.Sprintf("%t", li.HasFile),
			"data-year":      fmt.Sprint(li.Year),
			"data-profile":   li.QualityProfileRef,
			"data-poster":    posterState(li.Poster),
		},
	}) {
		@item.Media(item.MediaProps{Variant: item.MediaVariantImage, Class: "h-36 w-24"}) {
			@poster(li.Poster, li.Title)
		}
		@item.Content() {
			@item.Title(item.TitleProps{Class: "text-2xl font-bold"}) {
				<h1>{ li.Title }</h1>
				if li.Year > 0 {
					<span class="text-base font-normal text-muted-foreground">{ fmt.Sprint(li.Year) }</span>
				}
			}
			@item.Description() {
				{ string(li.Kind) }
				if li.QualityProfileRef != "" {
					· <span title="quality profile">{ li.QualityProfileRef }</span>
				}
			}
			<div class="mt-2 flex flex-wrap gap-2">
				@monitoredBadge(li.Monitored)
				if li.Phase != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: phaseTone(li.Phase)}) { { li.Phase } }
				}
				if li.HasFile {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { on disk }
				}
			</div>
			@item.Actions(item.ActionsProps{Class: "mt-6 flex-wrap gap-3"}) {
				<form method="post" action={ templ.URL(libraryActionURL(li, "monitor")) }>
					<input type="hidden" name="return" value={ libraryDetailPath(li) }/>
					<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !li.Monitored) }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-action": "set-monitored"}}) {
						if li.Monitored {
							Unmonitor
						} else {
							Monitor
						}
					}
				</form>
				<form method="post" action={ templ.URL(libraryActionURL(li, "search")) }>
					<input type="hidden" name="return" value={ libraryDetailPath(li) }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-action": "search-now"}}) { Search now }
				</form>
				@refreshMetadataForm(li)
			}
		}
	}
}

// refreshMetadataForm is the "Refresh metadata" action (design
// 2026-09-23-library-page-design, "Metadata refresh"): a form post the
// handler turns into the clustarr.io/refresh-metadata annotation.
templ refreshMetadataForm(li projection.LibraryItem) {
	<form method="post" action={ templ.URL(libraryActionURL(li, "refresh")) }>
		<input type="hidden" name="return" value={ libraryDetailPath(li) }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-action": "refresh-metadata"}}) { Refresh metadata }
	</form>
}

// SeasonComponent is one season: its header, and a <details> whose first
// open fetches the season's episodes into its body (hx-trigger "toggle
// once"). The header links to the season's own page, so a browser without
// JavaScript still gets there.
templ SeasonComponent(season SeasonRow) {
	<div class="rounded-md border border-border bg-card" id={ fmt.Sprintf("season-%d", season.Number) }>
		@SeasonHeader(season)
		<details
			class="border-t border-border"
			hx-get={ season.URL() }
			hx-trigger="toggle once"
			hx-target="find .episodes"
			hx-swap="innerHTML"
		>
			<summary class="cursor-pointer px-4 py-2 text-sm text-muted-foreground">Episodes</summary>
			<div class="episodes px-4 py-3 text-sm text-muted-foreground">Loading…</div>
		</details>
	</div>
}

// SeasonHeader is the season's heading row, and what its monitor toggle
// swaps in place -- the header alone, so an expanded episode list below it
// stays put. Its data attributes carry the counts and the effective
// monitored flag for the tests; a failed toggle renders its error here.
templ SeasonHeader(season SeasonRow) {
	@item.Item(item.Props{
		Variant: item.VariantMuted,
		Class:   "season-header rounded-b-none border-0",
		Attributes: templ.Attributes{
			"data-season":    fmt.Sprint(season.Number),
			"data-monitored": fmt.Sprintf("%t", season.Monitored),
			"data-episodes":  fmt.Sprint(season.Episodes),
			"data-files":     fmt.Sprint(season.Files),
		},
	}) {
		@item.Content() {
			@item.Title() {
				<a href={ templ.URL(season.URL()) } class="hover:underline">{ season.Label() }</a>
			}
			@item.Description() {
				{ fmt.Sprintf("%d of %d on disk", season.Files, season.Episodes) }
				if season.NextAiring != "" {
					· next { season.NextAiring }
				}
			}
			@actionFailure(season.Error)
		}
		@item.Actions() {
			<form
				hx-post={ season.MonitorURL() }
				hx-target="closest .season-header"
				hx-swap="outerHTML"
				method="post"
				action={ templ.URL(season.MonitorURL()) }
			>
				<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !season.Monitored) }/>
				@monitorToggle(season.Monitored, "set-season-monitored")
			</form>
		}
	}
}

// monitorToggle is the toggle button every monitorable row shows: the
// current state as its label, the primary look when monitored and the
// outline look when not, so it reads as the badge it flips.
templ monitorToggle(monitored bool, action string) {
	if monitored {
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Attributes: templ.Attributes{"data-action": action}}) { { monitoredLabel(monitored) } }
	} else {
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-action": action}}) { { monitoredLabel(monitored) } }
	}
}

// actionFailure renders a failed toggle's error inside its component;
// nothing for a zero value.
templ actionFailure(f ActionFailure) {
	if f.Code != "" {
		<p data-action-error={ f.Code } class="mt-2 rounded-md border border-red-900 bg-red-950/50 px-3 py-2 text-xs text-red-300">
			Action failed: { f.Message }
		</p>
	}
}

// SeasonPage is a season on its own: the series header, the season's
// header, then its episodes.
templ SeasonPage(li projection.LibraryItem, season SeasonRow, episodes []EpisodeRow) {
	@Layout(fmt.Sprintf("%s · %s", li.Title, season.Label())) {
		<a href={ libraryItemURL(li) } class="text-sm text-muted-foreground hover:text-foreground">&larr; { li.Title }</a>
		@itemHeader(li)
		<div class="mt-6 rounded-md border border-border bg-card">
			@SeasonHeader(season)
			<div class="episodes border-t border-border">
				@EpisodeRows(episodes)
			</div>
		</div>
	}
}

// EpisodeRows is the episodes component: what a season's first expand
// fetches, and what the season page renders inline -- one item group, one
// item per episode.
templ EpisodeRows(episodes []EpisodeRow) {
	if len(episodes) == 0 {
		<p class="px-4 py-3 text-sm text-muted-foreground">No episodes in this season yet.</p>
	} else {
		@item.Group(item.GroupProps{Class: "gap-0 p-2"}) {
			for _, ep := range episodes {
				@EpisodeRowView(ep)
			}
		}
	}
}

// EpisodeRowView is one episode as an item, and what its monitor toggle
// swaps in place: number and title as the item's title, the air date its
// description, the file's quality or the phase as a badge, and the toggle
// itself, an hx-post that replaces this item with the re-rendered one.
templ EpisodeRowView(ep EpisodeRow) {
	@item.Item(item.Props{
		Size:  item.SizeSm,
		Class: "flex-nowrap",
		Attributes: templ.Attributes{
			"data-episode":   fmt.Sprint(ep.Number),
			"data-monitored": fmt.Sprintf("%t", ep.Monitored),
			"data-hasfile":   fmt.Sprintf("%t", ep.HasFile),
			"data-quality":   ep.Quality,
			"data-phase":     ep.Phase,
		},
	}) {
		@item.Content() {
			@item.Title() {
				<span class="w-8 text-muted-foreground">{ fmt.Sprint(ep.Number) }</span>
				{ ep.Title }
			}
			if ep.AirDate != "" {
				@item.Description() { { ep.AirDate } }
			}
			@actionFailure(ep.Error)
		}
		@item.Content(item.ContentProps{Class: "flex-none items-end"}) {
			if ep.HasFile {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: phaseTone("Imported")}) { { ep.Quality } }
			} else if ep.Phase != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: phaseTone(ep.Phase)}) { { ep.Phase } }
			}
		}
		@item.Actions() {
			<form hx-post={ ep.MonitorURL() } hx-target="closest [data-slot=item]" hx-swap="outerHTML" method="post" action={ templ.URL(ep.MonitorURL()) }>
				<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !ep.Monitored) }/>
				@monitorToggle(ep.Monitored, "set-monitored")
			</form>
		}
	}
}
