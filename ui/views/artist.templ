package views

import (
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/collapsible"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/table"
	"github.com/mediactl/clustarr/ui/projection"
)

// An artist's page (2026-11-10 design §9.2; plan W4b.1) is Lidarr's: the
// item page's hero on the artist's fanart with the thumb, name, sort name,
// disambiguation, type, country, years active, genres, the Status fact from
// the rollup and the provider logos; the action bar (Refresh & Scan,
// Search, Rename, Edit, Delete); and the Albums table grouped by type under
// collapsible headers, each row the monitor bookmark, the title opening the
// album's page, the release date, the type badge, the status cell and the
// two searches. #album-modal holds an album's details or interactive search
// once one is opened, and #action-status says how a search went.

// ArtistActions are the artist page's bar: no interactive search (an
// artist's is its albums') and no image sets.
var ArtistActions = []Action{ActionRefresh, ActionSearch, ActionRename, ActionEdit, ActionDelete}

// ArtistPage is an artist's page.
templ ArtistPage(v ArtistView) {
	@Shell(Chrome{Title: v.Item.Title, Crumbs: itemCrumbs(v.Item), Tab: v.Item.Tab}) {
		@ItemActions(v.Detail, ArtistActions)
		@artistHero(v)
		@albumGroupsSection(v)
		@albumRegions()
	}
}

// albumRegions are what an album's actions answer into on an artist's or
// an album's page: the modal's mount point and the action status.
templ albumRegions() {
	<div id="album-modal"></div>
	@ActionStatusRegion()
}

// artistHero is the item page's hero for an artist: the fanart behind
// everything, the thumb, the bookmark and name with the neighbouring
// artists, the type, country, years active and provider logos, the facts
// -- path, the rollup's status, the profile, sort name, disambiguation,
// genres -- and the biography. It carries the card's data attributes, as
// the movie page's hero does.
templ artistHero(v ArtistView) {
	{{ li := v.Item }}
	<section
		data-hero
		data-artist-page={ li.Ref.Name }
		data-ref={ li.Ref.String() }
		data-kind={ string(li.Kind) }
		data-monitored={ fmt.Sprintf("%t", li.Monitored) }
		data-phase={ li.Phase }
		data-hasfile={ fmt.Sprintf("%t", li.HasFile) }
		data-profile={ li.QualityProfileRef }
		data-poster={ posterState(li.Poster) }
		class="relative -mx-6 mb-8"
	>
		if v.Backdrop != "" {
			<img data-backdrop src={ templ.URL(v.Backdrop) } data-art={ artKeyAs(li, "fanart") } alt="" loading="lazy" class="page-backdrop"/>
			<div class="page-backdrop-shade" aria-hidden="true"></div>
		}
		if li.ArtKey != "" {
			<div hidden hx-ext="sse" sse-connect={ artStreamURL(v.Detail) } hx-trigger="sse:art"></div>
		}
		<div class="relative flex flex-col gap-6 p-8 md:flex-row md:gap-10">
			<div class="w-40 shrink-0 md:w-56">
				<div class="overflow-hidden rounded-xl shadow-2xl shadow-black/60 ring-1 ring-white/10">
					@poster(li.Poster, li.Title, li.ArtKey)
				</div>
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-start justify-between gap-4">
					<div class="flex min-w-0 items-center gap-3">
						@monitorBookmark(li)
						<h1 class="min-w-0 truncate text-4xl font-bold tracking-tight md:text-5xl">{ li.Title }</h1>
					</div>
					@neighbours(v.Detail)
				</div>
				<div class="mt-3 flex flex-wrap items-center gap-3 text-xl text-muted-foreground">
					if v.Type != "" {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-base", Attributes: templ.Attributes{"data-artist-type": v.Type}}) {
							{ v.Type }
						}
					}
					if v.Country != "" {
						<span data-artist-country>{ v.Country }</span>
					}
					if v.YearsActive != "" {
						<span data-artist-years>{ v.YearsActive }</span>
					}
					@providerLinks(v.Links)
				</div>
				<dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4 text-lg">
					if v.Path != "" {
						@fact("path", "Path") {
							<span class="break-all">{ v.Path }</span>
						}
					}
					@fact("status", "Status") {
						<span class="flex items-center gap-2">
							<span data-status={ projection.LibraryStatus(li) } class={ "inline-block h-5 w-1 rounded-sm " + stripeColour(projection.LibraryStatus(li)) }></span>
							<span data-artist-summary>{ artistStatusLabel(v) }</span>
						</span>
						if li.DeleteError != "" {
							@deleteRetry(v.Detail)
						}
						if li.DeleteMode != "" {
							@deleteCancel(v.Detail)
						}
					}
					if li.QualityProfileRef != "" {
						@fact("profile", "Quality Profile") {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-sm"}) {
								{ li.QualityProfileRef }
							}
						}
					}
					if v.SortName != "" && v.SortName != li.Title {
						@fact("sortname", "Sort Name") {
							{ v.SortName }
						}
					}
					if v.Disambiguation != "" {
						@fact("disambiguation", "Disambiguation") {
							{ v.Disambiguation }
						}
					}
					if len(v.Genres) > 0 {
						@fact("genres", "Genres") {
							{ strings.Join(v.Genres, ", ") }
						}
					}
				</dl>
				if v.Overview != "" {
					<p data-overview class="mt-6 max-w-5xl text-base leading-relaxed">{ v.Overview }</p>
				}
			</div>
		</div>
	</section>
}

// artistStatusLabel is the Status fact in words: the rollup's summary
// ("12 albums, 3 missing"), else the library card's status.
func artistStatusLabel(v ArtistView) string {
	if v.Summary != "" {
		return v.Summary
	}
	return statusLabel(v.Item)
}

// albumGroupsSection is the Albums section: one collapsible per type in
// Lidarr's order, open as the page lands, its heading the group's label and
// its files-of-albums badge, its panel the group's table.
templ albumGroupsSection(v ArtistView) {
	<section data-section="albums" data-albums={ fmt.Sprint(v.AlbumCount()) } class="mb-8 space-y-4">
		@sectionTitle("Albums")
		if len(v.Groups) == 0 {
			@emptyNote("No albums yet: they arrive with the artist's metadata.", "panel rounded-xl border border-border bg-card", nil)
		}
		for _, g := range v.Groups {
			@albumGroupComponent(g)
		}
	</section>
}

// albumGroupComponent is one type's albums: the season block's shape, a
// collapsible open by default whose trigger is the heading row (the label,
// the files-of-albums badge) and whose panel is the table.
templ albumGroupComponent(g AlbumGroup) {
	<div class="overflow-hidden panel rounded-xl border border-border bg-card" id={ "albums-" + g.Key } data-album-group={ g.Key } data-album-group-count={ fmt.Sprint(len(g.Rows)) }>
		@collapsible.Collapsible(collapsible.Props{DefaultOpen: true}) {
			@albumGroupTrigger(g)
			@collapsible.Content(collapsible.ContentProps{Class: "border-t border-border"}) {
				@AlbumRows(g.Rows)
			}
		}
	</div>
}

// albumGroupTrigger is the group's heading row and the collapsible's
// trigger: the label, the count badge and a chevron that turns.
templ albumGroupTrigger(g AlbumGroup) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Class:      "group/trigger h-auto w-full justify-between rounded-none px-4 py-3 text-base font-medium",
		Attributes: collapsible.Trigger(ctx),
	}) {
		<span class="flex items-center gap-3">
			<span class="text-lg font-semibold">{ g.Label }</span>
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Attributes: templ.Attributes{"data-album-group-files": g.Count()}}) {
				{ g.Count() }
			}
		</span>
		<span class="transition-transform group-data-[panel-open]/trigger:rotate-180 [&_svg]:size-4">
			@icon.Icon("chevron-down")()
		</span>
	}
}

// AlbumRows is an album group's table: the monitor bookmark, title, release
// date, type, status and the two searches. Release dates and types fold
// away on a narrow screen.
templ AlbumRows(albums []AlbumRow) {
	if len(albums) == 0 {
		@emptyNote("Nothing here yet.", "py-3", nil)
	} else {
		@table.Table(table.Props{Attributes: templ.Attributes{"data-album-table": ""}}) {
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "w-10"}) {
						<span class="sr-only">Monitored</span>
					}
					@table.Head() {
						Title
					}
					@table.Head(table.HeadProps{Class: "hidden w-32 sm:table-cell"}) {
						Release Date
					}
					@table.Head(table.HeadProps{Class: "hidden w-24 md:table-cell"}) {
						Type
					}
					@table.Head(table.HeadProps{Class: "w-40"}) {
						Status
					}
					@table.Head(table.HeadProps{Class: "w-20"}) {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@table.Body() {
				for _, a := range albums {
					@AlbumRowView(a)
				}
			}
		}
	}
}

// AlbumRowView is one album, and what its monitor toggle swaps in place:
// the bookmark, the title (the album's page, preloaded) with its
// disambiguation and secondary types, the release date, the type badge, the
// status cell, and the automatic and interactive searches. An unmonitored
// album reads dimmed.
templ AlbumRowView(a AlbumRow) {
	@table.Row(table.RowProps{
		Class: rowTone(a.Monitored),
		Attributes: templ.Attributes{
			"data-album":     a.Name,
			"data-type":      a.Type,
			"data-monitored": fmt.Sprintf("%t", a.Monitored),
			"data-hasfile":   fmt.Sprintf("%t", a.HasFile),
			"data-quality":   a.Quality,
			"data-phase":     a.Phase,
			"data-status":    a.Status.Kind,
		},
	}) {
		@table.Cell(table.CellProps{Class: "py-1"}) {
			<form hx-post={ a.MonitorURL() } hx-target="closest tr" hx-swap="outerHTML" method="post" action={ templ.URL(a.MonitorURL()) } class="contents">
				<input type="hidden" name="return" value={ a.ReturnURL() }/>
				<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !a.Monitored) }/>
				@bookmarkToggle(a.Monitored, "set-monitored", false)
			</form>
		}
		@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
			<span class="flex flex-wrap items-center gap-2">
				<a
					href={ templ.URL(a.URL()) }
					preload="mouseover"
					class="font-medium hover:underline"
					data-album-title
				>
					{ a.DisplayTitle() }
				</a>
				if a.Disambiguation != "" {
					<span class="text-sm text-muted-foreground" data-album-disambiguation>{ a.Disambiguation }</span>
				}
				for _, st := range a.SecondaryTypes {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "border-sky-500/40 text-sky-300", Attributes: templ.Attributes{"data-secondary-type": st}}) {
						{ st }
					}
				}
			</span>
			@actionFailure(a.Error)
		}
		@table.Cell(table.CellProps{Class: "hidden text-muted-foreground sm:table-cell"}) {
			if a.ReleaseDate != "" {
				<time datetime={ a.ReleaseDate } title={ a.ReleaseDate }>{ a.ReleaseDateLabel }</time>
			}
		}
		@table.Cell(table.CellProps{Class: "hidden md:table-cell"}) {
			if a.TypeLabel() != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"data-album-type": a.Type}}) {
					{ a.TypeLabel() }
				}
			}
		}
		@table.Cell() {
			@statusCell(a.Status)
		}
		@table.Cell(table.CellProps{Class: "py-1"}) {
			<span class="flex justify-end">
				@searchButtons("album", a.SearchURL(), a.InteractiveSearchURL(), a.ReturnURL())
			</span>
		}
	}
}
