package views

import (
	"context"
	"fmt"
	"io"
	"net/url"
	"strings"

	commonv1 "github.com/mediactl/clustarr/api/common/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/empty"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/table"
	"github.com/mediactl/clustarr/ui/components/utils"
	"github.com/mediactl/clustarr/ui/projection"
)

// An item's page follows Radarr's movie page (design 2026-09-24): the
// toolbar, a hero on the item's fanart -- poster, title with its monitored
// bookmark, certification, year, runtime, provider links, the facts row,
// genres, overview -- then, for a movie, its file, its extra files and its
// alternative titles. Everything comes from the metadata the item already
// carries (Detail is filled by the ui package from the Movie, Series,
// Artist or Author and, for a movie, its MediaFile); what the metadata
// does not carry -- ratings, studio, cast, crew -- is not shown.

// Link is one provider page for the item. Provider names the site
// (ProviderIMDb, ProviderTMDB, ProviderTVDB), whose logo the link shows;
// a link naming none shows the external-link icon.
type Link struct {
	Label    string
	Href     string
	Provider string
}

// The providers whose logos ui/static/providers holds (owner, 2026-11-04:
// "The imdb, tvdb, and tmdb links in the series page or movie page should
// be the corresponding icon/logo"; the non-video providers since 2026-11-10,
// design §9.6: Simple Icons' CC0 marks where the brand has one -- MusicBrainz,
// Discogs, Wikipedia, Goodreads, Audible, AniList, MyAnimeList -- else a mark
// drawn here). A mark whose brand colour is black or near-black is drawn in
// currentColor, so it shows on the dark canvas.
const (
	ProviderIMDb        = "imdb"
	ProviderTMDB        = "tmdb"
	ProviderTVDB        = "tvdb"
	ProviderMusicBrainz = "musicbrainz"
	ProviderDiscogs     = "discogs"
	ProviderWikipedia   = "wikipedia"
	ProviderOpenLibrary = "openlibrary"
	ProviderHardcover   = "hardcover"
	ProviderComicVine   = "comicvine"
	ProviderMetron      = "metron"
	ProviderMangaDex    = "mangadex"
	ProviderAniList     = "anilist"
	ProviderMAL         = "myanimelist"
	ProviderAudible     = "audible"
	ProviderAudnexus    = "audnexus"
	ProviderGoodreads   = "goodreads"
)

// Providers lists every provider constant: each has its logo under
// ui/static/providers/<provider>.svg (TestEveryProviderHasItsLogo).
func Providers() []string {
	return []string{
		ProviderIMDb, ProviderTMDB, ProviderTVDB,
		ProviderMusicBrainz, ProviderDiscogs, ProviderWikipedia, ProviderOpenLibrary, ProviderHardcover,
		ProviderComicVine, ProviderMetron, ProviderMangaDex, ProviderAniList, ProviderMAL,
		ProviderAudible, ProviderAudnexus, ProviderGoodreads,
	}
}

// providerLinks are an item's provider pages in its hero's meta line, each
// its provider's logo (the file is /static/providers/<provider>.svg, its
// alt text the link's label), else the external-link icon over the label
// for a screen reader. The title says which page, as "TVDB (series)" does
// on an episode's page beside the episode's own TVDB link.
templ providerLinks(links []Link) {
	for _, l := range links {
		<a href={ templ.URL(l.Href) } target="_blank" rel="noreferrer" title={ l.Label } data-provider-link={ l.Provider } class="inline-flex items-center opacity-90 transition-opacity hover:text-foreground hover:opacity-100 [&_svg]:size-5">
			if l.Provider != "" {
				<img src={ "/static/providers/" + l.Provider + ".svg" } alt={ l.Label } class="h-6 w-auto"/>
			} else {
				@icon.Icon("external-link")()
				<span class="sr-only">{ l.Label }</span>
			}
		</a>
	}
}

// ImageSetNote is the item page's "Images" fact: which image set the
// item's artwork comes from.
type ImageSetNote struct {
	// Label names the set: "MediUX set <title> by <creator>", or
	// "pasted set" for the owner's own; Href links to the set's page when
	// known; Pasted is the owner's own, which wins over a chosen one.
	Label  string
	Href   string
	Pasted bool
}

// FileRow is one row of the Files table: a MediaFile as Radarr lists it,
// or as Lidarr, Readarr or Mylar would (2026-11-10 design §9.6): Kind is
// the file's mediaRef kind, which picks the cells FileCells renders -- the
// video cells for a movie's or an episode's, the audio cells for an album's
// or an audiobook's, format and pages for a book's or an issue's.
type FileRow struct {
	Name string
	// Kind is the MediaFile's spec.mediaRef.kind; "" and the video kinds
	// render the video cells.
	Kind commonv1.MediaKind
	// Path is the file's absolute path (the delete dialog names its folder).
	Path         string
	RelativePath string
	VideoCodec   string
	Audio        string
	SizeBytes    int64
	Languages    []string
	Quality      string
	ReleaseGroup string
	Formats      []string
	Score        int32
	// Markers are the file's skip segments from TheIntroDB, as text.
	Markers string
	// Transcode is the file's status.transcode phase, and its reason when
	// it has one.
	Transcode string
	// The audio cells (an album's track, an audiobook's part): the first
	// audio track's codec, bitrate, sample rate and bit depth (0 for a
	// lossy codec).
	AudioCodec   string
	BitrateKbps  int32
	SampleRateHz int32
	BitDepth     int32
	// The book cells (a book, an issue): the format as the quality ladder
	// names it (EPUB, CBZ), else the file's extension, and the probe's page
	// count (0 when unknown).
	Format string
	Pages  int32
}

// SubtitleRow is one language of a file's status.subtitles.
type SubtitleRow struct {
	LangKey, State, Score, Provider, NextSearch, LastError string
}

// ExtraRow is one extra file beside the media file: a sidecar subtitle.
type ExtraRow struct {
	Path     string
	Kind     string
	Language string
}

// Detail is everything an item's page shows beyond its library card.
type Detail struct {
	Item          projection.LibraryItem
	Backdrop      string
	Certification string
	Runtime       string
	Overview      string
	Genres        []string
	Language      string
	Network       string
	Path          string
	// SharedFolder is the folder of the container the item lives in and
	// leaves standing -- an album's artist's (librarydelete's Target.Keep)
	// -- or "" for a kind with a folder of its own: the delete dialog names
	// a folder only strictly under it (DeleteFolder), since import removes
	// such an item's files alone otherwise.
	SharedFolder string
	Links        []Link
	AltTitles    []string
	// ImageSet is the image set in use: the owner's pasted one, or the one
	// the mediux provider chose (status.imageSet). ImageSetAuto and
	// ImageSetPinned are the item's spec.imageSet (not none) and
	// spec.imageSetID, the Image Set dialog's policy form.
	ImageSet       *ImageSetNote
	ImageSetAuto   bool
	ImageSetPinned string
	// ShowFiles is whether the page has the Files and extra-files
	// sections: a movie's; a series' files live on its seasons.
	ShowFiles bool
	Files     []FileRow
	Extras    []ExtraRow
	// SubtitlesPhase and Subtitles are the file's status.subtitles: its
	// phase, and one row per language.
	SubtitlesPhase string
	Subtitles      []SubtitleRow
	// CanScan is whether "Refresh & Scan" can scan a folder of the item's
	// own: the kinds with a path under a RootFolder.
	CanScan bool
	// Prev and Next are the neighbouring items on the tab, in its order.
	Prev string
	Next string
	// Profiles are the cluster's QualityProfiles, the Edit dialog's choices
	// (editDialog); SeriesType and MinimumAvailability are the item's
	// current spec values for the dialog's other field.
	Profiles            []AddOption
	SeriesType          string
	MinimumAvailability string
	// Audio is a movie's status.audio as a note.
	Audio AudioNote
}

// DetailPath is the item's page.
func DetailPath(li projection.LibraryItem) string { return libraryDetailPath(li) }

// LibraryDetail is a movie's (or any other standalone item's) page.
templ LibraryDetail(d Detail) {
	@Shell(Chrome{Title: d.Item.Title, Crumbs: itemCrumbs(d.Item), Tab: d.Item.Tab}) {
		@itemToolbar(d)
		@hero(d)
		if d.ShowFiles {
			@filesSection(d)
			@extrasSection(d)
			@subtitlesSection(d)
		}
		@titlesSection(d)
		if d.Item.Kind == commonv1.MediaKindMovie {
			<div id="movie-modal"></div>
		}
	}
}

// Action is one button of an item page's action bar, named so a page
// composes its bar from the shared buttons (ItemActions; 2026-11-10 design
// §9.6: "views.actionBar takes the kind's buttons").
type Action string

// The actions a page can ask for, in the bar's usual order. ActionRename
// is the probe-driven naming design's pair, Preview (the dry run) and
// Rename; ActionEdit, ActionImages and ActionDelete open their dialogs.
const (
	ActionRefresh     Action = "refresh"
	ActionSearch      Action = "search"
	ActionInteractive Action = "interactive"
	ActionRename      Action = "rename"
	ActionEdit        Action = "edit"
	ActionImages      Action = "images"
	ActionDelete      Action = "delete"
)

// DefaultActions are the movie, series, artist and author pages' bar: every
// action, in the bar's order. ItemActions renders each only where the item
// takes it.
func DefaultActions(Detail) []Action {
	return []Action{ActionRefresh, ActionSearch, ActionInteractive, ActionRename, ActionEdit, ActionImages, ActionDelete}
}

// InteractiveSearchable reports whether kind has an interactive search of
// its own: a leaf (a movie, an episode, an album, a book, an issue, an
// audiobook) does; a series' is its seasons' and a container's (an
// artist's, an author's, a comic's) its children's, so neither bar shows
// one.
func InteractiveSearchable(kind commonv1.MediaKind) bool {
	return kind != commonv1.MediaKindSeries && !projection.IsContainer(kind)
}

// itemToolbar is the item page's toolbar (actionBar): Radarr's "Refresh &
// Scan" (the metadata refresh plus a scan of the item's own folder, when
// it has one), "Search <kind>", a movie's "Interactive Search"
// (MovieSearchModal, into the page's #movie-modal) and, for an item with
// a folder, the probe-driven naming design's per-item "Rename" (§5): the
// dry run previews the move without touching anything, "Rename" applies
// it, both restricted to the item's own folder (handleRenameItem,
// ui/actions.RenameFiles), then Radarr's Edit (editDialog: monitored,
// quality profile), the Image Set dialog and Delete. Each button reads one
// word -- Refresh, Search, Interactive, Preview, Rename, Edit, Images,
// Delete (owner, 2026-11-04) -- and says the whole action on hover.
// Monitoring is also the bookmark on the title, as in Radarr. It is
// ItemActions over DefaultActions.
templ itemToolbar(d Detail) {
	@ItemActions(d, DefaultActions(d))
}

// ItemActions is an item page's action bar composed by name (2026-11-10
// design §9.6): the bar (actionBar) with the actions asked for, in the
// order asked, each rendered only when the item takes it (itemAction) --
// Refresh always (as "Refresh & Scan" when the item has a folder, d.CanScan,
// else "Refresh"); Search always, worded by the kind (searchLabel);
// Interactive for a kind with an interactive search of its own
// (InteractiveSearchable), posting to the item's search/interactive route
// and opening the kind's modal region, #<kind>-modal, as data-action
// "<kind>-interactive-search"; Rename (the dry run and the apply) only for
// an item with a folder; Edit only for a kind the Edit dialog knows
// (Editable); Images only for a kind with image sets (ImageSettable);
// Delete only for a deletable kind with no delete pending. A page's region
// for the modal is its own to render. The slots are joined with one space
// each, as the bar's buttons always rendered, an empty slot's included.
func ItemActions(d Detail, actions []Action) templ.Component {
	slots := make([]templ.Component, 0, len(actions))
	for _, a := range actions {
		slots = append(slots, itemAction(d, a))
	}
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		return actionBar().Render(templ.WithChildren(ctx, joined(slots)), w)
	})
}

// itemAction is one of the bar's slots: the action's button (and its
// hidden form or its dialog), or nothing when the item does not take it.
templ itemAction(d Detail, a Action) {
	{{ name, here := d.Item.Ref.Name, libraryDetailPath(d.Item) }}
	switch a {
		case ActionRefresh:
			if d.CanScan {
				@actionForm("refresh-"+name, libraryActionURL(d.Item, "refresh"), []Field{{"return", here}, {"scan", "true"}}, "refresh-cw", "Refresh", "Refresh & Scan", "refresh-metadata", nil)
			} else {
				@actionForm("refresh-"+name, libraryActionURL(d.Item, "refresh"), []Field{{"return", here}}, "refresh-cw", "Refresh", "Refresh", "refresh-metadata", nil)
			}
		case ActionSearch:
			@actionForm("search-"+name, libraryActionURL(d.Item, "search"), []Field{{"return", here}}, "search", "Search", searchLabel(d.Item.Kind), "search-now", nil)
		case ActionInteractive:
			if InteractiveSearchable(d.Item.Kind) {
				@actionForm("interactive-search-"+name, libraryActionURL(d.Item, "search/interactive"), nil, "user-search", "Interactive", "Interactive Search", string(d.Item.Kind)+"-interactive-search",
					templ.Attributes{"hx-post": libraryActionURL(d.Item, "search/interactive"), "hx-target": ModalRegion(d.Item.Kind), "hx-swap": "innerHTML"})
			}
		case ActionRename:
			if d.CanScan {
				@actionForm("rename-dry-run-"+name, libraryActionURL(d.Item, "rename"), []Field{{"return", here}, {"rename", "dryRun"}}, "eye", "Preview", "Preview Rename (dry run)", "rename-dry-run", nil)
				@actionForm("rename-"+name, libraryActionURL(d.Item, "rename"), []Field{{"return", here}, {"rename", "apply"}}, "file-symlink", "Rename", "Rename", "rename-apply", nil)
			}
		case ActionEdit:
			if Editable(d) {
				@editDialog(d)
			}
		case ActionImages:
			if ImageSettable(d) {
				@imageSetDialog(d)
			}
		case ActionDelete:
			if deletable(d) && d.Item.DeleteMode == "" {
				@deleteDialog(d)
			}
	}
}

// ModalRegion is the selector of a page's modal region for kind,
// "#<kind>-modal": where the interactive search (ItemActions) and a row's
// details open. The movie page renders #movie-modal, the episode page
// #episode-modal, an author's books #book-modal; a new page renders its
// own.
func ModalRegion(kind commonv1.MediaKind) string {
	return "#" + string(kind) + "-modal"
}

// imageSetSource is the Images fact's data attribute: "pasted" or
// "chosen".
func imageSetSource(n *ImageSetNote) string {
	if n.Pasted {
		return "pasted"
	}
	return "chosen"
}

// kindLabel is the kind as Radarr names it in a button.
// searchLabel is the toolbar's Search button: "Search Movie" on an item,
// and on an author, artist or comic "Search Monitored Books/Albums/Issues",
// since that Search fans out into the container's missing or cutoff-unmet
// items and grabs the best release of each.
func searchLabel(kind commonv1.MediaKind) string {
	switch kind {
	case commonv1.MediaKindAuthor:
		return "Search Monitored Books"
	case commonv1.MediaKindArtist:
		return "Search Monitored Albums"
	case commonv1.MediaKindComic:
		return "Search Monitored Issues"
	default:
		return "Search " + kindLabel(kind)
	}
}

func kindLabel(kind commonv1.MediaKind) string {
	switch kind {
	case commonv1.MediaKindMovie:
		return "Movie"
	case commonv1.MediaKindSeries:
		return "Series"
	case commonv1.MediaKindArtist:
		return "Artist"
	case commonv1.MediaKindAuthor:
		return "Author"
	case commonv1.MediaKindBook:
		return "Book"
	default:
		return strings.ToUpper(string(kind)[:1]) + string(kind)[1:]
	}
}

// hero is Radarr's header: the fanart behind everything, the poster, the
// bookmark and title, the certification, year, runtime and provider links,
// the facts, the genres and the overview. It carries the card's data
// attributes (ruling R8) so the tests key on them, not on copy.
templ hero(d Detail) {
	{{ li := d.Item }}
	<section
		data-hero
		data-ref={ li.Ref.String() }
		data-kind={ string(li.Kind) }
		data-monitored={ fmt.Sprintf("%t", li.Monitored) }
		data-phase={ li.Phase }
		data-hasfile={ fmt.Sprintf("%t", li.HasFile) }
		data-year={ fmt.Sprint(li.Year) }
		data-profile={ li.QualityProfileRef }
		data-poster={ posterState(li.Poster) }
		class="relative -mx-6 mb-8"
	>
		if d.Backdrop != "" {
			<img data-backdrop src={ templ.URL(d.Backdrop) } data-art={ artKeyAs(li, "fanart") } alt="" loading="lazy" class="page-backdrop"/>
			<div class="page-backdrop-shade" aria-hidden="true"></div>
		}
		// The SSE art event for this page's images (artwork design §B.8 as
		// amended 2026-10-07): the page has no stream of its own, so this
		// one carries only its cover's and backdrop's keys; ui/static/art.js
		// swaps them.
		if li.ArtKey != "" {
			<div hidden hx-ext="sse" sse-connect={ artStreamURL(d) } hx-trigger="sse:art"></div>
		}
		<div class="relative flex flex-col gap-6 p-8 md:flex-row md:gap-10">
			<div class="w-40 shrink-0 md:w-56">
				<div class="overflow-hidden rounded-xl shadow-2xl shadow-black/60 ring-1 ring-white/10">
					@poster(li.Poster, li.Title, li.ArtKey)
				</div>
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-start justify-between gap-4">
					<div class="flex min-w-0 items-center gap-3">
						@monitorBookmark(li)
						<h1 class="min-w-0 truncate text-4xl font-bold tracking-tight md:text-5xl">{ li.Title }</h1>
					</div>
					@neighbours(d)
				</div>
				<div class="mt-3 flex flex-wrap items-center gap-3 text-xl text-muted-foreground">
					if d.Certification != "" {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-base"}) {
							{ d.Certification }
						}
					}
					if li.Year > 0 {
						<span>{ fmt.Sprint(li.Year) }</span>
					}
					if d.Runtime != "" {
						<span>{ d.Runtime }</span>
					}
					@providerLinks(d.Links)
				</div>
				<dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4 text-lg">
					if d.Path != "" {
						@fact("path", "Path") {
							<span class="break-all">{ d.Path }</span>
						}
					}
					if d.ImageSet != nil {
						@fact("imageset", "Images") {
							if d.ImageSet.Href != "" {
								<a href={ templ.URL(d.ImageSet.Href) } target="_blank" rel="noreferrer" class="hover:text-foreground" data-imageset-source={ imageSetSource(d.ImageSet) }>{ d.ImageSet.Label }</a>
							} else {
								<span data-imageset-source={ imageSetSource(d.ImageSet) }>{ d.ImageSet.Label }</span>
							}
						}
					}
					@fact("status", "Status") {
						<span class="flex items-center gap-2">
							<span data-status={ projection.LibraryStatus(li) } class={ "inline-block h-5 w-1 rounded-sm " + stripeColour(projection.LibraryStatus(li)) }></span>
							{ statusLabel(li) }
						</span>
						if li.DeleteError != "" {
							@deleteRetry(d)
						}
						if li.DeleteMode != "" {
							@deleteCancel(d)
						}
					}
					if li.QualityProfileRef != "" {
						@fact("profile", "Quality Profile") {
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-sm"}) {
								{ li.QualityProfileRef }
							}
						}
					}
					if size := heroSize(d); size > 0 {
						@fact("size", "Size") {
							{ formatBytes(size) }
						}
					}
					if d.Language != "" {
						@fact("language", "Original Language") {
							{ d.Language }
						}
					}
					if d.Audio.Text != "" {
						@fact("audio", "Audio") {
							@audioBadge(d.Audio)
						}
					}
					if d.Network != "" {
						@fact("network", "Network") {
							{ d.Network }
						}
					}
					if len(d.Genres) > 0 {
						@fact("genres", "Genres") {
							{ strings.Join(d.Genres, ", ") }
						}
					}
				</dl>
				if d.Overview != "" {
					<p data-overview class="mt-6 max-w-5xl text-base leading-relaxed">{ d.Overview }</p>
				}
			</div>
		</div>
	</section>
}

// fact is one labelled value of the hero's facts row.
templ fact(key, label string) {
	<div data-fact={ key }>
		<dt class="text-xs text-muted-foreground">{ label }</dt>
		<dd>
			{ children... }
		</dd>
	</div>
}

// monitorBookmark is Radarr's bookmark beside the title: filled when
// monitored, hollow when not, and the form that flips it.
templ monitorBookmark(li projection.LibraryItem) {
	<form method="post" action={ templ.URL(libraryActionURL(li, "monitor")) } class="contents">
		<input type="hidden" name="return" value={ libraryDetailPath(li) }/>
		<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !li.Monitored) }/>
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIconLg, Attributes: templ.Attributes{"data-action": "set-monitored", "aria-label": bookmarkLabel(li.Monitored), "title": bookmarkLabel(li.Monitored)}}) {
			if li.Monitored {
				<span class="[&_svg]:size-8 [&_svg]:fill-current">
					@icon.Icon("bookmark")()
				</span>
			} else {
				<span class="[&_svg]:size-8">
					@icon.Icon("bookmark")()
				</span>
			}
		}
	</form>
}

// bookmarkLabel is what pressing the bookmark does.
func bookmarkLabel(monitored bool) string {
	if monitored {
		return "Unmonitor"
	}
	return "Monitor"
}

// neighbours are Radarr's previous and next arrows: the items either side
// of this one on its tab.
templ neighbours(d Detail) {
	if d.Prev != "" || d.Next != "" {
		<div class="flex shrink-0 gap-2">
			if d.Prev != "" {
				@button.Button(button.Props{Href: d.Prev, Variant: button.VariantSecondary, Size: button.SizeIcon, Class: "rounded-full", Attributes: templ.Attributes{"data-nav": "prev", "aria-label": "Previous"}}) {
					@icon.Icon("arrow-left")()
				}
			}
			if d.Next != "" {
				@button.Button(button.Props{Href: d.Next, Variant: button.VariantSecondary, Size: button.SizeIcon, Class: "rounded-full", Attributes: templ.Attributes{"data-nav": "next", "aria-label": "Next"}}) {
					@icon.Icon("arrow-right")()
				}
			}
		</div>
	}
}

// statusLabel is Radarr's Status fact: the file's state in words.
func statusLabel(li projection.LibraryItem) string {
	switch projection.LibraryStatus(li) {
	case "deleting":
		if li.DeleteError != "" {
			return "Delete failed: " + li.DeleteError
		}
		return "Deleting"
	case "cutoff-unmet":
		return "Cutoff Unmet"
	case "downloaded":
		if li.Phase == "Transcoded" {
			return "Transcoded"
		}
		return "Downloaded"
	case "downloading":
		return "Downloading"
	case "unmonitored":
		// A series or a container (an artist, an author, a comic;
		// 2026-11-10 design §9.1) with nothing on disk and nothing wanted.
		// A movie keeps Radarr's word for an unmonitored item without a
		// file, Missing.
		if li.Kind == commonv1.MediaKindSeries || projection.IsContainer(li.Kind) {
			return "Unmonitored"
		}
		return "Missing"
	default:
		return "Missing"
	}
}

// totalSize is the size of the item's files together.
func totalSize(files []FileRow) int64 {
	var total int64
	for _, f := range files {
		total += f.SizeBytes
	}
	return total
}

// heroSize is the hero's Size fact: the files the page read, together,
// or, when it read none, the card's size on disk (LibraryItem.SizeBytes,
// the projection's sum over the item's files) -- a container over the
// bound on the files a page reads (ui.containerFiles, 500) still shows
// what its card carries. 0 is no fact.
func heroSize(d Detail) int64 {
	if len(d.Files) > 0 {
		return totalSize(d.Files)
	}
	return d.Item.SizeBytes
}

// sectionTitle is Radarr's ruled section heading.
// emptyState is a page's or a list's empty state, shadcn-templ's empty in
// full (owner, 2026-11-04: "shadcn-templ has an empty component"): an
// icon in its media slot, a title and a line under it; attrs for the
// tests.
templ emptyState(iconName, title, description string, attrs templ.Attributes) {
	@empty.Empty(empty.Props{Class: "py-16", Attributes: attrs}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@icon.Icon(iconName)()
			}
			@empty.Title() {
				{ title }
			}
			if description != "" {
				@empty.Description() {
					{ description }
				}
			}
		}
	}
}

// emptyNote says a section holds nothing: shadcn-templ's empty (owner,
// 2026-11-04) as one muted line, class on the box, attrs for the tests.
templ emptyNote(text, class string, attrs templ.Attributes) {
	@empty.Empty(empty.Props{Class: utils.CN("py-6", class), Attributes: attrs}) {
		@empty.Header() {
			@empty.Description() {
				{ text }
			}
		}
	}
}

templ sectionTitle(title string) {
	<h2 class="mb-3 border-b border-border pb-2 text-2xl font-light">{ title }</h2>
}

// filesSection is Radarr's Files table: the movie's file as import
// froze it (path relative to the movie's folder, quality, languages,
// release group, matched formats and score) and as it was probed (video
// codec, first audio track) -- and, since 2026-11-10 (design §9.6), the
// same table for every kind, its columns the rows' kind's (FileHeads,
// FileCells).
templ filesSection(d Detail) {
	<section data-section="files" class="mb-8">
		@sectionTitle("Files")
		if len(d.Files) == 0 {
			@emptyNote("No file on disk.", "panel rounded-xl border border-border bg-card", nil)
		} else {
			<div class="panel rounded-xl border border-border bg-card">
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@FileHeads(FilesKind(d.Files))
						}
					}
					@table.Body() {
						for _, f := range d.Files {
							@table.Row(table.RowProps{Attributes: templ.Attributes{"data-file": f.Name}}) {
								@FileCells(f)
							}
						}
					}
				}
			</div>
		}
	</section>
}

// extrasSection is Radarr's extra files: the sidecars beside the media
// file, or its "No extra files to manage."
templ extrasSection(d Detail) {
	<section data-section="extras" class="mb-8">
		if len(d.Extras) == 0 {
			@empty.Empty(empty.Props{Class: "panel rounded-xl border border-border bg-card py-6"}) {
				@empty.Header() {
					@empty.Title() {
						{ "No extra files to manage." }
					}
				}
			}
		} else {
			<div class="panel rounded-xl border border-border bg-card">
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								{ "Relative Path" }
							}
							@table.Head() {
								{ "Type" }
							}
							@table.Head() {
								{ "Language" }
							}
						}
					}
					@table.Body() {
						for _, e := range d.Extras {
							@table.Row(table.RowProps{Attributes: templ.Attributes{"data-extra": e.Path}}) {
								@table.Cell(table.CellProps{Class: "break-all whitespace-normal"}) {
									{ e.Path }
								}
								@table.Cell() {
									{ e.Kind }
								}
								@table.Cell() {
									{ e.Language }
								}
							}
						}
					}
				}
			</div>
		}
	</section>
}

// subtitlesSection is the file's status.subtitles: the phase, then one row
// per language (loop spec §6.9). Forcing a search is
// `kubectl annotate mediafile <name> subtitle.clustarr.io/search=$(date +%s)`;
// the ui offers no action for it (§9 D18).
templ subtitlesSection(d Detail) {
	if d.SubtitlesPhase != "" {
		<section data-section="subtitles" class="mb-8">
			@sectionTitle("Subtitles")
			<p class="mb-2 text-sm">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ d.SubtitlesPhase }
				}
			</p>
			if len(d.Subtitles) > 0 {
				<div class="panel rounded-xl border border-border bg-card">
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									{ "Language" }
								}
								@table.Head() {
									{ "State" }
								}
								@table.Head() {
									{ "Score" }
								}
								@table.Head() {
									{ "Provider" }
								}
								@table.Head() {
									{ "Next search" }
								}
								@table.Head() {
									{ "Last error" }
								}
							}
						}
						@table.Body() {
							for _, s := range d.Subtitles {
								@table.Row(table.RowProps{Attributes: templ.Attributes{"data-subtitle": s.LangKey}}) {
									@table.Cell() {
										{ s.LangKey }
									}
									@table.Cell() {
										{ s.State }
									}
									@table.Cell() {
										{ s.Score }
									}
									@table.Cell() {
										{ s.Provider }
									}
									@table.Cell() {
										{ s.NextSearch }
									}
									@table.Cell(table.CellProps{Class: "max-w-md break-words whitespace-normal text-xs text-muted-foreground"}) {
										{ s.LastError }
									}
								}
							}
						}
					}
				</div>
			}
		</section>
	}
}

// titlesSection is Radarr's Titles table: the alternative titles the
// metadata lists, when it lists any.
templ titlesSection(d Detail) {
	if len(d.AltTitles) > 0 {
		<section data-section="titles" class="mb-8">
			@sectionTitle("Titles")
			<div class="panel rounded-xl border border-border bg-card">
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								{ "Alternative Title" }
							}
						}
					}
					@table.Body() {
						for _, title := range d.AltTitles {
							@table.Row() {
								@table.Cell() {
									{ title }
								}
							}
						}
					}
				}
			</div>
		</section>
	}
}

// artKeyAs is li's image key for type t: its poster key, "<kind>/<uid>/poster",
// with the type swapped.
func artKeyAs(li projection.LibraryItem, t string) string {
	i := strings.LastIndex(li.ArtKey, "/")
	if i < 0 {
		return ""
	}
	return li.ArtKey[:i+1] + t
}

// artStreamURL is the item page's GET /events/art: its cover's key, and its
// backdrop's when it shows one.
func artStreamURL(d Detail) string {
	q := url.Values{}
	q.Add("key", d.Item.ArtKey)
	if d.Backdrop != "" {
		q.Add("key", artKeyAs(d.Item, "fanart"))
	}
	return "/events/art?" + q.Encode()
}
