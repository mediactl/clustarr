package views

import (
	"fmt"
	"net/url"

	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/inputgroup"
	"github.com/mediactl/clustarr/ui/components/scrollarea"
	"github.com/mediactl/clustarr/ui/projection"
)

// headerFind is the top bar's search (2026-10-01 as the library tab's
// typeahead, after Sonarr's and Radarr's header search; 2026-10-06 centred
// in the top bar as shadcn's input group): a search box whose dropdown,
// #library-find-results, the find handler fills with the monitored items
// matching what was typed -- the tab's on a library page
// (/library/{tab}/find), the whole library's anywhere else
// (/library/find) -- and whose end addon, #library-find-count, the
// response sets out of band to how many it lists. ui/static/find.js moves
// the highlight with the arrow keys, opens it with Enter and closes the
// dropdown with Escape or a click elsewhere; the dropdown is position:
// fixed, placed under the group by find.js.
templ headerFind(tab projection.Tab) {
	<div class="w-full" data-find>
		@inputgroup.InputGroup(inputgroup.Props{Class: "h-8 bg-muted/40"}) {
			@inputgroup.Input(inputgroup.InputProps{
				Type:        "search",
				Name:        "q",
				Placeholder: "Search " + findScope(tab) + "…",
				Attributes: templ.Attributes{
					"data-find-input": true,
					"aria-label":      "Search " + findScope(tab),
					"autocomplete":    "off",
					"role":            "combobox",
					"aria-controls":   "library-find-results",
					"aria-expanded":   "false",
					"hx-get":          findPath(tab),
					"hx-trigger":      "input changed delay:150ms, search",
					"hx-target":       "#library-find-results",
					"hx-sync":         "this:replace",
				},
			})
			@inputgroup.Addon() {
				@icon.Icon("search")()
			}
			@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
				<span id="library-find-count" class="text-xs tabular-nums empty:hidden" aria-live="polite"></span>
			}
		}
		<div
			id="library-find-results"
			role="listbox"
			class="fixed z-50 empty:hidden overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-md"
		></div>
	</div>
}

// findPath is where headerFind asks: the tab's find, or the library's.
func findPath(tab projection.Tab) string {
	if tab == "" {
		return "/library/find"
	}
	return "/library/" + string(tab) + "/find"
}

// findScope is what headerFind searches, for its placeholder.
func findScope(tab projection.Tab) string {
	if tab == "" {
		return "library"
	}
	return tabLabel(tab)
}

// findCount is the input group's end addon, swapped in out of band with
// each dropdown: how many matches it lists.
templ findCount(n int) {
	<span id="library-find-count" hx-swap-oob="true" class="text-xs tabular-nums empty:hidden" aria-live="polite">
		if n == 1 {
			1 result
		} else {
			{ fmt.Sprintf("%d results", n) }
		}
	</span>
}

// LibraryFindResults is the dropdown: one link per match, best first, each
// with its poster, title and year -- or, when nothing matches, a line
// saying so and a link to Add New with the text already typed (one per
// tab when the whole library was searched) -- plus the count, out of band.
templ LibraryFindResults(tab projection.Tab, q string, items []projection.LibraryItem) {
	@findCount(len(items))
	if len(items) == 0 {
		<div class="space-y-2 p-3 text-sm" data-find-empty>
			<p class="text-muted-foreground">No monitored { findNoun(tab) } match “{ q }”.</p>
			if tab == "" {
				<p class="flex flex-wrap gap-x-3">
					for _, t := range projection.Tabs() {
						<a
							class="font-medium underline underline-offset-4"
							data-action="find-add-new"
							href={ templ.SafeURL("/library/" + string(t) + "/add?q=" + url.QueryEscape(q)) }
						>Add a new { addLabel(t) }</a>
					}
				</p>
			} else {
				<a
					class="font-medium underline underline-offset-4"
					data-action="find-add-new"
					href={ templ.SafeURL("/library/" + string(tab) + "/add?q=" + url.QueryEscape(q)) }
				>Add a new { addLabel(tab) }</a>
			}
		</div>
	} else {
		// The list scrolls in shadcn's scroll area, its viewport capped at
		// 24rem, so a long dropdown keeps the theme's thin scrollbar.
		@scrollarea.ScrollArea(scrollarea.Props{Class: "[&>[data-slot=scroll-area-viewport]]:max-h-96"}) {
			<ul class="py-1">
				for _, li := range items {
					<li>
						<a
							href={ templ.SafeURL(libraryDetailPath(li)) }
							role="option"
							data-find-ref={ li.Ref.String() }
							class="flex items-center gap-3 px-3 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground data-[find-active]:bg-accent data-[find-active]:text-accent-foreground"
						>
							<span class="relative h-12 w-8 shrink-0 overflow-hidden rounded-sm bg-muted">
								if li.Poster != "" {
									<img src={ templ.URL(li.Poster) } alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover"/>
								}
							</span>
							<span class="min-w-0 flex-1 truncate">{ li.Title }</span>
							if li.Year > 0 {
								<span class="shrink-0 text-muted-foreground">{ fmt.Sprint(li.Year) }</span>
							}
						</a>
					</li>
				}
			</ul>
		}
	}
}

// findNoun is what the tab's items are called in the dropdown's empty
// state: "No monitored series match …".
func findNoun(tab projection.Tab) string {
	switch tab {
	case projection.TabTV:
		return "series"
	case projection.TabMusic:
		return "artists"
	case projection.TabBooks:
		return "authors"
	case "":
		return "titles"
	}
	return "movies"
}
