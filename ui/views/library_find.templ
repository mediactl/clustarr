package views

import (
	"fmt"
	"net/url"

	"github.com/mediactl/clustarr/ui/components/input"
	"github.com/mediactl/clustarr/ui/projection"
)

// libraryFind is the tab's typeahead (2026-10-01, after Sonarr's and
// Radarr's header search): a search box whose dropdown,
// #library-find-results, the handler at /library/{tab}/find fills with the
// tab's monitored items matching what was typed. ui/static/find.js moves
// the highlight with the arrow keys, opens it with Enter and closes the
// dropdown with Escape or a click elsewhere. It sits between the toolbar's
// two button groups; the dropdown is position: fixed, placed under the box
// by find.js, because the toolbar is a fixed-height strip that scrolls
// sideways (overflow-x: auto clips vertically too) and would cut it off.
templ libraryFind(tab projection.Tab) {
	<div class="flex min-w-48 max-w-sm flex-1 items-center px-2" data-find>
		@input.Input(input.Props{
			Type:        "search",
			Name:        "q",
			Placeholder: "Search " + tabLabel(tab) + "…",
			Class:       "h-8",
			Attributes: templ.Attributes{
				"data-find-input": true,
				"aria-label":      "Search " + tabLabel(tab),
				"autocomplete":    "off",
				"role":            "combobox",
				"aria-controls":   "library-find-results",
				"aria-expanded":   "false",
				"hx-get":          "/library/" + string(tab) + "/find",
				"hx-trigger":      "input changed delay:150ms, search",
				"hx-target":       "#library-find-results",
				"hx-sync":         "this:replace",
			},
		})
		<div
			id="library-find-results"
			role="listbox"
			class="fixed z-50 empty:hidden overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-md"
		></div>
	</div>
}

// LibraryFindResults is the dropdown: one link per match, best first, each
// with its poster, title and year -- or, when nothing matches, a line
// saying so and a link to Add New with the text already typed.
templ LibraryFindResults(tab projection.Tab, q string, items []projection.LibraryItem) {
	if len(items) == 0 {
		<div class="space-y-2 p-3 text-sm" data-find-empty>
			<p class="text-muted-foreground">No monitored { findNoun(tab) } match “{ q }”.</p>
			<a
				class="font-medium underline underline-offset-4"
				data-action="find-add-new"
				href={ templ.SafeURL("/library/" + string(tab) + "/add?q=" + url.QueryEscape(q)) }
			>Add a new { addLabel(tab) }</a>
		</div>
	} else {
		<ul class="max-h-96 overflow-y-auto py-1">
			for _, li := range items {
				<li>
					<a
						href={ templ.SafeURL(libraryDetailPath(li)) }
						role="option"
						data-find-ref={ li.Ref.String() }
						class="flex items-center gap-3 px-3 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground data-[find-active]:bg-accent data-[find-active]:text-accent-foreground"
					>
						<span class="relative h-12 w-8 shrink-0 overflow-hidden rounded-sm bg-muted">
							if li.Poster != "" {
								<img src={ templ.URL(li.Poster) } alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover"/>
							}
						</span>
						<span class="min-w-0 flex-1 truncate">{ li.Title }</span>
						if li.Year > 0 {
							<span class="shrink-0 text-muted-foreground">{ fmt.Sprint(li.Year) }</span>
						}
					</a>
				</li>
			}
		</ul>
	}
}

// findNoun is what the tab's items are called in the dropdown's empty
// state: "No monitored series match …".
func findNoun(tab projection.Tab) string {
	switch tab {
	case projection.TabTV:
		return "series"
	case projection.TabMusic:
		return "artists"
	case projection.TabBooks:
		return "authors"
	}
	return "movies"
}
