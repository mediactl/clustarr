package views

import (
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/field"
	"github.com/mediactl/clustarr/ui/components/input"
	selectcomp "github.com/mediactl/clustarr/ui/components/select"
	"github.com/mediactl/clustarr/ui/components/separator"
	"github.com/mediactl/clustarr/ui/components/textarea"
	"github.com/mediactl/clustarr/ui/forms"
)

// FormPage is one settings form page (settings CRUD design, 2026-09-24):
// the render tree ui/forms built for the kind, the object's coordinates,
// where the form posts and, after a rejected submission, what went wrong.
type FormPage struct {
	Form      *forms.Form
	Namespace string
	Name      string
	// Action is where the form posts; DeleteAction, on an edit, where the
	// delete form posts.
	Action       string
	DeleteAction string
	// ErrorCode and Error come back with a rejected submission.
	ErrorCode string
	Error     string
	// ReturnTo is where Save, Cancel and Delete go when done: the page the
	// form was opened from (the Import Lists page sets it), or the
	// Settings page.
	ReturnTo string
}

// returnTo is ReturnTo with its default applied.
func (p FormPage) returnTo() string {
	if p.ReturnTo != "" {
		return p.ReturnTo
	}
	return settingsReturnPath
}

func (p FormPage) title() string {
	if p.Form.Mode == forms.ModeNew {
		return "New " + p.Form.Kind.Singular
	}
	return "Edit " + p.Form.Kind.Singular
}

// SettingsForm renders a kind's form (2026-09-29: shadcn-templ's
// components on the theme's tokens throughout): the object's name and
// namespace, then the overlay's sections, each a Card whose content is a
// FieldGroup of Fields. A section with a When renders data-show-when, a row
// list its rows and a template, a Secret entry a password input that is
// never filled in: ui/static/settings.js does the showing, adding, removing
// and confirming, and holds a required select component to the browser's
// own required check.
templ SettingsForm(p FormPage) {
	@Layout("Settings") {
		<div class="mb-6 max-w-4xl space-y-1">
			<h1 class="text-2xl font-semibold tracking-tight">{ p.title() }</h1>
			if p.Form.Kind.Help != "" {
				<p class="text-sm text-muted-foreground">{ p.Form.Kind.Help }</p>
			}
		</div>
		if p.Error != "" {
			<div class="mb-6 max-w-4xl">
				@ActionError(p.ErrorCode, p.Error)
			</div>
		}
		<form method="post" action={ templ.URL(p.Action) } data-settings-form class="max-w-4xl space-y-6">
			<input type="hidden" name="return" value={ p.returnTo() }/>
			@card.Card(card.Props{Attributes: templ.Attributes{"data-section": "Object"}}) {
				@card.Header() {
					@card.Title() {
						{ strings.ToUpper(p.Form.Kind.Singular[:1]) + p.Form.Kind.Singular[1:] }
					}
				}
				@card.Content() {
					@field.Group(field.GroupProps{Class: "grid gap-4 sm:grid-cols-2"}) {
						@field.Field(field.Props{Attributes: templ.Attributes{"data-field": true}}) {
							@field.Label(field.LabelProps{For: "__name"}) {
								Name
							}
							@input.Input(input.Props{ID: "__name", Name: "__name", Value: p.Name, Required: true, ReadOnly: p.Form.Mode == forms.ModeEdit, Placeholder: "a-dns-1123-name"})
							@field.Description() {
								Lower-case letters, digits, dots and dashes. Cannot change once created.
							}
						}
						if p.Form.Kind.Namespaced {
							@field.Field(field.Props{Attributes: templ.Attributes{"data-field": true}}) {
								@field.Label(field.LabelProps{For: "__namespace"}) {
									Namespace
								}
								@input.Input(input.Props{ID: "__namespace", Name: "__namespace", Value: p.Namespace, Required: true, ReadOnly: p.Form.Mode == forms.ModeEdit})
							}
						}
					}
				}
			}
			for _, s := range p.Form.Sections {
				@formSection(s)
			}
			<div class="flex items-center gap-3">
				@button.Button(button.Props{Type: "submit"}) {
					Save
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Href: p.returnTo()}) {
					Cancel
				}
			</div>
		</form>
		if p.DeleteAction != "" {
			<div class="mt-8 max-w-4xl space-y-6">
				@separator.Separator()
				<form method="post" action={ templ.URL(p.DeleteAction) } data-confirm={ fmt.Sprintf("Delete %s %q? This cannot be undone.", p.Form.Kind.Singular, p.Name) }>
					<input type="hidden" name="return" value={ p.returnTo() }/>
					@button.Button(button.Props{Type: "submit", Variant: button.VariantDestructive}) {
						Delete this { p.Form.Kind.Singular }
					}
				</form>
			</div>
		}
	}
}

// whenAttr renders a When as "path=v1|v2", what settings.js reads.
func whenAttr(w *forms.When) string {
	if w == nil {
		return ""
	}
	return w.Path + "=" + strings.Join(w.Values, "|")
}

// sectionAttrs are a section card's hooks: its title, its condition and
// whether it is advanced.
func sectionAttrs(s forms.Section) templ.Attributes {
	a := templ.Attributes{"data-section": s.Title}
	if s.When != nil {
		a["data-show-when"] = whenAttr(s.When)
	}
	if s.Advanced {
		a["data-advanced"] = true
	}
	return a
}

templ formSection(s forms.Section) {
	@card.Card(card.Props{Attributes: sectionAttrs(s)}) {
		@card.Header() {
			@card.Title() {
				{ s.Title }
			}
			if s.Help != "" {
				@card.Description() {
					{ s.Help }
				}
			}
		}
		@card.Content() {
			@field.Group(field.GroupProps{Class: "grid gap-4 sm:grid-cols-2"}) {
				for _, c := range s.Controls {
					@formControl(c)
				}
			}
		}
	}
}

// fieldAttrs are a Field's hooks: data-field, and its own condition (a
// Secret entry shown for some provider types).
func fieldAttrs(w *forms.When) templ.Attributes {
	a := templ.Attributes{"data-field": true}
	if w != nil {
		a["data-show-when"] = whenAttr(w)
	}
	return a
}

// numberAttrs are a number input's bounds and step.
func numberAttrs(c forms.Control) templ.Attributes {
	a := templ.Attributes{}
	if c.Min != nil {
		a["min"] = number(*c.Min)
	}
	if c.Max != nil {
		a["max"] = number(*c.Max)
	}
	if c.Step != "" {
		a["step"] = c.Step
	}
	return a
}

// formControl renders one control by its type.
templ formControl(c forms.Control) {
	switch c.Type {
		case forms.ControlRows:
			@rowsControl(c)
		case forms.ControlMap:
			@mapControl(c)
		case forms.ControlLines:
			@field.Field(field.Props{Class: "sm:col-span-2", Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@textarea.Textarea(textarea.Props{ID: controlID(c.Name), Name: c.Name, Value: strings.Join(c.Lines, "\n"), Rows: 3, Placeholder: "one per line"})
				@fieldHelp(c)
			}
		case forms.ControlCheckbox:
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "sm:pt-6", Attributes: fieldAttrs(c.When)}) {
				<input type="hidden" name={ c.Name } value="false"/>
				@checkbox.Checkbox(checkbox.Props{ID: controlID(c.Name), Name: c.Name, Value: "true", Checked: &c.Checked, Disabled: c.ReadOnly})
				@field.Content() {
					@field.Label(field.LabelProps{For: controlID(c.Name)}) {
						{ c.Label }
					}
					@fieldHelp(c)
				}
			}
		case forms.ControlSelect:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				// the label names the trigger, the component's focusable part
				@fieldLabel(c, controlID(c.Name)+"-trigger")
				@selectControl(c)
				@fieldHelp(c)
			}
		case forms.ControlPassword:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				// Never required in the browser: on an edit a blank entry means
				// "keep the stored one", and a missing entry is the consumer's
				// DependencyNotReady to report.
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Type: "password", Placeholder: "unchanged", Attributes: templ.Attributes{"autocomplete": "new-password"}})
				@fieldHelp(c)
			}
		case forms.ControlNumber:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Type: "number", Value: c.Value, Placeholder: c.Placeholder, Required: c.Required, ReadOnly: c.ReadOnly, Attributes: numberAttrs(c)})
				@fieldHelp(c)
			}
		default:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Value: c.Value, Placeholder: c.Placeholder, Required: c.Required, ReadOnly: c.ReadOnly})
				@fieldHelp(c)
			}
	}
}

// selectControl is a choice as shadcn-templ's select component: its hidden
// input posts the value under the control's name, and its change event is
// what settings.js re-reads the conditions on. A read-only (immutable)
// choice is the component's ReadOnly, so its input is readonly and still
// posts, with the trigger itself disabled: the component renders a bare
// aria-readonly its script reads as not read-only, and a Disabled root
// would disable the input too, which then posts nothing.
// An option with the empty value is the "unset" choice of an optional
// field.
templ selectControl(c forms.Control) {
	@selectcomp.Select(selectcomp.Props{ID: controlID(c.Name), Name: c.Name, DefaultValue: c.Value, Required: c.Required && !c.ReadOnly, ReadOnly: c.ReadOnly}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full", Attributes: readOnlyTrigger(c.ReadOnly)}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: "—"})
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				for _, o := range c.Options {
					@selectcomp.Item(selectcomp.ItemProps{Value: o.Value}) {
						{ o.Label }
					}
				}
			}
		}
	}
}

// readOnlyTrigger disables a read-only select's trigger, so it cannot open.
func readOnlyTrigger(readOnly bool) templ.Attributes {
	if !readOnly {
		return nil
	}
	return templ.Attributes{"disabled": true, "data-disabled": true}
}

templ fieldLabel(c forms.Control, target string) {
	@field.Label(field.LabelProps{For: target}) {
		{ c.Label }
		if c.Required {
			<span class="text-destructive" aria-hidden="true">*</span>
		}
	}
}

templ fieldHelp(c forms.Control) {
	if c.Help != "" {
		@field.Description() {
			{ c.Help }
		}
	}
}

// rowsControl renders an array of objects: a row per element, each with
// the item's controls and a Remove button, and a template for Add.
templ rowsControl(c forms.Control) {
	@field.Set(field.SetProps{Class: "gap-3 sm:col-span-2", Attributes: rowsAttrs("data-rows", c)}) {
		<div class="flex items-start justify-between gap-4">
			@field.Content() {
				@field.Title() {
					{ c.Label }
				}
				@fieldHelp(c)
			}
			@button.Button(button.Props{Type: "button", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-add-row": true}}) {
				Add
			}
		</div>
		<div data-rows-list class="space-y-3">
			for _, row := range c.Rows {
				@formRow(row.Controls)
			}
		</div>
		<template data-row-template>
			@formRow(c.Template)
		</template>
	}
}

// rowsAttrs are a row list's hooks: which list (data-rows or data-map)
// and its condition.
func rowsAttrs(hook string, c forms.Control) templ.Attributes {
	a := templ.Attributes{hook: c.Name}
	if c.When != nil {
		a["data-show-when"] = whenAttr(c.When)
	}
	return a
}

templ formRow(controls []forms.Control) {
	@card.Card(card.Props{Size: card.SizeSm, Class: "bg-muted/30", Attributes: templ.Attributes{"data-row": true}}) {
		@card.Content() {
			@field.Group(field.GroupProps{Class: "grid gap-3 sm:grid-cols-3"}) {
				for _, rc := range controls {
					@formControl(rc)
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "justify-end"}) {
			@button.Button(button.Props{Type: "button", Size: button.SizeXs, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-remove-row": true}}) {
				Remove
			}
		}
	}
}

// mapControl renders a string map as key/value rows.
templ mapControl(c forms.Control) {
	@field.Set(field.SetProps{Class: "gap-2 sm:col-span-2", Attributes: rowsAttrs("data-map", c)}) {
		<div class="flex items-start justify-between gap-4">
			@field.Content() {
				@field.Title() {
					{ c.Label }
				}
				@fieldHelp(c)
			}
			@button.Button(button.Props{Type: "button", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-add-row": true}}) {
				Add
			}
		</div>
		<div data-rows-list class="space-y-2">
			for i, pair := range c.Pairs {
				@mapRow(c.Name, fmt.Sprint(i), pair)
			}
		</div>
		<template data-row-template>
			@mapRow(c.Name, "__i__", forms.Pair{})
		</template>
	}
}

templ mapRow(name, index string, pair forms.Pair) {
	<div data-row class="flex items-center gap-2">
		@input.Input(input.Props{Name: name + ".__k." + index, Value: pair.Key, Placeholder: "key", Class: "w-1/3", Attributes: templ.Attributes{"aria-label": "Key"}})
		@input.Input(input.Props{Name: name + ".__v." + index, Value: pair.Value, Placeholder: "value", Attributes: templ.Attributes{"aria-label": "Value"}})
		@button.Button(button.Props{Type: "button", Size: button.SizeXs, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-remove-row": true}}) {
			Remove
		}
	</div>
}

// controlID makes an input's id from its name; "__i__" stays so a cloned
// row gets a fresh one.
func controlID(name string) string {
	return "f-" + strings.NewReplacer(".", "-", "[", "-", "]", "-").Replace(name)
}

func number(f float64) string {
	return fmt.Sprintf("%v", f)
}

// configActions is the Edit link and Delete form on a Settings-page card,
// for its footer. namespace is "-" for a cluster-scoped kind, the form
// routes' placeholder.
templ configActions(slug, namespace, name string) {
	@configActionsTo(slug, namespace, name, settingsReturnPath)
}

// configActionsTo is configActions for a card on another page (the Import
// Lists page, 2026-09-24): the edit form and the delete both return to
// returnTo instead of the Settings page. It renders as the card's footer.
templ configActionsTo(slug, namespace, name, returnTo string) {
	{{ ns := namespace }}
	if ns == "" {
		{{ ns = "-" }}
	}
	{{ edit := fmt.Sprintf("/settings/edit/%s/%s/%s", slug, ns, name) }}
	if returnTo != settingsReturnPath {
		{{ edit += "?return=" + returnTo }}
	}
	@card.Footer(card.FooterProps{Class: "gap-2 border-t"}) {
		@button.Button(button.Props{Href: edit, Size: button.SizeXs, Variant: button.VariantOutline}) {
			Edit
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/settings/delete/%s/%s/%s", slug, ns, name)) } data-confirm={ fmt.Sprintf("Delete %q? This cannot be undone.", name) }>
			<input type="hidden" name="return" value={ returnTo }/>
			@button.Button(button.Props{Type: "submit", Size: button.SizeXs, Variant: button.VariantGhost, Class: "text-destructive"}) {
				Delete
			}
		</form>
	}
}
