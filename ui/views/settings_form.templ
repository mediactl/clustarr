package views

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/mediactl/clustarr/ui/components/alertdialog"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/collapsible"
	"github.com/mediactl/clustarr/ui/components/field"
	"github.com/mediactl/clustarr/ui/components/input"
	selectcomp "github.com/mediactl/clustarr/ui/components/select"
	"github.com/mediactl/clustarr/ui/components/textarea"
	"github.com/mediactl/clustarr/ui/forms"
)

// FormPage is one settings form page (settings CRUD design, 2026-09-24):
// the render tree ui/forms built for the kind, the object's coordinates,
// where the form posts and, after a rejected submission, what went wrong.
type FormPage struct {
	Form      *forms.Form
	Namespace string
	Name      string
	// Action is where the form posts; DeleteAction, on an edit, where the
	// delete form posts.
	Action       string
	DeleteAction string
	// ErrorCode and Error come back with a rejected submission.
	ErrorCode string
	Error     string
	// ReturnTo is where Save, Cancel and Delete go when done: the page the
	// form was opened from (the Import Lists page sets it), or the
	// Settings page.
	ReturnTo string
}

// returnTo is ReturnTo with its default applied.
func (p FormPage) returnTo() string {
	if p.ReturnTo != "" {
		return p.ReturnTo
	}
	return settingsReturnPath
}

// deleteAttrs post the object's delete from the dialog's footer.
func (p FormPage) deleteAttrs() templ.Attributes {
	vals, _ := json.Marshal(map[string]string{"return": p.returnTo()})
	out := confirmAttrs(fmt.Sprintf("Delete %s %q?", p.Form.Kind.Singular, p.Name), "This cannot be undone.", "Delete")
	out["hx-post"] = p.DeleteAction
	out["hx-vals"] = string(vals)
	out["hx-target"] = "#action-status"
	out["hx-swap"] = "innerHTML"
	out["data-action"] = "delete"
	return out
}

func (p FormPage) title() string {
	if p.Form.Mode == forms.ModeNew {
		return "New " + p.Form.Kind.Singular
	}
	return "Edit " + p.Form.Kind.Singular + " " + p.Name
}

// SettingsDialog is a kind's form in the modal region (owner, 2026-11-17:
// "Modifying or adding configuration from the settings page should be done
// within a modal"; until then a page of its own). The form (2026-09-29: shadcn-templ's
// components on the theme's tokens throughout): the object's name and
// namespace, then the overlay's sections, each a Card whose content is a
// FieldGroup of Fields. Since 2026-11-16 (owner: "Consider making each
// section an accordion area to simplify the page") each section is a
// collapsible, any number open at once: an Advanced section starts closed,
// every other open. A section, a field or one option of a
// choice with a When renders data-show-when (data-option-when for an
// option), a row list its rows and a template, a Secret entry a password
// input that is never filled in: ui/static/settings.js does the showing,
// adding, removing and confirming, holds a required select component to the
// browser's own required check, and opens a closed section that holds the
// input a submit was refused for.
templ SettingsDialog(p FormPage) {
	@FormDialog(FormDialogProps{
		Title:       p.title(),
		Description: p.Form.Kind.Help,
		Size:        FormDialogLg,
		FormID:      "config-form",
		Guard:       true,
		SubmitAttrs: templ.Attributes{"data-action": "save"},
		Extra:       configExtra(p),
		Attributes:  templ.Attributes{"data-config-dialog": p.Form.Kind.Slug},
	}) {
		@SettingsDialogForm(p)
	}
}

// SettingsDialogForm is the form itself, and all a rejected save answers:
// the form replaces itself inside the open dialog, its values the
// person's, the reason first.
templ SettingsDialogForm(p FormPage) {
	<form
		id="config-form"
		data-modal-form
		data-settings-form
		method="post"
		action={ templ.URL(p.Action) }
		hx-post={ p.Action }
		hx-target="#config-form"
		hx-swap="outerHTML"
		hx-disabled-elt="[form='config-form']"
		class="flex flex-col gap-4"
	>
		<input type="hidden" name="return" value={ p.returnTo() }/>
		if p.Error != "" {
			@FormError(p.ErrorCode, p.Error)
		}
		@card.Card(card.Props{Attributes: templ.Attributes{"data-section": "Object"}}) {
			@card.Header() {
				@card.Title() {
					{ strings.ToUpper(p.Form.Kind.Singular[:1]) + p.Form.Kind.Singular[1:] }
				}
			}
			@card.Content() {
				@field.Group(field.GroupProps{Class: "grid gap-4 @xl/modal:grid-cols-2"}) {
					@field.Field(field.Props{Attributes: templ.Attributes{"data-field": true}}) {
						@field.Label(field.LabelProps{For: "__name"}) {
							Name
						}
						@input.Input(input.Props{ID: "__name", Name: "__name", Value: p.Name, Required: true, ReadOnly: p.Form.Mode == forms.ModeEdit, Placeholder: "a-dns-1123-name"})
						@field.Description() {
							Lower-case letters, digits, dots and dashes. Cannot change once created.
						}
					}
					if p.Form.Kind.Namespaced {
						@field.Field(field.Props{Attributes: templ.Attributes{"data-field": true}}) {
							@field.Label(field.LabelProps{For: "__namespace"}) {
								Namespace
							}
							@input.Input(input.Props{ID: "__namespace", Name: "__namespace", Value: p.Namespace, Required: true, ReadOnly: p.Form.Mode == forms.ModeEdit})
						}
					}
				}
			}
		}
		for _, s := range p.Form.Sections {
			@formSection(s)
		}
	</form>
}

// SettingsFormPage is the form on a page of its own: what a plain form
// post (no script) that was rejected is answered with, the failure's
// status beside it. With script the form never leaves its dialog.
templ SettingsFormPage(p FormPage) {
	@Shell(Chrome{Title: p.title(), Nav: "/settings", Crumbs: []Crumb{{Label: "Settings", Href: "/settings"}, {Label: p.title()}}}) {
		<div class="mx-auto max-w-4xl space-y-6">
			<h1 class="text-2xl font-semibold tracking-tight">{ p.title() }</h1>
			@SettingsDialogForm(p)
			<div class="flex items-center gap-3">
				@button.Button(button.Props{Type: button.TypeSubmit, Form: "config-form"}) {
					Save
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Href: p.returnTo()}) {
					Cancel
				}
			</div>
		</div>
	}
}

// configExtra is the dialog footer's leading action on an edit: Delete,
// asked through the layout's confirm, answered as a save is (the dialog
// closes, a toast, the host page redrawn).
templ configExtra(p FormPage) {
	if p.DeleteAction != "" {
		@button.Button(button.Props{
			Type:       button.TypeButton,
			Variant:    button.VariantGhost,
			Class:      "text-destructive",
			Attributes: p.deleteAttrs(),
		}) {
			Delete
		}
	}
}

// deleteConfirm is a delete's question (shadcn-templ's alert dialog,
// since 2026-11-04; settings.js's window.confirm on data-confirm before):
// the form posting to action, with return, whose Delete sits in the
// dialog's footer beside Cancel. The trigger is the caller's.
templ deleteConfirm(action, returnTo, title string) {
	@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
		@alertdialog.Header() {
			@alertdialog.Title() {
				{ title }
			}
			@alertdialog.Description() {
				This cannot be undone.
			}
		}
		<form method="post" action={ templ.URL(action) } data-delete-form>
			<input type="hidden" name="return" value={ returnTo }/>
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel 
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-action": "delete-confirm"}}) {
					Delete
				}
			}
		</form>
	}
}

// whenAttr renders a When as settings.js reads it ("path=v1|v2", clauses
// joined by "&").
func whenAttr(w *forms.When) string {
	return w.Attr()
}

// dynamicAttrs make a Dynamic section's content fetch itself again while
// the field it watches changes: an htmx GET of the section's URL with the
// fields it includes, swapped in for the content.
func dynamicAttrs(d *forms.Dynamic) templ.Attributes {
	if d == nil {
		return nil
	}
	include := make([]string, 0, len(d.Include))
	for _, n := range d.Include {
		include = append(include, "[name='"+n+"']")
	}
	return templ.Attributes{
		"data-dynamic": d.Watch,
		"hx-get":       d.URL,
		"hx-trigger":   "change from:[name='" + d.Watch + "']",
		"hx-include":   strings.Join(include, ","),
		"hx-swap":      "innerHTML",
	}
}

// sectionAttrs are a section card's hooks: its title, its condition and
// whether it is advanced.
func sectionAttrs(s forms.Section) templ.Attributes {
	a := templ.Attributes{"data-section": s.Title}
	if s.When != nil {
		a["data-show-when"] = whenAttr(s.When)
	}
	if s.Advanced {
		a["data-advanced"] = true
	}
	return a
}

// formSection is one accordion area: a Card that is a collapsible, its
// header shadcn's own (the title, the help as its description, the chevron
// in the action slot) and its content the panel. The title and the chevron
// both toggle it.
templ formSection(s forms.Section) {
	@card.Card(card.Props{Attributes: sectionAttrs(s)}) {
		@collapsible.Collapsible(collapsible.Props{DefaultOpen: !s.Advanced, Class: "flex flex-col gap-(--card-spacing)"}) {
			@card.Header() {
				@card.Title() {
					@sectionTitleTrigger() {
						{ s.Title }
					}
				}
				if s.Help != "" {
					@card.Description() {
						{ s.Help }
					}
				}
				@card.Action() {
					@sectionChevron(s.Title)
				}
			}
			@collapsible.Content() {
				@card.Content() {
					@field.Group(field.GroupProps{Class: "grid gap-4 @xl/modal:grid-cols-2", Attributes: dynamicAttrs(s.Dynamic)}) {
						@FormControls(s.Controls)
					}
				}
			}
		}
	}
}

// FormControls renders controls in a section's grid: a section's content,
// and what a Dynamic section's URL answers with.
templ FormControls(controls []forms.Control) {
	for _, c := range controls {
		@formControl(c)
	}
}

// fieldAttrs are a Field's hooks: data-field, and its own condition (a
// Secret entry shown for some provider types, a field one choice makes
// meaningless).
func fieldAttrs(w *forms.When) templ.Attributes {
	a := templ.Attributes{"data-field": true}
	if w != nil {
		a["data-show-when"] = whenAttr(w)
	}
	return a
}

// optionAttrs are an option's condition, nil without one.
func optionAttrs(w *forms.When) templ.Attributes {
	if w == nil {
		return nil
	}
	return templ.Attributes{"data-option-when": whenAttr(w)}
}

// wide spans a control across its section's columns.
func wide(c forms.Control) string {
	if c.Wide {
		return "@xl/modal:col-span-2"
	}
	return ""
}

// hiddenAttrs are a hidden control's hooks: the input it fills, if any.
func hiddenAttrs(c forms.Control) templ.Attributes {
	if c.Fill == "" {
		return nil
	}
	return templ.Attributes{"data-fill": c.Fill}
}

func hasValue(values []string, v string) bool {
	for _, x := range values {
		if x == v {
			return true
		}
	}
	return false
}

// numberAttrs are a number input's bounds and step.
func numberAttrs(c forms.Control) templ.Attributes {
	a := templ.Attributes{}
	if c.Min != nil {
		a["min"] = number(*c.Min)
	}
	if c.Max != nil {
		a["max"] = number(*c.Max)
	}
	if c.Step != "" {
		a["step"] = c.Step
	}
	return a
}

// formControl renders one control by its type.
templ formControl(c forms.Control) {
	switch c.Type {
		case forms.ControlRows:
			@rowsControl(c)
		case forms.ControlMap:
			@mapControl(c)
		case forms.ControlHidden:
			<input type="hidden" name={ c.Name } value={ c.Value } { hiddenAttrs(c)... }/>
		case forms.ControlNote:
			@field.Field(field.Props{Class: "@xl/modal:col-span-2 gap-1", Attributes: fieldAttrs(c.When)}) {
				if c.Label != "" {
					@field.Title() {
						{ c.Label }
					}
				}
				@fieldHelp(c)
			}
		case forms.ControlChecks:
			@checksControl(c)
		case forms.ControlLines:
			@field.Field(field.Props{Class: "@xl/modal:col-span-2", Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@textarea.Textarea(textarea.Props{ID: controlID(c.Name), Name: c.Name, Value: strings.Join(c.Lines, "\n"), Rows: 3, Placeholder: "one per line"})
				@fieldHelp(c)
			}
		case forms.ControlCheckbox:
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "@xl/modal:pt-6", Attributes: fieldAttrs(c.When)}) {
				<input type="hidden" name={ c.Name } value="false"/>
				@checkbox.Checkbox(checkbox.Props{ID: controlID(c.Name), Name: c.Name, Value: "true", Checked: &c.Checked, Disabled: c.ReadOnly})
				@field.Content() {
					@field.Label(field.LabelProps{For: controlID(c.Name)}) {
						{ c.Label }
					}
					@fieldHelp(c)
				}
			}
		case forms.ControlSelect:
			@field.Field(field.Props{Class: wide(c), Attributes: fieldAttrs(c.When)}) {
				// the label names the trigger, the component's focusable part
				@fieldLabel(c, controlID(c.Name)+"-trigger")
				@selectControl(c)
				@fieldHelp(c)
			}
		case forms.ControlPassword:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				// Never required in the browser: on an edit a blank entry means
				// "keep the stored one", and a missing entry is the consumer's
				// DependencyNotReady to report.
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Type: "password", Placeholder: "unchanged", Attributes: templ.Attributes{"autocomplete": "new-password"}})
				@fieldHelp(c)
			}
		case forms.ControlNumber:
			@field.Field(field.Props{Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Type: "number", Value: c.Value, Placeholder: c.Placeholder, Required: c.Required, ReadOnly: c.ReadOnly, Attributes: numberAttrs(c)})
				@fieldHelp(c)
			}
		default:
			@field.Field(field.Props{Class: wide(c), Attributes: fieldAttrs(c.When)}) {
				@fieldLabel(c, controlID(c.Name))
				@input.Input(input.Props{ID: controlID(c.Name), Name: c.Name, Value: c.Value, Placeholder: c.Placeholder, Required: c.Required, ReadOnly: c.ReadOnly})
				@fieldHelp(c)
			}
	}
}

// selectControl is a choice as shadcn-templ's select component: its hidden
// input posts the value under the control's name, and its change event is
// what settings.js re-reads the conditions on. A read-only (immutable)
// choice is the component's ReadOnly, so its input is readonly and still
// posts, with the trigger itself disabled: the component renders a bare
// aria-readonly its script reads as not read-only, and a Disabled root
// would disable the input too, which then posts nothing.
// An option with the empty value is the "unset" choice of an optional
// field.
templ selectControl(c forms.Control) {
	@selectcomp.Select(selectcomp.Props{ID: controlID(c.Name), Name: c.Name, Items: optionItems(c.Options), DefaultValue: c.Value, Required: c.Required && !c.ReadOnly, ReadOnly: c.ReadOnly}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full", Attributes: readOnlyTrigger(c.ReadOnly)}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: "—"})
		}
		@selectcomp.Content() {
			@selectcomp.Group() {
				for _, o := range c.Options {
					@selectcomp.Item(selectcomp.ItemProps{Value: o.Value, Attributes: optionAttrs(o.When)}) {
						{ o.Label }
					}
				}
			}
		}
	}
}

// optionItems are the options as the select component's items: the labels
// its trigger shows for a value, where it would otherwise show the value
// itself until a choice is made (a definition's "1_2" for "Anime -
// English-translated").
func optionItems(options []forms.Option) []selectcomp.ItemData {
	items := make([]selectcomp.ItemData, 0, len(options))
	for _, o := range options {
		if o.Value == "" {
			continue // the unset choice shows the placeholder
		}
		items = append(items, selectcomp.ItemData{Value: o.Value, Label: o.Label})
	}
	return items
}

// readOnlyTrigger disables a read-only select's trigger, so it cannot open.
func readOnlyTrigger(readOnly bool) templ.Attributes {
	if !readOnly {
		return nil
	}
	return templ.Attributes{"disabled": true, "data-disabled": true}
}

// checksControl renders an array of an enumerated string as a checkbox per
// value, each posting the control's name: Decode reads the repeated inputs
// as the array. An option with a condition is hidden, and posts nothing,
// while it does not hold.
templ checksControl(c forms.Control) {
	@field.Set(field.SetProps{Class: "gap-3 @xl/modal:col-span-2", Attributes: rowsAttrs("data-checks", c)}) {
		@field.Content() {
			@field.Title() {
				{ c.Label }
				if c.Required {
					<span class="text-destructive" aria-hidden="true">*</span>
				}
			}
			@fieldHelp(c)
		}
		<div class="flex flex-wrap gap-x-6 gap-y-3">
			for _, o := range c.Options {
				{{ checked := hasValue(c.Values, o.Value) }}
				@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "w-auto", Attributes: optionAttrs(o.When)}) {
					@checkbox.Checkbox(checkbox.Props{ID: controlID(c.Name) + "-" + o.Value, Name: c.Name, Value: o.Value, Checked: &checked, Disabled: c.ReadOnly})
					@field.Label(field.LabelProps{For: controlID(c.Name) + "-" + o.Value}) {
						{ o.Label }
					}
				}
			}
		</div>
	}
}

templ fieldLabel(c forms.Control, target string) {
	@field.Label(field.LabelProps{For: target}) {
		{ c.Label }
		if c.Required {
			<span class="text-destructive" aria-hidden="true">*</span>
		}
	}
}

templ fieldHelp(c forms.Control) {
	if c.Help != "" {
		@field.Description() {
			{ c.Help }
		}
	}
}

// rowsControl renders an array of objects: a row per element, each with
// the item's controls and a Remove button, and a template for Add.
templ rowsControl(c forms.Control) {
	@field.Set(field.SetProps{Class: "gap-3 @xl/modal:col-span-2", Attributes: rowsAttrs("data-rows", c)}) {
		<div class="flex items-start justify-between gap-4">
			@field.Content() {
				@field.Title() {
					{ c.Label }
				}
				@fieldHelp(c)
			}
			@button.Button(button.Props{Type: "button", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-add-row": true}}) {
				Add
			}
		</div>
		<div data-rows-list class="space-y-3">
			for _, row := range c.Rows {
				@formRow(row.Controls)
			}
		</div>
		<template data-row-template>
			@formRow(c.Template)
		</template>
	}
}

// rowsAttrs are a row list's hooks: which list (data-rows or data-map)
// and its condition.
func rowsAttrs(hook string, c forms.Control) templ.Attributes {
	a := templ.Attributes{hook: c.Name}
	if c.When != nil {
		a["data-show-when"] = whenAttr(c.When)
	}
	return a
}

templ formRow(controls []forms.Control) {
	@card.Card(card.Props{Size: card.SizeSm, Class: "bg-muted/30", Attributes: templ.Attributes{"data-row": true}}) {
		@card.Content() {
			@field.Group(field.GroupProps{Class: "grid gap-3 @xl/modal:grid-cols-3"}) {
				for _, rc := range controls {
					@formControl(rc)
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "justify-end"}) {
			@button.Button(button.Props{Type: "button", Size: button.SizeXs, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-remove-row": true}}) {
				Remove
			}
		}
	}
}

// mapControl renders a string map as key/value rows.
templ mapControl(c forms.Control) {
	@field.Set(field.SetProps{Class: "gap-2 @xl/modal:col-span-2", Attributes: rowsAttrs("data-map", c)}) {
		<div class="flex items-start justify-between gap-4">
			@field.Content() {
				@field.Title() {
					{ c.Label }
				}
				@fieldHelp(c)
			}
			@button.Button(button.Props{Type: "button", Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-add-row": true}}) {
				Add
			}
		</div>
		<div data-rows-list class="space-y-2">
			for i, pair := range c.Pairs {
				@mapRow(c.Name, fmt.Sprint(i), pair)
			}
		</div>
		<template data-row-template>
			@mapRow(c.Name, "__i__", forms.Pair{})
		</template>
	}
}

templ mapRow(name, index string, pair forms.Pair) {
	<div data-row class="flex items-center gap-2">
		@input.Input(input.Props{Name: name + ".__k." + index, Value: pair.Key, Placeholder: "key", Class: "w-1/3", Attributes: templ.Attributes{"aria-label": "Key"}})
		@input.Input(input.Props{Name: name + ".__v." + index, Value: pair.Value, Placeholder: "value", Attributes: templ.Attributes{"aria-label": "Value"}})
		@button.Button(button.Props{Type: "button", Size: button.SizeXs, Variant: button.VariantGhost, Attributes: templ.Attributes{"data-remove-row": true}}) {
			Remove
		}
	</div>
}

// controlID makes an input's id from its name; "__i__" stays so a cloned
// row gets a fresh one.
func controlID(name string) string {
	return "f-" + strings.NewReplacer(".", "-", "[", "-", "]", "-").Replace(name)
}

func number(f float64) string {
	return fmt.Sprintf("%v", f)
}

// configActions is the Edit link and Delete form on a Settings-page card,
// for its footer. namespace is "-" for a cluster-scoped kind, the form
// routes' placeholder.
templ configActions(slug, namespace, name string) {
	@configActionsTo(slug, namespace, name, settingsReturnPath)
}

// configDeleteAttrs post a card's delete through htmx after the layout's
// confirm; the answer is a toast and the page redrawn in place.
func configDeleteAttrs(slug, ns, name, returnTo string) templ.Attributes {
	vals, _ := json.Marshal(map[string]string{"return": returnTo})
	out := confirmAttrs(fmt.Sprintf("Delete %q?", name), "This cannot be undone.", "Delete")
	out["hx-post"] = fmt.Sprintf("/settings/delete/%s/%s/%s", slug, ns, name)
	out["hx-vals"] = string(vals)
	out["hx-target"] = "#action-status"
	out["hx-swap"] = "innerHTML"
	out["data-action"] = "delete"
	return out
}

// configActionsTo is configActions for a card on another page (the Import
// Lists page, 2026-09-24): the edit form and the delete both return to
// returnTo instead of the Settings page. It renders as the card's footer.
templ configActionsTo(slug, namespace, name, returnTo string) {
	{{ ns := namespace }}
	if ns == "" {
		{{ ns = "-" }}
	}
	{{ edit := fmt.Sprintf("/settings/edit/%s/%s/%s", slug, ns, name) }}
	if returnTo != settingsReturnPath {
		{{ edit += "?return=" + returnTo }}
	}
	@card.Footer(card.FooterProps{Class: "gap-2 border-t"}) {
		@button.Button(button.Props{Href: edit, Size: button.SizeXs, Variant: button.VariantOutline, ID: "open-" + slug + "-" + ns + "-" + name, Attributes: ModalOpen(nil)}) {
			Edit
		}
		// Delete asks through the layout's one confirm (2026-11-17): a card's
		// own alert dialog, on the Import Lists page, sat inside the live
		// stream and was torn down by the next frame, within seconds.
		@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeXs, Variant: button.VariantGhost, Class: "text-destructive", Attributes: configDeleteAttrs(slug, ns, name, returnTo)}) {
			Delete
		}
	}
}
