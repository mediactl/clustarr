package views

import (
	"cmp"
	"fmt"
	"time"

	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"

	clustarrv1 "github.com/mediactl/clustarr/api/clustarr/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/icon"
	switchcomp "github.com/mediactl/clustarr/ui/components/switch"
	"github.com/mediactl/clustarr/ui/components/table"
	"github.com/mediactl/clustarr/ui/projection"
)

// SourcesRefresh is how often the M3U/EPG Manager's tables fetch
// themselves again: a provider's status moves on a minutes scale, so a
// poll does what a stream would (the Live TV plan's first call).
const SourcesRefresh = "10s"

// sourcesReturnPath is where the provider forms come back to.
const sourcesReturnPath = "/livetv/sources"

// LiveTVSources is the M3U/EPG Manager (the direct-tuners and ui design
// §5.5): each provider's playlist, its guide and its blocks.
templ LiveTVSources(rows []projection.SourceRow) {
	@liveTVPage("M3U/EPG Manager", "/livetv/sources", sourcesActions()) {
		@LiveTVSourcesTables(rows)
	}
}

templ sourcesActions() {
	@button.Button(button.Props{Href: "/settings/new/iptvproviders?return=" + sourcesReturnPath, Size: button.SizeSm, Variant: button.VariantOutline}) {
		@icon.Icon("plus")(icon.Props{Class: "mr-1 size-4"})
		Add playlist
	}
}

// LiveTVSourcesTables is the page's live part, which replaces itself every
// SourcesRefresh (GET /livetv/sources/tables).
templ LiveTVSourcesTables(rows []projection.SourceRow) {
	<div id="livetv-sources" hx-get="/livetv/sources/tables" hx-trigger={ "every " + SourcesRefresh } hx-swap="outerHTML" class="space-y-8">
		if len(rows) == 0 {
			@settingsEmpty("No IPTV providers configured.")
		} else {
			@card.Card(card.Props{Class: "gap-0 py-0"}) {
				@card.Header(card.HeaderProps{Class: "px-4 py-3"}) {
					@card.Title(card.TitleProps{Class: "text-lg font-semibold"}) {
						Playlists
					}
				}
				@card.Content(card.ContentProps{Class: "overflow-x-auto border-t border-border p-0"}) {
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									Name 
								}
								@table.Head() {
									Type 
								}
								@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
									Server 
								}
								@table.Head() {
									Status 
								}
								@table.Head() {
									Tuners 
								}
								@table.Head() {
									Expires 
								}
								@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
									Entries 
								}
								@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
									Candidates 
								}
								@table.Head() {
									Active 
								}
								@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
									Updated 
								}
								@table.Head() {
									Enabled 
								}
								@table.Head(table.HeadProps{Class: "w-24"}) {
									<span class="sr-only">Actions</span>
								}
							}
						}
						@table.Body() {
							for _, r := range rows {
								@playlistRow(r)
							}
						}
					}
				}
			}
			@card.Card(card.Props{Class: "gap-0 py-0"}) {
				@card.Header(card.HeaderProps{Class: "px-4 py-3"}) {
					@card.Title(card.TitleProps{Class: "text-lg font-semibold"}) {
						Guides
					}
				}
				@card.Content(card.ContentProps{Class: "overflow-x-auto border-t border-border p-0"}) {
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									Name 
								}
								@table.Head() {
									Type 
								}
								@table.Head() {
									Source 
								}
								@table.Head() {
									Status 
								}
								@table.Head() {
									Channels 
								}
								@table.Head() {
									Programmes 
								}
								@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
									Updated 
								}
								@table.Head(table.HeadProps{Class: "w-16"}) {
									<span class="sr-only">Actions</span>
								}
							}
						}
						@table.Body() {
							for _, r := range rows {
								@guideRow(r)
								if r.Plex != nil {
									@plexGuideRow(r)
								}
								if r.GuideSources != nil {
									@guideSourcesRow(r)
								}
							}
						}
					}
				}
			}
			<section class="space-y-3">
				<h2 class="text-lg font-semibold">Blocks</h2>
				<p class="text-sm text-muted-foreground">Each block is one HDHomeRun device and one Plex DVR, given to Plex at its URL.</p>
				for _, r := range rows {
					@blocksCard(r)
					if len(r.Categories) > 0 {
						@categoriesCard(r)
					}
				}
			</section>
		}
	</div>
}

templ playlistRow(r projection.SourceRow) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-provider": r.Namespace + "/" + r.Name}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ r.Name }
			<div class="text-xs text-muted-foreground">{ r.Namespace }</div>
		}
		@table.Cell() {
			{ r.Type }
		}
		@table.Cell(table.CellProps{Class: "hidden max-w-56 truncate lg:table-cell"}) {
			{ r.Server }
		}
		@table.Cell() {
			@readinessBadge(r.Ready, r.Reason)
			if r.Message != "" {
				<div class="mt-1 max-w-72 truncate text-xs text-muted-foreground" title={ r.Message }>{ r.Message }</div>
			}
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ fmt.Sprintf("%d / %d", r.TunersInUse, r.TunersTotal) }
		}
		@table.Cell() {
			if r.ExpiresSoon {
				<span data-expires-soon class="font-semibold text-primary">
					@liveTVTime(r.Expires)
				</span>
			} else {
				@liveTVTime(r.Expires)
			}
			if r.AccountStatus != "" {
				<div class="text-xs text-muted-foreground">{ r.AccountStatus }</div>
			}
		}
		@table.Cell(table.CellProps{Class: "hidden tabular-nums md:table-cell"}) {
			{ fmt.Sprint(r.Entries) }
		}
		@table.Cell(table.CellProps{Class: "hidden tabular-nums md:table-cell"}) {
			{ fmt.Sprint(r.Candidates) }
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ fmt.Sprint(r.Active) }
		}
		@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
			@liveTVTime(r.Updated)
		}
		@table.Cell() {
			@switchcomp.Switch(switchcomp.Props{
				Checked: &r.Enabled,
				Size:    switchcomp.SizeSm,
				Attributes: templ.Attributes{
					"aria-label": "Enabled",
					"hx-post":    "/livetv/providers/" + r.Namespace + "/" + r.Name + "/enabled",
					"hx-vals":    hxVals("enabled", fmt.Sprint(!r.Enabled)),
					"hx-trigger": "click",
					"hx-target":  "#action-status",
					"hx-swap":    "innerHTML",
				},
			})
		}
		@table.Cell() {
			<div class="flex items-center justify-end gap-1">
				@refreshButton(r)
				@button.Button(button.Props{
					Href: "/settings/edit/iptvproviders/" + r.Namespace + "/" + r.Name + "?return=" + sourcesReturnPath, Variant: button.VariantGhost, Size: button.SizeIconSm,
					Attributes: templ.Attributes{"aria-label": "Edit", "title": "Edit"},
				}) {
					@icon.Icon("pencil")()
				}
			</div>
		}
	}
}

// refreshButton is a provider's "Refresh now": every source fetched again.
templ refreshButton(r projection.SourceRow) {
	@button.Button(button.Props{
		Variant: button.VariantGhost, Size: button.SizeIconSm,
		Attributes: templ.Attributes{
			"aria-label": "Refresh now", "title": "Refresh now",
			"hx-post":   "/livetv/providers/" + r.Namespace + "/" + r.Name + "/refresh",
			"hx-target": "#action-status", "hx-swap": "innerHTML",
		},
	}) {
		@icon.Icon("refresh-cw")()
	}
}

// plexGuideRow is a provider's Plex lineup: the guide Plex shows for its
// paired channels (the Plex native guide design §5.7).
templ plexGuideRow(r projection.SourceRow) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-plex-guide": r.Namespace + "/" + r.Name}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ r.Name }
		}
		@table.Cell() {
			Plex 
		}
		@table.Cell(table.CellProps{Class: "max-w-96"}) {
			<div class="truncate text-sm" title={ r.PlexLineup }>{ cmp.Or(r.Plex.Title, r.PlexLineup) }</div>
			<div class="text-xs text-muted-foreground">
				if r.PlexOn {
					paired channels are on Plex's guide; the rest are off Plex
				} else {
					dry run: channels stay on the XMLTV guide until plexGuide.enabled
				}
			</div>
		}
		@table.Cell() {
			if r.PlexReason == "LineupFailed" || (r.Plex.Error != "" && r.Plex.FetchedAt == nil) {
				@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
					Error 
				}
				<div class="mt-1 max-w-72 truncate text-xs text-muted-foreground" title={ cmp.Or(r.Plex.Error, r.PlexMessage) }>{ cmp.Or(r.Plex.Error, r.PlexMessage) }</div>
			} else if r.Plex.FetchedAt == nil {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					Not fetched yet 
				}
			} else {
				@badge.Badge() {
					Fetched 
				}
			}
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			<div>{ fmt.Sprint(r.Plex.Paired) } paired</div>
			<div class="text-xs text-muted-foreground">
				{ fmt.Sprintf("%d ambiguous, %d taken, %d not in the lineup, %d off", r.Plex.Ambiguous, r.Plex.Taken, r.Plex.NotInLineup, r.Plex.Off) }
			</div>
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ fmt.Sprint(r.Plex.Stations) } stations 
		}
		@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
			@liveTVTime(plexFetched(r.Plex))
		}
		@table.Cell() {
			<div class="flex justify-end">
				@refreshButton(r)
			</div>
		}
	}
}

// guideSourcesRow is a provider's Plex grid source (spec.guideSources.plex,
// the custom-guides design §5.7): the lineups its stations pair over, the
// stations paired, the grids fetched, the last fetch, a rate limit's hold
// and the last error.
templ guideSourcesRow(r projection.SourceRow) {
	{{ g := r.GuideSources }}
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-guide-sources": r.Namespace + "/" + r.Name}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ r.Name }
		}
		@table.Cell() {
			Plex grids 
		}
		@table.Cell() {
			<div class="text-sm tabular-nums">{ fmt.Sprintf("%d lineups", g.Lineups) }</div>
			<div class="text-xs text-muted-foreground">the stations' 14 days from Plex's guide</div>
		}
		@table.Cell() {
			if r.GuideSourcesHeld {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					Held 
				}
				<div class="mt-1 text-xs text-muted-foreground">
					held until
					@liveTVTime(metaTime(g.HoldUntil))
				</div>
			} else if g.Error != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
					Error 
				}
			} else if g.FetchedAt == nil {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
					Not fetched yet 
				}
			} else {
				@badge.Badge() {
					Fetched 
				}
			}
			if g.Error != "" {
				<div class="mt-1 max-w-72 truncate text-xs text-muted-foreground" title={ g.Error }>{ g.Error }</div>
			}
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ fmt.Sprintf("%d stations", g.Stations) }
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			{ fmt.Sprintf("%d grids", g.Grids) }
		}
		@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
			@liveTVTime(metaTime(g.FetchedAt))
		}
		@table.Cell() {
			<div class="flex justify-end">
				@refreshButton(r)
			</div>
		}
	}
}

// metaTime is a status time as liveTVTime shows it, nil when unset.
func metaTime(t *metav1.Time) *time.Time {
	if t == nil {
		return nil
	}
	u := t.UTC()
	return &u
}

func plexFetched(g *clustarrv1.PlexGuideStatus) *time.Time {
	if g == nil || g.FetchedAt == nil {
		return nil
	}
	t := g.FetchedAt.UTC()
	return &t
}

templ guideRow(r projection.SourceRow) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-guide": r.Namespace + "/" + r.Name}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ r.Name }
		}
		@table.Cell() {
			XMLTV 
		}
		if r.GuideSource == "" {
			@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
				No guide: every channel has hourly dummy blocks 
			}
			@table.Cell()
			@table.Cell()
			@table.Cell()
			@table.Cell(table.CellProps{Class: "hidden lg:table-cell"})
			@table.Cell()
		} else {
			@table.Cell(table.CellProps{Class: "max-w-96"}) {
				<div class="truncate font-mono text-xs" title={ r.GuideSource }>{ r.GuideSource }</div>
				if r.GuideFallback {
					<div class="text-xs text-muted-foreground">the panel's guide fills the channels it lacks</div>
				}
			}
			@table.Cell() {
				if r.GuideError != "" {
					@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
						Error 
					}
					<div class="mt-1 max-w-72 truncate text-xs text-muted-foreground" title={ r.GuideError }>{ r.GuideError }</div>
				} else if r.GuideUpdated == nil {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						Not fetched yet 
					}
				} else {
					@badge.Badge() {
						Fetched 
					}
				}
			}
			@table.Cell(table.CellProps{Class: "tabular-nums"}) {
				{ fmt.Sprint(r.GuideChannels) }
			}
			@table.Cell(table.CellProps{Class: "tabular-nums"}) {
				{ fmt.Sprint(r.GuideProgrammes) }
			}
			@table.Cell(table.CellProps{Class: "hidden lg:table-cell"}) {
				@liveTVTime(r.GuideUpdated)
			}
			@table.Cell() {
				<div class="flex justify-end">
					@refreshButton(r)
				</div>
			}
		}
	}
}

templ blocksCard(r projection.SourceRow) {
	@card.Card(card.Props{Class: "gap-0 py-0", Attributes: templ.Attributes{"data-blocks": r.Namespace + "/" + r.Name}}) {
		@card.Header(card.HeaderProps{Class: "px-4 py-2"}) {
			@card.Title() {
				{ r.Name }
			}
		}
		if len(r.Blocks) == 0 {
			@emptyNote("No blocks yet: the provider has no active channel, or has not been reconciled.", "border-t border-border py-3", nil)
		} else {
			@card.Content(card.ContentProps{Class: "overflow-x-auto border-t border-border p-0"}) {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								Start 
							}
							@table.Head() {
								Numbers 
							}
							@table.Head() {
								Channels 
							}
							@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) {
								Map bytes 
							}
							@table.Head() {
								Device 
							}
							@table.Head() {
								URL 
							}
							@table.Head() {
								Plex 
							}
							@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
								Lineup / guide 
							}
						}
					}
					@table.Body() {
						for _, b := range r.Blocks {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "tabular-nums"}) {
									{ b.Start }
								}
								@table.Cell(table.CellProps{Class: "tabular-nums"}) {
									{ b.First + "–" + b.Last }
								}
								@table.Cell(table.CellProps{Class: "tabular-nums"}) {
									{ fmt.Sprint(b.Channels) }
								}
								@table.Cell(table.CellProps{Class: "hidden tabular-nums md:table-cell"}) {
									{ fmt.Sprint(b.MapBytes) }
								}
								@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
									{ b.DeviceID }
								}
								@table.Cell() {
									<div class="flex items-center gap-1">
										<span class="max-w-80 truncate font-mono text-xs" title={ b.URI }>{ b.URI }</span>
										@copyButton(b.URI, "Copy the device URL")
									</div>
								}
								@table.Cell() {
									if b.Owner != "" {
										{ b.Owner }
									} else {
										<span class="text-muted-foreground">not registered</span>
									}
								}
								@table.Cell(table.CellProps{Class: "hidden font-mono text-xs lg:table-cell"}) {
									{ b.LineupHash + " / " + b.GuideHash }
								}
							}
						}
					}
				}
			}
		}
	}
}

// categoriesCard is a provider's lineup categories (status.categories, the
// custom-guides design §5.1): each one's first number, active channels and
// HDHomeRun device, and a category over a DVR's limit.
templ categoriesCard(r projection.SourceRow) {
	@card.Card(card.Props{Class: "gap-0 py-0", Attributes: templ.Attributes{"data-categories": r.Namespace + "/" + r.Name}}) {
		@card.Header(card.HeaderProps{Class: "px-4 py-2"}) {
			@card.Title() {
				{ r.Name + " categories" }
			}
		}
		@card.Content(card.ContentProps{Class: "overflow-x-auto border-t border-border p-0"}) {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Category 
						}
						@table.Head() {
							Base 
						}
						@table.Head() {
							Channels 
						}
						@table.Head() {
							Device 
						}
						@table.Head() {
							Status 
						}
					}
				}
				@table.Body() {
					for _, c := range r.Categories {
						@table.Row(table.RowProps{Attributes: templ.Attributes{"data-category": c.Name}}) {
							@table.Cell(table.CellProps{Class: "font-medium"}) {
								{ c.Name }
							}
							@table.Cell(table.CellProps{Class: "tabular-nums"}) {
								{ fmt.Sprint(c.Base) }
							}
							@table.Cell(table.CellProps{Class: "tabular-nums"}) {
								{ fmt.Sprint(c.Channels) }
							}
							@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
								{ c.DeviceID }
							}
							@table.Cell() {
								if c.Reason == clustarrv1.ReasonTooMany {
									@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Attributes: templ.Attributes{"title": "Over a DVR's limit: refused, its channels left as they were and its published block kept"}}) {
										Too many 
									}
								} else if c.Reason != "" {
									@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
										{ c.Reason }
									}
								} else {
									@badge.Badge() {
										Ready 
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// readinessBadge is a Ready condition: Ready, or its reason.
templ readinessBadge(ready bool, reason string) {
	if ready {
		@badge.Badge() {
			Ready 
		}
	} else if reason == "" {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			Pending 
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
			{ reason }
		}
	}
}
