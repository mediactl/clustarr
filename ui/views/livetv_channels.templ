package views

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"
	"strings"

	clustarrv1 "github.com/mediactl/clustarr/api/clustarr/v1alpha1"
	"github.com/mediactl/clustarr/ui/projection"
	"github.com/mediactl/clustarr/ui/components/alertdialog"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/input"
	"github.com/mediactl/clustarr/ui/components/inputgroup"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/components/pagination"
	switchcomp "github.com/mediactl/clustarr/ui/components/switch"
	"github.com/mediactl/clustarr/ui/components/table"
)

// ChannelFilter is the Channels table's filters.
type ChannelFilter struct {
	Q, Provider, Group, State string
	NoGuide, NoLogo, OffPlex  bool
}

// Values is the filter as query values, empty ones left out.
func (f ChannelFilter) Values() url.Values {
	v := url.Values{}
	for k, s := range map[string]string{"q": f.Q, "provider": f.Provider, "group": f.Group, "state": f.State} {
		if s != "" {
			v.Set(k, s)
		}
	}
	if f.NoGuide {
		v.Set("noguide", "1")
	}
	if f.NoLogo {
		v.Set("nologo", "1")
	}
	if f.OffPlex {
		v.Set("offplex", "1")
	}
	return v
}

// ProviderOption is a provider in the filter's select.
type ProviderOption struct{ Value, Label string }

// BlockLinks is one block's URLs for the Links dialog.
type BlockLinks struct{ Provider, Start, HDHR, M3U, EPG string }

// ChannelsPage is the Channels page's view.
type ChannelsPage struct {
	Rows      []projection.ChannelRow
	Filter    ChannelFilter
	Providers []ProviderOption
	Groups    []string
	Links     []BlockLinks
	Pane      PlaylistPane
}

// PlaylistPane is a provider's playlist, filtered and paged.
type PlaylistPane struct {
	Provider, Q, Group string
	All, Loaded        bool
	Groups, Filters    []string
	Entries            []PlaylistPaneEntry
	Total, Page, Pages int
}

// PageURL is the pane's page n with its filters.
func (p PlaylistPane) PageURL(n int) string {
	v := url.Values{"provider": {p.Provider}, "page": {fmt.Sprint(n)}}
	if p.All {
		v.Set("all", "1")
	}
	if p.Q != "" {
		v.Set("q", p.Q)
	}
	if p.Group != "" {
		v.Set("group", p.Group)
	}
	return "/livetv/channels/playlist?" + v.Encode()
}

// PlaylistPaneEntry is one playlist entry: Number is its channel's when it
// is one; Candidate an entry the provider's filters admit, which alone may
// become a channel.
type PlaylistPaneEntry struct {
	ID, Key, Name, Group, TvgID, LogoPath, Provider, Number string
	Candidate                                               bool
}

// EPGPicker is a channel's guide picker; with Plex its Plex station picker
// (spec.epg.plex), whose choices post as "plex".
type EPGPicker struct {
	Namespace, Name, Q string
	// Generation is the channel's metadata.generation the picker read.
	Generation int64
	Choices    []EPGChoice
	Plex       bool
}

// EPGChoice is one guide choice: Value "" automatic, "dummy", or a guide
// channel id.
type EPGChoice struct{ Value, Label, Hint string }

const channelsReturnPath = "/livetv/channels"

// LiveTVChannels is the Channels page (the direct-tuners and ui design
// §5.4): the lineup's channels on the left, the provider's playlist on the
// right.
templ LiveTVChannels(p ChannelsPage) {
	@liveTVPage("Channels", "/livetv/channels", channelsActions(p.Links)) {
		<div class="grid gap-6 min-[1800px]:grid-cols-[minmax(0,1fr)_26rem]">
			<div class="min-w-0 space-y-3">
				@channelsFilterForm(p)
				@channelsBulkForm()
				@ChannelsTable(p.Rows, p.Filter)
			</div>
			<aside class="min-w-0">
				@PlaylistPaneView(p.Pane)
			</aside>
		</div>
		<div id="epg-picker"></div>
	}
}

templ channelsActions(links []BlockLinks) {
	@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: dialog.TriggerFor("livetv-links")}) {
		@icon.Icon("link")(icon.Props{Class: "mr-1 size-4"})
		Links
	}
	@dialog.Dialog(dialog.Props{ID: "livetv-links"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-3xl"}) {
			@dialog.Header() {
				@dialog.Title() { Links }
				@dialog.Description() { Each block's HDHomeRun device, M3U playlist and XMLTV guide on the livetv Service. }
			}
			if len(links) == 0 {
				@emptyNote("No block has a URL yet.", "py-3", nil)
			}
			<div class="space-y-3">
				for _, l := range links {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title() {
								{ l.Provider + " " + l.Start + "+" }
							}
						}
						@card.Content(card.ContentProps{Class: "gap-2"}) {
							@linkLine("HDHR", l.HDHR)
							@linkLine("M3U", l.M3U)
							@linkLine("EPG", l.EPG)
						}
					}
				}
			</div>
		}
	}
}

// linkLine is one URL of the Links dialog: an input group (shadcn-templ's,
// since 2026-11-04) -- the label at its start, the URL read-only and
// selectable, the copy button at its end.
templ linkLine(label, value string) {
	@inputgroup.InputGroup(inputgroup.Props{Class: "h-8"}) {
		@inputgroup.Addon() {
			<span class="w-8 text-xs text-muted-foreground">{ label }</span>
		}
		@inputgroup.Input(inputgroup.InputProps{Value: value, Class: "font-mono text-xs", Attributes: templ.Attributes{"readonly": true, "aria-label": label + " URL"}})
		@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
			@copyButton(value, "Copy the "+label+" URL")
		}
	}
}

templ channelsFilterForm(p ChannelsPage) {
	<form
		id="channels-filter"
		class="flex flex-wrap items-center gap-2"
		hx-get="/livetv/channels"
		hx-select="#channels-table"
		hx-target="#channels-table"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-trigger="input changed delay:300ms, change"
	>
		@input.Input(input.Props{Type: "search", Name: "q", Value: p.Filter.Q, Placeholder: "Name or number", Class: "h-8 w-48", Attributes: templ.Attributes{"aria-label": "Search"}})
		@filterSelect("provider", "Provider", "Every provider", p.Providers, p.Filter.Provider)
		@filterSelect("group", "Group", "Every group", groupOptions(p.Groups), p.Filter.Group)
		@filterSelect("state", "State", "Active and inactive", []ProviderOption{{Value: "active", Label: "Active"}, {Value: "inactive", Label: "Inactive"}}, p.Filter.State)
		@filterCheck("noguide", "No guide", p.Filter.NoGuide)
		@filterCheck("nologo", "No logo", p.Filter.NoLogo)
		@filterCheck("offplex", "Off Plex", p.Filter.OffPlex)
	</form>
}

// ChannelsDeleteConfirm asks before a bulk delete: an alert dialog
// (shadcn-templ's, since 2026-11-04) open as it lands in #action-status,
// whose Delete posts the selected items again with confirm=yes and whose
// Cancel closes it. library.js leaves the question standing in the
// region, where the next answer replaces it.
templ ChannelsDeleteConfirm(items []string) {
	@alertdialog.AlertDialog(alertdialog.Props{DefaultOpen: true}) {
		@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
			@alertdialog.Header() {
				@alertdialog.Title() {
					{ deleteQuestion(len(items)) }
				}
				@alertdialog.Description() {
					Their numbers, names and guide mappings go with them, and Plex's lineups lose them.
				}
			}
			<form
				data-action-confirm="delete-channels"
				hx-post="/livetv/channels/bulk"
				hx-target="#action-status"
				hx-swap="innerHTML"
			>
				<input type="hidden" name="op" value="delete"/>
				<input type="hidden" name="confirm" value="yes"/>
				for _, it := range items {
					<input type="hidden" name="item" value={ it }/>
				}
				@alertdialog.Footer() {
					@alertdialog.Cancel() { Cancel }
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) { Delete }
				}
			</form>
		}
	}
}

func deleteQuestion(n int) string {
	if n == 1 {
		return "Delete 1 channel?"
	}
	return fmt.Sprintf("Delete %d channels?", n)
}

templ channelsBulkForm() {
	<form
		id="channels-bulk"
		class="flex flex-wrap items-center gap-2 rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm"
		hx-post="/livetv/channels/bulk"
		hx-target="#action-status"
		hx-swap="innerHTML"
	>
		<span class="text-muted-foreground">Selected:</span>
		@filterSelect("op", "Bulk action", "", []ProviderOption{{Value: "enable", Label: "Enable"}, {Value: "disable", Label: "Disable"}, {Value: "group", Label: "Assign group"}, {Value: "renumber", Label: "Renumber from"}, {Value: "delete", Label: "Delete"}}, "enable")
		@input.Input(input.Props{Name: "value", Placeholder: "Group", Class: "h-8 w-36", Attributes: templ.Attributes{"aria-label": "Group"}})
		@input.Input(input.Props{Name: "start", Placeholder: "Start number", Class: "h-8 w-28", Attributes: templ.Attributes{"aria-label": "Start number", "inputmode": "numeric"}})
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) { Apply }
	</form>
}

// ChannelsTable is the channels table, which fetches itself again on
// every channels-changed event (a bulk edit, an added channel).
templ ChannelsTable(rows []projection.ChannelRow, f ChannelFilter) {
	<div
		id="channels-table"
		class="panel overflow-x-auto rounded-xl border border-border bg-card"
		hx-get={ "/livetv/channels/table?" + f.Values().Encode() }
		hx-trigger="channels-changed from:body"
		hx-swap="outerHTML"
	>
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Class: "w-8"}) { <span class="sr-only">Select</span> }
					@table.Head(table.HeadProps{Class: "w-12"}) { Active }
					@table.Head(table.HeadProps{Class: "w-24"}) { Number }
					@table.Head(table.HeadProps{Class: "w-12"}) { <span class="sr-only">Logo</span> }
					@table.Head() { Name }
					@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) { Group }
					@table.Head(table.HeadProps{Class: "hidden md:table-cell"}) { Provider }
					@table.Head() { EPG }
					@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) { Plex }
					@table.Head(table.HeadProps{Class: "w-28"}) { <span class="sr-only">Actions</span> }
				}
			}
			@table.Body() {
				for _, r := range rows {
					@ChannelRowView(r)
				}
			}
		}
		if len(rows) == 0 {
			<p class="px-4 py-6 text-center text-sm text-muted-foreground">No channel matches.</p>
		}
	</div>
}

// channelPost are an in-place edit's htmx attributes: post the field with
// the version the page read, answered by the row.
func channelPost(r projection.ChannelRow, vals string) templ.Attributes {
	return templ.Attributes{
		"hx-post":   "/livetv/channels/" + r.Namespace + "/" + r.Name,
		"hx-vals":   vals,
		"hx-target": "#channel-" + r.Name,
		"hx-swap":   "outerHTML",
	}
}

// genVals are an in-place edit's hx-vals: the generation the page read.
func genVals(r projection.ChannelRow) string { return hxVals("gen", strconv.FormatInt(r.Generation, 10)) }

// bulkValue is a row's selection value: namespace/name@generation.
func bulkValue(r projection.ChannelRow) string {
	return r.Namespace + "/" + r.Name + "@" + strconv.FormatInt(r.Generation, 10)
}

// hxVals is an hx-vals attribute's JSON object of the key, value pairs kv.
func hxVals(kv ...string) string {
	m := make(map[string]string, len(kv)/2)
	for i := 0; i+1 < len(kv); i += 2 {
		m[kv[i]] = kv[i+1]
	}
	b, _ := json.Marshal(m)
	return string(b)
}

// ChannelRowView is one channel's row.
templ ChannelRowView(r projection.ChannelRow) {
	@table.Row(table.RowProps{ID: "channel-" + r.Name, Attributes: templ.Attributes{"data-channel": r.Namespace + "/" + r.Name}}) {
		@table.Cell() {
			@checkbox.Checkbox(checkbox.Props{Name: "item", Value: bulkValue(r), Form: "channels-bulk", Attributes: templ.Attributes{"aria-label": "Select", "data-channel-select": true}})
		}
		@table.Cell() {
			{{ attrs := channelPost(r, hxVals("gen", strconv.FormatInt(r.Generation, 10), "active", fmt.Sprint(!r.Active))) }}
			{{ attrs["hx-trigger"] = "click" }}
			{{ attrs["aria-label"] = "Active" }}
			@switchcomp.Switch(switchcomp.Props{Checked: &r.Active, Size: switchcomp.SizeSm, Attributes: attrs})
		}
		@table.Cell() {
			@input.Input(input.Props{Name: "number", Value: r.Number, Class: inPlaceInputClass + " w-20 tabular-nums", Attributes: inPlaceAttrs(r, "Number", "decimal")})
		}
		@table.Cell() {
			@channelLogo(r.LogoPath, r.Number)
		}
		@table.Cell(table.CellProps{Class: "min-w-40"}) {
			@input.Input(input.Props{Name: "name", Value: r.DisplayName, Class: inPlaceInputClass + " w-full", Attributes: inPlaceAttrs(r, "Name", "")})
			<div class="flex items-center gap-1 px-1 text-xs text-muted-foreground">
				if r.NameOverridden {
					<span title="Named here, not by the playlist">renamed</span>
				}
				if !r.Ready {
					@badge.Badge(badge.Props{Variant: channelReasonVariant(r.Reason)}) { { r.Reason } }
				}
			</div>
		}
		@table.Cell(table.CellProps{Class: "hidden max-w-48 truncate text-sm lg:table-cell"}) { { r.Group } }
		@table.Cell(table.CellProps{Class: "hidden text-sm md:table-cell"}) { { r.Provider } }
		@table.Cell() {
			@pickerButton("/livetv/channels/"+r.Namespace+"/"+r.Name+"/epg", "Change the guide") {
				{ epgLabel(r.EPG) }
			}
		}
		@table.Cell(table.CellProps{Class: "hidden text-sm lg:table-cell"}) {
			if r.PlexGuide {
				@pickerButton("/livetv/channels/"+r.Namespace+"/"+r.Name+"/plex", plexTitle(r)) {
					{ plexLabel(r) }
				}
			}
			if r.BlockStart != "" {
				<div>{ r.BlockStart + "+" }</div>
				<div class="max-w-28 truncate text-xs text-muted-foreground" title={ r.Owner }>{ r.Owner }</div>
			}
		}
		@table.Cell() {
			<div class="flex items-center justify-end gap-1">
				@copyButton(r.StreamURL, "Copy the stream URL")
				@button.Button(button.Props{
					Href: "/settings/edit/iptvchannels/" + r.Namespace + "/" + r.Name + "?return=" + channelsReturnPath, Variant: button.VariantGhost, Size: button.SizeIconSm,
					Attributes: templ.Attributes{"aria-label": "Edit", "title": "Edit"},
				}) {
					@icon.Icon("pencil")()
				}
				@button.Button(button.Props{
					Variant: button.VariantGhost, Size: button.SizeIconSm,
					Attributes: templ.Attributes{
						"aria-label": "Delete", "title": "Delete",
						"hx-post":    "/livetv/channels/" + r.Namespace + "/" + r.Name + "/delete",
						"hx-confirm": "Delete channel " + r.Number + " (" + r.DisplayName + ")?",
						"hx-target":  "#channel-" + r.Name, "hx-swap": "outerHTML",
					},
				}) {
					@icon.Icon("trash-2")()
				}
			</div>
		}
	}
}

// inPlaceInputClass is a row's in-place input (number, name): an input
// whose border shows only under the pointer or focus, so the table reads
// as a table until a cell is edited.
const inPlaceInputClass = "h-8 border-transparent px-1 shadow-none hover:border-input focus-visible:border-input"

// inPlaceAttrs are an in-place input's attributes: the row's post on
// change, its label and, when set, its input mode.
func inPlaceAttrs(r projection.ChannelRow, label, mode string) templ.Attributes {
	attrs := channelPost(r, genVals(r))
	attrs["hx-trigger"] = "change"
	attrs["aria-label"] = label
	if mode != "" {
		attrs["inputmode"] = mode
	}
	return attrs
}

// pickerButton opens a channel's guide or Plex station picker (#epg-picker)
// from its cell: a ghost button reading the current choice.
templ pickerButton(href, title string) {
	@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeXs, Class: "max-w-40 justify-start px-1 font-normal", Attributes: templ.Attributes{"hx-get": href, "hx-target": "#epg-picker", "hx-swap": "innerHTML", "title": title}}) {
		<span class="truncate">
			{ children... }
		</span>
	}
}

// channelLogo is a channel's logo from the store, its number on a tile
// when it has none or the tuner has not stored it yet (livetv.js).
templ channelLogo(path, number string) {
	if path != "" {
		<img data-logo src={ path } alt="" loading="lazy" class="size-8 rounded object-contain"/>
		<span data-logo-tile hidden class="flex size-8 items-center justify-center rounded bg-muted text-[10px] tabular-nums text-muted-foreground">{ number }</span>
	} else {
		<span data-logo-tile class="flex size-8 items-center justify-center rounded bg-muted text-[10px] tabular-nums text-muted-foreground">{ number }</span>
	}
}

// plexLabel is a channel's pairing with its provider's Plex lineup, as the
// Plex column shows it: the station and its number there, or why it is off
// Plex.
func plexLabel(r projection.ChannelRow) string {
	switch {
	case r.Plex == nil:
		return "Not paired yet"
	case r.OnPlex():
		return r.Plex.CallSign + " " + r.Plex.VCN
	case r.Plex.Match == clustarrv1.PlexMatchNotInLineup:
		return "Not in the lineup"
	case r.Plex.Match == clustarrv1.PlexMatchOff:
		return "Off Plex"
	case r.Plex.Match == clustarrv1.PlexMatchNoLineup:
		return "No lineup yet"
	}
	return string(r.Plex.Match)
}

// plexTitle is plexLabel's tooltip: the station's title and how it was
// chosen, the candidates or the holder.
func plexTitle(r projection.ChannelRow) string {
	switch {
	case r.Plex == nil:
		return "Change the Plex station"
	case r.OnPlex():
		return r.Plex.Title + " (" + strings.ToLower(string(r.Plex.Match)) + ")"
	case r.Plex.Match == clustarrv1.PlexMatchAmbiguous:
		return "Several stations match: " + strings.Join(r.Plex.Candidates, "; ")
	case r.Plex.Match == clustarrv1.PlexMatchTaken:
		return r.Plex.CallSign + " is channel " + r.Plex.TakenBy + "'s"
	case r.Plex.Match == clustarrv1.PlexMatchTimeshifted:
		return "Plex's guide cannot shift a channel's times"
	}
	return "Change the Plex station"
}

func epgLabel(epg string) string {
	switch epg {
	case "":
		return "Auto"
	case "dummy":
		return "Dummy"
	}
	return epg
}

func channelReasonVariant(reason string) badge.Variant {
	if reason == "Inactive" {
		return badge.VariantOutline
	}
	return badge.VariantDestructive
}

// PlaylistPaneView is the provider's playlist beside the table.
templ PlaylistPaneView(p PlaylistPane) {
	@card.Card(card.Props{ID: "playlist-pane", Size: card.SizeSm}) {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "text-lg font-semibold"}) {
				Playlist
			}
			if p.Loaded {
				@card.Action() {
					<span class="text-xs text-muted-foreground">{ fmt.Sprint(p.Total) } entries</span>
				}
			}
		}
		@card.Content() {
			if len(p.Filters) > 0 {
				<div class="flex flex-wrap gap-1">
					for _, f := range p.Filters {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) { { f } }
					}
				</div>
			}
			<form
				class="flex flex-wrap items-center gap-2"
				hx-get="/livetv/channels/playlist"
				hx-target="#playlist-pane"
				hx-swap="outerHTML"
				hx-trigger="input changed delay:300ms, change"
			>
				<input type="hidden" name="provider" value={ p.Provider }/>
				@input.Input(input.Props{Type: "search", Name: "q", Value: p.Q, Placeholder: "Name, tvg-id or group", Class: "h-8 min-w-0 flex-1", Attributes: templ.Attributes{"aria-label": "Search the playlist"}})
				@filterSelect("group", "Group", "Every group", groupOptions(p.Groups), p.Group)
				@filterCheck("all", "Every entry", p.All)
			</form>
			if !p.Loaded {
				@emptyNote("The playlist has not been fetched yet.", "py-3", nil)
			} else {
				@item.Group(item.GroupProps{Class: "gap-0 divide-y divide-border"}) {
					for _, e := range p.Entries {
						@PlaylistEntryRow(e)
					}
				}
				if p.Pages > 1 {
					@pagination.Pagination(pagination.Props{Attributes: templ.Attributes{"data-playlist-pager": true}}) {
						@pagination.Content() {
							@pagination.Item() {
								@pagination.Previous(pagination.PreviousProps{Href: p.PageURL(max(p.Page-1, 1)), Disabled: p.Page <= 1, Text: "Previous", Attributes: playlistPageAttrs(p, p.Page-1)})
							}
							@pagination.Item() {
								<span class="px-2 text-sm text-muted-foreground">{ fmt.Sprintf("Page %d of %d", p.Page, p.Pages) }</span>
							}
							@pagination.Item() {
								@pagination.Next(pagination.NextProps{Href: p.PageURL(min(p.Page+1, p.Pages)), Disabled: p.Page >= p.Pages, Text: "Next", Attributes: playlistPageAttrs(p, p.Page+1)})
							}
						}
					}
				}
			}
		}
	}
}

// playlistPageAttrs fetch page n of the playlist pane into its place.
func playlistPageAttrs(p PlaylistPane, n int) templ.Attributes {
	return templ.Attributes{"hx-get": p.PageURL(n), "hx-target": "#playlist-pane", "hx-swap": "outerHTML"}
}

// PlaylistEntryRow is one playlist entry: its channel's number, or Add as
// channel when the provider's filters admit it.
templ PlaylistEntryRow(e PlaylistPaneEntry) {
	@item.Item(item.Props{ID: e.ID, Size: item.SizeXs, Class: "rounded-none px-0", Attributes: templ.Attributes{"data-playlist-entry": e.Key}}) {
		@item.Media() {
			@channelLogo(e.LogoPath, "")
		}
		@item.Content() {
			@item.Title(item.TitleProps{Class: "truncate text-sm font-normal"}) {
				{ e.Name }
			}
			@item.Description(item.DescriptionProps{Class: "truncate text-xs"}) {
				{ e.Group }
				if e.TvgID != "" {
					{ " · " + e.TvgID }
				}
			}
		}
		@item.Actions() {
			if e.Number != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) { { "Channel " + e.Number } }
			} else if e.Candidate {
				@button.Button(button.Props{
					Size: button.SizeXs, Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"hx-post":   "/livetv/channels/add",
						"hx-vals":   hxVals("provider", e.Provider, "key", e.Key, "name", e.Name),
						"hx-target": "#" + e.ID, "hx-swap": "outerHTML",
					},
				}) {
					Add as channel
				}
			} else {
				<span class="text-xs text-muted-foreground" title="Add a filter that admits it in the provider's settings">not in the filters</span>
			}
		}
	}
}

// EPGPickerDialog is a channel's guide picker, open as it lands in
// #epg-picker: automatic, dummy, or a guide channel matching the search.
templ EPGPickerDialog(p EPGPicker) {
	{{ id := "epg-picker-" + p.Name }}
	@dialog.Dialog(dialog.Props{ID: id, DefaultOpen: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl"}) {
			@dialog.Header() {
				if p.Plex {
					@dialog.Title() { Plex guide }
					@dialog.Description() { Which station of the Plex lineup this channel is on; Plex shows its programmes and its number. }
				} else {
					@dialog.Title() { Guide }
					@dialog.Description() { Which guide channel this channel takes its programmes from. }
				}
			}
			@input.Input(input.Props{
				Type: "search", Name: "q", Value: p.Q, Placeholder: pickerPlaceholder(p.Plex),
				Attributes: templ.Attributes{
					"aria-label": pickerPlaceholder(p.Plex),
					"hx-get":     "/livetv/channels/" + p.Namespace + "/" + p.Name + "/" + pickerRoute(p.Plex),
					"hx-trigger": "input changed delay:250ms",
					"hx-target":  "#epg-choices-" + p.Name,
					"hx-select":  "#epg-choices-" + p.Name,
					"hx-swap":    "outerHTML",
				},
			})
			<div id={ "epg-choices-" + p.Name } class="max-h-96 divide-y divide-border overflow-y-auto">
				for _, c := range p.Choices {
					{{ attrs := templ.Attributes{
						"data-epg-choice": c.Value,
						"hx-post":         "/livetv/channels/" + p.Namespace + "/" + p.Name,
						"hx-vals":         hxVals("gen", strconv.FormatInt(p.Generation, 10), pickerRoute(p.Plex), c.Value),
						"hx-target":       "#channel-" + p.Name,
						"hx-swap":         "outerHTML",
					} }}
					{{ for k, v := range dialog.CloseFor(id) {
						if k != "type" {
							attrs[k] = v
						}
					} }}
					@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-auto w-full justify-between gap-3 rounded-none px-2 py-2 font-normal", Attributes: attrs}) {
						<span class="truncate">{ c.Label }</span>
						<span class="truncate font-mono text-xs text-muted-foreground">{ c.Hint }</span>
					}
				}
			</div>
		}
	}
}

// pickerRoute is the picker's path segment and the field its choices post:
// "epg" for the guide, "plex" for the Plex station.
func pickerRoute(plex bool) string {
	if plex {
		return "plex"
	}
	return "epg"
}

func pickerPlaceholder(plex bool) string {
	if plex {
		return "Search the lineup's stations"
	}
	return "Search the guide's channels"
}
