package views

import (
	"context"
	"fmt"
	"hash/fnv"
	"strconv"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/alert"
	"github.com/mediactl/clustarr/ui/components/aspectratio"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/components/field"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/components/menubar"
	"github.com/mediactl/clustarr/ui/components/toast"
	"github.com/mediactl/clustarr/ui/components/toggle"
	"github.com/mediactl/clustarr/ui/components/tooltip"
	"github.com/mediactl/clustarr/ui/components/utils"
	"github.com/mediactl/clustarr/ui/projection"
)

// Library renders the Library page (amendment §A3.4, Task G3-3): every
// catalog item the shared projection lists, its monitored state and phase, a
// link to its detail view, and a toolbar with one "Rescan" for the tab's
// library (2026-09-24, replacing one form per RootFolder): the action fans
// out to every RootFolder of the tab's kinds, since "rescan" (§A3.2) is a
// RootFolder-scoped action, not a per-item one; rootFolders is already
// narrowed to the tab, and an empty list disables the button. It is a full
// page, wrapped in Layout, so a plain GET renders
// something useful even before htmx's SSE extension has connected.
//
// #library-rows holds every card the view keeps (owner, 2026-11-10: "We
// should probably not paginate the libraries so we can mass select and
// scroll more smoothly"): no window, no sentinels. Its stream
// (/events/library/{tab}, the same view) sends no markup: each frame is a
// manifest of the cards the view keeps, in order, with each card's
// fingerprint (CardFingerprint), and ui/static/library.js fetches only the
// cards that are new or changed (POST /library/{tab}/cards), morphs them in,
// drops the ones gone and puts the rest in the manifest's order -- a frame of
// a thousand cards' markup every few seconds was the alternative. The
// toolbar, the filter's chips and dialogs, the shared card action bar
// (cardActionBar) and the bulk bar render outside it.
//
// moves are the root folders the bulk bar's Move offers: the other
// library's, on TV and Anime; none draws no Move.
templ Library(tab projection.Tab, items []projection.LibraryItem, tb LibraryToolbar, rootFolders []catalogv1.RootFolder, jumpsFor []Jump, moves []AddOption) {
	@Shell(Chrome{Title: "Library", Crumbs: []Crumb{{Label: "Library", Href: "/library"}, {Label: tabLabel(tab)}}, Tab: tab, HideScrollbar: true}) {
		<div id="library-page" class="group/library lg:pr-12" data-tab={ string(tab) } data-query={ tb.Query }>
			@libraryToolbar(tab, tb, rootFolders)
			// The large title and the count under it (2026-11-28, the
			// Liquid Glass redesign: "1,294 movies", the noun the tab's).
			<header data-page-header class="mb-3">
				<h1>{ tabLabel(tab) }</h1>
				<p data-page-subtitle class="text-subheadline text-label-2"><span data-filter-count class="tabular-nums" title={ countTitle(tb) } data-noun={ countNoun(tab, 2) }>{ thousands(tb.Shown) }</span> { countNoun(tab, tb.Shown) }</p>
			</header>
			// While the page is selecting, the selection bar takes the
			// toolbar's place (Plex Web's selection screen).
			@bulkBar(tab, moves)
			@viewBar(tb)
			<div
				id="library-rows"
				data-tab={ string(tab) }
				data-total={ fmt.Sprint(len(items)) }
				hx-ext="sse"
				sse-connect={ libraryStreamURL(tab, tb.Query) }
				hx-trigger="sse:art, sse:library-manifest"
				class="space-y-4"
			>
				@LibraryRows(items, tb.Filtered)
			</div>
			@jumpBar(jumpsFor)
			@cardActionBar()
			@cardTooltip()
			@filterDialog(tb.Builder)
			@filterSaveDialog(tb)
			// Where a card's action says how it went.
			@ActionStatusRegion()
		</div>
	}
}

// libraryStreamURL is the tab's stream in the page's view.
func libraryStreamURL(tab projection.Tab, query string) string {
	if query == "" {
		return "/events/library/" + string(tab)
	}
	return "/events/library/" + string(tab) + "?" + query
}

// Jump is one entry of the A-Z bar: a letter, whether any title on the
// tab files under it, the index of its first title (data-index), which
// ui/static/jump.js scrolls to, and Href, the page at that title's card
// for a reader without JavaScript.
type Jump struct {
	Letter  string
	Enabled bool
	Href    string
	Index   int
}

// jumpLetterClass makes every letter share the bar's height evenly and
// its width: plain text, as the Plex apps' A-Z bar is (owner, 2026-11-04).
const jumpLetterClass = "flex min-h-0 w-full flex-1 items-center justify-center text-xs leading-none transition-colors"

// jumpBar is the A-Z bar, as the Plex apps draw it since their redesign
// (owner, 2026-11-04: "much simpler" than Radarr's button group it was):
// a column of plain letters fixed to the right edge of the screen, from
// beneath the top bar and the toolbar where the page starts (3rem, the
// page's 1.5rem of padding and the toolbar's 3rem, which is where 7.5rem
// comes from; a stuck toolbar sits half a rem under the bar, so a rem of
// air opens below it) to the bottom of the viewport, outside the grid's
// flow (the grid keeps clear of it with lg:pr-12). The strip is 44px, as
// Plex Web spaces it (owner, 2026-11-17: "the current scroll bar is too
// close to the letters"): the thumb down its left edge, then 12px of air,
// then the letters in its right 24px -- the thumb was 4px from them. A letter that has titles
// is a muted link that lights on hover; one that has none is dimmer still
// and no link. ui/static/jump.js places the thumb (data-jump-thumb) along
// it in proportion to the cards on screen over the whole grid and drags it
// like a native scrollbar's thumb: a 16px grab strip (w-4) down the strip's
// left edge drawing Plex's slim rounded bar (6px), pointer events on, the
// browser's touch panning off so a touch drag moves the thumb and not the
// page. Each letter carries data-jump for the tests and the script.
templ jumpBar(jumpsFor []Jump) {
	if len(jumpsFor) > 0 {
		<nav data-jump-bar aria-label="Jump to a letter" class="fixed top-[7.5rem] right-0 bottom-0 z-10 hidden w-11 lg:block">
			<div data-jump-thumb class="absolute left-0 z-10 w-4 cursor-grab touch-none select-none active:cursor-grabbing before:absolute before:inset-y-0 before:left-1 before:w-1.5 before:rounded-full before:bg-foreground/25 hover:before:bg-foreground/45 data-dragging:before:bg-foreground/60" style="top: 0; height: 16px"></div>
			<div data-jump-letters class="ml-auto flex h-full w-6 flex-col pb-2">
				for _, j := range jumpsFor {
					if j.Enabled {
						<a href={ templ.SafeURL(j.Href) } class={ jumpLetterClass + " text-muted-foreground hover:text-foreground" } data-jump={ j.Letter } data-index={ fmt.Sprint(j.Index) }>{ j.Letter }</a>
					} else {
						// No link, and no pointer events: the wheel over it
						// scrolls the page.
						<span class={ jumpLetterClass + " pointer-events-none text-muted-foreground/35" } aria-disabled="true" data-jump={ j.Letter }>{ j.Letter }</span>
					}
				}
			</div>
		</nav>
	}
}

// LibraryRows renders #library-rows' contents: the placeholder, shown
// while no card is (a filter's or an empty tab's, as filtered says;
// ui/static/library.js shows and hides it as the stream adds and drops
// cards), and the grid of every card.
templ LibraryRows(items []projection.LibraryItem, filtered bool) {
	if filtered {
		@emptyState("funnel", "Nothing matches this filter.", "Change the filter, or clear it to see the whole tab.", emptyAttrs(len(items)))
	} else {
		@emptyState("library", "Nothing in the library yet.", "Add a title from Add New, or scan a root folder in Settings.", emptyAttrs(len(items)))
	}
	// The column width is the Options menu's poster size
	// (--library-poster-width, set on <html> by ui/static/library.js).
	@item.Group(item.GroupProps{Class: "grid grid-cols-3 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(var(--library-poster-width,160px),1fr))] sm:gap-4", Attributes: templ.Attributes{"data-library-grid": true}}) {
		@LibraryCards(items)
	}
}

// LibraryCards are the cards alone, what POST /library/{tab}/cards
// answers for the stream's new and changed cards.
templ LibraryCards(items []projection.LibraryItem) {
	for _, li := range items {
		@libraryCard(li)
	}
}

// emptyAttrs are the placeholder's attributes: hidden while there are
// cards.
func emptyAttrs(cards int) templ.Attributes {
	attrs := templ.Attributes{"data-empty": "library"}
	if cards > 0 {
		attrs["hidden"] = true
	}
	return attrs
}

// libraryCard renders one LibraryItem as shadcn-templ's item: the whole
// tile is the link to the detail page, the poster is the item's media at
// poster ratio, the title (with the year) and the kind and profile are its
// title and description, and monitored, phase and on-disk are badges.
// Every card carries data-ref, data-kind, data-monitored, data-phase and
// data-hasfile (ruling R8): the UI tests assert on these attributes, not on
// visible copy, so a wording change does not break a test and a markup
// change does not pass one. The card is a div and its link (data-card-link)
// is stretched over it (2026-10-06), so the card can also hold its own
// actions (cardActions), which as buttons may not sit inside a link. While
// the page is selecting (Sonarr's mass editor, 2026-10-06) a click selects
// the card instead of opening it (ui/static/library.js sets
// data-selected), and its mark, hidden otherwise, shows in the poster's
// corner. data-fp is CardFingerprint, which the stream's manifest compares.
// The card's own actions are the page's one cardActionBar, which
// ui/static/library.js moves into the card under the pointer (2026-11-10:
// four buttons a card were half of a card's 10 KB, and a grid of a
// thousand cards renders them all).
templ libraryCard(li projection.LibraryItem) {
	@item.Item(item.Props{
		Variant: item.VariantMuted,
		ID:      CardID(li),
		Class:   "group/card relative flex-col flex-nowrap items-stretch gap-0 rounded-lg border-0 bg-transparent p-0 hover:bg-transparent",
		Attributes: templ.Attributes{
			"data-ref":       li.Ref.String(),
			"data-kind":      string(li.Kind),
			"data-monitored": fmt.Sprintf("%t", li.Monitored),
			"data-phase":     li.Phase,
			"data-hasfile":   fmt.Sprintf("%t", li.HasFile),
			"data-year":      fmt.Sprint(li.Year),
			"data-profile":   li.QualityProfileRef,
			"data-poster":    posterState(li.Poster),
			"data-fp":        CardFingerprint(li),
		},
	}) {
		<a
			data-card-link
			preload="mouseover"
			href={ templ.SafeURL(libraryDetailPath(li)) }
			aria-label={ cardLabel(li) }
			class="absolute inset-0 z-[1] rounded-[inherit] outline-none"
		></a>
		<span data-select-mark aria-hidden="true" class="absolute top-2 left-2 z-10 hidden size-6 items-center justify-center rounded-full border-2 border-white/80 bg-black/40 text-primary-foreground shadow group-data-selecting/library:flex group-data-selected/card:border-primary group-data-selected/card:bg-primary">
			@icon.Icon("check")(icon.Props{Class: "hidden size-4 group-data-selected/card:block"})
		</span>
		// The art is the card (owner, 2026-11-17, after the Plex apps'
		// grids): the poster, rounded, with the status stripe along its
		// foot, and the title and a line under it on the page itself, no
		// surface around them. The ring and the lift are the art's
		// (input.css).
		<div data-card-art class="relative overflow-hidden rounded-lg shadow-lg shadow-black/40 ring-1 ring-white/10">
			@aspectratio.AspectRatio(aspectratio.Props{Ratio: artRatio(li.Kind), Class: "w-full bg-muted", Attributes: templ.Attributes{"data-card-poster": true}}) {
				@posterFill(li.Poster, li.Title, li.ArtKey)
			}
			@cardStatus(projection.LibraryStatus(li))
		</div>
		// The card names its item (2026-11-17: a tab was a wall of unnamed
		// posters wherever the art carries no title, the Music tab above
		// all), then its monitored status and quality profile on one line.
		<div class="min-w-0 px-0.5 pt-1.5 text-[13px] leading-4">
			<div data-card-title class="truncate font-medium text-label-1">{ li.Title }</div>
			if li.Year > 0 {
				<div data-card-year class="truncate pt-0.5 text-label-2">{ fmt.Sprint(li.Year) }</div>
			}
			<div data-card-details class="truncate pt-0.5 text-label-2">
				<span>{ monitoredTitle(li.Monitored) }</span>
				if li.QualityProfileRef != "" {
					<span aria-hidden="true">·</span>
					<span>{ li.QualityProfileRef }</span>
				}
			</div>
		</div>
	}
}

// cardLabel is the card's accessible name and tooltip: the title and year.
// The tooltip is not rendered with the card (cardTooltip).
func cardLabel(li projection.LibraryItem) string {
	if li.Year > 0 {
		return fmt.Sprintf("%s (%d)", li.Title, li.Year)
	}
	return li.Title
}

// cardTooltip is the cards' title tooltip, which no card renders (owner,
// 2026-11-10): a thousand tooltip components were half of every card's
// markup and 40% of the library's load, each found its trigger by a query
// over the whole document as it started, and each was walked by the
// components' lifecycle observer on every later change to the page.
// ui/static/library.js clones this template into a card the first time the
// pointer rests on it or focus enters it, names the card's link its
// trigger and its label the link's aria-label, and the tooltip component
// takes it from there.
templ cardTooltip() {
	<template data-card-tooltip>
		@tooltip.Tooltip(tooltip.Props{ID: "card-tooltip"}) {
			@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom}) {
				<span data-card-tooltip-label></span>
			}
		}
	</template>
}

// cardActionBar is the cards' own actions (2026-10-06, after Sonarr's
// poster buttons), along the poster's foot: Refresh & Scan, Search,
// Monitor or Unmonitor (the one the card's data-monitored calls for), and
// Delete -- the item page's actions, so a card does what its page does
// without opening it. One bar serves every card (2026-11-10): it waits
// hidden in data-card-actions-home, and ui/static/library.js moves it into
// the card under the pointer or holding focus, where it shows while the
// pointer is over the card or focus is inside it, and never while the page
// is selecting, when a click selects. Each but Delete posts through htmx
// to the card's own action route -- library.js puts the card's path in
// place of the placeholder at htmx:configRequest -- and reads the outcome,
// a line saying it was done or why it failed, into the page's
// #action-status (ActionStatus); the live stream then redraws the card.
// Delete opens the page's delete dialog for that card alone (library.js
// reads the card), with the same two checkboxes as the item page's.
templ cardActionBar() {
	<div data-card-actions-home hidden>
		<div
			data-card-actions
			class="pointer-events-none absolute right-0 bottom-0 left-0 z-20 flex justify-center gap-1 bg-gradient-to-t from-black/80 to-transparent px-1 pt-6 pb-1.5 opacity-0 transition-opacity group-hover/card:opacity-100 group-has-[:focus-visible]/card:opacity-100 group-data-selecting/library:hidden"
		>
			@cardAction("refresh", "refresh-cw", "Refresh & Scan", `{"scan":"true"}`, "")
			@cardAction("search", "search", "Search", "", "")
			@cardAction("monitor", "bookmark-x", "Unmonitor", `{"monitored":"false"}`, "group-data-[monitored=false]/card:hidden")
			@cardAction("monitor", "bookmark-check", "Monitor", `{"monitored":"true"}`, "group-data-[monitored=true]/card:hidden")
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIconSm,
				Class:      cardActionClass + " hover:text-destructive",
				Attributes: cardDeleteAttrs(),
			}) {
				@icon.Icon("trash-2")()
			}
		</div>
	</div>
}

// cardActionClass is a card action's look: a light icon on the poster's
// shade.
//
// The bar itself takes no pointer events and its buttons take them only
// while the card is hovered or holds keyboard focus (2026-11-17): on touch
// a tap on a poster's foot did not open the item and the next tap fired
// Monitor, Search, Refresh or Delete, and on a desktop the lower quarter of
// a hovered poster outside the four buttons was dead.
const cardActionClass = "pointer-events-none size-8 rounded-full text-white/90 group-hover/card:pointer-events-auto group-has-[:focus-visible]/card:pointer-events-auto hover:bg-white/20 hover:text-white focus-visible:bg-white/20"

// cardActionPath is the placeholder a card action posts to until
// ui/static/library.js names the card's own route.
const cardActionPath = "/library/card-action"

// cardAction is one of the bar's posting actions: a button posting the
// action through htmx, vals its form fields as hx-vals JSON, class what
// hides it on a card it does not suit.
templ cardAction(action, iconName, label, vals, class string) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeIconSm,
		Class:      cardActionClass + " " + class,
		Attributes: cardActionAttrs(action, label, vals),
	}) {
		@icon.Icon(iconName)()
	}
}

// cardActionAttrs are a posting card action's htmx attributes.
func cardActionAttrs(action, label, vals string) templ.Attributes {
	attrs := templ.Attributes{
		"data-card-action": action,
		"aria-label":       label,
		"title":            label,
		"hx-post":          cardActionPath,
		"hx-target":        "#action-status",
		"hx-swap":          "innerHTML",
	}
	if vals != "" {
		attrs["hx-vals"] = vals
	}
	return attrs
}

// cardDeleteAttrs make the bar's Delete the page's delete dialog's
// trigger for the card it is in.
func cardDeleteAttrs() templ.Attributes {
	attrs := dialog.TriggerFor("library-bulk-delete")
	attrs["data-card-action"] = "delete"
	attrs["data-card-delete"] = true
	attrs["aria-label"] = "Delete"
	attrs["title"] = "Delete"
	return attrs
}

// CardFingerprint is what a card shows, as a short hash: the stream's
// manifest carries it, and ui/static/library.js fetches the card again
// only when it moves. Every field libraryCard renders goes in it
// (TestCardFingerprintMovesWithEveryRenderedField).
func CardFingerprint(li projection.LibraryItem) string {
	h := fnv.New64a()
	for _, part := range []string{
		li.Ref.String(), string(li.Kind), li.Title, fmt.Sprint(li.Year), fmt.Sprint(li.Monitored),
		li.Phase, fmt.Sprint(li.HasFile), li.QualityProfileRef, li.Poster, li.ArtKey,
		projection.LibraryStatus(li),
	} {
		h.Write([]byte(part))
		h.Write([]byte{0})
	}
	return strconv.FormatUint(h.Sum64(), 36)
}

// ActionStatus is what a card's action answers into #action-status: a
// toast saying it was done (shadcn-templ's, since 2026-11-04: the marker
// toast.js turns into one as it lands), in a wrapper carrying the tests'
// data-action-status; ActionErrorToast its why not.
templ ActionStatus(message string) {
	<div data-action-status="ok" role="status" class="contents">
		@toast.Toast(toast.Props{Title: message, Type: toast.TypeSuccess})
	</div>
}

// ActionErrorToast is ActionError as a toast, for an action answered into
// #action-status, the code on the wrapper as ActionError carries it.
templ ActionErrorToast(code, message string) {
	<div data-action-error={ code } role="alert" class="contents">
		@toast.Toast(toast.Props{Title: "Action failed", Description: message, Type: toast.TypeError, Timeout: 8000})
	</div>
}

// posterFill is the poster filling a 2:3 aspect-ratio box: the art at its
// [projection.ArtURL] (lazily, as poster's own doc says -- ui/art.go serves
// it, same-origin, so there is no referrer to withhold, ADR-0011), or a
// placeholder that names the film when there is none, as Radarr's does.
// data-art is its image key, which the SSE art event (ui/static/art.js)
// swaps to a new digest.
templ posterFill(url, title, artKey string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			data-art={ artKey }
			alt={ title }
			loading="lazy"
			class="absolute inset-0 h-full w-full object-cover"
		/>
	} else {
		<div class="absolute inset-0 flex items-center justify-center p-3 text-center text-sm font-medium text-muted-foreground">{ title }</div>
	}
}

// monitoredTitle is the footer's first line, Radarr's capitalisation.
func monitoredTitle(monitored bool) string {
	if monitored {
		return "Monitored"
	}
	return "Unmonitored"
}

// monitoredBadge is the monitored mark every card and header shows: the
// primary badge (Plex gold) when monitored, an outline one when not.
templ monitoredBadge(monitored bool) {
	if monitored {
		@badge.Badge() {
			{ monitoredLabel(monitored) }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			{ monitoredLabel(monitored) }
		}
	}
}

// poster renders the cover art at its [projection.ArtURL] -- ui/art.go's
// own route, same-origin, never a provider's URL (ADR-0011, superseding
// spec 2026-09-23-library-page-design decision 1): lazily, so a long grid
// does not fetch every image at once. It fills its container at poster
// ratio (2:3 -- a square crop takes the faces off), so the caller sizes the
// box. No art yet renders a placeholder of the same shape, never a broken
// image. data-art is its image key, for the SSE art event.
templ poster(url, title, artKey string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			data-art={ artKey }
			alt={ title }
			loading="lazy"
			class="aspect-[2/3] w-full rounded-sm bg-muted object-cover"
		/>
	} else {
		<div class="flex aspect-[2/3] w-full items-center justify-center rounded-sm bg-muted text-xs text-muted-foreground">no art</div>
	}
}

// squarePoster is poster for an image that is square (squareArt): an
// artist's, an album's or an audiobook's, framed 1:1 so nothing is cropped.
templ squarePoster(url, title, artKey string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			data-art={ artKey }
			alt={ title }
			loading="lazy"
			class="aspect-square w-full rounded-sm bg-muted object-cover"
		/>
	} else {
		<div class="flex aspect-square w-full items-center justify-center rounded-sm bg-muted text-xs text-muted-foreground">no art</div>
	}
}

// itemCrumbs is an item's trail: Library, its tab, itself.
func itemCrumbs(li projection.LibraryItem) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title},
	}
}

// childCrumbs is the trail of a page under an item -- a season, the
// albums, the books -- with the item linked and the page last.
func childCrumbs(li projection.LibraryItem, label string) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title, Href: libraryDetailPath(li)},
		{Label: label},
	}
}

// Choice is one entry of a toolbar menu: its ?sort or ?filter value, the
// label, the link to the page in that view, whether it is the current one
// and, for the current sort, its direction.
type Choice struct {
	Key    string
	Label  string
	Href   string
	Active bool
	Dir    string
}

// LibraryToolbar is the toolbar's state and menus: the current view for
// the tests (data-current-sort, -dir and -filter) and the Sort and Filter
// entries the handler built; since 2026-11-10 also the view's query (the
// page's own, for a saved filter and the stream), how many cards it keeps
// of the tab's, the active filter's chips and the custom filter builder.
type LibraryToolbar struct {
	Tab       string
	Sort      string
	Dir       string
	Filter    string
	Sorts     []Choice
	Filters   []Choice
	Query     string
	Shown     int
	Total     int
	Filtered  bool
	Chips     []FilterChip
	ClearHref string
	Builder   FilterBuilder
}

// libraryToolbar is the library's page actions (the Liquid Glass redesign,
// 2026-11-28; Sonarr's two-sided row from 2026-09-24 until then), one
// trailing set pinned into the page's toolbar row (input.css): the mass
// editor's Select (Stop Selecting while it is on), then one glass group of
// the Filter, Sort and Options menus -- Options holding the tab's single
// Rescan (rescanForm, §A3.2's third action) -- then Add, the tab's Add New
// page as a prominent circle. It renders outside the SSE-swapped rows: the view only changes
// when the reader chooses, and every menu link swaps the whole page as the
// sidebar's tab entries do so the stream reconnects with the new view.
templ libraryToolbar(tab projection.Tab, tb LibraryToolbar, rootFolders []catalogv1.RootFolder) {
	@toolbar(templ.Attributes{"data-current-sort": tb.Sort, "data-current-dir": tb.Dir, "data-current-filter": tb.Filter}) {
		@rescanForm(tab, len(rootFolders) > 0)
		@selectToggle()
		@toolbarGroup("View") {
			@filterMenu(tb)
			@toolbarSeparator()
			@viewMenu("Sort", "arrow-up-down", "Sort by", "data-sort", tb.Sorts)
			@toolbarSeparator()
			@optionsMenu(len(rootFolders) > 0)
		}
		@addNewButton(tab)
	}
}

// addNewButton is the toolbar's "Add New" (2026-09-29): a link to the
// tab's search-and-add page, Radarr's Movies > Add New.
templ addNewButton(tab projection.Tab) {
	@button.Button(button.Props{
		Href:    "/library/" + string(tab) + "/add",
		Variant: button.VariantDefault,
		Size:    button.SizeIcon,
		Attributes: templ.Attributes{
			"data-action":         "add-new",
			"data-toolbar-button": true,
			"title":               "Add a new " + addLabel(tab),
			"aria-label":          "Add a new " + addLabel(tab),
		},
	}) {
		@icon.Icon("plus")(icon.Props{Class: "size-5"})
	}
}

// addLabel is what the tab's Add New adds (2026-11-10 design D1: each tab
// adds its own kind).
func addLabel(tab projection.Tab) string {
	switch tab {
	case projection.TabTV:
		return "series"
	case projection.TabAnime:
		// Not "series": the Add New menu lists TV's beside it.
		return "anime"
	case projection.TabMusic:
		return "artist"
	case projection.TabBooks:
		return "author"
	case projection.TabComics:
		return "comic"
	case projection.TabAudiobooks:
		return "audiobook"
	}
	return "movie"
}

// rescanForm is the toolbar's "Rescan" (2026-09-24): one form posting the
// tab to /library/rescan, whose handler creates a LibraryScan for every
// RootFolder of the tab's kinds; the return field brings the reader back to
// this tab. With no RootFolder of those kinds the button is disabled and
// its title says so, rather than posting a request that can only fail.
templ rescanForm(tab projection.Tab, enabled bool) {
	<form id="library-rescan" hidden method="post" action="/library/rescan" hx-post="/library/rescan" hx-target="#action-status" hx-swap="innerHTML" data-tab={ string(tab) }>
		<input type="hidden" name="tab" value={ string(tab) }/>
		<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
		<button type="submit" data-action="rescan" title={ rescanTitle(tab, enabled) } disabled?={ !enabled }>Rescan</button>
	</form>
}

// rescanTitle is the Rescan button's tooltip: what it scans, or why it
// cannot.
func rescanTitle(tab projection.Tab, enabled bool) string {
	if !enabled {
		return "No root folder holds " + tabLabel(tab) + " yet; add one under Settings"
	}
	return "Rescan every " + tabLabel(tab) + " root folder"
}

// viewMenu is one toolbar menu: a menubar trigger and a menu of links,
// the current entry checked and, for a sort, marked with its direction.
// attr names the data attribute each entry carries its key in.
templ viewMenu(label, iconName, heading, attr string, choices []Choice) {
	@toolbarMenu(iconName, label) {
		@menubar.Label() {
			{ heading }
		}
		for _, c := range choices {
			@menubar.Item(menubar.ItemProps{Href: c.Href, Attributes: choiceAttributes(attr, c)}) {
				if c.Active {
					@icon.Icon("check")()
				} else {
					<span class="size-4"></span>
				}
				<span class="flex-1">{ c.Label }</span>
				switch c.Dir {
					case "asc":
						@icon.Icon("arrow-up")()
					case "desc":
						@icon.Icon("arrow-down")()
				}
			}
		}
	}
}

// filterMenu is the Filter menu: Radarr's and Sonarr's presets, then the
// custom filters -- the ones this browser keeps for the tab
// (data-saved-filters, which ui/static/library.js fills from the
// template), the builder, and saving the current view among them.
templ filterMenu(tb LibraryToolbar) {
	@toolbarMenu("funnel", "Filter") {
		@menubar.Label() {
			Filter
		}
		for _, c := range tb.Filters {
			@menubar.Item(menubar.ItemProps{Href: c.Href, Attributes: choiceAttributes("data-filter", c)}) {
				if c.Active {
					@icon.Icon("check")()
				} else {
					<span class="size-4"></span>
				}
				<span class="flex-1">{ c.Label }</span>
			}
		}
		@menubar.Separator()
		@menubar.Label() {
			Custom Filters
		}
		<div data-saved-filters data-tab={ tb.Tab } class="contents"></div>
		<template data-saved-filter-template>
			@menubar.Item(menubar.ItemProps{Href: "#", Attributes: templ.Attributes{"data-saved-filter": ""}}) {
				@icon.Icon("bookmark")()
				<span class="flex-1 truncate" data-saved-filter-name></span>
				<span data-saved-filter-delete role="button" aria-label="Forget this filter" title="Forget this filter" class="rounded-sm p-0.5 text-muted-foreground hover:text-destructive">
					@icon.Icon("x")(icon.Props{Class: "size-3.5"})
				</span>
			}
		</template>
		@menubar.Item(menubar.ItemProps{Attributes: templ.Attributes{"data-open-dialog": filterDialogID}}) {
			@icon.Icon("list-filter")()
			<span class="flex-1">Custom Filter…</span>
		}
		@menubar.Item(menubar.ItemProps{Disabled: !tb.Filtered, Attributes: templ.Attributes{"data-open-dialog": filterSaveDialogID}}) {
			@icon.Icon("bookmark-plus")()
			<span class="flex-1">Save Current Filter…</span>
		}
	}
}

// selectToggle turns the mass editor on: ui/static/library.js sets
// data-selecting on #library-page, which hides the toolbar and shows the
// cards' marks and the selection bar, whose Done turns it off again and
// whose Select All selects every card.
templ selectToggle() {
	@toggle.Toggle(toggle.Props{Pressed: utils.Ptr(false), Class: "glass h-9 rounded-full px-4 text-[15px] font-semibold text-label-1", Attributes: templ.Attributes{"data-action": "select-toggle", "data-toolbar-button": true}}) {
		<span class="group-data-selecting/library:hidden">Select</span>
		<span class="hidden group-data-selecting/library:inline">Done</span>
	}
}

// PosterSize is one of the Options menu's poster sizes: the grid's
// minimum column width.
type PosterSize struct {
	Key   string
	Label string
	Width string
}

// PosterSizes are Sonarr's three, medium the default.
var PosterSizes = []PosterSize{
	{"small", "Small", "120px"},
	{"medium", "Medium", "160px"},
	{"large", "Large", "220px"},
}

// optionsMenu is Sonarr's Options: the poster size and whether each card
// shows its details (monitored and quality profile) under the poster.
// Both are the reader's own and stay in the browser: ui/static/library.js
// applies them to every library page from localStorage, setting
// --library-poster-width and data-library-details on <html>.
templ optionsMenu(rescan bool) {
	@toolbarMenu("ellipsis", "Options") {
		@menubar.Item(menubar.ItemProps{Disabled: !rescan, Attributes: templ.Attributes{"data-submit-form": "library-rescan", "data-menu-action": "rescan"}}) {
			@icon.Icon("refresh-cw")()
			Rescan Library
		}
		@menubar.Separator()
		@menubar.Label() {
			Poster size
		}
		@menubar.RadioGroup(menubar.RadioGroupProps{DefaultValue: "medium", Attributes: templ.Attributes{"data-poster-sizes": true}}) {
			for _, sz := range PosterSizes {
				@menubar.RadioItem(menubar.RadioItemProps{Value: sz.Key, Attributes: templ.Attributes{"data-poster-size": sz.Key, "data-width": sz.Width}}) {
					{ sz.Label }
				}
			}
		}
		@menubar.Separator()
		@menubar.CheckboxItem(menubar.CheckboxItemProps{DefaultChecked: false, Attributes: templ.Attributes{"data-library-option": "details"}}) {
			Show Details
		}
	}
}

// bulkBar is the mass editor's bar (Sonarr's, 2026-10-06), shown at the
// foot of the screen while the page is selecting: how many cards are
// selected and what to do with them, one POST to /library/{tab}/bulk per
// action, the selected items filled in by ui/static/library.js as
// repeated "item" fields (namespace/kind/name) when a [data-bulk-form]
// submits. Delete asks first, as the item page's Delete does, in a dialog
// with the same two checkboxes; its form is the dialog's own, since the
// dialog moves its content to <body> when it opens. A card's own Delete
// opens the same dialog for that item alone (cardActions). The buttons stay
// disabled until something is selected.
//
// Move, on TV and Anime, stores the selected series under a root folder of
// the other library (moves; the first is the default), in a dialog of its
// own form as Delete's is: the root folder decides the library, and the
// files follow one at a time (anime library design, 2026-11-25, §5).
templ bulkBar(tab projection.Tab, moves []AddOption) {
	<div data-bulk-bar class="fixed bottom-6 left-1/2 z-40 hidden h-[3.25rem] max-w-[calc(100%-2rem)] -translate-x-1/2 items-center gap-1 rounded-full pr-2 pl-5 group-data-selecting/library:flex">
		<span class="min-w-0 pr-2 text-headline whitespace-nowrap text-label-1">
			<span data-selected-count>0</span> <span class="max-sm:hidden" data-selected-noun>items</span> Selected
		</span>
		<div class="flex min-w-0 items-center gap-0.5 overflow-x-auto [scrollbar-width:none]">
			<form id="library-bulk" method="post" action={ templ.URL(bulkPath(tab)) } hx-post={ bulkPath(tab) } hx-target="#action-status" hx-swap="innerHTML" data-bulk-form class="contents">
				<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
				@bulkButton("monitor", "bookmark-check", "Monitor")
				@bulkButton("unmonitor", "bookmark-x", "Unmonitor")
				@bulkButton("search", "search", "Search")
				@bulkButton("refresh", "refresh-cw", "Refresh & Scan")
			</form>
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"data-action": "select-all", "title": "Select all", "aria-label": "Select all"}}) {
				@icon.Icon("check-check")()
				<span class="max-lg:sr-only">Select All</span>
			}
			if len(moves) > 0 {
				@dialog.Dialog(dialog.Props{ID: "library-bulk-move"}) {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Disabled: true, Attributes: bulkMoveTrigger(ctx)}) {
						@icon.Icon("folder-input")()
						<span class="max-lg:sr-only">Move</span>
					}
					@dialog.Content() {
						@dialog.Header() {
							@dialog.Title() {
								Move the selected series
							}
							@dialog.Description() {
								The root folder a series is stored under decides its library. Its files follow, one at a time, keeping their names.
							}
						}
						<form method="post" action={ templ.URL(bulkPath(tab)) } hx-post={ bulkPath(tab) } hx-target="#action-status" hx-swap="innerHTML" data-bulk-form class="space-y-3">
							<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
							<input type="hidden" name="action" value="move"/>
							@addSelect("rootFolder", "bulk-move", "Move to", moves, moves[0].Value)
							@dialog.Footer() {
								@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
									Cancel 
								}
								@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-action": "bulk-move-confirm"}}) {
									Move 
								}
							}
						</form>
					}
				}
			}
			@dialog.Dialog(dialog.Props{ID: "library-bulk-delete"}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "text-destructive", Disabled: true, Attributes: bulkDeleteTrigger(ctx)}) {
					@icon.Icon("trash-2")()
					<span class="max-lg:sr-only">Delete</span>
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Delete <span data-delete-subject data-default={ "the selected " + findNoun(tab) }>{ "the selected " + findNoun(tab) }</span>
						}
						@dialog.Description() {
							<span data-delete-count>0</span> selected
						}
					}
					<form method="post" action={ templ.URL(bulkPath(tab)) } hx-post={ bulkPath(tab) } hx-target="#action-status" hx-swap="innerHTML" data-bulk-form class="space-y-3">
						<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
						<input type="hidden" name="action" value="delete"/>
						@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
							@checkbox.Checkbox(checkbox.Props{ID: "bulk-delete-files", Name: "files", Value: "true"})
							@field.Content() {
								@field.Label(field.LabelProps{For: "bulk-delete-files"}) {
									Delete files and folders
								}
								@field.Description(field.DescriptionProps{Class: "text-destructive"}) {
									This permanently deletes every selected folder and cannot be undone.
								}
							}
						}
						@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
							@checkbox.Checkbox(checkbox.Props{ID: "bulk-delete-exclude", Name: "exclude", Value: "true"})
							@field.Label(field.LabelProps{For: "bulk-delete-exclude"}) {
								Add import list exclusions
							}
						}
						@dialog.Footer() {
							@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
								Cancel 
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-action": "bulk-delete-confirm"}}) {
								Delete 
							}
						}
					</form>
				}
			}
		</div>
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "hidden", Attributes: templ.Attributes{"data-action": "select-toggle", "aria-label": "Stop selecting", "title": "Stop selecting (Esc)"}}) {
			@icon.Icon("x")()
		}
	</div>
}

// bulkButton is one of the bulk bar's actions: a submit of #library-bulk
// naming the action, disabled until something is selected.
templ bulkButton(action, iconName, label string) {
	@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm, Disabled: true, Attributes: templ.Attributes{"name": "action", "value": action, "data-bulk-action": action, "title": label, "aria-label": label}}) {
		@icon.Icon(iconName)()
		<span class="max-lg:sr-only">{ label }</span>
	}
}

// bulkDeleteTrigger is the bulk Delete's dialog trigger, a bulk action
// like the others for library.js' enabling.
func bulkDeleteTrigger(ctx context.Context) templ.Attributes {
	attrs := dialog.Trigger(ctx)
	attrs["data-bulk-action"] = "delete"
	return attrs
}

// bulkMoveTrigger is the bulk Move's dialog trigger, a bulk action like
// Delete's: disabled until something is selected.
func bulkMoveTrigger(ctx context.Context) templ.Attributes {
	attrs := dialog.Trigger(ctx)
	attrs["data-bulk-action"] = "move"
	attrs["title"] = "Move to another library"
	return attrs
}

// TabLabel is the tab's name as the page shows it.
func TabLabel(tab projection.Tab) string { return tabLabel(tab) }

// bulkPath is the tab's bulk action route.
func bulkPath(tab projection.Tab) string { return "/library/" + string(tab) + "/bulk" }

// choiceAttributes are a menu entry's attributes: its key under attr, the
// htmx swap of #library-page the tabs use (so the URL follows and the
// stream reconnects in the new view) and data-active on the current one.
func choiceAttributes(attr string, c Choice) templ.Attributes {
	attrs := templ.Attributes{
		attr:          c.Key,
		"hx-get":      c.Href,
		"hx-push-url": "true",
		"hx-target":   "#library-page",
		"hx-select":   "#library-page",
		"hx-swap":     "outerHTML",
	}
	if c.Active {
		attrs["data-active"] = true
	}
	return attrs
}

// ActionError renders the visible failure state for a write action (§A3.2's
// three actions): actions.ErrNoWriter in particular -- a ui process with no
// cluster configured has no writer, and this page must still say so rather
// than silently doing nothing. code is a stable machine-readable
// reason ("no-writer", "invalid" or "failed") carried on data-action-error
// (ruling R8), separate from message, which is the human-readable detail.
templ ActionError(code, message string) {
	@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"data-action-error": code, "role": "alert"}}) {
		@icon.CircleAlert()
		@alert.Title() {
			Action failed
		}
		@alert.Description() {
			{ message }
		}
	}
}

// tabLabel and tabClass render the tab strip: the label a person reads, and
// the current tab underlined.
func tabLabel(tab projection.Tab) string {
	switch tab {
	case projection.TabMovies:
		return "Movies"
	case projection.TabTV:
		return "TV"
	case projection.TabAnime:
		return "Anime"
	case projection.TabMusic:
		return "Music"
	case projection.TabBooks:
		return "Books"
	case projection.TabComics:
		return "Comics"
	case projection.TabAudiobooks:
		return "Audiobooks"
	default:
		return string(tab)
	}
}

// posterState is the card's data-poster value: "art" when the card has one
// to show (its [projection.ArtURL], same-origin -- ADR-0011), "none" when
// it shows the placeholder.
func posterState(url string) string {
	if url != "" {
		return "art"
	}
	return "none"
}

// monitoredLabel mirrors downloads.templ's
// clientEnabledLabel/clientEnabledBadgeClass for the identical boolean-badge
// shape.
func monitoredLabel(monitored bool) string {
	if monitored {
		return "monitored"
	}
	return "unmonitored"
}

// phaseTone is the colour alone, for a badge component that brings its own
// shape: the library card's phase badge keeps these semantics (the tests
// assert on them) over the component's neutral secondary colours.
func phaseTone(phase string) string {
	switch phase {
	case "CutoffUnmet", "CutoffUnevaluated", "Delayed":
		// CutoffUnevaluated (Movie, Episode) is an item whose quality
		// profile could not be resolved: like CutoffUnmet, something is
		// wrong with it that the user should look at, so it shares the
		// warning colour rather than the neutral in-flight sky blue.
		return "bg-amber-500/20 text-amber-300"
	case "Imported", "Transcoded":
		// Transcoded (Movie, Episode) is a transcoded file, which is final:
		// as settled as Imported, so it shares the "done" colour.
		return "bg-emerald-500/20 text-emerald-300"
	case "Unmonitored":
		return "bg-slate-500/20 text-slate-300"
	default:
		return "bg-sky-500/20 text-sky-300"
	}
}

// libraryDetailPath builds a LibraryItem's detail page path --
// /library/<namespace>/<kind>/<name>, matching ui/routes.go's
// "GET /library/{namespace}/{kind}/{name}" pattern -- as a plain string, for
// a hidden form field's value as much as an href.
func libraryDetailPath(item projection.LibraryItem) string {
	return fmt.Sprintf("/library/%s/%s/%s", item.Ref.Namespace, item.Kind, item.Ref.Name)
}

// libraryActionURL builds the POST target for one of a LibraryItem's own
// actions ("monitor" or "search"), appended to its detail path.
func libraryActionURL(item projection.LibraryItem, action string) string {
	return fmt.Sprintf("%s/%s", libraryDetailPath(item), action)
}

// CardID names a library card: the stream's manifest lists cards by it,
// ui/static/library.js finds, morphs, moves and drops them by it (a
// morphed card keeps its node -- its loaded poster, its hover state, its
// tooltip), and an A-Z letter links to its first title's card by it.
func CardID(li projection.LibraryItem) string {
	return "card-" + string(li.Kind) + "-" + li.Ref.Namespace + "-" + li.Ref.Name
}

// cardStatus is a poster's status, shown only when something is the
// matter (2026-11-28, the Liquid Glass redesign: a complete item is quiet):
// a clear-glass circle at the art's foot with the state's glyph -- missing,
// in flight, below its cutoff, unmonitored -- and the art dimmed when the
// item has no file. data-status names the state for the tests and the
// stream's fingerprint either way.
templ cardStatus(status string) {
	<div data-status={ status } data-tone={ statusTone(status) } class={ "pointer-events-none absolute inset-0 " + statusDim(status) }>
		if g := statusGlyph(status); g != "" {
			<span data-glass="clear" class={ "absolute right-1.5 bottom-1.5 flex size-[22px] items-center justify-center rounded-full " + statusGlyphTone(status) } title={ statusWord(status) }>
				@icon.Icon(g)(icon.Props{Class: "size-3.5"})
			</span>
		}
	</div>
}

// statusTone is what a projection.LibraryStatus means (the theme's status
// semantics): ok on disk, warn below the cutoff, busy in flight, missing,
// idle unmonitored.
func statusTone(status string) string {
	switch status {
	case "downloaded":
		return "ok"
	case "cutoff-unmet":
		return "warn"
	case "downloading":
		return "busy"
	case "missing":
		return "missing"
	}
	return "idle"
}

func statusGlyph(status string) string {
	switch status {
	case "missing":
		return "circle-arrow-down"
	case "downloading":
		return "loader"
	case "cutoff-unmet":
		return "triangle-alert"
	case "unmonitored":
		return "bookmark-x"
	case "deleting":
		return "trash-2"
	}
	return ""
}

func statusGlyphTone(status string) string {
	switch status {
	case "downloading":
		return "text-sky-400"
	case "cutoff-unmet":
		return "text-amber-300"
	}
	return "text-white"
}

func statusWord(status string) string {
	switch status {
	case "missing":
		return "Missing"
	case "downloading":
		return "Downloading"
	case "cutoff-unmet":
		return "Below the cutoff"
	case "unmonitored":
		return "Unmonitored"
	case "deleting":
		return "Deleting"
	}
	return ""
}

// statusDim dims a poster whose item has no file yet.
func statusDim(status string) string {
	if status == "missing" {
		return "bg-black/35"
	}
	return ""
}

// countNoun is the tab's noun for a count of n.
func countNoun(tab projection.Tab, n int) string {
	one, many := "item", "items"
	switch tab {
	case projection.TabMovies:
		one, many = "movie", "movies"
	case projection.TabTV, projection.TabAnime:
		one, many = "series", "series"
	case projection.TabMusic:
		one, many = "artist", "artists"
	case projection.TabBooks:
		one, many = "title", "titles"
	case projection.TabComics:
		one, many = "comic", "comics"
	case projection.TabAudiobooks:
		one, many = "audiobook", "audiobooks"
	}
	if n == 1 {
		return one
	}
	return many
}

// thousands writes n with thousands separators, as Apple's apps do.
func thousands(n int) string {
	if n < 0 {
		return "-" + thousands(-n)
	}
	s := fmt.Sprint(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	return s
}

// stripeColour is the background colour a projection.LibraryStatus takes in
// an item page's status fact: green on disk, amber on disk below the
// cutoff, blue in flight, red monitored and missing, gray unmonitored.
func stripeColour(status string) string {
	switch status {
	case "downloaded":
		return "bg-emerald-500"
	case "cutoff-unmet":
		return "bg-amber-500"
	case "downloading":
		return "bg-sky-500"
	case "missing":
		return "bg-red-500"
	case "deleting":
		return "bg-slate-400"
	default:
		return "bg-slate-500"
	}
}
