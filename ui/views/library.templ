package views

import (
	"fmt"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/aspectratio"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/buttongroup"
	"github.com/mediactl/clustarr/ui/components/dropdownmenu"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/components/tabs"
	"github.com/mediactl/clustarr/ui/components/tooltip"
	"github.com/mediactl/clustarr/ui/paging"
	"github.com/mediactl/clustarr/ui/projection"
)

// Library renders the Library page (amendment §A3.4, Task G3-3): every
// catalog item the shared projection lists, its monitored state and phase, a
// link to its detail view, and a rescan toolbar -- one form per known
// RootFolder, since "rescan" (§A3.2) is a RootFolder-scoped action, not a
// per-item one. It is a full page, wrapped in Layout, so a plain GET renders
// something useful even before htmx's SSE extension has connected.
//
// #library-rows is the sse-swap target, mirroring the Pipeline and Downloads
// pages: htmx's SSE extension replaces that element's innerHTML with the
// named event's data, so everything inside it (and only what's inside it)
// must be exactly what LibraryRows renders -- the toolbar renders outside the
// swapped element, deliberately: the set of RootFolders does not move on the
// same cadence as item status, mirroring downloads.templ's own client-cards
// placement.
templ Library(tab projection.Tab, p paging.Page, items []projection.LibraryItem, tb LibraryToolbar, rootFolders []catalogv1.RootFolder, jumpsFor []Jump) {
	@Shell("Library", []Crumb{{Label: "Library", Href: "/library"}, {Label: tabLabel(tab)}}) {
		<div id="library-page">
			@libraryToolbar(tb, rootFolders)
			<div class="flex gap-4">
			<div class="min-w-0 flex-1 space-y-4">
				@libraryTabs(tab)
				<div
					id="library-rows"
					data-tab={ string(tab) }
					hx-ext="sse"
					sse-connect={ "/events/library/" + string(tab) + p.Query(p.Number) }
					sse-swap="library"
					class="space-y-4"
				>
					@LibraryList(tab, p, items)
				</div>
			</div>
			@jumpBar(jumpsFor)
			</div>
		</div>
	}
}

// Jump is one entry of the A-Z bar: a letter, whether any title on the
// tab files under it, and the link to the page where those titles begin.
type Jump struct {
	Letter  string
	Enabled bool
	Href    string
}

// jumpBar is Radarr's A-Z bar as a vertical button group down the right
// edge: a link per letter that has titles, a disabled button per letter
// that does not, each carrying data-jump for the tests.
templ jumpBar(jumpsFor []Jump) {
	if len(jumpsFor) > 0 {
		<div data-jump-bar class="sticky top-16 hidden self-start lg:block">
			@buttongroup.ButtonGroup(buttongroup.Props{Orientation: buttongroup.OrientationVertical}) {
				for _, j := range jumpsFor {
					if j.Enabled {
						@button.Button(button.Props{Href: j.Href, Size: button.SizeXs, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-jump": j.Letter}}) { { j.Letter } }
					} else {
						@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Disabled: true, Attributes: templ.Attributes{"data-jump": j.Letter}}) { { j.Letter } }
					}
				}
			}
		</div>
	}
}

// LibraryList is what #library-rows holds and what every
// /events/library/{tab} frame carries: the pager, the page's cards, the
// pager again. items is already the tab's page window.
templ LibraryList(tab projection.Tab, p paging.Page, items []projection.LibraryItem) {
	@Pager(p, "/library/"+string(tab))
	@LibraryRows(items)
	@Pager(p, "/library/"+string(tab))
}

// libraryTabs renders the tab strip -- one link per projection.Tab, in
// the order Tabs() lists them, the current one marked -- so every tab is
// reachable by a plain link, no JavaScript needed to switch.
templ libraryTabs(current projection.Tab) {
	@tabs.Tabs(tabs.Props{DefaultValue: string(current), Attributes: templ.Attributes{"data-tabs": true}}) {
		@tabs.List(tabs.ListProps{Variant: tabs.VariantLine}) {
			for _, tab := range projection.Tabs() {
				@tabs.Trigger(tabs.TriggerProps{
					Value: string(tab),
					Attributes: templ.Attributes{
						"hx-get":      "/library/" + string(tab),
						"hx-push-url": "true",
						"hx-target":   "#library-page",
						"hx-select":   "#library-page",
						"hx-swap":     "outerHTML",
					},
				}) {
					{ tabLabel(tab) }
				}
			}
		}
	}
}

// LibraryRows renders the dynamic part of the Library page: the "nothing
// collected yet" placeholder or the item grid. This is also what
// /events/library renders into each SSE event's data, so the initial page
// render and every live update produce byte-for-byte the same markup for
// #library-rows's contents.
templ LibraryRows(items []projection.LibraryItem) {
	if len(items) == 0 {
		<p class="text-muted-foreground">Nothing in the library yet.</p>
	}
	@item.Group(item.GroupProps{Class: "grid grid-cols-[repeat(auto-fill,minmax(160px,1fr))] gap-3"}) {
		for _, li := range items {
			@libraryCard(li)
		}
	}
}

// libraryCard renders one LibraryItem as shadcn-templ's item: the whole
// tile is the link to the detail page, the poster is the item's media at
// poster ratio, the title (with the year) and the kind and profile are its
// title and description, and monitored, phase and on-disk are badges.
// Every card carries data-ref, data-kind, data-monitored, data-phase and
// data-hasfile (ruling R8): the UI tests assert on these attributes, not on
// visible copy, so a wording change does not break a test and a markup
// change does not pass one.
templ libraryCard(li projection.LibraryItem) {
	@item.Item(item.Props{
		Variant: item.VariantMuted,
		Href:    libraryDetailPath(li),
		Class:   "flex-col items-stretch gap-0 overflow-hidden border-0 bg-card p-0 hover:bg-card",
		Attributes: templ.Attributes{
			"data-ref":       li.Ref.String(),
			"data-kind":      string(li.Kind),
			"data-monitored": fmt.Sprintf("%t", li.Monitored),
			"data-phase":     li.Phase,
			"data-hasfile":   fmt.Sprintf("%t", li.HasFile),
			"data-year":      fmt.Sprint(li.Year),
			"data-profile":   li.QualityProfileRef,
			"data-poster":    posterState(li.Poster),
		},
	}) {
		@tooltip.Tooltip() {
			@aspectratio.AspectRatio(aspectratio.Props{Ratio: "2/3", Class: "w-full bg-muted", Attributes: tooltip.Trigger(ctx)}) {
				@posterFill(li.Poster, li.Title)
			}
			@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom}) {
				{ li.Title }
				if li.Year > 0 {
					({ fmt.Sprint(li.Year) })
				}
			}
		}
		<div class={ stripeClass(projection.LibraryStatus(li)) } data-status={ projection.LibraryStatus(li) }></div>
		<div class="px-2 py-1.5 text-center text-xs leading-5">
			<div>{ monitoredTitle(li.Monitored) }</div>
			<div class="truncate text-muted-foreground">{ li.QualityProfileRef }</div>
		</div>
	}
}

// posterFill is the poster filling a 2:3 aspect-ratio box: the hotlinked
// art (lazily, without a referrer, as poster's own doc says), or a
// placeholder that names the film when there is none, as Radarr's does.
templ posterFill(url, title string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			alt={ title }
			loading="lazy"
			referrerpolicy="no-referrer"
			class="absolute inset-0 h-full w-full object-cover"
		/>
	} else {
		<div class="absolute inset-0 flex items-center justify-center p-3 text-center text-sm font-medium text-muted-foreground">{ title }</div>
	}
}

// monitoredTitle is the footer's first line, Radarr's capitalisation.
func monitoredTitle(monitored bool) string {
	if monitored {
		return "Monitored"
	}
	return "Unmonitored"
}

// monitoredBadge is the monitored mark every card and header shows: the
// primary badge (Plex gold) when monitored, an outline one when not.
templ monitoredBadge(monitored bool) {
	if monitored {
		@badge.Badge() { { monitoredLabel(monitored) } }
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { { monitoredLabel(monitored) } }
	}
}

// poster renders the cover art the provider published, hotlinked (spec
// 2026-09-23-library-page-design, decision 1): lazily, so a long grid does
// not fetch every image at once, and without a referrer, so the provider's
// image CDN never learns the UI's address. It fills its container at
// poster ratio (2:3 -- a square crop takes the faces off), so the caller
// sizes the box. No art yet renders a placeholder of the same shape, never
// a broken image.
templ poster(url, title string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			alt={ title }
			loading="lazy"
			referrerpolicy="no-referrer"
			class="aspect-[2/3] w-full rounded-sm bg-muted object-cover"
		/>
	} else {
		<div class="flex aspect-[2/3] w-full items-center justify-center rounded-sm bg-muted text-xs text-muted-foreground">no art</div>
	}
}

// itemCrumbs is an item's trail: Library, its tab, itself.
func itemCrumbs(li projection.LibraryItem) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title},
	}
}

// childCrumbs is the trail of a page under an item -- a season, the
// albums, the books -- with the item linked and the page last.
func childCrumbs(li projection.LibraryItem, label string) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title, Href: libraryDetailPath(li)},
		{Label: label},
	}
}

// Choice is one entry of a toolbar menu: its ?sort or ?filter value, the
// label, the link to the page in that view, whether it is the current one
// and, for the current sort, its direction.
type Choice struct {
	Key    string
	Label  string
	Href   string
	Active bool
	Dir    string
}

// LibraryToolbar is the toolbar's state and menus: the current view for
// the tests (data-current-sort, -dir and -filter) and the Sort and Filter
// entries the handler built.
type LibraryToolbar struct {
	Sort    string
	Dir     string
	Filter  string
	Sorts   []Choice
	Filters []Choice
}

// libraryToolbar is Radarr's toolbar row (design 2026-09-24, views/toolbar.templ): the actions
// on the left -- one "Rescan" form per known RootFolder, §A3.2's third
// action, reading config-like data that needs no live stream of its own,
// as downloads.templ's client cards do -- and the Sort and Filter menus on
// the right. It renders outside the SSE-swapped rows: the view only changes
// when the reader chooses, and every menu link swaps the whole page as the
// tabs do so the stream reconnects with the new view.
templ libraryToolbar(tb LibraryToolbar, rootFolders []catalogv1.RootFolder) {
	@toolbar(templ.Attributes{"data-current-sort": tb.Sort, "data-current-dir": tb.Dir, "data-current-filter": tb.Filter}) {
		@toolbarGroup() {
			for _, rf := range rootFolders {
				@toolbarForm("/library/rescan", []Field{{"namespace", rf.Namespace}, {"rootFolder", rf.Name}, {"return", "/library"}}, "refresh-cw", "Rescan "+rf.Name, "rescan", templ.Attributes{"data-root-folder": rf.Name})
			}
		}
		@toolbarGroup() {
			@viewMenu("Sort", "arrow-up-down", "Sort by", "data-sort", tb.Sorts)
			@viewMenu("Filter", "funnel", "Filter", "data-filter", tb.Filters)
		}
	}
}

// viewMenu is one toolbar menu: a button trigger and a dropdown of links,
// the current entry checked and, for a sort, marked with its direction.
// attr names the data attribute each entry carries its key in.
templ viewMenu(label, iconName, heading, attr string, choices []Choice) {
	@dropdownmenu.DropdownMenu() {
		@toolbarTrigger(iconName, label, dropdownmenu.Trigger(ctx))
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd}) {
			@dropdownmenu.Label() {
				{ heading }
			}
			for _, c := range choices {
				@dropdownmenu.Item(dropdownmenu.ItemProps{Href: c.Href, Attributes: choiceAttributes(attr, c)}) {
					if c.Active {
						@icon.Icon("check")()
					} else {
						<span class="size-4"></span>
					}
					<span class="flex-1">{ c.Label }</span>
					switch c.Dir {
						case "asc":
							@icon.Icon("arrow-up")()
						case "desc":
							@icon.Icon("arrow-down")()
					}
				}
			}
		}
	}
}

// choiceAttributes are a menu entry's attributes: its key under attr, the
// htmx swap of #library-page the tabs use (so the URL follows and the
// stream reconnects in the new view) and data-active on the current one.
func choiceAttributes(attr string, c Choice) templ.Attributes {
	attrs := templ.Attributes{
		attr:          c.Key,
		"hx-get":      c.Href,
		"hx-push-url": "true",
		"hx-target":   "#library-page",
		"hx-select":   "#library-page",
		"hx-swap":     "outerHTML",
	}
	if c.Active {
		attrs["data-active"] = true
	}
	return attrs
}

// ActionError renders the visible failure state for a write action (§A3.2's
// three actions): actions.ErrNoWriter in particular -- a ui process with no
// cluster configured has no writer, and this page must still say so rather
// than silently doing nothing. code is a stable machine-readable
// reason ("no-writer", "invalid" or "failed") carried on data-action-error
// (ruling R8), separate from message, which is the human-readable detail.
templ ActionError(code, message string) {
	<p data-action-error={ code } class="rounded-md border border-red-900 bg-red-950/50 p-4 text-sm text-red-300">
		Action failed: { message }
	</p>
}

// tabLabel and tabClass render the tab strip: the label a person reads, and
// the current tab underlined.
func tabLabel(tab projection.Tab) string {
	switch tab {
	case projection.TabMovies:
		return "Movies"
	case projection.TabTV:
		return "TV"
	case projection.TabMusic:
		return "Music"
	case projection.TabBooks:
		return "Books"
	default:
		return string(tab)
	}
}

// posterState is the card's data-poster value: "provider" when the card
// hotlinks the provider's art, "none" when it shows the placeholder.
func posterState(url string) string {
	if url != "" {
		return "provider"
	}
	return "none"
}

// stripeClass is a card's stripe for a projection.LibraryStatus.
func stripeClass(status string) string {
	return "h-1 w-full " + stripeColour(status)
}

// stripeColour is the background colour a projection.LibraryStatus takes:
// green on disk, amber on disk below the cutoff, blue in flight, red
// monitored and missing, gray unmonitored.
func stripeColour(status string) string {
	switch status {
	case "downloaded":
		return "bg-emerald-500"
	case "cutoff-unmet":
		return "bg-amber-500"
	case "downloading":
		return "bg-sky-500"
	case "missing":
		return "bg-red-500"
	default:
		return "bg-slate-500"
	}
}

// monitoredLabel and monitoredBadgeClass mirror downloads.templ's
// clientEnabledLabel/clientEnabledBadgeClass for the identical boolean-badge
// shape.
func monitoredLabel(monitored bool) string {
	if monitored {
		return "monitored"
	}
	return "unmonitored"
}

func monitoredBadgeClass(monitored bool) string {
	const base = "rounded-full px-2 py-0.5 text-xs font-medium "
	if monitored {
		return base + "bg-emerald-500/20 text-emerald-300"
	}
	return base + "bg-slate-500/20 text-slate-300"
}

// stagePhaseBadgeClass gives a LibraryItem's raw status.phase string a
// badge, grouped the same way helpers.go's stageTone groups
// pipeline.Stage: failed/cutoff-style phases read as amber, a settled phase
// reads as emerald, anything else (including a phase this switch does not
// specifically know, which keeps the badge readable for a phase value added
// to a kind's enum after this was written) reads as the default "in
// progress" sky blue.
func stagePhaseBadgeClass(phase string) string {
	return "rounded-full px-2 py-0.5 text-xs font-medium " + phaseTone(phase)
}

// phaseTone is the colour alone, for a badge component that brings its own
// shape: the library card's phase badge keeps these semantics (the tests
// assert on them) over the component's neutral secondary colours.
func phaseTone(phase string) string {
	switch phase {
	case "CutoffUnmet", "CutoffUnevaluated", "Delayed":
		// CutoffUnevaluated (Movie, Episode) is an item whose quality
		// profile could not be resolved: like CutoffUnmet, something is
		// wrong with it that the user should look at, so it shares the
		// warning colour rather than the neutral in-flight sky blue.
		return "bg-amber-500/20 text-amber-300"
	case "Imported", "Transcoded":
		// Transcoded (Movie, Episode) is a transcoded file, which is final:
		// as settled as Imported, so it shares the "done" colour.
		return "bg-emerald-500/20 text-emerald-300"
	case "Unmonitored":
		return "bg-slate-500/20 text-slate-300"
	default:
		return "bg-sky-500/20 text-sky-300"
	}
}

// libraryItemURL and libraryDetailPath both build a LibraryItem's detail
// page path -- /library/<namespace>/<kind>/<name>, matching ui/routes.go's
// "GET /library/{namespace}/{kind}/{name}" pattern -- the former typed as
// templ.SafeURL for the <a href> it's used in, the latter a plain string for
// a hidden form field's value, where templ does not apply URL sanitisation.
func libraryItemURL(item projection.LibraryItem) templ.SafeURL {
	return templ.URL(libraryDetailPath(item))
}

func libraryDetailPath(item projection.LibraryItem) string {
	return fmt.Sprintf("/library/%s/%s/%s", item.Ref.Namespace, item.Kind, item.Ref.Name)
}

// libraryActionURL builds the POST target for one of a LibraryItem's own
// actions ("monitor" or "search"), appended to its detail path.
func libraryActionURL(item projection.LibraryItem, action string) string {
	return fmt.Sprintf("%s/%s", libraryDetailPath(item), action)
}
