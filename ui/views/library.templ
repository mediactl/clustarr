package views

import (
	"context"
	"fmt"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/alert"
	"github.com/mediactl/clustarr/ui/components/aspectratio"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/buttongroup"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/dialog"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/components/menubar"
	"github.com/mediactl/clustarr/ui/components/separator"
	"github.com/mediactl/clustarr/ui/components/tooltip"
	"github.com/mediactl/clustarr/ui/paging"
	"github.com/mediactl/clustarr/ui/projection"
)

// Library renders the Library page (amendment §A3.4, Task G3-3): every
// catalog item the shared projection lists, its monitored state and phase, a
// link to its detail view, and a toolbar with one "Rescan" for the tab's
// library (2026-09-24, replacing one form per RootFolder): the action fans
// out to every RootFolder of the tab's kinds, since "rescan" (§A3.2) is a
// RootFolder-scoped action, not a per-item one; rootFolders is already
// narrowed to the tab, and an empty list disables the button. It is a full
// page, wrapped in Layout, so a plain GET renders
// something useful even before htmx's SSE extension has connected.
//
// #library-rows is the sse-swap target, mirroring the Pipeline and Downloads
// pages: htmx's SSE extension replaces that element's innerHTML with the
// named event's data, so everything inside it (and only what's inside it)
// must be exactly what LibraryRows renders -- the toolbar renders outside the
// swapped element, deliberately: the set of RootFolders does not move on the
// same cadence as item status, mirroring downloads.templ's own client-cards
// placement.
templ Library(tab projection.Tab, p paging.Page, items []projection.LibraryItem, tb LibraryToolbar, rootFolders []catalogv1.RootFolder, jumpsFor []Jump) {
	@Shell(Chrome{Title: "Library", Crumbs: []Crumb{{Label: "Library", Href: "/library"}, {Label: tabLabel(tab)}}, Tab: tab, HideScrollbar: true}) {
		<div id="library-page" class="group/library" data-tab={ string(tab) }>
			@libraryToolbar(tab, tb, rootFolders)
			<div
				id="library-rows"
				data-tab={ string(tab) }
				data-offset={ fmt.Sprint(p.Offset) }
				data-total={ fmt.Sprint(p.Total) }
				data-page={ fmt.Sprint(p.Number) }
				data-pages={ fmt.Sprint(p.Pages) }
				data-per={ fmt.Sprint(p.Per) }
				hx-ext="sse"
				sse-connect={ "/events/library/" + string(tab) + p.Query(p.Number) }
				sse-swap="library"
				class="space-y-4 lg:pr-10"
			>
				@LibraryList(tab, p, items)
			</div>
			@jumpBar(jumpsFor)
			@bulkBar(tab)
			// Where a card's action says how it went (ActionStatus,
			// ActionError); ui/static/library.js clears it after a while.
			<div id="action-status" aria-live="polite" class="fixed top-16 left-1/2 z-50 w-max max-w-[90vw] -translate-x-1/2 empty:hidden"></div>
		</div>
	}
}

// Jump is one entry of the A-Z bar: a letter, whether any title on the
// tab files under it, and the link to the page where those titles begin.
type Jump struct {
	Letter  string
	Enabled bool
	Href    string
	// Page is the page the letter's titles begin on and Index the index
	// of its first title (data-page, data-index): ui/static/jump.js widens
	// the loaded window to the page and scrolls to the title, keeping what
	// is already loaded; Href is the fallback without JavaScript.
	Page  int
	Index int
}

// jumpButtonClass makes every letter share the bar's height evenly and
// fill its width, so the bar fills the strip to the right border as
// Radarr's does.
const jumpButtonClass = "min-h-0 w-full flex-1 px-0 py-0 text-[11px]"

// jumpBar is Radarr's A-Z bar as a vertical button group fixed to the
// right edge of the screen, from beneath the top bar and the toolbar
// (3rem + 3.5rem, which is where 6.5rem comes from) to the bottom of the
// viewport, outside the grid's flow (the grid
// keeps clear of it with lg:pr-10). ui/static/jump.js places the thumb
// (data-jump-thumb) along it in proportion to the items on screen over
// the whole list, from #library-rows' data-offset and data-total, and
// drags it like a native scrollbar's thumb: a 12px grab strip (w-3) down
// the strip's left edge drawing a 2px line, pointer events on, the
// browser's touch panning off so a touch drag moves the thumb and not the
// page. Then a link per
// letter that has titles, a disabled button per letter that does not,
// each carrying data-jump for the tests. A disabled letter lets pointer
// events through: Chromium swallows wheel events over a disabled button,
// which stalled scrolling whenever the pointer rested on one.
templ jumpBar(jumpsFor []Jump) {
	if len(jumpsFor) > 0 {
		<div data-jump-bar class="fixed top-[6.5rem] right-0 bottom-0 z-10 hidden w-8 lg:block">
			<div data-jump-thumb class="absolute left-0 z-10 w-3 cursor-grab touch-none select-none rounded-l-sm border-l-2 border-primary active:cursor-grabbing" style="top: 0; height: 16px"></div>
			@buttongroup.ButtonGroup(buttongroup.Props{Orientation: buttongroup.OrientationVertical, Class: "h-full w-full"}) {
				for _, j := range jumpsFor {
					if j.Enabled {
						@button.Button(button.Props{Href: j.Href, Size: button.SizeXs, Variant: button.VariantOutline, Class: jumpButtonClass, Attributes: templ.Attributes{"data-jump": j.Letter, "data-page": fmt.Sprint(j.Page), "data-index": fmt.Sprint(j.Index)}}) { { j.Letter } }
					} else {
						@button.Button(button.Props{Size: button.SizeXs, Variant: button.VariantOutline, Disabled: true, Class: jumpButtonClass + " pointer-events-none", Attributes: templ.Attributes{"data-jump": j.Letter}}) { { j.Letter } }
					}
				}
			}
		</div>
	}
}

// LibraryList is what #library-rows holds and what every
// /events/library/{tab} frame carries: the window's cards and, while the
// list goes on, the sentinel that loads more. items is already the tab's
// window.
templ LibraryList(tab projection.Tab, p paging.Page, items []projection.LibraryItem) {
	@loadPrev(tab, p)
	@LibraryRows(items)
	@loadMore(tab, p)
}

// loadPrev is the scroll's other direction (design 2026-09-24): after a
// jump the window starts partway down the list, so a sentinel above the
// grid fetches the same window one page earlier -- the start moves back
// a page, the span grows by one -- and swaps #library-rows whole, like
// loadMore. ui/static/jump.js fires its loadprev event when the reader
// scrolls up at the top of the page and keeps the first card in place
// across the prepend; a click does the same for anyone else. Nothing on
// the first page.
templ loadPrev(tab projection.Tab, p paging.Page) {
	if p.Number > 1 {
		{{ q := p.Values(p.Number - 1) }}
		{{ q.Set("pages", fmt.Sprint(p.Pages+1)) }}
		<div
			data-load-prev
			hx-get={ "/library/" + string(tab) + "?" + q.Encode() }
			hx-trigger="loadprev, click"
			hx-target="#library-rows"
			hx-select="#library-rows"
			hx-swap="outerHTML"
			class="cursor-pointer py-3 text-center text-sm text-muted-foreground hover:text-foreground"
		>
			Load earlier…
		</div>
	}
}

// loadMore is the library's infinite scroll (design 2026-09-24): a
// sentinel after the grid that, once scrolled into view, fetches the
// same window one page wider and swaps #library-rows whole -- the wider
// grid, the next sentinel and the stream element, which reconnects for
// the wider window so live frames carry everything on screen. Nothing
// once the window reaches the end.
templ loadMore(tab projection.Tab, p paging.Page) {
	if p.HasNext() {
		{{ q := p.Values(p.Number) }}
		{{ q.Set("pages", fmt.Sprint(p.Pages+1)) }}
		<div
			data-load-more
			hx-get={ "/library/" + string(tab) + "?" + q.Encode() }
			hx-trigger="revealed"
			hx-target="#library-rows"
			hx-select="#library-rows"
			hx-swap="outerHTML"
			class="py-6 text-center text-sm text-muted-foreground"
		>
			Loading more…
		</div>
	}
}

// LibraryRows renders the dynamic part of the Library page: the "nothing
// collected yet" placeholder or the item grid. This is also what
// /events/library renders into each SSE event's data, so the initial page
// render and every live update produce byte-for-byte the same markup for
// #library-rows's contents.
templ LibraryRows(items []projection.LibraryItem) {
	if len(items) == 0 {
		<p class="text-muted-foreground">Nothing in the library yet.</p>
	}
	// The column width is the Options menu's poster size
	// (--library-poster-width, set on <html> by ui/static/library.js).
	@item.Group(item.GroupProps{Class: "grid grid-cols-[repeat(auto-fill,minmax(var(--library-poster-width,160px),1fr))] gap-3", Attributes: templ.Attributes{"data-library-grid": true}}) {
		for _, li := range items {
			@libraryCard(li)
		}
	}
}

// libraryCard renders one LibraryItem as shadcn-templ's item: the whole
// tile is the link to the detail page, the poster is the item's media at
// poster ratio, the title (with the year) and the kind and profile are its
// title and description, and monitored, phase and on-disk are badges.
// Every card carries data-ref, data-kind, data-monitored, data-phase and
// data-hasfile (ruling R8): the UI tests assert on these attributes, not on
// visible copy, so a wording change does not break a test and a markup
// change does not pass one. The card is a div and its link (data-card-link)
// is stretched over it (2026-10-06), so the card can also hold its own
// actions (cardActions), which as buttons may not sit inside a link. While
// the page is selecting (Sonarr's mass editor, 2026-10-06) a click selects
// the card instead of opening it (ui/static/library.js sets
// data-selected), and its mark, hidden otherwise, shows in the poster's
// corner.
templ libraryCard(li projection.LibraryItem) {
	@item.Item(item.Props{
		Variant: item.VariantMuted,
		Class:   "group/card relative flex-col items-stretch gap-0 overflow-hidden border-0 bg-card p-0 hover:bg-card data-selected:ring-2 data-selected:ring-primary",
		Attributes: templ.Attributes{
			"data-ref":       li.Ref.String(),
			"data-kind":      string(li.Kind),
			"data-monitored": fmt.Sprintf("%t", li.Monitored),
			"data-phase":     li.Phase,
			"data-hasfile":   fmt.Sprintf("%t", li.HasFile),
			"data-year":      fmt.Sprint(li.Year),
			"data-profile":   li.QualityProfileRef,
			"data-poster":    posterState(li.Poster),
		},
	}) {
		@tooltip.Tooltip() {
			<a
				data-card-link
				href={ templ.SafeURL(libraryDetailPath(li)) }
				aria-label={ cardLabel(li) }
				class="absolute inset-0 z-[1] rounded-[inherit] outline-none focus-visible:ring-2 focus-visible:ring-ring"
				{ tooltip.Trigger(ctx)... }
			></a>
			@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom}) {
				{ cardLabel(li) }
			}
		}
		<span data-select-mark aria-hidden="true" class="absolute top-2 left-2 z-10 hidden size-6 items-center justify-center rounded-full border-2 border-white/80 bg-black/40 text-primary-foreground shadow group-data-selecting/library:flex group-data-selected/card:border-primary group-data-selected/card:bg-primary">
			@icon.Icon("check")(icon.Props{Class: "hidden size-4 group-data-selected/card:block"})
		</span>
		@aspectratio.AspectRatio(aspectratio.Props{Ratio: "2/3", Class: "w-full bg-muted"}) {
			@posterFill(li.Poster, li.Title)
			@cardActions(li)
		}
		<div class={ stripeClass(projection.LibraryStatus(li)) } data-status={ projection.LibraryStatus(li) }></div>
		<div data-card-details class="px-2 py-1.5 text-center text-xs leading-5">
			<div>{ monitoredTitle(li.Monitored) }</div>
			<div class="truncate text-muted-foreground">{ li.QualityProfileRef }</div>
		</div>
	}
}

// cardLabel is the card's accessible name and tooltip: the title and year.
func cardLabel(li projection.LibraryItem) string {
	if li.Year > 0 {
		return fmt.Sprintf("%s (%d)", li.Title, li.Year)
	}
	return li.Title
}

// cardActions are a card's own actions (2026-10-06, after Sonarr's poster
// buttons), along the poster's foot: Refresh & Scan, Search, Monitor or
// Unmonitor, and Delete -- the item page's actions, so a card does what
// its page does without opening it. They show while the pointer is over
// the card or focus is inside it, and never while the page is selecting,
// when a click selects. Each but Delete posts through htmx to the item's
// own action route and reads the outcome, a line saying it was done or why
// it failed, into the page's #action-status (ActionStatus); the live
// stream then redraws the card. Delete opens the page's delete dialog for
// this item alone (ui/static/library.js reads data-card-delete), with the
// same two checkboxes as the item page's.
templ cardActions(li projection.LibraryItem) {
	<div
		data-card-actions
		class="absolute right-0 bottom-0 left-0 z-20 flex justify-center gap-1 bg-gradient-to-t from-black/80 to-transparent px-1 pt-6 pb-1.5 opacity-0 transition-opacity group-hover/card:opacity-100 group-focus-within/card:opacity-100 group-data-selecting/library:hidden"
	>
		@cardAction(li, "refresh", "refresh-cw", "Refresh & Scan", `{"scan":"true"}`)
		@cardAction(li, "search", "search", "Search", "")
		if li.Monitored {
			@cardAction(li, "monitor", "bookmark-x", "Unmonitor", `{"monitored":"false"}`)
		} else {
			@cardAction(li, "monitor", "bookmark-check", "Monitor", `{"monitored":"true"}`)
		}
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIconSm,
			Class:      cardActionClass + " hover:text-destructive",
			Attributes: cardDeleteAttrs(li),
		}) {
			@icon.Icon("trash-2")()
		}
	</div>
}

// cardActionClass is a card action's look: a light icon on the poster's
// shade.
const cardActionClass = "size-8 rounded-full text-white/90 hover:bg-white/20 hover:text-white focus-visible:bg-white/20"

// cardAction is one of a card's posting actions: a button posting to the
// item's action route through htmx, vals its form fields as hx-vals JSON.
templ cardAction(li projection.LibraryItem, action, iconName, label, vals string) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeIconSm,
		Class:      cardActionClass,
		Attributes: cardActionAttrs(li, action, label, vals),
	}) {
		@icon.Icon(iconName)()
	}
}

// cardActionAttrs are a posting card action's htmx attributes.
func cardActionAttrs(li projection.LibraryItem, action, label, vals string) templ.Attributes {
	attrs := templ.Attributes{
		"data-card-action": action,
		"aria-label":       label,
		"title":            label,
		"hx-post":          libraryActionURL(li, action),
		"hx-target":        "#action-status",
		"hx-swap":          "innerHTML",
	}
	if vals != "" {
		attrs["hx-vals"] = vals
	}
	return attrs
}

// cardDeleteAttrs make a card's Delete the page's delete dialog's trigger,
// naming the item (namespace/kind/name) for ui/static/library.js.
func cardDeleteAttrs(li projection.LibraryItem) templ.Attributes {
	attrs := dialog.TriggerFor("library-bulk-delete")
	attrs["data-card-action"] = "delete"
	attrs["data-card-delete"] = li.Ref.Namespace + "/" + string(li.Kind) + "/" + li.Ref.Name
	attrs["aria-label"] = "Delete"
	attrs["title"] = "Delete"
	return attrs
}

// ActionStatus is what a card's action answers into #action-status: a
// line saying it was done, or ActionError's why not.
templ ActionStatus(message string) {
	<div data-action-status="ok" role="status" class="flex items-center gap-2 rounded-md border border-border bg-popover px-3 py-2 text-sm text-popover-foreground shadow-md">
		@icon.Icon("circle-check")(icon.Props{Class: "size-4 text-primary"})
		{ message }
	</div>
}

// posterFill is the poster filling a 2:3 aspect-ratio box: the art at its
// [projection.ArtURL] (lazily, as poster's own doc says -- ui/art.go serves
// it, same-origin, so there is no referrer to withhold, ADR-0011), or a
// placeholder that names the film when there is none, as Radarr's does.
templ posterFill(url, title string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			alt={ title }
			loading="lazy"
			class="absolute inset-0 h-full w-full object-cover"
		/>
	} else {
		<div class="absolute inset-0 flex items-center justify-center p-3 text-center text-sm font-medium text-muted-foreground">{ title }</div>
	}
}

// monitoredTitle is the footer's first line, Radarr's capitalisation.
func monitoredTitle(monitored bool) string {
	if monitored {
		return "Monitored"
	}
	return "Unmonitored"
}

// monitoredBadge is the monitored mark every card and header shows: the
// primary badge (Plex gold) when monitored, an outline one when not.
templ monitoredBadge(monitored bool) {
	if monitored {
		@badge.Badge() { { monitoredLabel(monitored) } }
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) { { monitoredLabel(monitored) } }
	}
}

// poster renders the cover art at its [projection.ArtURL] -- ui/art.go's
// own route, same-origin, never a provider's URL (ADR-0011, superseding
// spec 2026-09-23-library-page-design decision 1): lazily, so a long grid
// does not fetch every image at once. It fills its container at poster
// ratio (2:3 -- a square crop takes the faces off), so the caller sizes the
// box. No art yet renders a placeholder of the same shape, never a broken
// image.
templ poster(url, title string) {
	if url != "" {
		<img
			src={ templ.URL(url) }
			alt={ title }
			loading="lazy"
			class="aspect-[2/3] w-full rounded-sm bg-muted object-cover"
		/>
	} else {
		<div class="flex aspect-[2/3] w-full items-center justify-center rounded-sm bg-muted text-xs text-muted-foreground">no art</div>
	}
}

// itemCrumbs is an item's trail: Library, its tab, itself.
func itemCrumbs(li projection.LibraryItem) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title},
	}
}

// childCrumbs is the trail of a page under an item -- a season, the
// albums, the books -- with the item linked and the page last.
func childCrumbs(li projection.LibraryItem, label string) []Crumb {
	return []Crumb{
		{Label: "Library", Href: "/library"},
		{Label: tabLabel(li.Tab), Href: "/library/" + string(li.Tab)},
		{Label: li.Title, Href: libraryDetailPath(li)},
		{Label: label},
	}
}

// Choice is one entry of a toolbar menu: its ?sort or ?filter value, the
// label, the link to the page in that view, whether it is the current one
// and, for the current sort, its direction.
type Choice struct {
	Key    string
	Label  string
	Href   string
	Active bool
	Dir    string
}

// LibraryToolbar is the toolbar's state and menus: the current view for
// the tests (data-current-sort, -dir and -filter) and the Sort and Filter
// entries the handler built.
type LibraryToolbar struct {
	Sort    string
	Dir     string
	Filter  string
	Sorts   []Choice
	Filters []Choice
}

// libraryToolbar is Sonarr's toolbar row (design 2026-09-24, views/toolbar.templ): the actions
// on the left -- the tab's single "Rescan" (rescanForm), §A3.2's third
// action, reading config-like data that needs no live stream of its own,
// as downloads.templ's client cards do, Add New, and the mass editor's
// Select (Stop Selecting while it is on) and Select All -- and the
// Options, Sort and Filter menus on the right. It renders outside the SSE-swapped rows: the view only changes
// when the reader chooses, and every menu link swaps the whole page as the
// sidebar's tab entries do so the stream reconnects with the new view.
templ libraryToolbar(tab projection.Tab, tb LibraryToolbar, rootFolders []catalogv1.RootFolder) {
	@toolbar(templ.Attributes{"data-current-sort": tb.Sort, "data-current-dir": tb.Dir, "data-current-filter": tb.Filter}) {
		@toolbarGroup() {
			@rescanForm(tab, len(rootFolders) > 0)
			@addNewButton(tab)
			@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mx-1 my-2 data-vertical:h-auto"})
			@selectToggle()
			<div class="hidden group-data-selecting/library:flex">
				@toolbarButton("check-check", "Select All", templ.Attributes{"data-action": "select-all", "data-toolbar-button": true})
			</div>
		}
		@toolbarGroup() {
			@optionsMenu()
			@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mx-1 my-2 data-vertical:h-auto"})
			@viewMenu("Sort", "arrow-up-down", "Sort by", "data-sort", tb.Sorts)
			@viewMenu("Filter", "funnel", "Filter", "data-filter", tb.Filters)
		}
	}
}

// addNewButton is the toolbar's "Add New" (2026-09-29): a link to the
// tab's search-and-add page, Radarr's Movies > Add New.
templ addNewButton(tab projection.Tab) {
	@button.Button(button.Props{
		Href:    "/library/" + string(tab) + "/add",
		Variant: button.VariantGhost,
		Class:   toolbarButtonClass,
		Attributes: templ.Attributes{
			"data-action":         "add-new",
			"data-toolbar-button": true,
			"title":               "Add a new " + addLabel(tab),
		},
	}) {
		@icon.Icon("plus")()
		<span>Add New</span>
	}
}

// addLabel is what the tab's Add New adds.
func addLabel(tab projection.Tab) string {
	switch tab {
	case projection.TabTV:
		return "series"
	case projection.TabMusic:
		return "artist"
	case projection.TabBooks:
		return "author"
	}
	return "movie"
}

// rescanForm is the toolbar's "Rescan" (2026-09-24): one form posting the
// tab to /library/rescan, whose handler creates a LibraryScan for every
// RootFolder of the tab's kinds; the return field brings the reader back to
// this tab. With no RootFolder of those kinds the button is disabled and
// its title says so, rather than posting a request that can only fail.
templ rescanForm(tab projection.Tab, enabled bool) {
	<form method="post" action="/library/rescan" data-tab={ string(tab) }>
		<input type="hidden" name="tab" value={ string(tab) }/>
		<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
		@button.Button(button.Props{
			Type:     button.TypeSubmit,
			Variant:  button.VariantGhost,
			Class:    toolbarButtonClass,
			Disabled: !enabled,
			Attributes: templ.Attributes{
				"data-action":         "rescan",
				"data-toolbar-button": true,
				"title":               rescanTitle(tab, enabled),
			},
		}) {
			@icon.Icon("refresh-cw")()
			<span>Rescan</span>
		}
	</form>
}

// rescanTitle is the Rescan button's tooltip: what it scans, or why it
// cannot.
func rescanTitle(tab projection.Tab, enabled bool) string {
	if !enabled {
		return "No root folder holds " + tabLabel(tab) + " yet; add one under Settings"
	}
	return "Rescan every " + tabLabel(tab) + " root folder"
}

// viewMenu is one toolbar menu: a menubar trigger and a menu of links,
// the current entry checked and, for a sort, marked with its direction.
// attr names the data attribute each entry carries its key in.
templ viewMenu(label, iconName, heading, attr string, choices []Choice) {
	@toolbarMenu(iconName, label) {
		@menubar.Label() {
			{ heading }
		}
		for _, c := range choices {
			@menubar.Item(menubar.ItemProps{Href: c.Href, Attributes: choiceAttributes(attr, c)}) {
				if c.Active {
					@icon.Icon("check")()
				} else {
					<span class="size-4"></span>
				}
				<span class="flex-1">{ c.Label }</span>
				switch c.Dir {
					case "asc":
						@icon.Icon("arrow-up")()
					case "desc":
						@icon.Icon("arrow-down")()
				}
			}
		}
	}
}

// selectToggle turns the mass editor on and off (Sonarr's Select and Stop
// Selecting): ui/static/library.js toggles data-selecting on
// #library-page, which swaps the label and shows the cards' marks, Select
// All and the bulk bar.
templ selectToggle() {
	@button.Button(button.Props{Variant: button.VariantGhost, Class: toolbarButtonClass, Attributes: templ.Attributes{"data-action": "select-toggle", "data-toolbar-button": true, "aria-pressed": "false"}}) {
		@icon.Icon("square-check")(icon.Props{Class: "group-data-selecting/library:hidden"})
		@icon.Icon("square-x")(icon.Props{Class: "hidden group-data-selecting/library:block"})
		<span class="group-data-selecting/library:hidden">Select</span>
		<span class="hidden group-data-selecting/library:inline">Stop Selecting</span>
	}
}

// PosterSize is one of the Options menu's poster sizes: the grid's
// minimum column width.
type PosterSize struct {
	Key   string
	Label string
	Width string
}

// PosterSizes are Sonarr's three, medium the default.
var PosterSizes = []PosterSize{
	{"small", "Small", "120px"},
	{"medium", "Medium", "160px"},
	{"large", "Large", "220px"},
}

// optionsMenu is Sonarr's Options: the poster size and whether each card
// shows its details (monitored and quality profile) under the poster.
// Both are the reader's own and stay in the browser: ui/static/library.js
// applies them to every library page from localStorage, setting
// --library-poster-width and data-library-details on <html>.
templ optionsMenu() {
	@toolbarMenu("settings-2", "Options") {
		@menubar.Label() {
			Poster size
		}
		@menubar.RadioGroup(menubar.RadioGroupProps{DefaultValue: "medium", Attributes: templ.Attributes{"data-poster-sizes": true}}) {
			for _, sz := range PosterSizes {
				@menubar.RadioItem(menubar.RadioItemProps{Value: sz.Key, Attributes: templ.Attributes{"data-poster-size": sz.Key, "data-width": sz.Width}}) {
					{ sz.Label }
				}
			}
		}
		@menubar.Separator()
		@menubar.CheckboxItem(menubar.CheckboxItemProps{DefaultChecked: true, Attributes: templ.Attributes{"data-library-option": "details"}}) {
			Show details
		}
	}
}

// bulkBar is the mass editor's bar (Sonarr's, 2026-10-06), shown at the
// foot of the screen while the page is selecting: how many cards are
// selected and what to do with them, one POST to /library/{tab}/bulk per
// action, the selected items filled in by ui/static/library.js as
// repeated "item" fields (namespace/kind/name) when a [data-bulk-form]
// submits. Delete asks first, as the item page's Delete does, in a dialog
// with the same two checkboxes; its form is the dialog's own, since the
// dialog moves its content to <body> when it opens. A card's own Delete
// opens the same dialog for that item alone (cardActions). The buttons stay
// disabled until something is selected.
templ bulkBar(tab projection.Tab) {
	<div data-bulk-bar class="sticky bottom-0 z-20 -mx-6 -mb-6 mt-6 hidden flex-wrap items-center gap-2 border-t border-border bg-card px-4 py-3 group-data-selecting/library:flex lg:pr-12">
		<form id="library-bulk" method="post" action={ templ.URL(bulkPath(tab)) } data-bulk-form class="flex flex-wrap items-center gap-2">
			<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
			@bulkButton("monitor", "bookmark-check", "Monitor", button.VariantSecondary)
			@bulkButton("unmonitor", "bookmark-x", "Unmonitor", button.VariantSecondary)
			@bulkButton("search", "search", "Search", button.VariantSecondary)
			@bulkButton("refresh", "refresh-cw", "Refresh & Scan", button.VariantSecondary)
		</form>
		@dialog.Dialog(dialog.Props{ID: "library-bulk-delete"}) {
			@button.Button(button.Props{Variant: button.VariantDestructive, Disabled: true, Attributes: bulkDeleteTrigger(ctx)}) {
				@icon.Icon("trash-2")()
				Delete
			}
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						Delete <span data-delete-subject data-default={ "the selected " + findNoun(tab) }>{ "the selected " + findNoun(tab) }</span>
					}
					@dialog.Description() {
						<span data-delete-count>0</span> selected
					}
				}
				<form method="post" action={ templ.URL(bulkPath(tab)) } data-bulk-form class="space-y-3">
					<input type="hidden" name="return" value={ "/library/" + string(tab) }/>
					<input type="hidden" name="action" value="delete"/>
					<label class="flex items-start gap-2">
						@checkbox.Checkbox(checkbox.Props{ID: "bulk-delete-files", Name: "files", Value: "true"})
						<span>
							Delete files and folders
							<span class="block text-xs text-destructive">This permanently deletes every selected folder and cannot be undone.</span>
						</span>
					</label>
					<label class="flex items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{ID: "bulk-delete-exclude", Name: "exclude", Value: "true"})
						<span>Add import list exclusions</span>
					</label>
					@dialog.Footer() {
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) { Cancel }
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-action": "bulk-delete-confirm"}}) { Delete }
					}
				</form>
			}
		}
		<span class="ml-auto text-sm text-muted-foreground"><span data-selected-count>0</span> selected</span>
	</div>
}

// bulkButton is one of the bulk bar's actions: a submit of #library-bulk
// naming the action, disabled until something is selected.
templ bulkButton(action, iconName, label string, variant button.Variant) {
	@button.Button(button.Props{Type: button.TypeSubmit, Variant: variant, Disabled: true, Attributes: templ.Attributes{"name": "action", "value": action, "data-bulk-action": action}}) {
		@icon.Icon(iconName)()
		{ label }
	}
}

// bulkDeleteTrigger is the bulk Delete's dialog trigger, a bulk action
// like the others for library.js' enabling.
func bulkDeleteTrigger(ctx context.Context) templ.Attributes {
	attrs := dialog.Trigger(ctx)
	attrs["data-bulk-action"] = "delete"
	return attrs
}

// bulkPath is the tab's bulk action route.
func bulkPath(tab projection.Tab) string { return "/library/" + string(tab) + "/bulk" }

// choiceAttributes are a menu entry's attributes: its key under attr, the
// htmx swap of #library-page the tabs use (so the URL follows and the
// stream reconnects in the new view) and data-active on the current one.
func choiceAttributes(attr string, c Choice) templ.Attributes {
	attrs := templ.Attributes{
		attr:          c.Key,
		"hx-get":      c.Href,
		"hx-push-url": "true",
		"hx-target":   "#library-page",
		"hx-select":   "#library-page",
		"hx-swap":     "outerHTML",
	}
	if c.Active {
		attrs["data-active"] = true
	}
	return attrs
}

// ActionError renders the visible failure state for a write action (§A3.2's
// three actions): actions.ErrNoWriter in particular -- a ui process with no
// cluster configured has no writer, and this page must still say so rather
// than silently doing nothing. code is a stable machine-readable
// reason ("no-writer", "invalid" or "failed") carried on data-action-error
// (ruling R8), separate from message, which is the human-readable detail.
templ ActionError(code, message string) {
	@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"data-action-error": code, "role": "alert"}}) {
		@icon.CircleAlert()
		@alert.Title() {
			Action failed
		}
		@alert.Description() {
			{ message }
		}
	}
}

// tabLabel and tabClass render the tab strip: the label a person reads, and
// the current tab underlined.
func tabLabel(tab projection.Tab) string {
	switch tab {
	case projection.TabMovies:
		return "Movies"
	case projection.TabTV:
		return "TV"
	case projection.TabMusic:
		return "Music"
	case projection.TabBooks:
		return "Books"
	default:
		return string(tab)
	}
}

// posterState is the card's data-poster value: "art" when the card has one
// to show (its [projection.ArtURL], same-origin -- ADR-0011), "none" when
// it shows the placeholder.
func posterState(url string) string {
	if url != "" {
		return "art"
	}
	return "none"
}

// stripeClass is a card's stripe for a projection.LibraryStatus.
func stripeClass(status string) string {
	return "h-1 w-full " + stripeColour(status)
}

// stripeColour is the background colour a projection.LibraryStatus takes:
// green on disk, amber on disk below the cutoff, blue in flight, red
// monitored and missing, gray unmonitored.
func stripeColour(status string) string {
	switch status {
	case "downloaded":
		return "bg-emerald-500"
	case "cutoff-unmet":
		return "bg-amber-500"
	case "downloading":
		return "bg-sky-500"
	case "missing":
		return "bg-red-500"
	case "deleting":
		return "bg-slate-400"
	default:
		return "bg-slate-500"
	}
}

// monitoredLabel and monitoredBadgeClass mirror downloads.templ's
// clientEnabledLabel/clientEnabledBadgeClass for the identical boolean-badge
// shape.
func monitoredLabel(monitored bool) string {
	if monitored {
		return "monitored"
	}
	return "unmonitored"
}

func monitoredBadgeClass(monitored bool) string {
	const base = "rounded-full px-2 py-0.5 text-xs font-medium "
	if monitored {
		return base + "bg-emerald-500/20 text-emerald-300"
	}
	return base + "bg-slate-500/20 text-slate-300"
}

// stagePhaseBadgeClass gives a LibraryItem's raw status.phase string a
// badge, grouped the same way helpers.go's stageTone groups
// pipeline.Stage: failed/cutoff-style phases read as amber, a settled phase
// reads as emerald, anything else (including a phase this switch does not
// specifically know, which keeps the badge readable for a phase value added
// to a kind's enum after this was written) reads as the default "in
// progress" sky blue.
func stagePhaseBadgeClass(phase string) string {
	return "rounded-full px-2 py-0.5 text-xs font-medium " + phaseTone(phase)
}

// phaseTone is the colour alone, for a badge component that brings its own
// shape: the library card's phase badge keeps these semantics (the tests
// assert on them) over the component's neutral secondary colours.
func phaseTone(phase string) string {
	switch phase {
	case "CutoffUnmet", "CutoffUnevaluated", "Delayed":
		// CutoffUnevaluated (Movie, Episode) is an item whose quality
		// profile could not be resolved: like CutoffUnmet, something is
		// wrong with it that the user should look at, so it shares the
		// warning colour rather than the neutral in-flight sky blue.
		return "bg-amber-500/20 text-amber-300"
	case "Imported", "Transcoded":
		// Transcoded (Movie, Episode) is a transcoded file, which is final:
		// as settled as Imported, so it shares the "done" colour.
		return "bg-emerald-500/20 text-emerald-300"
	case "Unmonitored":
		return "bg-slate-500/20 text-slate-300"
	default:
		return "bg-sky-500/20 text-sky-300"
	}
}

// libraryItemURL and libraryDetailPath both build a LibraryItem's detail
// page path -- /library/<namespace>/<kind>/<name>, matching ui/routes.go's
// "GET /library/{namespace}/{kind}/{name}" pattern -- the former typed as
// templ.SafeURL for the <a href> it's used in, the latter a plain string for
// a hidden form field's value, where templ does not apply URL sanitisation.
func libraryItemURL(item projection.LibraryItem) templ.SafeURL {
	return templ.URL(libraryDetailPath(item))
}

func libraryDetailPath(item projection.LibraryItem) string {
	return fmt.Sprintf("/library/%s/%s/%s", item.Ref.Namespace, item.Kind, item.Ref.Name)
}

// libraryActionURL builds the POST target for one of a LibraryItem's own
// actions ("monitor" or "search"), appended to its detail path.
func libraryActionURL(item projection.LibraryItem, action string) string {
	return fmt.Sprintf("%s/%s", libraryDetailPath(item), action)
}
