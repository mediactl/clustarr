package views

import (
	"fmt"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	"github.com/mediactl/clustarr/ui/projection"
)

// Library renders the Library page (amendment §A3.4, Task G3-3): every
// catalog item the shared projection lists, its monitored state and phase, a
// link to its detail view, and a rescan toolbar -- one form per known
// RootFolder, since "rescan" (§A3.2) is a RootFolder-scoped action, not a
// per-item one. It is a full page, wrapped in Layout, so a plain GET renders
// something useful even before htmx's SSE extension has connected.
//
// #library-rows is the sse-swap target, mirroring the Pipeline and Downloads
// pages: htmx's SSE extension replaces that element's innerHTML with the
// named event's data, so everything inside it (and only what's inside it)
// must be exactly what LibraryRows renders -- the toolbar renders outside the
// swapped element, deliberately: the set of RootFolders does not move on the
// same cadence as item status, mirroring downloads.templ's own client-cards
// placement.
templ Library(items []projection.LibraryItem, rootFolders []catalogv1.RootFolder) {
	@Layout("Library") {
		<h1 class="mb-4 text-2xl font-bold">Library</h1>
		if len(rootFolders) > 0 {
			@rescanToolbar(rootFolders)
		}
		<div
			id="library-rows"
			hx-ext="sse"
			sse-connect="/events/library"
			sse-swap="library"
			class="space-y-4"
		>
			@LibraryRows(items)
		</div>
	}
}

// LibraryRows renders the dynamic part of the Library page: the "nothing
// collected yet" placeholder or the item grid. This is also what
// /events/library renders into each SSE event's data, so the initial page
// render and every live update produce byte-for-byte the same markup for
// #library-rows's contents.
templ LibraryRows(items []projection.LibraryItem) {
	if len(items) == 0 {
		<p class="text-slate-400">Nothing in the library yet.</p>
	}
	<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		for _, item := range items {
			@libraryCard(item)
		}
	</div>
}

// libraryCard renders one LibraryItem as a poster-grid tile: title, kind and
// monitored badges, phase when the kind has one, and a link through to its
// detail view. Every row carries data-ref, data-kind, data-monitored,
// data-phase and data-hasfile (ruling R8): the UI tests assert on these
// attributes, not on visible copy, so a wording change does not break a test
// and a markup change does not pass one.
templ libraryCard(item projection.LibraryItem) {
	<div
		class="rounded-lg border border-slate-800 bg-slate-900 p-4"
		data-ref={ item.Ref.String() }
		data-kind={ string(item.Kind) }
		data-monitored={ fmt.Sprintf("%t", item.Monitored) }
		data-phase={ item.Phase }
		data-hasfile={ fmt.Sprintf("%t", item.HasFile) }
	>
		<div class="flex items-center justify-between gap-4">
			<a href={ libraryItemURL(item) } class="font-medium hover:underline">{ item.Title }</a>
			<span class={ monitoredBadgeClass(item.Monitored) }>{ monitoredLabel(item.Monitored) }</span>
		</div>
		<div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
			<span class="rounded-full bg-slate-800 px-2 py-0.5">{ string(item.Kind) }</span>
			if item.Phase != "" {
				<span class={ stagePhaseBadgeClass(item.Phase) }>{ item.Phase }</span>
			}
			if item.HasFile {
				<span class="text-emerald-300">on disk</span>
			}
		</div>
	</div>
}

// LibraryDetail renders one catalog item's detail view (amendment §A3.4's
// "detail modal" -- rendered here as its own page rather than a client-side
// modal, since ui has no client-side framework and everything it does must
// stay reachable without JavaScript, same as every other page): its
// monitored state and phase, and the two per-item actions, monitor/unmonitor
// and search now (§A3.2). "Rescan" is RootFolder-scoped, not per-item, so it
// lives only on the Library page's own toolbar.
templ LibraryDetail(item projection.LibraryItem) {
	@Layout(item.Title) {
		<a href="/library" class="text-sm text-slate-400 hover:text-slate-100">&larr; Library</a>
		<div
			class="mt-4 rounded-lg border border-slate-800 bg-slate-900 p-6"
			data-ref={ item.Ref.String() }
			data-kind={ string(item.Kind) }
			data-monitored={ fmt.Sprintf("%t", item.Monitored) }
			data-phase={ item.Phase }
			data-hasfile={ fmt.Sprintf("%t", item.HasFile) }
		>
			<div class="flex items-center justify-between gap-4">
				<h1 class="text-2xl font-bold">{ item.Title }</h1>
				<span class={ monitoredBadgeClass(item.Monitored) }>{ monitoredLabel(item.Monitored) }</span>
			</div>
			<div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
				<span class="rounded-full bg-slate-800 px-2 py-0.5">{ string(item.Kind) }</span>
				if item.Phase != "" {
					<span class={ stagePhaseBadgeClass(item.Phase) }>{ item.Phase }</span>
				}
				if item.HasFile {
					<span class="text-emerald-300">on disk</span>
				}
			</div>
			<div class="mt-6 flex gap-3">
				<form method="post" action={ templ.URL(libraryActionURL(item, "monitor")) }>
					<input type="hidden" name="return" value={ libraryDetailPath(item) }/>
					<input type="hidden" name="monitored" value={ fmt.Sprintf("%t", !item.Monitored) }/>
					<button
						type="submit"
						data-action="set-monitored"
						class="rounded-md bg-slate-800 px-3 py-1.5 text-sm font-medium hover:bg-slate-700"
					>
						if item.Monitored {
							Unmonitor
						} else {
							Monitor
						}
					</button>
				</form>
				<form method="post" action={ templ.URL(libraryActionURL(item, "search")) }>
					<input type="hidden" name="return" value={ libraryDetailPath(item) }/>
					<button
						type="submit"
						data-action="search-now"
						class="rounded-md bg-sky-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-sky-500"
					>
						Search now
					</button>
				</form>
			</div>
		</div>
	}
}

// rescanToolbar renders one "Rescan" form per known RootFolder (§A3.2's
// third action). It reads config-like data (RootFolder is edited rarely, via
// the eventual Settings page, not something that needs a live SSE stream of
// its own), the same reasoning downloads.templ's downloadClientsSection
// gives for rendering its own DownloadClient cards outside the SSE-swapped
// region.
templ rescanToolbar(rootFolders []catalogv1.RootFolder) {
	<div class="mb-6 flex flex-wrap items-center gap-3 rounded-lg border border-slate-800 bg-slate-900 p-4">
		<span class="text-sm text-slate-400">Rescan:</span>
		for _, rf := range rootFolders {
			<form method="post" action="/library/rescan" data-root-folder={ rf.Name }>
				<input type="hidden" name="namespace" value={ rf.Namespace }/>
				<input type="hidden" name="rootFolder" value={ rf.Name }/>
				<input type="hidden" name="return" value="/library"/>
				<button
					type="submit"
					data-action="rescan"
					class="rounded-md bg-slate-800 px-3 py-1.5 text-sm font-medium hover:bg-slate-700"
				>
					{ rf.Name }
				</button>
			</form>
		}
	</div>
}

// ActionError renders the visible failure state for a write action (§A3.2's
// three actions): actions.ErrNoWriter in particular -- a ui process with no
// cluster configured has no writer, and this page must still say so rather
// than silently doing nothing. code is a stable machine-readable
// reason ("no-writer", "invalid" or "failed") carried on data-action-error
// (ruling R8), separate from message, which is the human-readable detail.
templ ActionError(code, message string) {
	<p data-action-error={ code } class="rounded-md border border-red-900 bg-red-950/50 p-4 text-sm text-red-300">
		Action failed: { message }
	</p>
}

// monitoredLabel and monitoredBadgeClass mirror downloads.templ's
// clientEnabledLabel/clientEnabledBadgeClass for the identical boolean-badge
// shape.
func monitoredLabel(monitored bool) string {
	if monitored {
		return "monitored"
	}
	return "unmonitored"
}

func monitoredBadgeClass(monitored bool) string {
	const base = "rounded-full px-2 py-0.5 text-xs font-medium "
	if monitored {
		return base + "bg-emerald-500/20 text-emerald-300"
	}
	return base + "bg-slate-500/20 text-slate-300"
}

// stagePhaseBadgeClass gives a LibraryItem's raw status.phase string a
// badge, grouped the same way helpers.go's stageBadgeClass groups
// pipeline.Stage: failed/cutoff-style phases read as amber, a settled phase
// reads as emerald, anything else (including a phase this switch does not
// specifically know, which keeps the badge readable for a phase value added
// to a kind's enum after this was written) reads as the default "in
// progress" sky blue.
func stagePhaseBadgeClass(phase string) string {
	const base = "rounded-full px-2 py-0.5 text-xs font-medium "
	switch phase {
	case "CutoffUnmet", "CutoffUnevaluated", "Delayed":
		// CutoffUnevaluated (Movie, Episode) is an item whose quality
		// profile could not be resolved: like CutoffUnmet, something is
		// wrong with it that the user should look at, so it shares the
		// warning colour rather than the neutral in-flight sky blue.
		return base + "bg-amber-500/20 text-amber-300"
	case "Imported":
		return base + "bg-emerald-500/20 text-emerald-300"
	case "Unmonitored":
		return base + "bg-slate-500/20 text-slate-300"
	default:
		return base + "bg-sky-500/20 text-sky-300"
	}
}

// libraryItemURL and libraryDetailPath both build a LibraryItem's detail
// page path -- /library/<namespace>/<kind>/<name>, matching ui/routes.go's
// "GET /library/{namespace}/{kind}/{name}" pattern -- the former typed as
// templ.SafeURL for the <a href> it's used in, the latter a plain string for
// a hidden form field's value, where templ does not apply URL sanitisation.
func libraryItemURL(item projection.LibraryItem) templ.SafeURL {
	return templ.URL(libraryDetailPath(item))
}

func libraryDetailPath(item projection.LibraryItem) string {
	return fmt.Sprintf("/library/%s/%s/%s", item.Ref.Namespace, item.Kind, item.Ref.Name)
}

// libraryActionURL builds the POST target for one of a LibraryItem's own
// actions ("monitor" or "search"), appended to its detail path.
func libraryActionURL(item projection.LibraryItem, action string) string {
	return fmt.Sprintf("%s/%s", libraryDetailPath(item), action)
}
