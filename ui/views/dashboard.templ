package views

import (
	"fmt"
	"strconv"
	"time"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/chart"
	"github.com/mediactl/clustarr/ui/components/pagination"
	"github.com/mediactl/clustarr/ui/components/progress"
	"github.com/mediactl/clustarr/ui/components/tabs"
	"github.com/mediactl/clustarr/ui/components/togglegroup"
	"github.com/mediactl/clustarr/ui/components/utils"
	"github.com/mediactl/clustarr/ui/projection"
)

// DashboardView is the dashboard, the ui's home page (2026-10-22): what is
// running, waiting, failed and skipped now, from the projection, and charts
// of clustarr's and Plex's metrics, from the metrics store.
type DashboardView struct {
	Summary DashboardSummaryView
	Charts  DashboardChartsView
}

// DashboardSummaryView is the dashboard's live part, re-fetched every
// SummaryRefresh: the projection's counts and lists, and the active
// downloads with their transfer telemetry.
type DashboardSummaryView struct {
	Summary projection.Dashboard
	Active  []DownloadView
	// Tabs is the tab each section card shows, by section key, as the
	// summary poller reports it (ui/static/dashboard.js), so a refresh
	// keeps it; empty, the first tab with rows. Pages is the page each
	// running list shows ("downloads-running", "transcodes-running"), whose
	// rows Active and Summary's Transcodes.Running carry.
	Tabs  map[string]string
	Pages map[string]ListPage
}

// ListPage is the page a paged list shows, from 1, of Pages.
type ListPage struct {
	Page, Pages int
}

// DashboardChartsView is the dashboard's charts over one range, re-fetched
// every ChartsRefresh.
type DashboardChartsView struct {
	Range      string
	Ranges     []string
	Configured bool
	Panels     []ChartPanel
	// Tabs are each section's chart card's tabs; a section without any
	// shows its panels as cards of their own. Selected is the tab each
	// card shows, by section, as the request reports it.
	Tabs     map[string][]ChartTab
	Selected map[string]string
}

// ChartPanel is one chart: its series' config, one datum per sample time
// (key "t" its axis label), and the error that left it empty, if any.
type ChartPanel struct {
	ID string
	// Section is the dashboard section the chart stands in (a
	// dashboardSections key).
	Section     string
	Title       string
	Description string
	Kind        string // "area", "bar" or "line"
	Stacked     bool
	Config      chart.Config
	Keys        []string
	Data        []chart.Datum
	Err         string
}

// ChartTab is one tab of a section's chart card: a chart, or one series of
// it, the figure it shows over the range (its total, peak or latest, "–"
// without data) and, when it shows one series, that series' colour.
type ChartTab struct {
	Value, Label   string
	Figure, Swatch string
	Panel          ChartPanel
}

// The dashboard's refresh periods.
const (
	SummaryRefresh = "10s"
	ChartsRefresh  = "60s"
)

// dashboardSection is one subject of the dashboard (owner, 2026-11-04:
// "order sections based on the subject"): its key, its heading, and
// whether it has live cards (a summary and lists from the projection) as
// well as charts.
type dashboardSection struct {
	Key, Title string
	Live       bool
}

// dashboardSections are the dashboard's sections, in the order work
// flows: what is downloading, then transcoding, then what Plex and Live
// TV serve.
var dashboardSections = []dashboardSection{
	{"downloads", "Downloads", true},
	{"transcodes", "Transcodes", true},
	{"plex", "Plex", false},
	{"livetv", "Live TV", false},
}

// Has is whether a section has charts to show.
func (v DashboardChartsView) Has(section string) bool {
	for _, p := range v.Panels {
		if p.Section == section {
			return true
		}
	}
	return false
}

// Dashboard is the page: the title and the charts' range, then a section
// per subject, each one grid of eighths on a wide screen -- its tabbed card
// the whole row, a chart two columns -- quarters on a laptop and halves on
// a phone, the cards of a row as tall as the tallest (owner, 2026-11-04:
// "Card height should be identical for all cards"). A section's grid holds two
// groups whose boxes vanish (display: contents), its live cards and its
// charts, and two hidden pollers refresh them: every SummaryRefresh the
// live groups, every ChartsRefresh and at a range pick the chart groups,
// each answered out of band so one request serves every section.
templ Dashboard(v DashboardView) {
	@Layout("Dashboard") {
		<div class="mb-4 flex items-center justify-between gap-4">
			<h1 class="text-2xl font-bold">Dashboard</h1>
			if v.Charts.Configured {
				@rangePicker(v.Charts, false)
			}
		</div>
		<div id="dashboard-summary-poller" hidden hx-get="/dashboard/summary" hx-trigger={ "every " + SummaryRefresh + ", dashboard:page" } hx-swap="none"></div>
		if v.Charts.Configured {
			@chartsPoller(v.Charts, false)
		}
		<div class="space-y-8">
			for _, sec := range dashboardSections {
				if sec.Live || v.Charts.Has(sec.Key) {
					<section data-dashboard-section={ sec.Key } class="space-y-3">
						// A live section's card carries its title; a section of
						// charts alone is headed.
						if !sec.Live {
							<h2 class="text-lg font-semibold">{ sec.Title }</h2>
						}
						<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 xl:grid-cols-8">
							if sec.Live {
								@liveGroup(sec.Key, v.Summary, false)
							}
							@chartsGroup(sec.Key, v.Charts, false)
						</div>
					</section>
				}
			}
			if !v.Charts.Configured {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Metrics are not configured
						}
						@card.Description() {
							Give the ui a Prometheus-compatible API with --metrics-url (the chart's ui.metrics.url), e.g. Mimir's http://mimir.observability.svc:8080/prometheus, to chart clustarr's and Plex's metrics here.
						}
					}
				}
			}
		</div>
	}
}

// DashboardSummary is GET /dashboard/summary: every live group, out of
// band.
templ DashboardSummary(v DashboardSummaryView) {
	for _, sec := range dashboardSections {
		if sec.Live {
			@liveGroup(sec.Key, v, true)
		}
	}
}

// liveGroup is a section's live cards, swapped in place (oob) by the
// summary poller.
templ liveGroup(key string, v DashboardSummaryView, oob bool) {
	<div
		id={ "dashboard-live-" + key }
		class="contents"
		if oob {
			hx-swap-oob="true"
		}
	>
		switch key {
			case "downloads":
				@downloadsLive(v)
			case "transcodes":
				@transcodesLive(v)
		}
	</div>
}

// downloadsLive is the Downloads section's card: a tab per state of a
// grab, its count the tab's overview, its rows the tab's content.
templ downloadsLive(v DashboardSummaryView) {
	{{ d := v.Summary.Downloads }}
	{{
		tabList := []statTab{
			{Value: "running", Label: "Running", Color: "bg-sky-500", N: d.Active.Total,
				Body: downloadRows("downloads-running", v.Active, v.Pages["downloads-running"], "Nothing is downloading.")},
			{Value: "queued", Label: "Queued", Color: "bg-blue-700", N: d.Pending.Total,
				Body: downloadRows("downloads-queued", rowViews(d.Pending.Rows), v.Pages["downloads-queued"], "Nothing is waiting.")},
			{Value: "failed", Label: "Failed", Color: "bg-red-500", N: d.Failed.Total,
				Body: downloadRows("downloads-failed", rowViews(d.Failed.Rows), v.Pages["downloads-failed"], "Nothing has failed.")},
		}
	}}
	@sectionCard("downloads", "Downloads", "Grabs by state", "/downloads", tabList, selectedTab(tabList, v.Tabs["downloads"]))
}

// transcodesLive is the Transcodes section's card, as downloadsLive.
templ transcodesLive(v DashboardSummaryView) {
	{{ t := v.Summary.Transcodes }}
	{{
		tabList := []statTab{
			{Value: "running", Label: "Running", Color: "bg-sky-500", N: t.Running.Total,
				Body: transcodeRows("transcodes-running", t.Running.Rows, v.Pages["transcodes-running"], "Nothing is transcoding.")},
			{Value: "pending", Label: "Pending", Color: "bg-blue-700", N: t.Pending.Total,
				Body: transcodeRows("transcodes-pending", t.Pending.Rows, v.Pages["transcodes-pending"], "Nothing is waiting.")},
			{Value: "failed", Label: "Failed", Color: "bg-red-500", N: t.Failed.Total,
				Body: transcodeRows("transcodes-failed", t.Failed.Rows, v.Pages["transcodes-failed"], "Nothing has failed.")},
			{Value: "skipped", Label: "Skipped", Color: "bg-amber-500", N: t.Skipped.Total,
				Body: transcodeRows("transcodes-skipped", t.Skipped.Rows, v.Pages["transcodes-skipped"], "No transcode was skipped.")},
		}
	}}
	@sectionCard("transcodes", "Transcodes", "Transcodes by state", "/pipeline", tabList, selectedTab(tabList, v.Tabs["transcodes"]))
}

// statTab is one tab of a section card, as shadcn's interactive chart
// header has one per series: its value, its label and colour, its count
// (the tab's overview) and what it reveals.
type statTab struct {
	Value, Label, Color string
	N                   int
	// Figure is the tab's overview when it is no count (a chart's total,
	// peak or latest); Swatch its colour as a CSS value when Color, a
	// Tailwind class, is empty.
	Figure, Swatch string
	Body           templ.Component
}

// figure is the tab's overview: its Figure, else its count.
func (t statTab) figure() string {
	if t.Figure != "" {
		return t.Figure
	}
	return strconv.Itoa(t.N)
}

// selectedTab is the tab a section card opens on: the one asked for when
// it is one of the card's, else the first with rows, else the first.
func selectedTab(list []statTab, asked string) string {
	for _, t := range list {
		if t.Value == asked {
			return asked
		}
	}
	for _, t := range list {
		if t.N > 0 {
			return t.Value
		}
	}
	return list[0].Value
}

// sectionTabClass dresses a section card's tab as shadcn's interactive
// chart header does its series buttons: a block divided from its
// neighbours, the label over the count, the open one shaded. It overrides
// the tabs component's own pill (tailwind-merge drops what it replaces).
// Every tab is a square of one size on every card -- 4rem on a phone, 5 on
// a laptop, 6 on a wide screen -- so the headers of every card are as tall
// (owner, 2026-11-04: "the tabs should be square in all aspect
// ratios/screen sizes", "the same size for all cards", "can shrink on
// smaller screens"); the tabs stand in the header beside the title, except
// on a phone, where they take a line of their own.
const sectionTabClass = "group/tab relative size-16 flex-none cursor-pointer flex-col items-center justify-center gap-0.5 rounded-none border-0 border-l border-border p-1 text-center hover:bg-muted/30 data-active:bg-muted/50 data-active:text-foreground group-data-[variant=default]/tabs-list:data-active:shadow-none sm:size-20 xl:size-24"

// sectionTabStripeClass is a tab's colour: a line along its bottom edge,
// as a tab strip underlines its tabs, dim until the tab is open or under
// the pointer (owner, 2026-11-04: "the tabs being navigable is not
// evident ... moving the colored lines to the bottom").
const sectionTabStripeClass = "absolute inset-x-0 bottom-0 h-1 opacity-40 transition-opacity group-hover/tab:opacity-80 group-data-[active]/tab:opacity-100"

// sectionCardSpan is a section card's width in its section's grid: half a
// wide screen's row, a section's two cards side by side, and the whole row
// below xl (owner, 2026-11-04).
const sectionCardSpan = "col-span-full xl:col-span-4"

// sectionCard is a section's tabbed card (owner, 2026-11-04, after
// shadcn's "Bar Chart - Interactive"): the title and its one-line
// description at the left of the header and the square tabs at its right
// (on a phone a line of their own), each its colour as a line along its
// bottom edge, its name and its figure; the open tab's content below. A
// tab switches in the browser
// (ui/components/tabs); the pollers tell the server which tab each card
// shows, so a refresh keeps it open. A section has two: its lists, and its
// charts (chartCard). href links the title, when there is one.
templ sectionCard(key, title, description, href string, tabList []statTab, selected string) {
	@card.Card(card.Props{Class: sectionCardSpan + " gap-0 py-0", Attributes: templ.Attributes{"data-section-card": key}}) {
		@tabs.Tabs(tabs.Props{ID: "dashboard-tabs-" + key, DefaultValue: selected, Class: "@container gap-0", Attributes: templ.Attributes{"data-dashboard-tabs": key}}) {
			<div class="flex flex-col items-stretch border-b border-border sm:flex-row">
				<div class="flex min-w-0 flex-1 flex-col justify-center gap-0.5 px-4 py-3 sm:px-6">
					if href != "" {
						<a href={ templ.SafeURL(href) } class="truncate font-semibold leading-snug hover:underline">{ title }</a>
					} else {
						<span class="truncate font-semibold leading-snug">{ title }</span>
					}
					<p class="truncate text-sm text-muted-foreground" title={ description }>{ description }</p>
				</div>
				@tabs.List(tabs.ListProps{Class: "flex h-auto w-full items-stretch justify-start overflow-x-auto overflow-y-hidden rounded-none border-t border-border bg-transparent p-0 [scrollbar-width:none] group-data-horizontal/tabs:h-auto sm:w-auto sm:overflow-visible sm:border-t-0"}) {
					for _, t := range tabList {
						@tabs.Trigger(tabs.TriggerProps{Value: t.Value, Class: sectionTabClass, Attributes: templ.Attributes{"data-stat": t.Label, "data-count": t.figure()}}) {
							// The tab's colour is a line along its bottom edge; a
							// chart of several series has no one colour, and a
							// neutral line keeps the tabs alike.
							if t.Color != "" {
								<span data-stripe class={ sectionTabStripeClass + " " + t.Color } aria-hidden="true"></span>
							} else if t.Swatch != "" {
								<span data-stripe class={ sectionTabStripeClass } style={ templ.SafeCSS("background-color: " + t.Swatch + ";") } aria-hidden="true"></span>
							} else {
								<span data-stripe class={ sectionTabStripeClass + " bg-muted-foreground" } aria-hidden="true"></span>
							}
							<span class="text-[11px] font-normal text-muted-foreground sm:text-xs">{ t.Label }</span>
							<span class="text-lg font-bold leading-none tabular-nums sm:text-xl xl:text-2xl">{ t.figure() }</span>
						}
					}
				}
			</div>
			for _, t := range tabList {
				@tabs.Content(tabs.ContentProps{Value: t.Value, Class: "px-6 py-4", Attributes: templ.Attributes{"data-list": key + "-" + t.Value}}) {
					@t.Body
				}
			}
		}
	}
}

// downloadRows is a download tab's content, list naming it for the pages
// (owner, 2026-11-04: every tab "one item per line" with a cap "and
// pagination at the bottom", "All tables should have the same max rows",
// four rows so the card fits beside its charts):
// a row a line, a page of them (pg), and the pages beneath; none says an
// empty list.
templ downloadRows(list string, rows []DownloadView, pg ListPage, none string) {
	if len(rows) == 0 {
		@emptyNote(none, "py-6", templ.Attributes{"data-dashboard-page-list": list, "data-dashboard-page": "1"})
	} else {
		<div class="grid gap-4" data-dashboard-page-list={ list } data-dashboard-page={ strconv.Itoa(pg.Page) }>
			for _, d := range rows {
				@dashboardDownload(d)
			}
		</div>
	}
	@listPager(list, pg)
}

// transcodeRows is a transcode tab's content, as downloadRows.
templ transcodeRows(list string, rows []projection.TranscodeRow, pg ListPage, none string) {
	if len(rows) == 0 {
		@emptyNote(none, "py-6", templ.Attributes{"data-dashboard-page-list": list, "data-dashboard-page": "1"})
	} else {
		<div class="grid gap-4" data-dashboard-page-list={ list } data-dashboard-page={ strconv.Itoa(pg.Page) }>
			for _, r := range rows {
				@dashboardTranscode(r)
			}
		</div>
	}
	@listPager(list, pg)
}

// listPager is a paged list's pages (shadcn's pagination), under every
// list so the cards read alike (owner, 2026-11-04): Previous, the pages
// around the one open, Next. Each is a link to the dashboard on that
// page, which ui/static/dashboard.js turns into a refresh of the summary
// on it (data-dashboard-goto).
templ listPager(list string, pg ListPage) {
	@pagination.Pagination(pagination.Props{Class: "mt-4", Attributes: templ.Attributes{"data-pager": list}}) {
		@pagination.Content() {
			@pagination.Item() {
				@pagination.Previous(pagination.PreviousProps{Href: listPageHref(list, pg.Page-1), Disabled: pg.Page <= 1, Text: "Previous", Attributes: gotoAttrs(list, pg.Page-1)})
			}
			for _, n := range listPageWindow(pg) {
				@pagination.Item() {
					if n == 0 {
						@pagination.Ellipsis()
					} else {
						@pagination.Link(pagination.LinkProps{Href: listPageHref(list, n), IsActive: n == pg.Page, Attributes: gotoAttrs(list, n)}) {
							{ strconv.Itoa(n) }
						}
					}
				}
			}
			@pagination.Item() {
				@pagination.Next(pagination.NextProps{Href: listPageHref(list, pg.Page+1), Disabled: pg.Page >= pg.Pages, Text: "Next", Attributes: gotoAttrs(list, pg.Page+1)})
			}
		}
	}
}

// listPageWindow is the pages a listPager lists: all of up to seven, else the
// first, the last and the open one's neighbours, a 0 for each gap.
func listPageWindow(pg ListPage) []int {
	if pg.Pages <= 7 {
		out := make([]int, pg.Pages)
		for i := range out {
			out[i] = i + 1
		}
		return out
	}
	var out []int
	for n := 1; n <= pg.Pages; n++ {
		switch {
		case n == 1 || n == pg.Pages || (n >= pg.Page-1 && n <= pg.Page+1):
			out = append(out, n)
		case len(out) > 0 && out[len(out)-1] != 0:
			out = append(out, 0)
		}
	}
	return out
}

// listPageHref is the dashboard on page n of list, the link without
// JavaScript.
func listPageHref(list string, n int) string {
	return fmt.Sprintf("/dashboard?page-%s=%d", list, n)
}

// gotoAttrs mark a listPager's link for ui/static/dashboard.js.
func gotoAttrs(list string, n int) templ.Attributes {
	return templ.Attributes{"data-dashboard-goto": strconv.Itoa(n), "data-dashboard-list": list}
}

// rowViews are grab entries without transfer telemetry, as the queued and
// failed tabs list them.
func rowViews(rows []projection.DownloadRow) []DownloadView {
	out := make([]DownloadView, 0, len(rows))
	for _, r := range rows {
		out = append(out, DownloadView{Row: r})
	}
	return out
}

// dashboardDownload is one grab entry.
templ dashboardDownload(d DownloadView) {
	<div class="min-w-0 space-y-1" data-download={ d.Row.Entry.ID } data-phase={ string(d.Row.Entry.Phase) }>
		<div class="flex items-start justify-between gap-2">
			<a class="min-w-0 truncate text-sm font-medium hover:underline" href={ templ.SafeURL(ownerURL(d.Row)) } title={ downloadTitle(d.Row) }>{ downloadTitle(d.Row) }</a>
			<div class="flex flex-none gap-1">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: downloadPhaseTone(d.Row.Entry.Phase)}) {
					{ downloadPhaseLabel(d.Row.Entry.Phase) }
				}
			</div>
		</div>
		{{ pct := downloadPercent(d) }}
		if pct >= 0 {
			@rowProgress(downloadRate(d), pct)
		} else if detail := downloadRate(d); detail != "" {
			@rowDetail(detail)
		}
		if failed(d.Row.Entry.Phase) {
			<div class="truncate text-xs text-destructive" title={ downloadFailureDetail(d.Row.Entry) }>{ downloadFailureDetail(d.Row.Entry) }</div>
		}
	</div>
}

// dashboardTranscode is one MediaFile's transcode.
templ dashboardTranscode(r projection.TranscodeRow) {
	<div class="min-w-0 space-y-1" data-transcode={ r.File.Name } data-phase={ string(r.Phase) }>
		<div class="flex items-start justify-between gap-2">
			<a class="min-w-0 truncate text-sm font-medium hover:underline" href={ templ.SafeURL(r.ItemURL) } title={ r.Name }>{ r.Name }</a>
			<div class="flex flex-none gap-1">
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ string(r.Phase) }
				}
			</div>
		</div>
		if r.Percent >= 0 {
			@rowProgress(transcodeDetail(r), r.Percent)
		} else {
			@rowDetail(transcodeDetail(r))
		}
	</div>
}

// rowProgress is a row's bar with its label and value, shadcn-templ's
// progress in full (owner, 2026-11-04): the details as the label at the
// left, the percent as the value at the right, the bar beneath.
templ rowProgress(detail string, percent int32) {
	@progress.Progress(progress.Props{Value: int(clampPercent(percent)), Class: "gap-x-3 gap-y-1", Attributes: templ.Attributes{"data-progress": fmt.Sprint(percent)}}) {
		@progress.Label(progress.LabelProps{Class: "min-w-0 flex-1 truncate text-xs font-normal text-muted-foreground", Attributes: templ.Attributes{"title": detail}}) {
			{ detail }
		}
		@progress.Value(progress.ValueProps{Class: "text-xs", Attributes: templ.Attributes{"data-percent": true}})
	}
}

// rowDetail is a row's details alone, for one with no bar.
templ rowDetail(detail string) {
	<p class="truncate text-xs text-muted-foreground" title={ detail }>{ detail }</p>
}

// downloadRate is a transfer's rate and ETA, "" without its telemetry.
func downloadRate(d DownloadView) string {
	pr := d.Progress
	if pr == nil {
		return ""
	}
	return fmt.Sprintf("%s/s · ETA %s", formatBytes(pr.DownRateBytesPerSec), formatETA(pr.ETASeconds))
}

// transcodeDetail is a row's second line: its plan or verdict, the class it
// runs on and its age.
func transcodeDetail(r projection.TranscodeRow) string {
	var parts []string
	running := r.Phase == catalogv1.TranscodePhaseRunning || r.Phase == catalogv1.TranscodePhaseSwapping
	switch {
	case running && r.Plan != "":
		// A running transcode's message carries its dispatch's attempt id;
		// the plan says what it is doing.
		parts = append(parts, r.Plan)
	case r.Message != "":
		parts = append(parts, r.Message)
	case r.Plan != "":
		parts = append(parts, r.Plan)
	case r.Reason != "":
		parts = append(parts, r.Reason)
	}
	if r.Class != "" {
		parts = append(parts, string(r.Class))
	}
	if !r.Since.IsZero() {
		parts = append(parts, sinceLabel(time.Since(r.Since)))
	}
	return joinDot(parts)
}

func sinceLabel(d time.Duration) string {
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d/time.Minute))
	case d < 48*time.Hour:
		return fmt.Sprintf("%dh ago", int(d/time.Hour))
	default:
		return fmt.Sprintf("%dd ago", int(d/(24*time.Hour)))
	}
}

func joinDot(parts []string) string {
	out := ""
	for i, p := range parts {
		if i > 0 {
			out += " · "
		}
		out += p
	}
	return out
}

// DashboardCharts is GET /dashboard/charts: every section's charts over
// v.Range, the range picker and the poller (now asking for v.Range), all
// out of band.
templ DashboardCharts(v DashboardChartsView) {
	@chartsPoller(v, true)
	@rangePicker(v, true)
	for _, sec := range dashboardSections {
		if v.Has(sec.Key) {
			@chartsGroup(sec.Key, v, true)
		}
	}
}

// chartsPoller asks for the charts over v.Range every ChartsRefresh.
templ chartsPoller(v DashboardChartsView, oob bool) {
	<div
		id="dashboard-charts-poller"
		hidden
		hx-get={ "/dashboard/charts?range=" + v.Range }
		hx-trigger={ "every " + ChartsRefresh }
		hx-swap="none"
		data-range={ v.Range }
		if oob {
			hx-swap-oob="true"
		}
	></div>
}

// rangePicker is the charts' range, beside the page's title since it
// ranges every section's charts: shadcn-templ's toggle group (since
// 2026-11-04), the current range pressed; a press asks the charts poller
// for that range and the answer re-renders the picker out of band.
templ rangePicker(v DashboardChartsView, oob bool) {
	@togglegroup.ToggleGroup(togglegroup.Props{
		ID:         "dashboard-range",
		Variant:    togglegroup.VariantOutline,
		Size:       togglegroup.SizeSm,
		Spacing:    utils.Ptr(0),
		Value:      []string{v.Range},
		Attributes: rangePickerAttrs(oob),
	}) {
		for _, r := range v.Ranges {
			@togglegroup.Item(togglegroup.ItemProps{Value: r, Attributes: templ.Attributes{"hx-get": "/dashboard/charts?range=" + r, "hx-swap": "none"}}) {
				{ r }
			}
		}
	}
}

// rangePickerAttrs label the range picker and, when oob, have it swap
// itself in place.
func rangePickerAttrs(oob bool) templ.Attributes {
	attrs := templ.Attributes{"aria-label": "Range"}
	if oob {
		attrs["hx-swap-oob"] = "true"
	}
	return attrs
}

// chartsGroup is a section's charts, swapped in place (oob) by the charts
// poller and the range picker.
templ chartsGroup(key string, v DashboardChartsView, oob bool) {
	<div
		id={ "dashboard-charts-" + key }
		class="contents"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(v.Tabs[key]) > 0 {
			@chartCard(key, v)
		} else {
			for _, p := range v.Panels {
				if p.Section == key {
					@chartPanel(p)
				}
			}
		}
	</div>
}

// chartCard is a section's second card (owner, 2026-11-04): its charts
// behind tabs, each tab a chart's or a series' figure over the range.
templ chartCard(key string, v DashboardChartsView) {
	{{ list := chartStatTabs(v.Tabs[key]) }}
	@sectionCard(key+"-charts", chartCardTitles[key], "Over "+rangeLabel(v.Range), "", list, selectedTab(list, v.Selected[key]))
}

// chartCardTitles title the chart cards.
var chartCardTitles = map[string]string{
	"downloads":  "Grabs and imports",
	"transcodes": "Transcode activity",
}

// rangeLabel says a range in words.
func rangeLabel(r string) string {
	switch r {
	case "6h":
		return "the last 6 hours"
	case "7d":
		return "the last 7 days"
	default:
		return "the last 24 hours"
	}
}

// chartStatTabs are a chart card's tabs as sectionCard draws them.
func chartStatTabs(list []ChartTab) []statTab {
	out := make([]statTab, 0, len(list))
	for _, t := range list {
		out = append(out, statTab{Value: t.Value, Label: t.Label, Figure: t.Figure, Swatch: t.Swatch, Body: chartView(t.Panel, "h-[250px]")})
	}
	return out
}

// chartPanel is one chart, a quarter of a wide screen as a list card is.
templ chartPanel(p ChartPanel) {
	@card.Card(card.Props{Class: "col-span-2", Attributes: templ.Attributes{"data-panel": p.ID}}) {
		@card.Header() {
			@card.Title() {
				{ p.Title }
			}
			@card.Description(card.DescriptionProps{Class: "truncate", Attributes: templ.Attributes{"title": p.Description}}) {
				{ p.Description }
			}
		}
		@card.Content() {
			@chartView(p, "h-[220px]")
		}
	}
}

// chartView is a panel's chart, height tall, or why it has none.
templ chartView(p ChartPanel, height string) {
	if p.Err != "" {
		<p class="text-sm text-destructive">{ p.Err }</p>
	} else if len(p.Data) == 0 {
		<p class="text-sm text-muted-foreground">No data in this range.</p>
	} else {
		@chart.Container(chart.ContainerProps{ID: "dash-" + p.ID, Config: p.Config, Class: "aspect-auto w-full " + height}) {
			switch p.Kind {
				case "bar":
					@chart.BarChart(chart.BarChartProps{Data: p.Data, AccessibilityLayer: true}) {
						@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
						@chart.XAxis(chart.XAxisProps{DataKey: "t", TickLine: false, AxisLine: false, TickMargin: 8, MinTickGap: 32})
						@chart.YAxis(chart.YAxisProps{TickLine: false, AxisLine: false, Width: 40})
						@chart.Tooltip(chart.TooltipProps{Content: chart.TooltipContentProps{Indicator: "dot"}})
						for _, k := range p.Keys {
							@chart.Bar(chart.BarProps{DataKey: k, Fill: "var(--color-" + k + ")", StackID: stackID(p), Radius: 2})
						}
						@chart.Legend()
					}
				case "line":
					@chart.LineChart(chart.LineChartProps{Data: p.Data, AccessibilityLayer: true}) {
						@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
						@chart.XAxis(chart.XAxisProps{DataKey: "t", TickLine: false, AxisLine: false, TickMargin: 8, MinTickGap: 32})
						@chart.YAxis(chart.YAxisProps{TickLine: false, AxisLine: false, Width: 40})
						@chart.Tooltip(chart.TooltipProps{Content: chart.TooltipContentProps{Indicator: "line"}})
						for _, k := range p.Keys {
							@chart.Line(chart.LineProps{DataKey: k, Type: chart.CurveMonotone, Stroke: "var(--color-" + k + ")", StrokeWidth: 2})
						}
						@chart.Legend()
					}
				default:
					@chart.AreaChart(chart.AreaChartProps{Data: p.Data, AccessibilityLayer: true}) {
						@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
						@chart.XAxis(chart.XAxisProps{DataKey: "t", TickLine: false, AxisLine: false, TickMargin: 8, MinTickGap: 32})
						@chart.YAxis(chart.YAxisProps{TickLine: false, AxisLine: false, Width: 40})
						@chart.Tooltip(chart.TooltipProps{Content: chart.TooltipContentProps{Indicator: "dot"}})
						for _, k := range p.Keys {
							@chart.Area(chart.AreaProps{DataKey: k, Type: chart.CurveMonotone, Fill: "var(--color-" + k + ")", Stroke: "var(--color-" + k + ")", FillOpacity: 0.3, StackID: stackID(p)})
						}
						@chart.Legend()
					}
			}
		}
	}
}

// stackID stacks a stacked panel's series, and no other.
func stackID(p ChartPanel) string {
	if p.Stacked {
		return "a"
	}
	return ""
}
