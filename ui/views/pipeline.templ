package views

import (
	"fmt"

	"github.com/mediactl/clustarr/pkg/pipeline"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/item"
	"github.com/mediactl/clustarr/ui/paging"
)

// Pipeline renders the Pipeline page (§A3.4): one row per in-flight item,
// live-updated over the /events/pipeline SSE stream. It is a full page,
// wrapped in Layout, so a plain GET renders something useful even before
// htmx's SSE extension has connected.
//
// #pipeline-rows is the sse-swap target: htmx's SSE extension replaces that
// element's innerHTML with the named event's data, so everything inside it
// (and only what's inside it) must be exactly what PipelineRows renders --
// the page heading lives outside the swapped element so it survives a live
// update instead of being replaced by it.
templ Pipeline(p paging.Page, entries []pipeline.Entry) {
	@Layout("Pipeline") {
		<h1 class="mb-4 text-2xl font-bold">Pipeline</h1>
		<div
			id="pipeline-rows"
			hx-ext="sse"
			sse-connect={ "/events/pipeline" + p.Query(p.Number) }
			sse-swap="pipeline"
			class="space-y-4"
		>
			@PipelineList(p, entries)
		</div>
	}
}

// PipelineList is what #pipeline-rows holds and what every /events/pipeline
// frame carries: the pager, the page's rows, the pager again. entries is
// already the page's window (paging.Window); p says where it sits, so the
// counts in the pager are as live as the rows.
templ PipelineList(p paging.Page, entries []pipeline.Entry) {
	@Pager(p, "/pipeline")
	@PipelineRows(entries)
	@Pager(p, "/pipeline")
}

// PipelineRows renders the dynamic part of the Pipeline page: the "nothing
// in flight" placeholder or the row grid. This is also what
// /events/pipeline renders into each SSE event's data, so the initial page
// render and every live update produce byte-for-byte the same markup for
// #pipeline-rows's contents.
templ PipelineRows(entries []pipeline.Entry) {
	if len(entries) == 0 {
		<p class="text-muted-foreground">Nothing in flight.</p>
	}
	@item.Group(item.GroupProps{Class: "gap-3"}) {
		for _, e := range entries {
			@pipelineRow(e)
		}
	}
}

// pipelineRow renders one Entry as an item: the title, the stage as a
// badge keeping its meaning colour (stageTone), the progress bar when the
// stage has a meaningful percentage, and the failure detail when the item
// is Failed or Blocked. Every row carries data-kind, data-stage and
// data-ref (ruling R8) for the tests.
templ pipelineRow(e pipeline.Entry) {
	@item.Item(item.Props{
		Variant: item.VariantOutline,
		Class:   "flex-nowrap items-start",
		Attributes: templ.Attributes{
			"data-kind":  string(e.Kind),
			"data-stage": string(e.Stage),
			"data-ref":   e.Ref.String(),
		},
	}) {
		@item.Content() {
			@item.Title() { { e.Title } }
			if e.Percent >= 0 {
				@progressBar(e.Percent)
			}
			if e.Detail != "" {
				@item.Description() { { e.Detail } }
			}
			if e.Stage == pipeline.StageFailed || e.Stage == pipeline.StageBlocked {
				<div class="text-sm text-destructive">{ e.Failure }</div>
			}
		}
		@item.Content(item.ContentProps{Class: "flex-none items-end"}) {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: stageTone(e.Stage)}) { { string(e.Stage) } }
		}
	}
}

// progressBar is the bar the pipeline and downloads rows share: the fill
// carries data-progress with the raw percentage, the width the clamped one.
templ progressBar(percent int32) {
	<div class="mt-1 w-full overflow-hidden rounded-full bg-muted">
		<div
			class="h-2 rounded-full bg-primary"
			data-progress={ fmt.Sprint(percent) }
			style={ fmt.Sprintf("width: %d%%", clampPercent(percent)) }
		></div>
	</div>
	<div class="text-xs text-muted-foreground">{ fmt.Sprintf("%d%%", percent) }</div>
}
