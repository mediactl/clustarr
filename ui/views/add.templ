package views

import (
	"fmt"
	"net/url"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	commonv1 "github.com/mediactl/clustarr/api/common/v1alpha1"
	"github.com/mediactl/clustarr/ui/components/alert"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/checkbox"
	"github.com/mediactl/clustarr/ui/components/collapsible"
	"github.com/mediactl/clustarr/ui/components/empty"
	"github.com/mediactl/clustarr/ui/components/field"
	"github.com/mediactl/clustarr/ui/components/input"
	selectcomp "github.com/mediactl/clustarr/ui/components/select"
	"github.com/mediactl/clustarr/ui/components/spinner"
	"github.com/mediactl/clustarr/ui/components/togglegroup"
	"github.com/mediactl/clustarr/ui/components/utils"
	"github.com/mediactl/clustarr/ui/projection"
)

// AddOption is one choice of an Add New select.
type AddOption struct{ Value, Label string }

// AddIDKey is one id key a kind's search hits may carry, with the source
// it names: a comic's hits carry a ComicVine id or a MangaDex one, and the
// Comic is created with that source (2026-11-10 design §9.1).
type AddIDKey struct {
	Key, Source, Label string
}

// AddKind is Add New for one library tab (ui/add.go's addKinds).
type AddKind struct {
	Tab         projection.Tab
	Kind        commonv1.MediaKind
	Label       string
	IDKey       string
	RootKind    catalogv1.RootFolderKind
	ProfileKind catalogv1.ProfileMediaKind
	Monitor     []AddOption
	MonitorNew  []AddOption
	// IDKeys, when set, are the id keys a hit may carry instead of IDKey,
	// tried in order, each naming the hit's source.
	IDKeys []AddIDKey
	// Alternate is a kind the tab adds beside its own (a Book on the Books
	// tab), reached with ?kind=<kind> on every one of its URLs.
	Alternate bool
	// SearchOnAdd labels the "start a search" checkbox; "" for a kind
	// without add options (a Book).
	SearchOnAdd string
}

// AddPageData is the Add New page: the search box, and the action error
// of a rejected add.
type AddPageData struct {
	Kind AddKind
	// Kinds are the tab's kinds, its own first: a switch when there are two.
	Kinds     []AddKind
	Available bool
	ErrorCode string
	Error     string
	// Query and Results, after a rejected add, bring back the owner's
	// search and the form they submitted.
	Query   string
	Results *AddResultsData
}

// AddHit is one search result: InLibrary is the item's detail path when
// the library already holds it, and Poster the /art/search path or "".
// Source and SourceLabel name a comic hit's provider (comicvine, MangaDex).
type AddHit struct {
	ID, Title, Poster, InLibrary string
	Source, SourceLabel          string
	Year                         int32
}

// AddResultsData is what one search renders.
type AddResultsData struct {
	Kind                  AddKind
	Query                 string
	Hits                  []AddHit
	RootFolders, Profiles []AddOption
	Prompt, NoProvider    bool
	Error                 string
	// RetryURL, set when the search did not answer, re-runs it.
	RetryURL string
	// OpenID and Posted, after a rejected add, open that hit's form with
	// the values the owner submitted.
	OpenID string
	Posted url.Values
	// Region is the Audible marketplace an audiobook search asked in, the
	// form's default (the audiobook root's defaults.region, else us).
	Region string
}

// kindQuery is the ?kind= an alternate kind's URLs carry, "" for a tab's own.
func kindQuery(k AddKind) string {
	if !k.Alternate {
		return ""
	}
	return "kind=" + string(k.Kind)
}

// withQuery appends the non-empty parts as path's query.
func withQuery(path string, parts ...string) string {
	q := ""
	for _, p := range parts {
		if p == "" {
			continue
		}
		if q != "" {
			q += "&"
		}
		q += p
	}
	if q == "" {
		return path
	}
	return path + "?" + q
}

// AddPageURL is k's Add New page, with q in the box when given.
func AddPageURL(k AddKind, q string) string {
	var query string
	if q != "" {
		query = "q=" + url.QueryEscape(q)
	}
	return withQuery("/library/"+string(k.Tab)+"/add", kindQuery(k), query)
}

// AddSearchURL is k's search for q.
func AddSearchURL(k AddKind, q string) string {
	return withQuery("/library/"+string(k.Tab)+"/add/search", "q="+url.QueryEscape(q), kindQuery(k))
}

// addPostURL is where k's form posts; the alternate kind rides as a hidden
// field.
func addPostURL(k AddKind) string { return "/library/" + string(k.Tab) + "/add" }

// searchVals is the search input's hx-vals: the alternate kind beside q.
func searchVals(k AddKind) string {
	if !k.Alternate {
		return ""
	}
	return fmt.Sprintf(`{"kind":%q}`, string(k.Kind))
}

templ AddPage(d AddPageData) {
	@Shell(Chrome{Title: "Add " + d.Kind.Label, Tab: d.Kind.Tab, Crumbs: []Crumb{{Label: tabLabel(d.Kind.Tab), Href: "/library/" + string(d.Kind.Tab)}, {Label: "Add New"}}}) {
		<h1 class="mb-2 text-2xl font-semibold tracking-tight">Add { d.Kind.Label }</h1>
		<p class="mb-6 text-sm text-muted-foreground">Search by title, then choose how to add it.</p>
		if len(d.Kinds) > 1 {
			@addKindSwitch(d)
		}
		if d.Error != "" {
			<div class="mb-6">
				@ActionError(d.ErrorCode, d.Error)
			</div>
		}
		if !d.Available {
			<div class="mb-6">
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Title() {
						Metadata search is not available
					}
					@alert.Description() {
						The ui has no connection to the catalog metadata service.
					}
				}
			</div>
		}
		@input.Input(input.Props{
			Type:        "search",
			Name:        "q",
			Placeholder: "Search for a " + d.Kind.Label + " by title",
			Value:       d.Query,
			Class:       "max-w-xl",
			Attributes:  searchAttrs(d),
		})
		<p id="add-searching" class="htmx-indicator mt-2 flex items-center gap-2 text-sm text-muted-foreground">
			@spinner.Spinner()
			Searching…
		</p>
		<div id="add-results" class="mt-6" data-add-results>
			if d.Results != nil {
				@AddResults(*d.Results)
			}
		</div>
	}
}

// searchAttrs are the search box's htmx attributes: the kind's search
// route, the alternate kind in hx-vals, and a search as the page loads
// when it arrives with a query.
func searchAttrs(d AddPageData) templ.Attributes {
	attrs := templ.Attributes{
		"aria-label":   "Search",
		"autofocus":    true,
		"hx-get":       "/library/" + string(d.Kind.Tab) + "/add/search",
		"hx-trigger":   addSearchTrigger(d.Query),
		"hx-target":    "#add-results",
		"hx-indicator": "#add-searching",
	}
	if v := searchVals(d.Kind); v != "" {
		attrs["hx-vals"] = v
	}
	return attrs
}

// addKindSwitch is the Books tab's "Author | Book" (2026-11-10 design
// §9.1): a toggle group whose items swap the page body to the other
// kind's Add New, the query kept, as the sidebar's sub-entries swap it.
templ addKindSwitch(d AddPageData) {
	@togglegroup.ToggleGroup(togglegroup.Props{
		Variant:    togglegroup.VariantOutline,
		Size:       togglegroup.SizeSm,
		Spacing:    utils.Ptr(0),
		Class:      "mb-6",
		Value:      []string{string(d.Kind.Kind)},
		Attributes: templ.Attributes{"data-add-kinds": string(d.Kind.Kind), "aria-label": "What to add"},
	}) {
		for _, k := range d.Kinds {
			@togglegroup.Item(togglegroup.ItemProps{
				Value:      string(k.Kind),
				Attributes: kindSwitchAttrs(k, d.Query),
			}) {
				{ k.Label }
			}
		}
	}
}

// kindSwitchAttrs swap the page body to k's Add New (subNavAttrs, the
// sidebar's own swap), marked for the tests.
func kindSwitchAttrs(k AddKind, q string) templ.Attributes {
	attrs := subNavAttrs(AddPageURL(k, q))
	attrs["data-add-kind"] = string(k.Kind)
	return attrs
}

// AddPending is the detail page of an item Add New just created, before
// the library view shows it: it reloads until the item appears.
templ AddPending(name string) {
	@Shell(Chrome{Title: "Adding " + name, Crumbs: []Crumb{{Label: name}}}) {
		<meta http-equiv="refresh" content="2"/>
		@empty.Empty(empty.Props{Class: "border border-dashed py-8"}) {
			@empty.Header() {
				@empty.Title() {
					{ name } is being added
				}
				@empty.Description() {
					It will appear here in a few seconds.
				}
			}
		}
	}
}

templ AddResults(d AddResultsData) {
	if d.Prompt {
		<p class="text-sm text-muted-foreground">Type at least two characters.</p>
	} else if d.NoProvider {
		@alert.Alert() {
			@alert.Title() {
				No { d.Kind.Label } metadata provider is configured
			}
			@alert.Description() {
				Add one under <a class="text-primary underline" href="/settings">Settings</a> to search here.
			}
		}
	} else if d.Error != "" {
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"role": "alert"}}) {
			@alert.Title() {
				{ d.Error }
			}
			if d.RetryURL != "" {
				@alert.Description() {
					@button.Button(button.Props{
						Type: "button", Size: button.SizeSm, Variant: button.VariantOutline,
						Attributes: templ.Attributes{"data-action": "retry-search", "hx-get": d.RetryURL, "hx-target": "#add-results"},
					}) {
						Retry
					}
				}
			}
		}
	} else if len(d.Hits) == 0 {
		@empty.Empty(empty.Props{Class: "border border-dashed py-8"}) {
			@empty.Header() {
				@empty.Title() {
					No matches for “{ d.Query }”
				}
			}
		}
	} else {
		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			for _, h := range d.Hits {
				@addHitCard(d, h)
			}
		</div>
	}
}

templ addHitCard(d AddResultsData, h AddHit) {
	@card.Card(card.Props{Size: card.SizeSm, Attributes: templ.Attributes{"data-add-hit": h.ID, "data-add-source": h.Source}}) {
		@card.Content(card.ContentProps{Class: "flex gap-4"}) {
			if h.Poster != "" {
				<img src={ h.Poster } alt="" loading="lazy" class="aspect-[2/3] w-20 shrink-0 rounded bg-muted object-cover"/>
			} else {
				<div class="aspect-[2/3] w-20 shrink-0 rounded bg-muted" aria-hidden="true"></div>
			}
			<div class="min-w-0 flex-1">
				<p class="font-medium">{ h.Title }</p>
				if h.Year > 0 || h.SourceLabel != "" {
					<p class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
						if h.Year > 0 {
							<span>{ fmt.Sprint(h.Year) }</span>
						}
						if h.SourceLabel != "" {
							@badge.Badge(badge.Props{Variant: badge.VariantOutline, Attributes: templ.Attributes{"data-hit-source": h.Source}}) {
								{ h.SourceLabel }
							}
						}
					</p>
				}
				if h.InLibrary != "" {
					<a href={ templ.SafeURL(h.InLibrary) } class="mt-2 inline-block">
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							In library
						}
					</a>
				} else {
					@addForm(d, h)
				}
			</div>
		}
	}
}

// addForm is a hit's add form behind an "Add" link (shadcn-templ's
// collapsible, since 2026-11-04), open from the start for the hit whose
// post was refused. Each kind's own fields follow the root folder and the
// profile: a movie's availability, a series' type and folders, a comic's
// kind (comic or manga), an audiobook's Audible region; a kind with
// monitor modes offers them, and one with add options the search.
templ addForm(d AddResultsData, h AddHit) {
	@collapsible.Collapsible(collapsible.Props{Class: "mt-2", DefaultOpen: d.OpenID != "" && d.OpenID == h.ID}) {
		@button.Button(button.Props{Variant: button.VariantLink, Class: "h-auto p-0 text-sm", Attributes: collapsible.Trigger(ctx)}) {
			Add
		}
		@collapsible.Content() {
			<form method="post" action={ templ.SafeURL(addPostURL(d.Kind)) } class="mt-3 grid gap-3" data-settings-form>
				<input type="hidden" name="title" value={ h.Title }/>
				<input type="hidden" name="id" value={ h.ID }/>
				<input type="hidden" name="q" value={ d.Query }/>
				if d.Kind.Alternate {
					<input type="hidden" name="kind" value={ string(d.Kind.Kind) }/>
				}
				if h.Source != "" {
					<input type="hidden" name="source" value={ h.Source }/>
				}
				@addSelect("rootFolder", h.ID, "Root folder", d.RootFolders, posted(d, h, "rootFolder", onlyValue(d.RootFolders)))
				@addSelect("qualityProfile", h.ID, "Quality profile", d.Profiles, posted(d, h, "qualityProfile", onlyValue(d.Profiles)))
				if len(d.Kind.Monitor) > 0 {
					@addSelect("monitor", h.ID, "Monitor", d.Kind.Monitor, posted(d, h, "monitor", d.Kind.Monitor[0].Value))
				}
				switch d.Kind.Kind {
					case commonv1.MediaKindMovie:
						@addSelect("minimumAvailability", h.ID, "Minimum availability", []AddOption{{Value: "announced", Label: "Announced"}, {Value: "inCinemas", Label: "In cinemas"}, {Value: "released", Label: "Released"}}, posted(d, h, "minimumAvailability", "released"))
					case commonv1.MediaKindSeries:
						@addSelect("seriesType", h.ID, "Series type", []AddOption{{Value: "standard", Label: "Standard"}, {Value: "daily", Label: "Daily"}, {Value: "anime", Label: "Anime"}}, posted(d, h, "seriesType", "standard"))
						@addCheck("seasonFolder", h.ID, "Season folders", postedCheck(d, h, "seasonFolder", true))
						@addCheck("searchCutoffUnmet", h.ID, "Search for cutoff unmet", postedCheck(d, h, "searchCutoffUnmet", false))
					case commonv1.MediaKindComic:
						@addSelect("comicKind", h.ID, "Kind", comicKindOptions, posted(d, h, "comicKind", comicKindOptions[0].Value))
					case commonv1.MediaKindAudiobook:
						@addSelect("region", h.ID, "Audible region", audiobookRegionOptions, posted(d, h, "region", selectedOf(audiobookRegionOptions, d.Region)))
				}
				if len(d.Kind.MonitorNew) > 0 {
					@addSelect("monitorNewItems", h.ID, monitorNewLabel(d.Kind.Kind), d.Kind.MonitorNew, posted(d, h, "monitorNewItems", d.Kind.MonitorNew[0].Value))
				}
				@addCheck("monitored", h.ID, "Monitored", postedCheck(d, h, "monitored", true))
				if d.Kind.SearchOnAdd != "" {
					@addCheck("searchOnAdd", h.ID, d.Kind.SearchOnAdd, postedCheck(d, h, "searchOnAdd", true))
				}
				<div>
					@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Attributes: templ.Attributes{"data-action": "add"}}) {
						Add { h.Title }
					}
				</div>
			</form>
		}
	}
}

// comicKindOptions and audiobookRegionOptions are a comic's spec.kind and
// an audiobook's spec.region as the CRDs spell them (the same values
// ui/actions.Choices admits; TestAddAndEditOptionsAreTheActionsChoices
// holds them equal).
var (
	comicKindOptions       = []AddOption{{Value: "comic", Label: "Comic"}, {Value: "manga", Label: "Manga"}}
	audiobookRegionOptions = []AddOption{
		{Value: "us", Label: "United States (audible.com)"}, {Value: "uk", Label: "United Kingdom (audible.co.uk)"},
		{Value: "ca", Label: "Canada (audible.ca)"}, {Value: "au", Label: "Australia (audible.com.au)"},
		{Value: "de", Label: "Germany (audible.de)"}, {Value: "fr", Label: "France (audible.fr)"},
		{Value: "es", Label: "Spain (audible.es)"}, {Value: "in", Label: "India (audible.in)"},
		{Value: "it", Label: "Italy (audible.it)"}, {Value: "jp", Label: "Japan (audible.co.jp)"},
	}
)

// monitorNewLabel names the monitor-new choice by what the kind discovers.
func monitorNewLabel(kind commonv1.MediaKind) string {
	switch kind {
	case commonv1.MediaKindComic:
		return "Monitor new issues"
	default:
		return "Monitor new items"
	}
}

templ addSelect(name, hitID, label string, opts []AddOption, def string) {
	@field.Field() {
		@field.Label(field.LabelProps{For: "add-" + name + "-" + hitID + "-trigger"}) {
			{ label }
		}
		@selectcomp.Select(selectcomp.Props{ID: "add-" + name + "-" + hitID, Name: name, DefaultValue: def, Required: true}) {
			@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-full"}) {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: "—"})
			}
			@selectcomp.Content() {
				@selectcomp.Group() {
					for _, o := range opts {
						@selectcomp.Item(selectcomp.ItemProps{Value: o.Value}) {
							{ o.Label }
						}
					}
				}
			}
		}
	}
}

templ addCheck(name, hitID, label string, on bool) {
	@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
		<input type="hidden" name={ name } value="false"/>
		@checkbox.Checkbox(checkbox.Props{ID: "add-" + name + "-" + hitID, Name: name, Value: "true", Checked: &on})
		@field.Label(field.LabelProps{For: "add-" + name + "-" + hitID}) {
			{ label }
		}
	}
}

// onlyValue preselects a root folder or profile only when there is exactly
// one to choose; with several, a person picks deliberately, and
// ui/static/settings.js's required-select check blocks an empty submit.
func onlyValue(opts []AddOption) string {
	if len(opts) == 1 {
		return opts[0].Value
	}
	return ""
}

// posted is the value the owner submitted for name, when h is the hit whose
// add was rejected, and def otherwise.
func posted(d AddResultsData, h AddHit, name, def string) string {
	if d.OpenID == h.ID && d.Posted != nil {
		if _, ok := d.Posted[name]; ok {
			return d.Posted.Get(name)
		}
	}
	return def
}

// postedCheck is posted for a checkbox, which posts a hidden "false" and,
// when ticked, a "true".
func postedCheck(d AddResultsData, h AddHit, name string, def bool) bool {
	if d.OpenID == h.ID && d.Posted != nil {
		if vs, ok := d.Posted[name]; ok {
			for _, v := range vs {
				if v == "true" {
					return true
				}
			}
			return false
		}
	}
	return def
}

// addSearchTrigger searches as the reader types, and once as the page
// loads when it arrives with a query already in the box (the library
// typeahead's "Add a new …", 2026-10-01).
func addSearchTrigger(query string) string {
	if query != "" {
		return "input changed delay:400ms, search, load"
	}
	return "input changed delay:400ms, search"
}
