// Package views holds the ui service's templ templates. Styling is Tailwind
// utility classes, compiled ahead of time by the standalone tailwindcss CLI
// (Makefile's `css` target, Phase G ruling R4) into ui/static/app.css, which
// is committed and served by ui.staticHandler via go:embed -- there is no
// CDN and no Node involved at request time or at build time.
package views

import (
	"github.com/mediactl/clustarr/ui/components"
	"github.com/mediactl/clustarr/ui/components/alertdialog"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/dropdownmenu"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/sidebar"
	"github.com/mediactl/clustarr/ui/components/toast"
	"github.com/mediactl/clustarr/ui/components/utils"
	"github.com/mediactl/clustarr/ui/projection"
)

// Chrome is what a page tells the Shell: its title, its trail (whose
// parent is a child page's back button; there is no breadcrumb row since
// 2026-11-28) and, when it belongs to a library tab, that tab, which the
// sidebar marks.
type Chrome struct {
	// Title is the document title ("<Title> · Clustarr") and, for a page
	// that is a sidebar entry, the entry it lights (activeFor).
	Title string
	// Nav is the lit sidebar entry's href ("/settings") for a page whose
	// Title is no entry's label; "none" lights nothing.
	Nav    string
	Crumbs []Crumb
	Tab    projection.Tab
	// LiveTV is the current Live TV page's path, which the sidebar's Live
	// TV sub-menu marks; "" off the Live TV section.
	LiveTV string
	// Activity is the current Activity page's path, which the sidebar's
	// Activity sub-menu marks; "" off the Activity section.
	Activity string
	// HideScrollbar hides the document's native scrollbar (data-scrollbar
	// on <html>, app.css): the library, where the A-Z strip is the only
	// thing on the right edge, as in Sonarr. ui/static/jump.js keeps the
	// attribute in step when htmx swaps the page body.
	HideScrollbar bool
}

// section is the lit top-level sidebar entry's href.
func (c Chrome) section() string {
	switch {
	case c.Nav != "":
		return c.Nav
	case c.Tab != "":
		return "/library"
	case c.LiveTV != "":
		return "/livetv"
	case c.Activity != "":
		return "/activity"
	}
	return activeFor(c.Title)
}

// leaf is the lit sub-entry's href, "" when the page is none.
func (c Chrome) leaf() string {
	switch {
	case c.Tab != "":
		return "/library/" + string(c.Tab)
	case c.LiveTV != "":
		return c.LiveTV
	case c.Activity != "":
		return c.Activity
	}
	return ""
}

// Crumb is one step of a page's breadcrumb trail. The last crumb has no
// Href: it is the page itself.
type Crumb struct {
	Label string
	Href  string
}

// navEntry is one row of the shell's navigation: the sidebar's, the tab
// bars' and the section strip's.
type navEntry struct {
	Label string
	Href  string
	Icon  string
	// NoPreload keeps a row from being fetched on hover: the Live TV pages
	// take seconds to render and weigh megabytes.
	NoPreload bool
	// Swap marks a row that swaps the page body through htmx (the
	// section pages, which share the sidebar's state); the others load
	// their page whole.
	Swap bool
}

// navSection is one of the sidebar's sections (2026-11-28, the Liquid
// Glass redesign, after the Music app's sidebar): a header that is no link
// and no row, then flat rows each with its own glyph. The first section
// has no header. Key names it in the reader's nav_closed cookie.
type navSection struct {
	Key   string
	Label string
	Rows  []navEntry
}

// sidebarID names the one sidebar, so a trigger rendered outside the
// sidebar's provider can address it.
const sidebarID = "app-sidebar"

// navSections is the sidebar: Dashboard, the seven libraries, Plex's
// collections and hubs, Live TV, Activity and the library's health, with
// Settings pinned to the panel's foot (settingsEntry).
func navSections() []navSection {
	library := make([]navEntry, 0, len(projection.Tabs()))
	for _, tab := range projection.Tabs() {
		library = append(library, navEntry{Label: tabLabel(tab), Href: "/library/" + string(tab), Icon: tabIcon(tab), Swap: true})
	}
	return []navSection{
		{Rows: []navEntry{{Label: "Dashboard", Href: "/dashboard", Icon: "layout-dashboard"}}},
		{Key: "library", Label: "Library", Rows: library},
		{Key: "plex", Label: "Plex", Rows: []navEntry{
			{Label: "Collections", Href: "/library/collections", Icon: "layers", Swap: true},
			{Label: "Hubs", Href: "/library/hubs", Icon: "rows-3", Swap: true},
		}},
		{Key: "livetv", Label: "Live TV", Rows: liveTVEntries()},
		{Key: "activity", Label: "Activity", Rows: activityEntries()},
		{Key: "health", Label: "Library Health", Rows: []navEntry{
			{Label: "Unmatched", Href: "/unmatched", Icon: "file-question-mark"},
			{Label: "Import Lists", Href: "/import-lists", Icon: "list-plus"},
		}},
	}
}

func liveTVEntries() []navEntry {
	return []navEntry{
		{Label: "Channels", Href: "/livetv/channels", Icon: "radio-tower", NoPreload: true, Swap: true},
		{Label: "Guide", Href: "/livetv/guide", Icon: "calendar-clock", NoPreload: true, Swap: true},
		{Label: "Sources", Href: "/livetv/sources", Icon: "cable", NoPreload: true, Swap: true},
	}
}

func activityEntries() []navEntry {
	return []navEntry{
		{Label: "Downloads", Href: "/activity/downloads", Icon: "download", Swap: true},
		{Label: "Transcodes", Href: "/activity/transcodes", Icon: "wand-sparkles", Swap: true},
		{Label: "Subtitles", Href: "/activity/subtitles", Icon: "captions", Swap: true},
		{Label: "Markers", Href: "/activity/markers", Icon: "milestone", Swap: true},
	}
}

var settingsEntry = navEntry{Label: "Settings", Href: "/settings", Icon: "settings"}

// tabIcon is a library's glyph in the sidebar.
func tabIcon(tab projection.Tab) string {
	switch tab {
	case projection.TabMovies:
		return "film"
	case projection.TabTV:
		return "tv"
	case projection.TabAnime:
		return "sparkles"
	case projection.TabMusic:
		return "music"
	case projection.TabBooks:
		return "book"
	case projection.TabComics:
		return "book-image"
	case projection.TabAudiobooks:
		return "headphones"
	}
	return "library"
}

// barTabs are the phone's tab bar (and, with Settings, the tablet's top
// tab bar): the sections a reader moves between, each lit by Chrome.section.
func barTabs() []navEntry {
	return []navEntry{
		{Label: "Dashboard", Href: "/dashboard", Icon: "layout-dashboard"},
		{Label: "Library", Href: "/library", Icon: "library"},
		{Label: "Live TV", Href: "/livetv", Icon: "tv"},
		{Label: "Activity", Href: "/activity", Icon: "activity"},
	}
}

// activeFor maps a page title onto the navigation row it belongs to: the
// pages that are rows name themselves; anything else -- an item's own page,
// a season, a scan -- is somewhere under the library.
func activeFor(title string) string {
	if title == settingsEntry.Label {
		return settingsEntry.Href
	}
	for _, s := range navSections() {
		for _, e := range s.Rows {
			if e.Label == title && !e.Swap {
				return e.Href
			}
		}
	}
	// A download's import detail, beneath Activity.
	if title == "Import" {
		return "/activity"
	}
	return "/library"
}

// current is the lit sidebar row's href: the page's library, Live TV or
// Activity page, else the top-level page itself.
func (c Chrome) current() string {
	if l := c.leaf(); l != "" {
		return l
	}
	return c.section()
}

// sectionPage reports whether the page is one of a section's own pages
// (a library, Collections, Hubs, a Live TV or an Activity page) rather
// than something beneath one: those carry the section strip on a phone
// and a tablet and no back button.
func (c Chrome) sectionPage() bool {
	switch {
	case c.Activity != "", c.LiveTV != "":
		return true
	case c.Tab == CollectionsTab || c.Tab == HubsTab:
		return c.Title == "Collections" || c.Title == "Hubs"
	case c.Tab != "":
		return c.Title == "Library"
	}
	return false
}

// back is the page a child page returns to: its parent crumb.
func (c Chrome) back() (Crumb, bool) {
	if c.sectionPage() || len(c.Crumbs) < 2 {
		return Crumb{}, false
	}
	p := c.Crumbs[len(c.Crumbs)-2]
	return p, p.Href != ""
}

// pageName is the page's own name, which the toolbar shows once the large
// title has scrolled away.
func (c Chrome) pageName() string {
	if n := len(c.Crumbs); n > 0 {
		return c.Crumbs[n-1].Label
	}
	return c.Title
}

// addHere reports whether the toolbar offers the every-library Add menu:
// the Dashboard's (a library page has its own Add among its actions).
func (c Chrome) addHere() bool {
	return c.Title == "Dashboard"
}

// strip is a section page's sibling pages, the section strip.
func (c Chrome) strip() []navEntry {
	switch {
	case c.Activity != "":
		return activityEntries()
	case c.LiveTV != "":
		return liveTVEntries()
	case c.Tab != "":
		var out []navEntry
		for _, s := range navSections() {
			if s.Key == "library" || s.Key == "plex" {
				out = append(out, s.Rows...)
			}
		}
		return out
	}
	return nil
}

// navAttrs are a row's attributes: a section page's swap the page body
// through htmx, push their URL and carry the shell's live parts out of band
// (the sidebar's rows, the phone's tab bar and the search), so the lit row
// follows a swap; pressed in the phone's sheet they also close the sheet.
// Every row is marked so the shell can light it at the press and send the
// reader to the top of the page it loads.
func navAttrs(e navEntry, current bool) templ.Attributes {
	a := templ.Attributes{"data-nav-link": true}
	if e.Swap {
		a["hx-get"] = e.Href
		a["hx-push-url"] = "true"
		a["hx-target"] = "#page-body"
		a["hx-select"] = "#page-body"
		a["hx-select-oob"] = "#app-nav,#app-tabbar,#header-find"
		a["hx-swap"] = "outerHTML"
		a["data-templ-dialog-close"] = sidebarID + "-mobile"
		if !e.NoPreload {
			a["preload"] = "mouseover"
		}
	}
	if current {
		a["aria-current"] = "page"
	}
	return a
}

// subNavAttrs are navAttrs of a swapping link to href, for a view's own
// links between section pages (Add New's kind switch).
func subNavAttrs(href string) templ.Attributes {
	return navAttrs(navEntry{Href: href, Swap: true}, false)
}

// slotless drops a trigger's own data-slot so the part it is spread onto
// keeps its slot (and with it the theme's rules).
func slotless(a templ.Attributes) templ.Attributes {
	delete(a, "data-slot")
	return a
}

// Layout is the page chrome for a page that is itself a navigation row.
templ Layout(title string) {
	@Shell(Chrome{Title: title, Crumbs: []Crumb{{Label: title}}}) {
		{ children... }
	}
}

// Shell is the page chrome every ui page renders inside: the stylesheet,
// htmx and its extensions, and the component script bundle, all vendored
// and served from the embedded static files so a cluster without Internet
// egress still has a working UI; then the navigation and the page.
//
// The Liquid Glass shell (2026-11-28, after the Music and TV apps on
// macOS Tahoe, iPadOS 26 and iOS 26). The navigation floats as glass over
// the content, and its shape follows the size class:
//
//   - desktop (from 1024px): a full-height floating glass sidebar --
//     the brand, the search, the sections, Settings at its foot -- which
//     collapses off-canvas, not to an icon rail;
//   - tablet (768 to 1023px): the same sidebar as an overlay, opened from
//     the toolbar, and a centred tab bar of the sections in the toolbar;
//   - phone (below 768px): a floating glass tab bar at the foot, a search
//     circle beside it that opens the sidebar's sheet with the search.
//
// Every page has a sticky toolbar (pageToolbar) holding a back button on a
// child page, the page's name once its large title has scrolled away, and
// Add where it applies; content scrolls under it through the scroll-edge
// effect. There is no full-width top bar and no breadcrumb trail.
//
// #action-status, where every action says how it went, is rendered once,
// here; #modal is where a form dialog is loaded; and #page-refresh redraws
// the page body in place when an action changed what it shows
// (feedback.js), a moment after the event: the page is drawn from the ui's
// cache, which trails a write by a watch event.
templ Shell(c Chrome) {
	<!DOCTYPE html>
	<html
		lang="en"
		class="dark"
		if c.HideScrollbar {
			data-scrollbar="hidden"
		}
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#050507"/>
			<title>{ c.Title } · Clustarr</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.js"></script>
			<script src="/static/idiomorph-ext.min.js"></script>
			<script src="/static/htmx-ext-preload.js"></script>
			<script src="/static/jump.js" defer></script>
			<script src="/static/find.js" defer></script>
			<script src="/static/settings.js" defer></script>
			<script src="/static/library.js" defer></script>
			<script src="/static/art.js" defer></script>
			<script src="/static/portals.js" defer></script>
			<script src="/static/livetv.js" defer></script>
			<script src="/static/guide.js" defer></script>
			<script src="/static/dashboard.js" defer></script>
			<script src="/static/confirm.js" defer></script>
			<script src="/static/shell.js" defer></script>
			<script src="/static/feedback.js" defer></script>
			<script src="/static/rowselect.js" defer></script>
			<script src="/static/modal.js" defer></script>
			@components.Scripts()
		</head>
		<body class="min-h-svh bg-transparent font-sans text-foreground" hx-ext="preload, morph">
			<a href="#page-body" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-popover focus:px-3 focus:py-2 focus:text-sm focus:text-popover-foreground">Skip to content</a>
			<div id="nav-progress" aria-hidden="true"></div>
			@actionStatusRegion()
			@sidebar.Provider(sidebar.ProviderProps{ID: sidebarID, DisableDefaultOpen: shellState(ctx).SidebarCollapsed}) {
				@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleOffcanvas, Variant: sidebar.VariantFloating}) {
					@sidebar.Header(sidebar.HeaderProps{Class: "gap-3 px-3 pt-3 pb-1"}) {
						<div class="flex h-8 items-center gap-2">
							<a href="/" class="flex min-w-0 flex-1 items-center gap-2 px-1 text-headline text-label-1" data-brand>
								<img src="/static/logo.svg" alt="Clustarr" width="22" height="22" class="size-[22px] shrink-0"/>
								<span>Clustarr</span>
							</a>
							@sidebar.Trigger(sidebar.TriggerProps{Class: "max-md:hidden", Target: sidebarID, Attributes: templ.Attributes{"aria-label": "Hide the sidebar"}})
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIconSm,
								Class:      "md:hidden",
								Attributes: templ.Attributes{"data-templ-dialog-close": sidebarID + "-mobile", "aria-label": "Close"},
							}) {
								@icon.Icon("x")()
							}
						</div>
						<div id="header-find">
							@headerFind(findTab(c.Tab))
						</div>
					}
					@sidebar.Content(sidebar.ContentProps{Class: "gap-0"}) {
						<nav id="app-nav" aria-label="Main" class="flex flex-col">
							for _, s := range navSections() {
								@sidebar.Group(sidebar.GroupProps{Class: "py-0", Attributes: templ.Attributes{"data-nav-section": s.Key}}) {
									if s.Label != "" {
										@sidebar.GroupLabel() {
											{ s.Label }
										}
									}
									@sidebar.GroupContent() {
										@sidebar.Menu() {
											for _, e := range s.Rows {
												@navRow(e, e.Href == c.current())
											}
										}
									}
								}
							}
						</nav>
					}
					@sidebar.Footer(sidebar.FooterProps{Class: "px-2 pt-1 pb-2"}) {
						@sidebar.Menu() {
							@navRow(settingsEntry, settingsEntry.Href == c.current())
						}
					}
				}
				@shellBoot()
				@sidebar.Inset() {
					<div id="page-body" tabindex="-1" class="flex flex-1 flex-col">
						@pageToolbar(c)
						if c.sectionPage() {
							@sectionStrip(c)
						}
						<div data-shell-page class="flex-1 px-(--page-gutter) pt-2 pb-(--page-gutter)">
							{ children... }
						</div>
					</div>
				}
			}
			@tabBar(c)
			<div id="page-refresh" hidden hx-get="" hx-trigger="page-changed from:body delay:350ms" hx-target="#page-body" hx-select="#page-body" hx-swap="outerHTML"></div>
			@toast.Toaster()
			<div id="modal"></div>
			@confirmDialog()
		</body>
	</html>
}

// navRow is one sidebar row: its glyph in the tint and its name.
templ navRow(e navEntry, current bool) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{Href: e.Href, IsActive: current, Attributes: navAttrs(e, current)}) {
			@icon.Icon(e.Icon)()
			<span>{ e.Label }</span>
		}
	}
}

// pageToolbar is a page's toolbar. On a tablet it is two rows (iPadOS 26):
// a fixed first row of the sidebar's toggle, the sections' tab bar and the
// search, and under it the sticky navigation row. The navigation row --
// the only row on a desktop and a phone -- holds, leading, the sidebar's
// toggle (a desktop, while the sidebar is hidden) and a child page's back
// button naming its parent, then the page's name once its large title has
// scrolled under the bar (shell.js sets html[data-title-collapsed]; centred
// on a phone, leading as macOS sets it elsewhere); trailing, the page's own
// actions and the Dashboard's Add and, on a phone, its Settings. It has no
// fill of its own: the scroll-edge layer behind it darkens and blurs what
// scrolls under it.
templ pageToolbar(c Chrome) {
	<div data-tablet-bar class="pointer-events-none fixed inset-x-0 top-2 z-30 hidden h-11 items-center justify-between gap-3 px-(--page-gutter) md:max-lg:flex">
		@sidebar.Trigger(sidebar.TriggerProps{Class: "glass pointer-events-auto size-11 rounded-full", Target: sidebarID, Attributes: templ.Attributes{"data-sidebar-show": true, "aria-label": "Show the sidebar"}})
		<nav data-toptabs aria-label="Sections" class="glass pointer-events-auto flex h-11 items-center gap-0.5 rounded-full p-1" data-edge-light>
			for _, e := range append(barTabs(), settingsEntry) {
				<a
					href={ templ.SafeURL(e.Href) }
					class="flex h-9 items-center rounded-full px-3 text-[15px] font-semibold whitespace-nowrap"
					if e.Href == c.section() {
						data-active
						aria-current="page"
					}
				>{ e.Label }</a>
			}
		</nav>
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeIcon,
			Class:      "glass pointer-events-auto size-11",
			Attributes: templ.Attributes{"data-find-open-button": true, "aria-label": "Search"},
		}) {
			@icon.Icon("search")()
		}
	</div>
	<header data-topbar class="sticky top-0 z-30 flex h-(--topbar-h) shrink-0 items-center gap-2 px-(--page-gutter)">
		<div data-bar-lead class="flex min-w-0 flex-1 items-center gap-2">
			@sidebar.Trigger(sidebar.TriggerProps{Class: "glass size-[2.125rem] rounded-full max-lg:hidden", Target: sidebarID, Attributes: templ.Attributes{"data-sidebar-show": true, "aria-label": "Show the sidebar"}})
			if b, ok := c.back(); ok {
				<a href={ templ.SafeURL(b.Href) } data-back class="glass inline-flex h-[2.125rem] max-w-[20ch] min-w-0 shrink-0 items-center gap-1 rounded-full pr-3.5 pl-2 text-subheadline font-semibold text-label-1 max-md:size-9 max-md:justify-center max-md:p-0" aria-label={ "Back to " + b.Label }>
					@icon.Icon("chevron-left")(icon.Props{Class: "size-[18px] shrink-0"})
					<span class="truncate max-md:sr-only">{ b.Label }</span>
				</a>
			}
			<div data-inline-title class="min-w-0 truncate text-headline text-label-1" aria-hidden="true">{ c.pageName() }</div>
		</div>
		<div data-page-actions class="flex shrink-0 items-center justify-end gap-2">
			if c.Title == "Dashboard" {
				@button.Button(button.Props{
					Href:       settingsEntry.Href,
					Variant:    button.VariantSecondary,
					Size:       button.SizeIcon,
					Class:      "md:hidden",
					Attributes: templ.Attributes{"aria-label": "Settings"},
				}) {
					@icon.Icon("settings")()
				}
			}
			if c.addHere() {
				@addNewMenu()
			}
		</div>
	</header>
}

// sectionStrip is a section's sibling pages on a phone and a tablet (the
// sidebar lists them on a desktop): a scrolling segmented control of
// links, the current page its lens. The library's nine pages are the
// Library root's on a phone, where a strip of them clips.
templ sectionStrip(c Chrome) {
	<nav data-section-strip aria-label="Pages" class={ "flex h-12 items-center px-(--page-gutter) lg:hidden", templ.KV("max-md:hidden", c.LiveTV == "" && c.Activity == "") }>
		<div data-slot="tabs-list" class="scroll-fade-x">
			for _, e := range c.strip() {
				<a
					href={ templ.SafeURL(e.Href) }
					data-slot="tabs-trigger"
					class="inline-flex items-center"
					if e.Href == c.current() {
						data-active
					}
					{ navAttrs(e, e.Href == c.current())... }
				>{ e.Label }</a>
			}
		</div>
	</nav>
}

// tabBar is the phone's floating tab bar (below 768px): the four sections
// in one glass capsule, the current one in the lens and the tint, and a
// search circle beside it that opens the sidebar's sheet with the search
// focused (find.js). It rides every section swap out of band (#app-tabbar),
// and the bottom scroll-edge layer under it fades the content into it.
templ tabBar(c Chrome) {
	<div id="app-tabbar" data-tabbar class="md:hidden">
		<nav aria-label="Sections" class="glass flex h-[3.625rem] flex-1 items-stretch rounded-full p-1" data-edge-light>
			for _, e := range barTabs() {
				<a
					href={ templ.SafeURL(e.Href) }
					class="flex flex-1 flex-col items-center justify-center gap-0.5 rounded-full text-[10px] leading-3 font-semibold"
					if e.Href == c.section() {
						data-active
						aria-current="page"
					}
				>
					@icon.Icon(e.Icon)(icon.Props{Class: "size-6"})
					<span>{ e.Label }</span>
				</a>
			}
		</nav>
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Class:      "glass size-[3.625rem] shrink-0 rounded-full p-0 text-label-1",
			Attributes: templ.Attributes{"data-find-open-button": true, "data-edge-light": true, "aria-label": "Search"},
		}) {
			@icon.Icon("search")(icon.Props{Class: "size-6"})
		}
	</div>
}

// actionStatusRegion is where an htmx action says how it went
// (ActionStatus, ActionErrorToast): once a page, in the Shell, above a
// dialog's overlay so an action posted from a modal answers where it can
// be seen.
templ actionStatusRegion() {
	<div id="action-status" aria-live="polite" class="fixed top-[calc(env(safe-area-inset-top)+0.75rem)] left-1/2 z-[60] w-max max-w-[90vw] -translate-x-1/2 empty:hidden"></div>
}

// shellBoot runs before the page body is parsed, which a deferred script
// cannot (the first paint comes before it): from 768 to 1023px the sidebar
// is an overlay, so it starts hidden whatever the reader chose on a wider
// window; and it marks the document when a query container leaves
// position:fixed descendants alone, which turns the page's query container
// on (input.css) -- the page backdrop and the A-Z strip are fixed inside it.
templ shellBoot() {
	<script>
(function () {
  var d = document.documentElement;
  if (matchMedia("(min-width: 768px) and (max-width: 1023.98px)").matches) {
    var el = document.querySelector('[data-templ-sidebar-id="app-sidebar"]');
    if (el) { el.setAttribute("data-state", "collapsed"); el.setAttribute("data-collapsible", "offcanvas"); }
  }
  var c = document.createElement("div"), f = document.createElement("div");
  c.style.cssText = "container-type:inline-size;position:absolute;top:0;left:50px;width:10px;height:0";
  f.style.cssText = "position:fixed;top:0;left:0;width:1px;height:1px";
  c.appendChild(f); document.body.appendChild(c);
  if (f.getBoundingClientRect().left === 0) d.setAttribute("data-cq", "");
  c.remove();
})();
	</script>
}

// addNewMenu is the toolbar's Add: a prominent "+" circle opening a menu
// of each library's Add New page, the phrases the search's empty state
// uses.
templ addNewMenu() {
	@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "add-new"}) {
		@button.Button(button.Props{
			Variant:    button.VariantDefault,
			Size:       button.SizeIcon,
			Attributes: utils.MergeAttributes(dropdownmenu.Trigger(ctx), templ.Attributes{"data-nav": "add-new", "aria-label": "Add New"}),
		}) {
			@icon.Icon("plus")(icon.Props{Class: "size-5"})
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Class: "w-56"}) {
			@dropdownmenu.Label() {
				Add to the Library
			}
			for _, tab := range projection.Tabs() {
				for i, t := range addTargets(tab, "") {
					@dropdownmenu.Item(dropdownmenu.ItemProps{Href: t.Href, Attributes: addNewAttrs(tab, i)}) {
						{ t.Label }
					}
				}
			}
		}
	}
}

// addNewAttrs mark a tab's own Add New entry (its first target) for the
// tests and scripts that name it.
func addNewAttrs(tab projection.Tab, i int) templ.Attributes {
	if i > 0 {
		return nil
	}
	return templ.Attributes{"data-nav-add": string(tab)}
}

// confirmDialog is the one alert dialog every hx-confirm asks through
// (ui/static/confirm.js, since 2026-11-04; the browser's window.confirm
// before). Its text is the request's question. Since 2026-11-17 the
// element asking may name the title, the action's word and its tone
// (data-confirm-title, data-confirm-action, data-confirm-variant
// "default"), so a question reads "Delete root folder tv?" with "Delete",
// not "Are you sure?" with a red "Continue"; Cancel comes first and takes
// the focus; and a script asks through window.clustarr.confirm.
templ confirmDialog() {
	@alertdialog.AlertDialog(alertdialog.Props{ID: "confirm"}) {
		<button hidden data-confirm-open { alertdialog.TriggerFor("confirm")... }></button>
		@alertdialog.Content(alertdialog.ContentProps{Size: alertdialog.SizeSm}) {
			@alertdialog.Header() {
				@alertdialog.Title() {
					<span data-confirm-title>Are you sure?</span>
				}
				@alertdialog.Description(alertdialog.DescriptionProps{Class: "whitespace-pre-line"}) {
					<span data-confirm-text></span>
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel 
				}
				@alertdialog.Action(alertdialog.ActionProps{Variant: button.VariantDestructive, Attributes: confirmOKAttrs("destructive", false)}) {
					<span data-confirm-action>Continue</span>
				}
				@alertdialog.Action(alertdialog.ActionProps{Variant: button.VariantDefault, Attributes: confirmOKAttrs("default", true)}) {
					<span data-confirm-action>Continue</span>
				}
			}
		}
	}
}

// confirmOKAttrs mark an action button for confirm.js by its tone and
// close the dialog on its click; the default-toned one starts hidden.
func confirmOKAttrs(variant string, hidden bool) templ.Attributes {
	attrs := alertdialog.CloseFor("confirm")
	attrs["data-confirm-ok"] = variant
	if hidden {
		attrs["hidden"] = true
	}
	return attrs
}
