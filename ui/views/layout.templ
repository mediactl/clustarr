// Package views holds the ui service's templ templates. Styling is Tailwind
// utility classes, compiled ahead of time by the standalone tailwindcss CLI
// (Makefile's `css` target, Phase G ruling R4) into ui/static/app.css, which
// is committed and served by ui.staticHandler via go:embed -- there is no
// CDN and no Node involved at request time or at build time.
package views

import (
	"github.com/mediactl/clustarr/ui/components"
	"github.com/mediactl/clustarr/ui/components/breadcrumb"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/sidebar"
	"github.com/mediactl/clustarr/ui/components/tabs"
	"github.com/mediactl/clustarr/ui/projection"
)

// Chrome is what a page tells the Shell: its title, its breadcrumb trail
// and, when it belongs to a library tab, that tab, which the top bar
// marks.
type Chrome struct {
	Title  string
	Crumbs []Crumb
	Tab    projection.Tab
	// HideScrollbar hides the document's native scrollbar (data-scrollbar
	// on <html>, app.css): the library, where the A-Z strip is the only
	// thing on the right edge, as in Radarr. ui/static/jump.js keeps the
	// attribute in step when htmx swaps the page body.
	HideScrollbar bool
}

// Crumb is one step of a page's breadcrumb trail. The last crumb has no
// Href: it is the page itself.
type Crumb struct {
	Label string
	Href  string
}

// navEntry is one sidebar entry: the pages the ui serves, in Radarr's
// order of a media library first and the machinery after it.
type navEntry struct {
	Label string
	Href  string
	Icon  string
}

var navEntries = []navEntry{
	{"Library", "/library", "library"},
	{"Pipeline", "/pipeline", "activity"},
	{"Downloads", "/downloads", "download"},
	{"Unmatched", "/unmatched", "file-question-mark"},
	{"Import Lists", "/import-lists", "list"},
	{"Settings", "/settings", "settings"},
}

// activeFor maps a page title onto the sidebar entry it belongs to. The
// pages that are entries name themselves; anything else -- an item's own
// page, a season, a scan -- is somewhere under the library.
func activeFor(title string) string {
	for _, n := range navEntries {
		if n.Label == title {
			return n.Href
		}
	}
	return "/library"
}

// Layout is the page chrome for a page that is itself a sidebar entry:
// Shell with no breadcrumbs beyond the page's own name.
templ Layout(title string) {
	@Shell(Chrome{Title: title, Crumbs: []Crumb{{Label: title}}}) {
		{ children... }
	}
}

// Shell is the page chrome every ui page renders inside (design
// 2026-09-24, after Radarr): the stylesheet, htmx and its SSE extension,
// and the component script bundle, all vendored and served from the
// embedded static files so a cluster without Internet egress still has a
// working UI; then shadcn-templ's sidebar with every page, collapsible to
// icons, and its inset holding the top bar -- the sidebar trigger and the
// library's tabs, as Radarr's top nav -- and the page body: the
// breadcrumb row and the page. The active sidebar entry is derived from
// the title (activeFor); a tab's trigger swaps the page body through
// htmx, so the top bar stays and the URL follows. The top bar and the
// breadcrumb row are sticky, as is a page's toolbar, so the library's A-Z
// bar can sit exactly beneath them and fill the rest of the viewport.
templ Shell(c Chrome) {
	<!DOCTYPE html>
	<html
			lang="en"
			if c.HideScrollbar {
				data-scrollbar="hidden"
			}
		>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ c.Title } · Clustarr</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.js"></script>
			<script src="/static/jump.js" defer></script>
			<script src="/static/settings.js" defer></script>
			@components.Scripts()
		</head>
		<body class="min-h-screen bg-background font-sans text-foreground">
			@sidebar.Provider() {
				@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon}) {
					@sidebar.Header() {
						<a href="/" class="flex h-8 items-center px-2 text-lg font-semibold text-primary">
							<span class="group-data-[collapsible=icon]:hidden">Clustarr</span>
							<span class="hidden group-data-[collapsible=icon]:inline">C</span>
						</a>
					}
					@sidebar.Content() {
						@sidebar.Group() {
							@sidebar.GroupContent() {
								@sidebar.Menu() {
									for _, n := range navEntries {
										@sidebar.MenuItem() {
											@sidebar.MenuButton(sidebar.MenuButtonProps{Href: n.Href, IsActive: n.Href == activeFor(c.Title), Tooltip: n.Label}) {
												@icon.Icon(n.Icon)()
												<span>{ n.Label }</span>
											}
										}
									}
								}
							}
						}
					}
					@sidebar.Rail()
				}
				@sidebar.Inset() {
					<header class="sticky top-0 z-20 flex h-12 shrink-0 items-center gap-4 border-b border-border bg-background px-4">
						@sidebar.Trigger()
						@topTabs(c.Tab)
					</header>
					<div id="page-body" class="flex flex-1 flex-col">
						<div class="sticky top-12 z-10 flex h-9 shrink-0 items-center border-b border-border bg-background px-4 text-sm">
							@breadcrumbs(c.Crumbs)
						</div>
						<div class="flex-1 p-6">
							{ children... }
						</div>
					</div>
				}
			}
		</body>
	</html>
}

// breadcrumbs renders the trail: every crumb but the last a link, the last
// the page itself.
templ breadcrumbs(crumbs []Crumb) {
	if len(crumbs) > 0 {
		@breadcrumb.Breadcrumb() {
			@breadcrumb.List() {
				for i, c := range crumbs {
					if i > 0 {
						@breadcrumb.Separator()
					}
					@breadcrumb.Item() {
						if i < len(crumbs)-1 && c.Href != "" {
							@breadcrumb.Link(breadcrumb.LinkProps{Href: c.Href}) { { c.Label } }
						} else {
							@breadcrumb.Page() { { c.Label } }
						}
					}
				}
			}
		}
	}
}

// topTabs is the library's tab strip in the top bar (design 2026-09-24,
// after Radarr's top nav): one trigger per projection.Tab, the current
// one marked, each swapping the page body through htmx (hx-select of
// #page-body, URL pushed) so the sidebar and the bar itself stay put.
templ topTabs(current projection.Tab) {
	@tabs.Tabs(tabs.Props{DefaultValue: string(current), Attributes: templ.Attributes{"data-tabs": true}}) {
		@tabs.List(tabs.ListProps{Variant: tabs.VariantLine}) {
			for _, tab := range projection.Tabs() {
				@tabs.Trigger(tabs.TriggerProps{
					Value: string(tab),
					Attributes: templ.Attributes{
						"hx-get":      "/library/" + string(tab),
						"hx-push-url": "true",
						"hx-target":   "#page-body",
						"hx-select":   "#page-body",
						"hx-swap":     "outerHTML",
					},
				}) {
					{ tabLabel(tab) }
				}
			}
		}
	}
}
