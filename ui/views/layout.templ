// Package views holds the ui service's templ templates. Styling is Tailwind
// utility classes, compiled ahead of time by the standalone tailwindcss CLI
// (Makefile's `css` target, Phase G ruling R4) into ui/static/app.css, which
// is committed and served by ui.staticHandler via go:embed -- there is no
// CDN and no Node involved at request time or at build time.
package views

import (
	"github.com/mediactl/clustarr/ui/components"
	"github.com/mediactl/clustarr/ui/components/breadcrumb"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/navigationmenu"
	"github.com/mediactl/clustarr/ui/components/separator"
	"github.com/mediactl/clustarr/ui/components/sidebar"
	"github.com/mediactl/clustarr/ui/projection"
)

// Chrome is what a page tells the Shell: its title, its breadcrumb trail
// and, when it belongs to a library tab, that tab, which the sidebar's
// Library sub-menu marks.
type Chrome struct {
	Title  string
	Crumbs []Crumb
	Tab    projection.Tab
	// LiveTV is the current Live TV page's path, which the sidebar's Live
	// TV sub-menu marks; "" off the Live TV section.
	LiveTV string
	// HideScrollbar hides the document's native scrollbar (data-scrollbar
	// on <html>, app.css): the library, where the A-Z strip is the only
	// thing on the right edge, as in Sonarr. ui/static/jump.js keeps the
	// attribute in step when htmx swaps the page body.
	HideScrollbar bool
}

// Crumb is one step of a page's breadcrumb trail. The last crumb has no
// Href: it is the page itself.
type Crumb struct {
	Label string
	Href  string
}

// navEntry is one sidebar entry: the pages the ui serves, in Radarr's
// order of a media library first and the machinery after it.
type navEntry struct {
	Label string
	Href  string
	Icon  string
}

// sidebarID names the one sidebar, so the top bar's trigger, rendered
// outside the sidebar's provider, can address it.
const sidebarID = "app-sidebar"

var navEntries = []navEntry{
	{"Dashboard", "/dashboard", "layout-dashboard"},
	{"Library", "/library", "library"},
	{"Live TV", "/livetv", "tv"},
	{"Pipeline", "/pipeline", "activity"},
	{"Downloads", "/downloads", "download"},
	{"Unmatched", "/unmatched", "file-question-mark"},
	{"Import Lists", "/import-lists", "list"},
	{"Settings", "/settings", "settings"},
}

// liveTVEntries are the Live TV entry's sub-menu (the direct-tuners and ui
// design 2026-10-27 §5.3); a DVR page joins them with §5.8.
var liveTVEntries = []navEntry{
	{"Channels", "/livetv/channels", "list-video"},
	{"M3U/EPG Manager", "/livetv/sources", "radio-tower"},
	{"TV Guide", "/livetv/guide", "calendar-days"},
}

// activeFor maps a page title onto the sidebar entry it belongs to. The
// pages that are entries name themselves, a Live TV page is under Live TV;
// anything else -- an item's own page, a season, a scan -- is somewhere
// under the library.
func activeFor(title string) string {
	for _, n := range navEntries {
		if n.Label == title {
			return n.Href
		}
	}
	for _, n := range liveTVEntries {
		if n.Label == title {
			return "/livetv"
		}
	}
	return "/library"
}

// subNavAttrs are a sub-menu entry's htmx attributes: it swaps the page
// body, pushes its URL, and carries the whole menu out of band
// (#app-nav), so the active entry and both sub-menus follow a swap from
// one section to another, with the top bar's trail and search.
func subNavAttrs(href string) templ.Attributes {
	return templ.Attributes{
		"hx-get":        href,
		"preload":       "mouseover",
		"hx-push-url":   "true",
		"hx-target":     "#page-body",
		"hx-select":     "#page-body",
		"hx-select-oob": "#app-nav,#page-crumbs,#header-find",
		"hx-swap":       "outerHTML",
	}
}

// Layout is the page chrome for a page that is itself a sidebar entry:
// Shell with no breadcrumbs beyond the page's own name.
templ Layout(title string) {
	@Shell(Chrome{Title: title, Crumbs: []Crumb{{Label: title}}}) {
		{ children... }
	}
}

// Shell is the page chrome every ui page renders inside (design
// 2026-09-24, after Radarr): the stylesheet, htmx and its SSE extension,
// and the component script bundle, all vendored and served from the
// embedded static files so a cluster without Internet egress still has a
// working UI; then shadcn-templ's sidebar with every page, collapsible to
// icons, the Library entry carrying the four media tabs as its sub-menu
// (librarySubMenu), and its inset holding the top bar (topNav) and the
// page body. The active sidebar entry is derived from the title
// (activeFor); a tab's sub-entry swaps the page body through htmx, so the
// sidebar and the top bar stay and the URL follows. The top bar is sticky,
// as is a page's toolbar, so the library's A-Z bar can sit exactly beneath
// them and fill the rest of the viewport.
templ Shell(c Chrome) {
	<!DOCTYPE html>
	<html
			lang="en"
			if c.HideScrollbar {
				data-scrollbar="hidden"
			}
		>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ c.Title } · Clustarr</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/htmx-ext-sse.js"></script>
			<script src="/static/idiomorph-ext.min.js"></script>
			<script src="/static/htmx-ext-preload.js"></script>
			<script src="/static/jump.js" defer></script>
			<script src="/static/find.js" defer></script>
			<script src="/static/settings.js" defer></script>
			<script src="/static/library.js" defer></script>
			<script src="/static/art.js" defer></script>
			<script src="/static/portals.js" defer></script>
			<script src="/static/livetv.js" defer></script>
			<script src="/static/guide.js" defer></script>
			@components.Scripts()
		</head>
		<body class="min-h-screen bg-transparent font-sans text-foreground" hx-ext="preload">
			// The top bar spans the window, above the sidebar, as the Plex apps'
			// does (owner, 2026-10-22): the brand lives in it, and the floating
			// sidebar hangs below it (app.css offsets the sidebar's fixed
			// container by the bar's height). The trigger sits outside the
			// provider, so it names the sidebar it toggles.
			@topNav(c)
			@sidebar.Provider(sidebar.ProviderProps{ID: sidebarID, Class: "min-h-[calc(100svh-3rem)]"}) {
				@sidebar.Sidebar(sidebar.Props{Collapsible: sidebar.CollapsibleIcon, Variant: sidebar.VariantFloating}) {
					@sidebar.Content() {
						@sidebar.Group() {
							@sidebar.GroupContent() {
								@sidebar.Menu(sidebar.MenuProps{ID: "app-nav"}) {
									for _, n := range navEntries {
										@sidebar.MenuItem() {
											@sidebar.MenuButton(sidebar.MenuButtonProps{Href: n.Href, IsActive: n.Href == activeFor(c.Title), Tooltip: n.Label}) {
												@icon.Icon(n.Icon)()
												<span>{ n.Label }</span>
											}
											if n.Href == "/library" {
												@librarySubMenu(c.Tab)
											}
											if n.Href == "/livetv" {
												@liveTVSubMenu(c.LiveTV)
											}
										}
									}
								}
							}
						}
					}
					@sidebar.Rail()
				}
				@sidebar.Inset() {
					<div id="page-body" class="flex flex-1 flex-col">
						<div class="flex-1 p-6">
							{ children... }
						</div>
					</div>
				}
			}
		</body>
	</html>
}

// topNav is the top bar (2026-10-06, after Sonarr's header): shadcn's
// navigation menu holding the sidebar trigger and the page's breadcrumb
// trail on the left, the library search centred (headerFind), and the Add
// New menu on the right. The left and right thirds share the width
// evenly, so the search sits at the bar's true centre whatever the trail's
// length; on a narrow screen the search gives way, down to 10rem, before
// the trail (clipped at 6rem, the trigger always shown) or Add New. The
// trail (#page-crumbs) and the search (#header-find) depend on the page,
// so a tab's htmx swap carries both out of band (librarySubMenu's
// hx-select-oob) while the bar itself stays.
templ topNav(c Chrome) {
	<header class="glass sticky top-0 z-30 flex h-12 shrink-0 items-center border-b border-border bg-background/70 px-4">
		@navigationmenu.NavigationMenu(navigationmenu.Props{Align: navigationmenu.AlignEnd, Class: "w-full max-w-none justify-between gap-4"}) {
			<div class="flex min-w-24 flex-1 basis-0 items-center overflow-hidden">
				<a href="/" class="mr-3 flex h-8 shrink-0 items-center gap-2 text-lg font-semibold text-primary">
					<img src="/static/logo.svg" alt="Clustarr" width="24" height="24" class="size-6 shrink-0"/>
					<span class="hidden sm:inline">Clustarr</span>
				</a>
				@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1", Target: sidebarID})
				@separator.Separator(separator.Props{
					Orientation: separator.OrientationVertical,
					Class:       "mx-2 data-vertical:h-4 data-vertical:self-auto",
				})
				<div id="page-crumbs" class="min-w-0 text-sm">
					@breadcrumbs(c.Crumbs)
				</div>
			</div>
			<div id="header-find" class="flex min-w-40 flex-[0_1_28rem] justify-center">
				@headerFind(c.Tab)
			</div>
			<div class="flex flex-1 basis-0 justify-end">
				@navigationmenu.List(navigationmenu.ListProps{Class: "flex-none"}) {
					@navigationmenu.Item() {
						@navigationmenu.Trigger(navigationmenu.TriggerProps{Attributes: templ.Attributes{"data-nav": "add-new"}}) {
							@icon.Icon("plus")(icon.Props{Class: "mr-1 size-4"})
							<span class="hidden sm:inline">Add New</span>
						}
						@navigationmenu.Content(navigationmenu.ContentProps{Class: "w-48"}) {
							<ul class="grid gap-1">
								for _, tab := range projection.Tabs() {
									<li>
										@navigationmenu.Link(navigationmenu.LinkProps{Href: "/library/" + string(tab) + "/add", Attributes: templ.Attributes{"data-nav-add": string(tab)}}) {
											{ "Add " + addLabel(tab) }
										}
									</li>
								}
							</ul>
						}
					}
				}
			</div>
		}
	</header>
}

// breadcrumbs renders the trail: every crumb but the last a link, the last
// the page itself. On a narrow screen only the page shows.
templ breadcrumbs(crumbs []Crumb) {
	if len(crumbs) > 0 {
		@breadcrumb.Breadcrumb() {
			@breadcrumb.List(breadcrumb.ListProps{Class: "flex-nowrap"}) {
				for i, c := range crumbs {
					if i > 0 {
						@breadcrumb.Separator(breadcrumb.SeparatorProps{Class: "hidden md:block"})
					}
					@breadcrumb.Item(breadcrumb.ItemProps{Class: crumbClass(i, len(crumbs))}) {
						if i < len(crumbs)-1 && c.Href != "" {
							@breadcrumb.Link(breadcrumb.LinkProps{Href: c.Href}) { { c.Label } }
						} else {
							@breadcrumb.Page() { { c.Label } }
						}
					}
				}
			}
		}
	}
}

// librarySubMenu is the Library entry's sub-menu (2026-09-24, after
// shadcn's sidebar-07, replacing the top bar's tab strip): one sub-entry
// per projection.Tab, the current one marked, each swapping the page body
// through htmx (hx-select of #page-body, URL pushed) so the sidebar and
// the top bar stay put -- and, since the sidebar sits outside that swap,
// the whole menu out of band (subNavAttrs' hx-select-oob of #app-nav) so
// the active marks follow the tab, with the top bar's trail and search
// (#page-crumbs, #header-find), which name the tab. The component hides the sub-menu while
// the sidebar is collapsed to icons; the Library entry itself still opens
// the library then.
templ librarySubMenu(current projection.Tab) {
	@sidebar.MenuSub(sidebar.MenuSubProps{ID: "library-subnav"}) {
		for _, tab := range projection.Tabs() {
			@sidebar.MenuSubItem() {
				@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
					Href:       "/library/" + string(tab),
					IsActive:   tab == current,
					Attributes: subNavAttrs("/library/" + string(tab)),
				}) {
					<span>{ tabLabel(tab) }</span>
				}
			}
		}
	}
}

// liveTVSubMenu is the Live TV entry's sub-menu (the direct-tuners and ui
// design §5.3): Channels, the M3U/EPG Manager and the TV Guide, each
// swapping the page body as the Library's tabs do.
templ liveTVSubMenu(current string) {
	@sidebar.MenuSub(sidebar.MenuSubProps{ID: "livetv-subnav"}) {
		for _, e := range liveTVEntries {
			@sidebar.MenuSubItem() {
				@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
					Href:       e.Href,
					IsActive:   e.Href == current,
					Attributes: subNavAttrs(e.Href),
				}) {
					<span>{ e.Label }</span>
				}
			}
		}
	}
}

// crumbClass hides every crumb but the page itself on a narrow screen, and
// truncates the page's own, so a long title never pushes the search aside.
func crumbClass(i, n int) string {
	if i < n-1 {
		return "hidden md:inline-flex"
	}
	return "min-w-0 truncate"
}
