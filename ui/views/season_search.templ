package views

import (
	"fmt"

	"github.com/mediactl/clustarr/ui/components/dialog"
)

// SeasonSearchModal is Sonarr's interactive season search (Wave S): the
// season's results, season packs listed by default, in a modal swapped into
// the page's #episode-modal, opening as it lands.
templ SeasonSearchModal(series Detail, season SeasonRow, p SearchPanel) {
	@dialog.Dialog(dialog.Props{DefaultOpen: true}) {
		@dialog.Content(dialog.ContentProps{
			Class:      "max-h-[90vh] overflow-y-auto sm:max-w-6xl",
			Attributes: templ.Attributes{"data-season-search-modal": fmt.Sprint(season.Number)},
		}) {
			@dialog.Header() {
				@dialog.Title() { { fmt.Sprintf("%s - %s", series.Item.Title, season.Label()) } }
				@dialog.Description() { Interactive search }
			}
			@SearchPanelView(p)
		}
	}
}
