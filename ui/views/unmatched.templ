	"fmt"
	"net/url"
	"path"
	"strings"

	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"

	catalogv1 "github.com/mediactl/clustarr/api/catalog/v1alpha1"
	commonv1 "github.com/mediactl/clustarr/api/common/v1alpha1"
	"github.com/mediactl/clustarr/ui/actions"
	"github.com/mediactl/clustarr/ui/components/alert"
	"github.com/mediactl/clustarr/ui/components/badge"
	"github.com/mediactl/clustarr/ui/components/button"
	"github.com/mediactl/clustarr/ui/components/card"
	"github.com/mediactl/clustarr/ui/components/field"
	"github.com/mediactl/clustarr/ui/components/icon"
	"github.com/mediactl/clustarr/ui/components/input"
	"github.com/mediactl/clustarr/ui/components/item"
	selectcomp "github.com/mediactl/clustarr/ui/components/select"
	"github.com/mediactl/clustarr/ui/paging"
	"github.com/mediactl/clustarr/ui/projection"
)

// Unmatched renders the Unmatched page (amendment §A3.4, Task G3-3):
// LibraryScan.status.unmatched -- files the scanner could not attribute to a
// catalog item (A1.5's never-guess rule) -- flattened across every current
// scan, with the reason and any candidates the scanner considered, plus
// (Task G3-4, G2-4's mechanism: app/import/worker/rescan/doc.go, "Manual
// assignment") a per-row manual-assign form.
//
// #unmatched-rows is the sse-swap target, mirroring every other live page:
// htmx's SSE extension replaces that element's innerHTML with the named
// event's data, so everything inside it (and only what's inside it) must be
// exactly what UnmatchedRows renders.
templ Unmatched(p paging.Page, entries []projection.UnmatchedEntry) {
	@Layout("Unmatched") {
		<h1 class="mb-4 text-2xl font-bold">Unmatched</h1>
		<div
			id="unmatched-rows"
			hx-ext="sse, morph"
			sse-connect={ "/events/unmatched" + p.Query(p.Number) }
			sse-swap="unmatched"
			hx-swap="morph:innerHTML"
			class="space-y-4"
		>
			@UnmatchedList(p, entries)
		</div>
	}
}

// UnmatchedList is what #unmatched-rows holds and what every
// /events/unmatched frame carries: the pager, the page's rows, the pager
// again. entries is already the page's window.
templ UnmatchedList(p paging.Page, entries []projection.UnmatchedEntry) {
	@Pager(p, "/unmatched")
	@UnmatchedRows(entries)
	@Pager(p, "/unmatched")
}

// UnmatchedRows renders the dynamic part of the Unmatched page: the "nothing
// unmatched" placeholder or the row list. This is also what /events/unmatched
// renders into each SSE event's data, so the initial page render and every
// live update produce byte-for-byte the same markup for #unmatched-rows's
// contents.
templ UnmatchedRows(entries []projection.UnmatchedEntry) {
	if len(entries) == 0 {
		@emptyState("file-x", "Nothing unmatched.", "Every scanned file was attributed to an item.", templ.Attributes{"data-empty": "unmatched"})
	}
	@item.Group(item.GroupProps{Class: "gap-3"}) {
		for _, e := range entries {
			@unmatchedRow(e)
		}
	}
}

// unmatchedRow renders one UnmatchedEntry: its path, the scanner's reason,
// any candidates it considered but would not guess between, and the
// manual-assign form -- or, for a folder the scan could not identify
// (Folder; the 2026-11-10 non-video libraries design's D20), its Add
// buttons instead ([folderActions]). Every row carries data-scan,
// data-root-folder, data-path, data-reason and data-candidates, and a
// folder's data-folder (ruling R8): the UI tests assert on these
// attributes, not on visible copy, so a wording change does not break a
// test and a markup change does not pass one.
templ unmatchedRow(e projection.UnmatchedEntry) {
	@item.Item(item.Props{
		Variant: item.VariantOutline,
		Class:   "flex-wrap items-start",
		Attributes: templ.Attributes{
			"data-scan":        e.ScanRef.String(),
			"data-root-folder": e.RootFolder,
			"data-path":        e.Path,
			"data-reason":      e.Reason,
			"data-candidates":  strings.Join(e.Candidates, ","),
			"data-folder":      e.Folder,
		},
	}) {
		if e.Folder {
			@item.Media(item.MediaProps{Variant: item.MediaVariantIcon}) {
				@icon.Icon("folder")()
			}
		}
		@item.Content() {
			@item.Title() {
				{ e.Path }
			}
			@item.Description(item.DescriptionProps{Class: "text-amber-300"}) {
				{ e.Reason }
			}
			if len(e.Candidates) > 0 {
				@item.Description() {
					Candidates: { strings.Join(e.Candidates, ", ") }
				}
			}
		}
		@item.Content(item.ContentProps{Class: "flex-none items-end"}) {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				{ e.RootFolder }
			}
		}
		@item.Footer(item.FooterProps{Class: "basis-full"}) {
			if e.Folder {
				@folderActions(e)
			} else {
				@manualAssignForm(e)
			}
		}
	}
}

// folderActions confirms a folder the scan could not identify as an
// Artist, Author or Audiobook (the 2026-11-10 non-video libraries design's
// D20, Lidarr's Library Import confirmation; the scan never picks among the
// hits itself): one "Add as <kind>" button per candidate the scan listed,
// each a form posting Add New's create to the folder's tab
// (POST /library/{tab}/add, ui/add.go's handleAddCreate) with the hit's
// title and provider id, the scan's root folder and the folder, which the
// add pins as the item's spec.folder (actions.AddRequest.Folder); an
// audiobook's "<author>/<title>" folder also names its author, which the add
// links as Add New links a hit's (audiobookAuthorRef). The form posts no
// profile, monitoring or search, so the add takes the root folder's
// defaults and starts no search, as the scan's own create would have.
// "Search Add New" opens the tab's Add New on the folder's name, the folder
// and root riding along so the hit chosen there pins it too. A folder whose
// root folder the projection could not read offers neither.
templ folderActions(e projection.UnmatchedEntry) {
	<div class="flex w-full flex-wrap items-center gap-2 border-t border-border pt-3" data-folder-actions={ e.Path }>
		if e.Tab == "" {
			@item.Description() {
				Its root folder { e.RootFolder } is gone or holds no artists, authors or audiobooks, so there is nothing to add it as.
			}
		} else {
			for _, c := range folderCandidates(e) {
				<form method="post" action={ templ.SafeURL("/library/" + string(e.Tab) + "/add") } data-folder-add={ c.ID }>
					<input type="hidden" name="title" value={ c.Name }/>
					<input type="hidden" name="id" value={ c.ID }/>
					<input type="hidden" name="rootFolder" value={ e.ScanRef.Namespace + "/" + e.RootFolder }/>
					<input type="hidden" name="folder" value={ e.Path }/>
					if author := folderAuthor(e); author != "" {
						<input type="hidden" name="authorName" value={ author }/>
					}
					@button.Button(button.Props{
						Type:       button.TypeSubmit,
						Size:       button.SizeSm,
						Variant:    button.VariantOutline,
						Attributes: templ.Attributes{"data-action": "add-folder", "title": string(e.Kind) + " " + c.ID},
					}) {
						@icon.Icon("folder-plus")()
						Add as { string(e.Kind) }: { c.Label() }
					}
				</form>
			}
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Href:       folderSearchURL(e),
				Attributes: templ.Attributes{"data-action": "search-folder"},
			}) {
				@icon.Icon("search")()
				Search Add New
			}
		}
	</div>
}

// folderCandidates are a folder entry's candidates that name a provider
// hit ("Name (disambiguation) [id]", projection.ParseFolderCandidate), in
// the scan's order; any other string is shown among the candidates but
// offers no button.
func folderCandidates(e projection.UnmatchedEntry) []projection.FolderCandidate {
	out := make([]projection.FolderCandidate, 0, len(e.Candidates))
	for _, raw := range e.Candidates {
		if c, ok := projection.ParseFolderCandidate(raw); ok {
			out = append(out, c)
		}
	}
	return out
}

// folderAuthor is the author an audiobook folder names, its first segment
// ("<author>/<title>", the layout an audiobook root's scan reads); "" for
// any other kind, or a folder of one segment.
func folderAuthor(e projection.UnmatchedEntry) string {
	if e.Kind != commonv1.MediaKindAudiobook {
		return ""
	}
	author, _, ok := strings.Cut(e.Path, "/")
	if !ok {
		return ""
	}
	return strings.TrimSpace(author)
}

// folderSearchURL is the folder's tab's Add New, its search box filled with
// the folder's own name (an audiobook's title, the last segment) and the
// folder and root carried for the hit's form to pin (AddPageData.Folder).
func folderSearchURL(e projection.UnmatchedEntry) string {
	q := url.Values{"q": {path.Base(e.Path)}}
	return "/library/" + string(e.Tab) + "/add?" + q.Encode() + "&" + AddFolderQuery(e.Path, e.ScanRef.Namespace+"/"+e.RootFolder)
}

// manualAssignForm renders one unmatched entry's "assign" form
// (app/import/worker/rescan/doc.go, "Manual assignment"), on shadcn-templ's
// fields since 2026-11-04: a name input with the row's own candidates
// offered through a <datalist> -- a native, no-JavaScript
// picker-plus-free-form-text hybrid, since ui ships no client-side
// framework -- a select (shadcn-templ's, the owner's choice over the native
// one) restricted to actions.MediaKinds(), and an
// optional key for a comic or series target.
// Submitting posts to POST /unmatched/assign (ui/routes.go's
// handleManualAssign), which calls Options.Actions.ManualAssign and, on
// success, redirects to the created LibraryScan's own detail page
// ([LibraryScanDetail]) so the user can see whether the worker accepted it;
// on failure it renders through routes.go's finishAction exactly like the
// Library page's own actions, so actions.ErrNoWriter and actions.ErrInvalid
// are visible rather than silently doing nothing.
templ manualAssignForm(e projection.UnmatchedEntry) {
	<form
		method="post"
		action="/unmatched/assign"
		class="flex w-full flex-wrap items-end gap-2 border-t border-border pt-3"
		data-manual-assign-form={ e.Path }
	>
		<input type="hidden" name="namespace" value={ e.ScanRef.Namespace }/>
		<input type="hidden" name="rootFolder" value={ e.RootFolder }/>
		<input type="hidden" name="subpath" value={ e.Path }/>
		<input type="hidden" name="return" value="/unmatched"/>
		{{ id := manualAssignRowID(e) }}
		@field.Field(field.Props{Class: "w-auto gap-1.5"}) {
			@field.Label(field.LabelProps{For: "kind-" + id + "-trigger", Class: "text-xs text-muted-foreground"}) {
				Kind
			}
			@selectcomp.Select(selectcomp.Props{ID: "kind-" + id, Name: "kind", DefaultValue: string(actions.MediaKinds()[0]), Required: true}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{Size: selectcomp.SizeSm, Class: "w-32"}) {
					@selectcomp.Value()
				}
				@selectcomp.Content() {
					for _, kind := range actions.MediaKinds() {
						@selectcomp.Item(selectcomp.ItemProps{Value: string(kind)}) {
							{ string(kind) }
						}
					}
				}
			}
		}
		@field.Field(field.Props{Class: "w-auto gap-1.5"}) {
			@field.Label(field.LabelProps{For: "name-" + id, Class: "text-xs text-muted-foreground"}) {
				Name
			}
			@input.Input(input.Props{ID: "name-" + id, Name: "name", Placeholder: "item name", Class: "h-8 w-48", Attributes: templ.Attributes{"list": "candidates-" + id}})
			if len(e.Candidates) > 0 {
				<datalist id={ "candidates-" + id }>
					for _, c := range e.Candidates {
						<option value={ c }></option>
					}
				</datalist>
			}
		}
		@field.Field(field.Props{Class: "w-auto gap-1.5"}) {
			@field.Label(field.LabelProps{For: "key-" + id, Class: "text-xs text-muted-foreground"}) {
				Key (comic/series only)
			}
			@input.Input(input.Props{ID: "key-" + id, Name: "key", Placeholder: "issue or episode name", Class: "h-8 w-40"})
		}
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Attributes: templ.Attributes{"data-action": "manual-assign"}}) {
			Assign
		}
	</form>
}

// manualAssignRowID builds a stable, HTML-id-safe identifier for one row's
// form elements from its scan name and path, replacing characters a file
// path may contain but an id attribute should not (spaces, slashes, dots).
func manualAssignRowID(e projection.UnmatchedEntry) string {
	r := strings.NewReplacer(" ", "-", "/", "-", ".", "-", "(", "", ")", "")
	return r.Replace(e.ScanRef.Name + "-" + e.Path)
}

// LibraryScanDetail renders one LibraryScan's status (Task G3-4): phase,
// file/item counts, and -- once the worker has ruled on a manual assignment
// -- the Ready condition's reason and message, which is where a refusal
// (bad target, subpath outside the root, a path already recorded elsewhere)
// shows up (app/import/worker/rescan/doc.go: "a malformed or unusable
// annotation ... end the scan Done with the reason (the LibraryScan
// controller reports it as Failed)"). This is a plain GET of one resource
// the UI already had create access to -- the UI never writes status, and
// this page reads it, exactly like every other page's own status reads.
templ LibraryScanDetail(scan catalogv1.LibraryScan) {
	@Layout(scan.Name) {
		@button.Button(button.Props{Variant: button.VariantLink, Size: button.SizeSm, Href: "/unmatched", Class: "px-0 text-muted-foreground"}) {
			@icon.Icon("arrow-left")()
			Unmatched
		}
		@card.Card(card.Props{Class: "mt-4", Attributes: templ.Attributes{"data-scan": scan.Namespace + "/" + scan.Name, "data-phase": string(scan.Status.Phase)}}) {
			@card.Header() {
				@card.Title(card.TitleProps{Class: "text-2xl font-bold"}) {
					{ scan.Name }
				}
				@card.Description() {
					root folder { scan.Spec.RootFolderRef }
					if scan.Spec.Subpath != "" {
						· { scan.Spec.Subpath }
					}
				}
				@card.Action() {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: scanPhaseTone(scan.Status.Phase)}) {
						{ scanPhaseLabel(scan.Status.Phase) }
					}
				}
			}
			@card.Content() {
				<div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
					<span>{ fmt.Sprintf("files seen %d", scan.Status.FilesSeen) }</span>
					<span>{ fmt.Sprintf("files matched %d", scan.Status.FilesMatched) }</span>
					<span>{ fmt.Sprintf("files skipped %d", scan.Status.FilesSkipped) }</span>
					<span>{ fmt.Sprintf("items created %d", scan.Status.ItemsCreated) }</span>
					<span>{ fmt.Sprintf("items updated %d", scan.Status.ItemsUpdated) }</span>
				</div>
				if progress := scanProgress(scan); progress != "" {
					<p class="mt-3 text-sm text-muted-foreground" data-scan-progress>{ progress }</p>
				}
				if awaiting := scanAwaiting(scan); awaiting != "" {
					@alert.Alert(alert.Props{Class: "mt-3", Attributes: templ.Attributes{"data-scan-awaiting": awaiting}}) {
						@icon.Icon("hourglass")()
						@alert.Title() {
							Files awaiting their items' children
						}
						@alert.Description() {
							{ awaiting }. Each item's own folder scan attributes its files once its children are listed.
						}
					}
				}
				if reason, message, ok := scanReadyFailure(scan); ok {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Attributes: templ.Attributes{"data-scan-failure": reason}}) {
						@icon.CircleAlert()
						@alert.Title() {
							{ reason }
						}
						@alert.Description() {
							{ message }
						}
					}
				}
			}
		}
	}
}

// scanPhaseLabel and scanPhaseTone render a LibraryScan's coarse
// phase, mirroring library.templ's phaseTone for the same
// unset-phase-still-renders-sensibly reasoning.
func scanPhaseLabel(phase catalogv1.ScanPhase) string {
	if phase == "" {
		return "unset"
	}
	return string(phase)
}

// scanPhaseTone is the phase badge's colour, over the badge component's
// own shape (shadcn-templ's badge, since 2026-11-04).
func scanPhaseTone(phase catalogv1.ScanPhase) string {
	switch phase {
	case catalogv1.ScanPhaseFailed:
		return "bg-red-500/20 text-red-300"
	case catalogv1.ScanPhaseCompleted:
		return "bg-emerald-500/20 text-emerald-300"
	case "":
		return "bg-slate-500/20 text-slate-300"
	default:
		return "bg-sky-500/20 text-sky-300"
	}
}

// scanReadyFailure reads the scan's "Ready" condition (the one condition
// type every Clustarr kind reports -- restated as a literal here, the way
// ui/actions restates pkg/k8s.ManagerUI's value, because ui/ may not import
// pkg/k8s) and reports its Reason and Message when the condition is present
// and not True: this is where the worker's refusal of a manual assignment
// (a bad target, a subpath outside the root, a path already recorded
// elsewhere) surfaces.
func scanReadyFailure(scan catalogv1.LibraryScan) (reason, message string, ok bool) {
	c, found := scanReady(scan)
	if !found || c.Status == metav1.ConditionTrue || c.Reason == scanReasonScanning {
		// A running scan is not failed: its message is its progress.
		return "", "", false
	}
	return c.Reason, c.Message, true
}

// scanReasonScanning is the Ready reason of a scan still walking
// (app/import/controller/libraryscan.ReasonScanning, restated as
// conditionReady is; TestTheScanPageShowsWhatAwaitsItsChildren holds the
// two equal): its False Ready is the walk's progress, not a failure.
const scanReasonScanning = "Scanning"

// scanReady is the scan's Ready condition, when it has one.
func scanReady(scan catalogv1.LibraryScan) (metav1.Condition, bool) {
	const conditionReady = "Ready"
	for _, c := range scan.Status.Conditions {
		if c.Type == conditionReady {
			return c, true
		}
	}
	return metav1.Condition{}, false
}

// scanProgress is the scan's progress line: the Ready condition's message
// while the scan walks (reason Scanning) and once it succeeded, which the
// LibraryScan controller writes as the tally's summary
// (app/import/scanprogress.Progress.Summary: the counters, then the
// breakdown the CRD has no field for); "" before the first condition and
// for a failed scan, whose alert says it.
func scanProgress(scan catalogv1.LibraryScan) string {
	c, ok := scanReady(scan)
	if !ok || (c.Status != metav1.ConditionTrue && c.Reason != scanReasonScanning) {
		return ""
	}
	return c.Message
}

// scanAwaiting is the summary's clause counting the files that await their
// items' children -- the scan progress's awaitingChildren, kind by kind,
// "412 awaiting their artists' albums, 3 awaiting their series' episodes"
// (scanprogress.Progress.Summary's "; <clauses>, which each one's own
// folder scan attributes once they are listed"; the 2026-11-10 non-video
// libraries design's D20) -- read from the Ready condition's message,
// failed or not, since LibraryScanStatus has no field for it; "" when
// nothing awaits.
func scanAwaiting(scan catalogv1.LibraryScan) string {
	c, ok := scanReady(scan)
	if !ok {
		return ""
	}
	for _, part := range strings.Split(c.Message, "; ") {
		if !strings.Contains(part, " awaiting ") {
			continue
		}
		clause, _, _ := strings.Cut(part, ", which ")
		return strings.TrimSpace(clause)
	}
	return ""
}
