{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "plex",
  "type": "registry:style",
  "title": "Plex",
  "description": "Clustarr's UI theme, as close to Plex's web app as shadcn tokens allow: Plex Gold (#e5a00d) as the primary, Plex's dark gray (#282a2d) for surfaces on a slightly darker page, light gray text, tight 4px corners and the Open Sans face Plex set. Plex has one look, so the light and dark token sets are the same dark palette. Apply with `shadcn-templ apply --preset <url of this file>`; the shades that are not the two brand colours are derived, not lifted from Plex.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Open Sans\", \"Noto Sans\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "ui-monospace, \"JetBrains Mono\", \"SFMono-Regular\", Menlo, monospace",
      "radius": "0.25rem"
    },
    "light": {
      "background": "#1f2326",
      "foreground": "#eeeeee",
      "card": "#282a2d",
      "card-foreground": "#eeeeee",
      "popover": "#2f3235",
      "popover-foreground": "#eeeeee",
      "primary": "#e5a00d",
      "primary-foreground": "#1f2326",
      "secondary": "#3a3d41",
      "secondary-foreground": "#eeeeee",
      "muted": "#33363a",
      "muted-foreground": "#9a9a9a",
      "accent": "#3f4245",
      "accent-foreground": "#ffffff",
      "destructive": "#e5484d",
      "destructive-foreground": "#ffffff",
      "border": "#3a3d41",
      "input": "#3a3d41",
      "ring": "#e5a00d",
      "chart-1": "#e5a00d",
      "chart-2": "#f2c94c",
      "chart-3": "#cc7b19",
      "chart-4": "#9a9a9a",
      "chart-5": "#eeeeee",
      "sidebar": "#1f2326",
      "sidebar-foreground": "#eeeeee",
      "sidebar-primary": "#e5a00d",
      "sidebar-primary-foreground": "#1f2326",
      "sidebar-accent": "#282a2d",
      "sidebar-accent-foreground": "#eeeeee",
      "sidebar-border": "#3a3d41",
      "sidebar-ring": "#e5a00d"
    },
    "dark": {
