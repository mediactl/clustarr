{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "plex",
  "type": "registry:style",
  "title": "Plex",
  "description": "Clustarr's UI theme, Plex's native look (the iOS, tvOS and web apps, 2026-10-22): one dark canvas (#111417), every surface a translucent white laid over it so artwork behind a page shows through the glass, hairlines in the same white, Plex Gold (#e5a00d) as the one accent, 12px corners and the Open Sans face Plex set. The surfaces are rgba on purpose: Tailwind's opacity modifiers colour-mix them like any other colour, and ui/static/input.css adds the blur to the frosted ones. Plex has one look, so the light and dark token sets are the same dark palette. Apply with `shadcn-templ apply --preset <url of this file>`; ui/static/input.css is the copy that builds app.css and is the one to keep in step.",
  "cssVars": {
    "theme": {
      "font-sans": "\"Open Sans\", \"Noto Sans\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "ui-monospace, \"JetBrains Mono\", \"SFMono-Regular\", Menlo, monospace",
      "radius": "0.75rem"
    },
    "light": {
      "background": "#111417",
      "foreground": "#f3f4f6",
      "card": "rgba(255, 255, 255, 0.055)",
      "card-foreground": "#f3f4f6",
      "popover": "rgba(30, 33, 37, 0.82)",
      "popover-foreground": "#f3f4f6",
      "primary": "#e5a00d",
      "primary-foreground": "#141414",
      "secondary": "rgba(255, 255, 255, 0.1)",
      "secondary-foreground": "#f3f4f6",
      "muted": "rgba(255, 255, 255, 0.08)",
      "muted-foreground": "#a7adb4",
      "accent": "rgba(255, 255, 255, 0.12)",
      "accent-foreground": "#ffffff",
      "destructive": "#e5484d",
      "destructive-foreground": "#ffffff",
      "border": "rgba(255, 255, 255, 0.1)",
      "input": "rgba(255, 255, 255, 0.12)",
      "ring": "#e5a00d",
      "chart-1": "#e5a00d",
      "chart-2": "#f2c94c",
      "chart-3": "#cc7b19",
      "chart-4": "#a7adb4",
      "chart-5": "#f3f4f6",
      "sidebar": "rgba(17, 20, 23, 0.62)",
      "sidebar-foreground": "#f3f4f6",
      "sidebar-primary": "#e5a00d",
      "sidebar-primary-foreground": "#141414",
      "sidebar-accent": "rgba(255, 255, 255, 0.1)",
      "sidebar-accent-foreground": "#ffffff",
      "sidebar-border": "rgba(255, 255, 255, 0.08)",
      "sidebar-ring": "#e5a00d"
    },
    "dark": {
      "background": "#111417",
      "foreground": "#f3f4f6",
      "card": "rgba(255, 255, 255, 0.055)",
      "card-foreground": "#f3f4f6",
      "popover": "rgba(30, 33, 37, 0.82)",
      "popover-foreground": "#f3f4f6",
      "primary": "#e5a00d",
      "primary-foreground": "#141414",
      "secondary": "rgba(255, 255, 255, 0.1)",
      "secondary-foreground": "#f3f4f6",
      "muted": "rgba(255, 255, 255, 0.08)",
      "muted-foreground": "#a7adb4",
      "accent": "rgba(255, 255, 255, 0.12)",
      "accent-foreground": "#ffffff",
      "destructive": "#e5484d",
      "destructive-foreground": "#ffffff",
      "border": "rgba(255, 255, 255, 0.1)",
      "input": "rgba(255, 255, 255, 0.12)",
      "ring": "#e5a00d",
      "chart-1": "#e5a00d",
      "chart-2": "#f2c94c",
      "chart-3": "#cc7b19",
      "chart-4": "#a7adb4",
      "chart-5": "#f3f4f6",
      "sidebar": "rgba(17, 20, 23, 0.62)",
      "sidebar-foreground": "#f3f4f6",
      "sidebar-primary": "#e5a00d",
      "sidebar-primary-foreground": "#141414",
      "sidebar-accent": "rgba(255, 255, 255, 0.1)",
      "sidebar-accent-foreground": "#ffffff",
      "sidebar-border": "rgba(255, 255, 255, 0.08)",
      "sidebar-ring": "#e5a00d"
    }
  }
}
