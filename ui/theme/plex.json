{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "plex",
  "type": "registry:style",
  "title": "Plex Liquid Glass",
  "description": "Clustarr's UI theme (2026-11-28, the Liquid Glass redesign): a first-party Apple look in the spirit of Apple Music and the TV app, Plex-native adjacent. A near-black canvas (#050507) under Plex's four corner colours as faint light; content is translucent platters that do not blur; the navigation and floating layers are Liquid Glass (ui/static/input.css adds the blur, the specular rims and the per-slot rules); Apple's dark label, fill and system colours; Plex Gold (#e5a00d) as the one tint; SF on Apple devices and Inter elsewhere; concentric radii with capsule controls. One appearance, so the light and dark token sets are the same dark palette. Apply with `shadcn-templ apply --preset <url of this file>`; ui/static/input.css is the copy that builds app.css and is the one to keep in step.",
  "cssVars": {
    "theme": {
      "font-sans": "-apple-system, BlinkMacSystemFont, \"Inter\", \"Noto Sans\", system-ui, sans-serif",
      "font-mono": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, monospace",
      "radius": "0.625rem"
    },
    "light": {
      "background": "#050507",
      "foreground": "#f5f5f7",
      "card": "rgba(30, 30, 34, 0.68)",
      "card-foreground": "#f5f5f7",
      "popover": "rgba(36, 36, 42, 0.74)",
      "popover-foreground": "#f5f5f7",
      "primary": "#e5a00d",
      "primary-foreground": "#1a1200",
      "secondary": "rgba(118, 118, 128, 0.24)",
      "secondary-foreground": "#f5f5f7",
      "muted": "rgba(118, 118, 128, 0.18)",
      "muted-foreground": "rgba(235, 235, 245, 0.62)",
      "accent": "rgba(255, 255, 255, 0.1)",
      "accent-foreground": "#f5f5f7",
      "destructive": "#ff6961",
      "destructive-foreground": "#ffffff",
      "border": "rgba(255, 255, 255, 0.1)",
      "input": "rgba(118, 118, 128, 0.24)",
      "ring": "#e5a00d",
      "chart-1": "#e5a00d",
      "chart-2": "#0a84ff",
      "chart-3": "#30d158",
      "chart-4": "#bf5af2",
      "chart-5": "#8e8e93",
      "radius": "0.625rem",
      "sidebar": "transparent",
      "sidebar-foreground": "#f5f5f7",
      "sidebar-primary": "#e5a00d",
      "sidebar-primary-foreground": "#1a1200",
      "sidebar-accent": "rgba(255, 255, 255, 0.12)",
      "sidebar-accent-foreground": "#f5f5f7",
      "sidebar-border": "transparent",
      "sidebar-ring": "#e5a00d"
    },
    "dark": {
      "background": "#050507",
      "foreground": "#f5f5f7",
      "card": "rgba(30, 30, 34, 0.68)",
      "card-foreground": "#f5f5f7",
      "popover": "rgba(36, 36, 42, 0.74)",
      "popover-foreground": "#f5f5f7",
      "primary": "#e5a00d",
      "primary-foreground": "#1a1200",
      "secondary": "rgba(118, 118, 128, 0.24)",
      "secondary-foreground": "#f5f5f7",
      "muted": "rgba(118, 118, 128, 0.18)",
      "muted-foreground": "rgba(235, 235, 245, 0.62)",
      "accent": "rgba(255, 255, 255, 0.1)",
      "accent-foreground": "#f5f5f7",
      "destructive": "#ff6961",
      "destructive-foreground": "#ffffff",
      "border": "rgba(255, 255, 255, 0.1)",
      "input": "rgba(118, 118, 128, 0.24)",
      "ring": "#e5a00d",
      "chart-1": "#e5a00d",
      "chart-2": "#0a84ff",
      "chart-3": "#30d158",
      "chart-4": "#bf5af2",
      "chart-5": "#8e8e93",
      "radius": "0.625rem",
      "sidebar": "transparent",
      "sidebar-foreground": "#f5f5f7",
      "sidebar-primary": "#e5a00d",
      "sidebar-primary-foreground": "#1a1200",
      "sidebar-accent": "rgba(255, 255, 255, 0.12)",
      "sidebar-accent-foreground": "#f5f5f7",
      "sidebar-border": "transparent",
      "sidebar-ring": "#e5a00d"
    }
  }
}
