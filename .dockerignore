# Build context for images/Dockerfile.*: the Go module plus the fixture
# sources. Keep VCS metadata, local tooling state and build output out, so
# they neither bloat the context nor invalidate the `COPY . .` layer cache.
.git
.github
.superpowers
.worktrees
.claude
bin/
# A bare `go build` of one of ./cmd/* drops its binary in the repo root. No
# /ui: the ui/ package directory holds that name, and the pattern would drop
# the package from the build context.
/manager
/agent
/markers
/transcode
charts/clustarr/charts/*.tgz
